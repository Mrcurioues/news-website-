      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHD7urH_zbqs8Kv3OtlLojz74kRyJ18H6tYsqaCnhwsew6NttS-iLqH5M90sKK2XuNSPz6A2JFl-rCilebHWs6IW1hIjhQzB6aNhKEtlSqeEzmV1PEIur_1VrAOoPLer3A4PcsWZ3jobk_fOMVhQ5nApGYt0TobAwxGAeYALdTaylzqKko="
