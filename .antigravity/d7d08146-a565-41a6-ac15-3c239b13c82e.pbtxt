        lines {
          text: "          <span>{isAssistantDrawerOpen ? \'\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\254\340\244\202\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\' : \'WP AI Assistant\'}</span>"
