        }
        lines {
          text: "  const [enhancedResult, setEnhancedResult] = useState<string | null>(null);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [isEnhancing, setIsEnhancing] = useState(false);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
