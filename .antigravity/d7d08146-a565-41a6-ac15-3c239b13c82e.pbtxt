340\245\201\340\244\241, \340\244\270\340\244\277\340\244\250\340\245\207\340\244\256\340\244\276 \340\244\224\340\244\260 \340\244\223\340\244\237\340\245\200\340\244\237\340\245\200 \340\244\225\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\', color: \'bg-purple-600\' },\n  { id: \'5\', slug: \'business\', nameHi: \'\340\244\265\340\245\215\340\244\257\340\244\276\340\244\252\340\244\276\340\244\260\', nameEn: \'Business\', description: \'\340\244\266\340\245\207\340\244\257\340\244\260 \340\244\254\340\244\276\340\244\234\340\244\276\340\244\260, \340\244\254\340\244\234\340\244\237, \340\244\205\340\244\260\340\245\215\340\244\245\340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276 \340\244\224\340\244\260 \340\244\225\340\245\211\340\244\260\340\245\215\340\244\252\340\245\213\340\244\260\340\245\207\340\244\237\', color: \'bg-emerald-600\' },\n  { id: \'6\', slug: \'tech\', nameHi: \'\340\244\244\340\244\225\340\244\250\340\245\200\340\244\225\', nameEn: \'Tech & AI\', description: \'\340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250, \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\253\340\244\277\340\244\266\340\244\277\340\244\257\340\244\262 \340\244\207\340\244\202\340\244\237\340\245\207\340\244\262\340\244\277\340\244\234\340\245\207\340\244\202\340\244\270 \340\244\224\340\244\260 \340\244\227\340\245\210\340\244\234\340\245\207\340\244\237\340\245\215\340\244\270\', color: \'bg-cyan-600\' },\n  { id: \'7\', slug: \'world\', nameHi: \'\340\244\265\340\244\277\340\244\246\340\245\207\340\244\266\', nameEn: \'World\', description: \'\340\244\265\340\245\210\340\244\266\340\245\215\340\244\265\340\244\277\340\244\225 \340\244\225\340\245\202\340\244\237\340\244\250\340\245\200\340\244\244\340\244\277 \340\244\224\340\244\260 \340\244\205\340\244\202\340\244\244\340\244\260\340\244\260\