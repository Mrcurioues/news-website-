        lines {
          text: "          className=\"px-4 py-3 rounded-full bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold text-xs sm:text-sm shadow-xl flex items-center gap-2 transition-transform hover:scale-105\""
