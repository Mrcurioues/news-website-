      replacement_content: "          {/* =========================================================\n              VIEW 10: USER ROLES & PERMISSIONS (Module 10)\n             ========================================================= */}\n          {activeSection === \'roles\' && (\n            <div className=\"space-y-6\">\n              {/* Clean Sub-Nav for Workflow & Settings */}\n              <div className=\"flex items-center gap-1.5 p-1 bg-gray-100/90 rounded-xl w-fit overflow-x-auto max-w-full\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'revisions\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\225\222 {t.revTitle}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'taxonomy\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\217\267\357\270\217 {t.modTaxonomy}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'roles\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap bg-white text-gray-900 shadow-2xs cursor-pointer\"\n                >\n                  \360\237\221\245 {t.modRoles}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'delete_module\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\233\241\357\270\217 {t.modDelete}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'settings_help\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \342\232\231\357\270\217 {t.modSettings}\n                </button>\n              </div>\n\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Users className=\"w-5 h-5 text-indigo-600\" />\n                    <span>{t.modRoles}</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    {lang === \'en\' ? \'User permissions, role-based access control (RBAC), and review approval queue\' : \'\340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276\340\244\252\340\244\225, \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225, \340\244\262\340\245\207\340\244\226\340\244\225 \340\244\217\340\244\265\340\244\202 \340\244\257\340\245\213\340\244\227\340\244\246\340\244\276\340\244\250\340\244\225\340\244\260\340\245\215\340\244\244\340\244\276 \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276\340\244\223\340\244\202 \340\244\225\340\245\200 \340\244\205\340\244\250\340\245\201\340\244\256\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202\'}\n                  </p>\n                </div>\n              </div>"
