  file_change {
    absolute_path_uri: "file:///src/pages/AdminPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { getAllArticles, CATEGORIES, addArticle } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { Article } from \'../types\';\nimport {\n  ShieldCheck,\n  PlusCircle,\n  List,\n  CheckCircle,\n  Eye,\n  Radio,\n  Flame,\n  FileText,\n  ExternalLink,\n  Sparkles\n} from \'lucide-react\';\n\nexport const AdminPage: React.FC = () => {\n  const { updateMetadata, push } = useRouter();\n  const [articles, setArticles] = useState<Article[]>(() => getAllArticles());\n  const [activeTab, setActiveTab] = useState<\'list\' | \'create\'>(\'list\');\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n  const [newCreatedSlug, setNewCreatedSlug] = useState<string | null>(null);\n\n  // Form State\n  const [formData, setFormData] = useState({\n    title: \'\',\n    titleEn: \'\',\n    categorySlug: \'national\',\n    excerpt: \'\',\n    bodyText: \'\',\n    coverImage: \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\',\n    isBreaking: false,\n    isTrending: true\n  });\n\n  useEffect(() => {\n    updateMetadata({\n      title: \'\340\244\250\340\245\215\340\244\257\340\245\202\340\244\234 \340\244\260\340\245\202\340\244\256 \340\244\217\340\244\241\340\244\256\340\244\277\340\244\250 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 (Demo) - Newsroom Admin Dashboard\',\n      description: \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 - \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\217\340\244\265\340\244\202 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 (\340\244\241\340\245\207\340\244\256\340\245\213)\'\n    });\n  }, []);\n\n  const handlePresetImage = (url: string) => {\n    setFormData((prev) => ({ ...prev, coverImage: url }));\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.title.trim() || !formData.excerpt.trim()) {\n      alert(\'\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\');\n      return;\n    }\n\n    const paragraphs = formData.bodyText\n      .split(\'\\n\\n\')\n      .map((p) => p.trim())\n      .filter((p) => p.length > 0);\n\n    const created = addArticle({\n      title: formData.title.trim(),\n      titleEn: formData.titleEn.trim(),\n      categorySlug: formData.categorySlug,\n      excerpt: formData.excerpt.trim(),\n      body: paragraphs.length > 0 ? paragraphs : [formData.excerpt.trim()],\n      coverImage: formData.coverImage,\n      isBreaking: formData.isBreaking,\n      isTrending: formData.isTrending\n    });\n\n    setArticles([...getAllArticles()]);\n    setSuccessMessage(`\340\244\262\340\245\207\340\244\226 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\201\340\244\206!`);\n    setNewCreatedSlug(created.idSlug);\n    setActiveTab(\'list\');\n\n    // Reset Form\n    setFormData({\n      title: \'\',\n      titleEn: \'\',\n      categorySlug: \'national\',\n      excerpt: \'\',\n      bodyText: \'\',\n      coverImage: \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\',\n      isBreaking: false,\n      isTrending: true\n    });\n\n    setTimeout(() => {\n      setSuccessMessage(null);\n    }, 6000);\n  };\n\n  const breakingCount = articles.filter(a => a.isBreaking).length;\n  const totalViews = articles.reduce((acc, a) => acc + a.views, 0);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Top Banner */}\n      <div className=\"bg-linear-to-r from-gray-900 via-slate-900 to-zinc-900 text-white rounded-xl p-6 sm:p-8 mb-6 shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"px-2.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold uppercase tracking-wider flex items-center gap-1\">\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              \340\244\241\340\245\207\340\244\256\340\245\213 \340\244\217\340\244\241\340\244\256\340\244\277\340\244\250 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 (Pitch Demo)\n            </span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-white\">\n            \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 (Newsroom Admin)\n          </h1>\n          <p className=\"text-xs sm:text-sm text-gray-400 mt-1\">\n            \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\245\207 \340\244\206\340\244\252 \340\244\250\340\244\210 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\254\340\244\250\340\244\276 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\234\340\245\213 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 \340\244\252\340\244\260 \340\244\246\340\244\277\340\244\226\340\244\276\340\244\210 \340\244\246\340\245\207\340\244\202\340\244\227\340\245\200\340\245\244\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'create\')}\n            className=\"flex items-center gap-2 px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-bold text-xs sm:text-sm transition-colors shadow-sm\"\n          >\n            <PlusCircle className=\"w-4 h-4\" />\n            <span>\340\244\250\340\244\210 \340\244\226\340\244\254\340\244\260 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202 (Publish)</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6\">\n        <div className=\"bg-white p-4 rounded-xl border border-gray-200 shadow-xs\">\n          <span className=\"text-xs text-gray-500 font-medium\">\340\244\225\340\245\201\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202</span>\n          <div className=\"text-2xl font-black text-gray-900 mt-1\">{articles.length}</div>\n        </div>\n        <div className=\"bg-white p-4 rounded-xl border border-gray-200 shadow-xs\">\n          <span className=\"text-xs text-gray-500 font-medium\">\340\244\254\340\244\241\340\244\274\340\245\200 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 (Breaking)</span>\n          <div className=\"text-2xl font-black text-rose-600 mt-1 flex items-center gap-1\">\n            <Radio className=\"w-5 h-5 animate-pulse\" />\n            {breakingCount}\n          </div>\n        </div>\n        <div className=\"bg-white p-4 rounded-xl border border-gray-200 shadow-xs\">\n          <span className=\"text-xs text-gray-500 font-medium\">\340\244\225\340\245\201\340\244\262 \340\244\252\340\244\276\340\244\240\340\244\225 (Estimated Views)</span>\n          <div className=\"text-2xl font-black text-emerald-600 mt-1\">\n            {totalViews.toLocaleString(\'hi-IN\')}\n          </div>\n        </div>\n        <div className=\"bg-white p-4 rounded-xl border border-gray-200 shadow-xs\">\n          <span className=\"text-xs text-gray-500 font-medium\">\340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202</span>\n          <div className=\"text-2xl font-black text-blue-600 mt-1\">{CATEGORIES.length}</div>\n        </div>\n      </div>\n\n      {/* Success Notification Alert */}\n      {successMessage && (\n        <div className=\"mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2 text-sm font-semibold\">\n            <CheckCircle className=\"w-5 h-5 text-emerald-600\" />\n            <span>{successMessage}</span>\n          </div>\n          {newCreatedSlug && (\n            <Link\n              href={`/news/${newCreatedSlug}`}\n              className=\"inline-flex items-center gap-1 px-3 py-1 bg-emerald-600 text-white rounded text-xs font-bold hover:bg-emerald-700 transition-colors\"\n            >\n              <span>\340\244\262\340\244\276\340\244\207\340\244\265 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </Link>\n          )}\n        </div>\n      )}\n\n      {/* Tabs */}\n      <div className=\"flex border-b border-gray-200 mb-6 bg-white rounded-t-xl px-4 pt-2\">\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'list\')}\n          className={`flex items-center gap-2 px-5 py-3 border-b-2 font-bold text-sm transition-colors ${\n            activeTab === \'list\'\n              ? \'border-rose-600 text-rose-600\'\n              : \'border-transparent text-gray-500 hover:text-gray-700\'\n          }`}\n        >\n          <List className=\"w-4 h-4\" />\n          <span>\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 (Article List)</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => setActiveTab(\'create\')}\n          className={`flex items-center gap-2 px-5 py-3 border-b-2 font-bold text-sm transition-colors ${\n            activeTab === \'create\'\n              ? \'border-rose-600 text-rose-600\'\n              : \'border-transparent text-gray-500 hover:text-gray-700\'\n          }`}\n        >\n          <PlusCircle className=\"w-4 h-4\" />\n          <span>\340\244\250\340\244\210 \340\244\226\340\244\254\340\244\260 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Create Article)</span>\n        </button>\n      </div>\n\n      {/* Tab 1: Articles List Table */}\n      {activeTab === \'list\' && (\n        <div className=\"bg-white rounded-xl border border-gray-200 overflow-hidden shadow-xs\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs sm:text-sm\">\n              <thead className=\"bg-gray-50 border-b border-gray-200 text-gray-600 font-bold\">\n                <tr>\n                  <th className=\"py-3.5 px-4\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Title)</th>\n                  <th className=\"py-3.5 px-4\">\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Category)</th>\n                  <th className=\"py-3.5 px-4\">\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 (Status)</th>\n                  <th className=\"py-3.5 px-4\">\340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Views)</th>\n                  <th className=\"py-3.5 px-4\">\340\244\246\340\244\277\340\244\250\340\244\276\340\244\202\340\244\225 (Date)</th>\n                  <th className=\"py-3.5 px-4 text-right\">\340\244\225\340\244\276\340\244\260\340\245\215\340\244\260\340\244\265\340\244\276\340\244\210 (Action)</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-100 text-gray-800\">\n                {articles.map((item) => (\n                  <tr key={item.id} className=\"hover:bg-gray-50/70 transition-colors\">\n                    <td className=\"py-3 px-4 max-w-xs sm:max-w-md\">\n                      <div className=\"font-bold text-gray-900 line-clamp-1\">{item.title}</div>\n                      <div className=\"text-[11px] text-gray-400 line-clamp-1\">{item.idSlug}</div>\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      <span className=\"px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold\">\n                        {item.category}\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      <div className=\"flex items-center gap-1.5\">\n                        <span className=\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 text-xs font-bold\">\n                          \340\244\262\340\244\276\340\244\207\340\244\265\n                        </span>\n                        {item.isBreaking && (\n                          <span className=\"px-1.5 py-0.5 rounded bg-rose-100 text-rose-700 text-[10px] font-bold\">\n                            \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227\n                          </span>\n                        )}\n                      </div>\n                    </td>\n                    <td className=\"py-3 px-4 font-mono text-gray-600\">\n                      {item.views.toLocaleString(\'hi-IN\')}\n                    </td>\n                    <td className=\"py-3 px-4 text-xs text-gray-500 whitespace-nowrap\">\n                      {item.publishedAt.split(\',\')[0]}\n                    </td>\n                    <td className=\"py-3 px-4 text-right\">\n                      <Link\n                        href={`/news/${item.idSlug}`}\n                        className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded bg-rose-50 text-rose-600 hover:bg-rose-100 text-xs font-bold transition-colors\"\n                      >\n                        <Eye className=\"w-3.5 h-3.5\" />\n                        <span>\340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n                      </Link>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n\n      {/* Tab 2: Create Article Form */}\n      {activeTab === \'create\' && (\n        <div className=\"bg-white rounded-xl border border-gray-200 p-6 sm:p-8 shadow-xs max-w-4xl mx-auto\">\n          <div className=\"mb-6 pb-4 border-b border-gray-100\">\n            <h2 className=\"text-xl font-black text-gray-900\">\n              \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 (Publish New Article)\n            </h2>\n            <p className=\"text-xs text-gray-500 mt-1\">\n              \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\340\245\200\340\244\257 \340\244\270\340\245\215\340\244\237\340\245\207\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\250\340\244\210 \340\244\226\340\244\254\340\244\260 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\340\245\244 \340\244\270\340\244\254\340\244\256\340\244\277\340\244\237 \340\244\225\340\244\260\340\244\244\340\245\207 \340\244\271\340\245\200 \340\244\257\340\244\271 \340\244\271\340\245\213\340\244\256\340\244\252\340\245\207\340\244\234, \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\237\340\244\277\340\244\225\340\244\260 \340\244\224\340\244\260 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\256\340\245\207\340\244\202 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\271\340\245\213\340\244\227\340\245\200\340\245\244\n            </p>\n          </div>\n\n          <form onSubmit={handleSubmit} className=\"space-y-6\">\n            {/* Title */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Hindi Headline) *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={formData.title}\n                onChange={(e) => setFormData({ ...formData, title: e.target.value })}\n                placeholder=\"\340\244\211\340\244\246\340\244\276. \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\250\340\245\207 \340\244\205\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225\340\245\215\340\244\267 \340\244\205\340\244\250\340\245\201\340\244\270\340\244\202\340\244\247\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\260\340\244\232\340\244\276 \340\244\250\340\244\257\340\244\276 \340\244\207\340\244\244\340\244\277\340\244\271\340\244\276\340\244\270...\"\n                className=\"w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-rose-600 focus:ring-2 focus:ring-rose-100 text-sm\"\n              />\n            </div>\n\n            {/* English Title / Subtitle */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                \340\244\205\340\244\202\340\244\227\340\245\215\340\244\260\340\245\207\340\244\234\340\245\200 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (English Headline / Subtitle)\n              </label>\n              <input\n                type=\"text\"\n                value={formData.titleEn}\n                onChange={(e) => setFormData({ ...formData, titleEn: e.target.value })}\n                placeholder=\"e.g. Landmark achievement in science and technology announced...\"\n                className=\"w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-rose-600 focus:ring-2 focus:ring-rose-100 text-sm\"\n              />\n            </div>\n\n            {/* Category and Badges Row */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              <div>\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Category) *\n                </label>\n                <select\n                  value={formData.categorySlug}\n                  onChange={(e) => setFormData({ ...formData, categorySlug: e.target.value })}\n                  className=\"w-full px-3 py-2.5 rounded-lg border border-gray-300 bg-white font-medium text-sm focus:border-rose-600\"\n                >\n                  {CATEGORIES.map((c) => (\n                    <option key={c.id} value={c.slug}>\n                      {c.nameHi} ({c.nameEn})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Toggles */}\n              <div className=\"flex items-center gap-2 pt-6\">\n                <input\n                  type=\"checkbox\"\n                  id=\"breakingCheckbox\"\n                  checked={formData.isBreaking}\n                  onChange={(e) => setFormData({ ...formData, isBreaking: e.target.checked })}\n                  className=\"w-4 h-4 text-rose-600 rounded border-gray-300\"\n                />\n                <label htmlFor=\"breakingCheckbox\" className=\"text-xs font-bold text-gray-800 flex items-center gap-1 cursor-pointer\">\n                  <Radio className=\"w-3.5 h-3.5 text-rose-600\" />\n                  <span>\340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Breaking)</span>\n                </label>\n              </div>\n\n              <div className=\"flex items-center gap-2 pt-6\">\n                <input\n                  type=\"checkbox\"\n                  id=\"trendingCheckbox\"\n                  checked={formData.isTrending}\n                  onChange={(e) => setFormData({ ...formData, isTrending: e.target.checked })}\n                  className=\"w-4 h-4 text-amber-500 rounded border-gray-300\"\n                />\n                <label htmlFor=\"trendingCheckbox\" className=\"text-xs font-bold text-gray-800 flex items-center gap-1 cursor-pointer\">\n                  <Flame className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span>\340\244\237\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\277\340\244\202\340\244\227 (Trending)</span>\n                </label>\n              </div>\n            </div>\n\n            {/* Excerpt */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                \340\244\270\340\244\202\340\244\225\340\245\215\340\244\267\340\244\277\340\244\252\340\245\215\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Summary / Excerpt) *\n              </label>\n              <textarea\n                required\n                rows={2}\n                value={formData.excerpt}\n                onChange={(e) => setFormData({ ...formData, excerpt: e.target.value })}\n                placeholder=\"2-3 \340\244\252\340\244\202\340\244\225\340\245\215\340\244\244\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\226\340\244\254\340\244\260 \340\244\225\340\244\276 \340\244\270\340\244\276\340\244\260\340\244\276\340\244\202\340\244\266 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\"\n                className=\"w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-rose-600 text-sm\"\n              ></textarea>\n            </div>\n\n            {/* Body */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 (Full Body Paragraphs - \340\244\246\340\245\213\340\244\271\340\244\260\340\245\207 \340\244\217\340\244\202\340\244\237\340\244\260 \340\244\270\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246 \340\244\205\340\244\262\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202)\n              </label>\n              <textarea\n                rows={5}\n                value={formData.bodyText}\n                onChange={(e) => setFormData({ ...formData, bodyText: e.target.value })}\n                placeholder=\"\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\"\n                className=\"w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:border-rose-600 text-sm\"\n              ></textarea>\n            </div>\n\n            {/* Cover Image */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                \340\244\225\340\244\265\340\244\260 \340\244\207\340\244\256\340\245\207\340\244\234 URL (Cover Image URL)\n              </label>\n              <input\n                type=\"url\"\n                value={formData.coverImage}\n                onChange={(e) => setFormData({ ...formData, coverImage: e.target.value })}\n                className=\"w-full px-4 py-2 rounded-lg border border-gray-300 text-xs font-mono mb-2\"\n              />\n              <div className=\"flex flex-wrap items-center gap-2 text-xs\">\n                <span className=\"text-gray-400\">\340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\232\340\245\201\340\244\250\340\245\207\340\244\202:</span>\n                <button\n                  type=\"button\"\n                  onClick={() => handlePresetImage(\'https://images.unsplash.com/photo-1517976487507-59a5e01bb502?auto=format&fit=crop&w=1200&q=80\')}\n                  className=\"px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded text-[11px]\"\n                >\n                  \340\244\205\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225\340\245\215\340\244\267 (Space)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => handlePresetImage(\'https://images.unsplash.com/photo-1540747913346-19e32dc3e97e?auto=format&fit=crop&w=1200&q=80\')}\n                  className=\"px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded text-[11px]\"\n                >\n                  \340\244\225\340\245\215\340\244\260\340\244\277\340\244\225\340\245\207\340\244\237 (Cricket)\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => handlePresetImage(\'https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?auto=format&fit=crop&w=1200&q=80\')}\n                  className=\"px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded text-[11px]\"\n                >\n                  \340\244\270\340\244\202\340\244\270\340\244\246 / \340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => handlePresetImage(\'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1200&q=80\')}\n                  className=\"px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded text-[11px]\"\n                >\n                  \340\244\205\340\244\260\340\245\215\340\244\245\340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276 (Finance)\n                </button>\n              </div>\n            </div>\n\n            {/* Submit Action */}\n            <div className=\"pt-4 border-t border-gray-200 flex items-center justify-end gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'list\')}\n                className=\"px-4 py-2 border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-50\"\n              >\n                \340\244\260\340\244\246\340\245\215\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-6 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-bold text-sm shadow-sm\"\n              >\n                \340\244\226\340\244\254\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish Now)\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
