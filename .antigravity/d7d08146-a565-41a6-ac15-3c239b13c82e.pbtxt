        lines {
          text: "                  <span>\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 (Pro Editorial Tips):</span>"
