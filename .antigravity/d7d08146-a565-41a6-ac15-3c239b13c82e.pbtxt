      replacement_content: "import React from \'react\';\nimport { CATEGORIES } from \'../data/demo\';\nimport { Link } from \'../context/RouterContext\';\nimport { ChevronUp, ShieldCheck, Heart } from \'lucide-react\';\n\nexport const Footer: React.FC = () => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-gray-950 text-gray-400 mt-16 border-t-4 border-rose-600\">\n      {/* 1. Brand & Value Prop */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-8\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-gray-800\">\n          {/* Logo Column */}\n          <div className=\"md:col-span-1\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <div className=\"w-9 h-9 bg-rose-600 rounded-lg flex items-center justify-center text-white font-black text-lg\">\n                \340\244\255\340\244\276\n              </div>\n              <span className=\"text-xl font-black text-white tracking-tight font-serif\">\n                \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 <span className=\"text-rose-500 text-xs font-sans uppercase\">LIVE</span>\n              </span>\n            </div>\n            <p className=\"text-xs text-gray-400 leading-relaxed\">\n              \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\225\340\244\276 \340\244\205\340\244\227\340\245\215\340\244\260\340\244\243\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\256\340\244\202\340\244\232 \340\244\271\340\245\210, \340\244\234\340\245\213 \340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257, \340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277\340\244\225, \340\244\226\340\245\207\340\244\262, \340\244\256\340\244\250\340\245\213\340\244\260\340\244\202\340\244\234\340\244\250 \340\244\224\340\244\260 \340\244\244\340\244\225\340\244\250\340\245\200\340\244\225\340\245\200 \340\244\234\340\244\227\340\244\244 \340\244\225\340\245\200 \340\244\250\340\244\277\340\244\267\340\245\215\340\244\252\340\244\225\340\245\215\340\244\267 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\270\340\244\256\340\244\225\340\245\215\340\244\267 \340\244\252\340\245\215\340\244\260\340\244\270\340\245\215\340\244\244\340\245\201\340\244\244 \340\244\225\340\244\260\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\n            </p>\n            <div className=\"mt-4 flex items-center gap-2\">\n              <span className=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span>\n              <span className=\"text-xs text-gray-300 font-medium\">24x7 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\265\340\244\260\340\245\207\340\244\234</span>\n            </div>\n          </div>\n\n          {/* Categories Column */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-3 border-l-2 border-rose-500 pl-2\">\n              \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202\n            </h4>\n            <ul className=\"space-y-2 text-xs\">\n              {CATEGORIES.slice(0, 5).map((cat) => (\n                <li key={cat.id}>\n                  <Link\n                    href={`/category/${cat.slug}`}\n                    className=\"hover:text-white transition-colors\"\n                  >\n                    {cat.nameHi} ({cat.nameEn})\n                  </Link>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Media & Formats Column */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-3 border-l-2 border-rose-500 pl-2\">\n              \340\244\256\340\244\262\340\245\215\340\244\237\340\245\200\340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276\n            </h4>\n            <ul className=\"space-y-2 text-xs\">\n              <li>\n                <Link href=\"/videos\" className=\"hover:text-white transition-colors\">\n                  \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237\340\244\277\340\244\250 (Video Bulletins)\n                </Link>\n              </li>\n              <li>\n                <Link href=\"/photos\" className=\"hover:text-white transition-colors\">\n                  \340\244\253\340\245\213\340\244\237\340\245\213 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200 (Photo Galleries)\n                </Link>\n              </li>\n              <li>\n                <Link href=\"/category/tech\" className=\"hover:text-white transition-colors\">\n                  \340\244\244\340\244\225\340\244\250\340\245\200\340\244\225 \340\244\217\340\244\265\340\244\202 AI \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\n                </Link>\n              </li>\n              <li>\n                <Link href=\"/category/cricket\" className=\"hover:text-white transition-colors\">\n                  \340\244\225\340\245\215\340\244\260\340\244\277\340\244\225\340\245\207\340\244\237 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 & \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\n                </Link>\n              </li>\n              <li>\n                <Link href=\"/admin\" className=\"hover:text-emerald-400 text-emerald-500 font-semibold transition-colors flex items-center gap-1\">\n                  <ShieldCheck className=\"w-3 h-3\" />\n                  <span>\340\244\217\340\244\241\340\244\256\340\244\277\340\244\250 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 (Demo)</span>\n                </Link>\n              </li>\n            </ul>\n          </div>\n\n          {/* Editorial & Compliance Column */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-3 border-l-2 border-rose-500 pl-2\">\n              \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\250\340\245\200\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202\n            </h4>\n            <ul className=\"space-y-2 text-xs\">\n              <li><span className=\"hover:text-white cursor-pointer\">\340\244\206\340\244\232\340\244\276\340\244\260 \340\244\270\340\244\202\340\244\271\340\244\277\340\244\244\340\244\276 \340\244\265 \340\244\244\340\244\245\340\245\215\340\244\257-\340\244\234\340\244\276\340\244\202\340\244\232</span></li>\n              <li><span className=\"hover:text-white cursor-pointer\">\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\246\340\244\277\340\244\266\340\244\276\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266</span></li>\n              <li><span className=\"hover:text-white cursor-pointer\">\340\244\227\340\245\213\340\244\252\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\250\340\245\200\340\244\244\340\244\277 (Privacy Policy)</span></li>\n              <li><span className=\"hover:text-white cursor-pointer\">\340\244\250\340\244\277\340\244\257\340\244\256 \340\244\217\340\244\265\340\244\202 \340\244\266\340\244\260\340\245\215\340\244\244\340\245\207\340\244\202 (Terms of Service)</span></li>\n              <li><span className=\"hover:text-white cursor-pointer\">\340\244\266\340\244\277\340\244\225\340\244\276\340\244\257\340\244\244 \340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\244\243 (Grievance Redressal)</span></li>\n            </ul>\n          </div>\n        </div>\n\n        {/* 2. Disclaimer & Copyright */}\n        <div className=\"pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500\">\n          <p>\n            \302\251 {new Date().getFullYear()} \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 (Bharat Samachar Live Demo). All rights reserved. ABP-style inspired UI concept demonstration.\n          </p>\n          <div className=\"flex items-center gap-4\">\n            <button\n              type=\"button\"\n              onClick={scrollToTop}\n              className=\"flex items-center gap-1 text-gray-400 hover:text-white transition-colors\"\n            >\n              <span>\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267 \340\244\252\340\244\260 \340\244\234\340\244\276\340\244\217\340\244\202</span>\n              <ChevronUp className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    }
