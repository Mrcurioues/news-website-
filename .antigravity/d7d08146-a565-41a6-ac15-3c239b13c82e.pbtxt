  file_change {
    absolute_path_uri: "file:///src/pages/PhotoDetailPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { getGalleryByIdSlug, DEMO_GALLERIES } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { ShareBar } from \'../components/ShareBar\';\nimport { ImageWithFallback } from \'../components/ImageWithFallback\';\nimport {\n  ChevronLeft,\n  ChevronRight,\n  Maximize2,\n  Minimize2,\n  Camera,\n  ArrowLeft,\n  Images\n} from \'lucide-react\';\n\ninterface PhotoDetailPageProps {\n  idSlug: string;\n}\n\nexport const PhotoDetailPage: React.FC<PhotoDetailPageProps> = ({ idSlug }) => {\n  const { updateMetadata } = useRouter();\n  const gallery = getGalleryByIdSlug(idSlug);\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [isFullscreen, setIsFullscreen] = useState(false);\n\n  useEffect(() => {\n    if (gallery) {\n      updateMetadata({\n        title: gallery.titleHi,\n        description: `${gallery.titleHi} - \340\244\225\340\245\201\340\244\262 ${gallery.images.length} \340\244\217\340\244\225\340\245\215\340\244\270\340\244\225\340\245\215\340\244\262\340\245\202\340\244\270\340\244\277\340\244\265 \340\244\244\340\244\270\340\245\215\340\244\265\340\245\200\340\244\260\340\245\207\340\244\202 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\340\245\244`,\n        ogImage: gallery.coverImage\n      });\n    }\n    setCurrentIndex(0);\n  }, [idSlug]);\n\n  if (!gallery) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-20 text-center\">\n        <h1 className=\"text-2xl font-black text-gray-900 mb-4\">\340\244\253\340\245\213\340\244\237\340\245\213 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210</h1>\n        <Link\n          href=\"/photos\"\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 text-white rounded-lg font-bold text-sm\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>\340\244\270\340\244\255\340\245\200 \340\244\253\340\245\213\340\244\237\340\245\213 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n        </Link>\n      </div>\n    );\n  }\n\n  const currentImage = gallery.images[currentIndex] || gallery.images[0];\n  const otherGalleries = DEMO_GALLERIES.filter(g => g.id !== gallery.id);\n\n  const prevPhoto = () => {\n    setCurrentIndex((prev) => (prev - 1 + gallery.images.length) % gallery.images.length);\n  };\n\n  const nextPhoto = () => {\n    setCurrentIndex((prev) => (prev + 1) % gallery.images.length);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Breadcrumbs */}\n      <nav aria-label=\"Breadcrumb\" className=\"flex items-center gap-1.5 text-xs text-gray-500 mb-4\">\n        <Link href=\"/\" className=\"hover:text-rose-600 transition-colors\">\340\244\271\340\245\213\340\244\256</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <Link href=\"/photos\" className=\"hover:text-rose-600 transition-colors\">\340\244\253\340\245\213\340\244\237\340\245\213</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <span className=\"truncate max-w-[200px] sm:max-w-md text-gray-900 font-semibold\">{gallery.titleHi}</span>\n      </nav>\n\n      {/* Gallery Header Box */}\n      <div className=\"bg-white rounded-xl border border-gray-200 p-6 mb-6 shadow-xs\">\n        <div className=\"flex flex-wrap items-center gap-2 mb-2\">\n          <span className=\"px-3 py-1 rounded-full bg-rose-600 text-white font-bold text-xs\">\n            {gallery.category}\n          </span>\n          <span className=\"text-xs text-gray-500\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244: {gallery.publishedAt}</span>\n        </div>\n\n        <h1 className=\"text-2xl sm:text-3xl font-black text-gray-950 leading-tight\">\n          {gallery.titleHi}\n        </h1>\n        {gallery.title && (\n          <p className=\"mt-1 text-sm text-gray-500 font-medium\">\n            {gallery.title}\n          </p>\n        )}\n\n        <div className=\"mt-4\">\n          <ShareBar title={gallery.titleHi} />\n        </div>\n      </div>\n\n      {/* Slideshow Canvas */}\n      <div className={`relative bg-zinc-950 rounded-2xl overflow-hidden shadow-xl border border-zinc-800 ${\n        isFullscreen ? \'fixed inset-0 z-50 rounded-none\' : \'\'\n      }`}>\n        {/* Active Image Stage */}\n        <div className=\"relative aspect-16/10 md:aspect-21/9 w-full flex items-center justify-center bg-black\">\n          <ImageWithFallback\n            src={currentImage.url}\n            alt={currentImage.captionHi}\n            className=\"w-full h-full object-contain\"\n          />\n\n          {/* Prev Slide Control */}\n          <button\n            type=\"button\"\n            onClick={prevPhoto}\n            aria-label=\"Previous photo\"\n            className=\"absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-rose-600 text-white flex items-center justify-center transition-colors backdrop-blur-xs shadow-md\"\n          >\n            <ChevronLeft className=\"w-6 h-6\" />\n          </button>\n\n          {/* Next Slide Control */}\n          <button\n            type=\"button\"\n            onClick={nextPhoto}\n            aria-label=\"Next photo\"\n            className=\"absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/60 hover:bg-rose-600 text-white flex items-center justify-center transition-colors backdrop-blur-xs shadow-md\"\n          >\n            <ChevronRight className=\"w-6 h-6\" />\n          </button>\n\n          {/* Top Stage Bar: Slide Counter & Fullscreen button */}\n          <div className=\"absolute top-4 left-4 right-4 flex items-center justify-between text-xs text-white\">\n            <span className=\"px-3 py-1 rounded-full bg-black/70 backdrop-blur-xs font-mono font-bold tracking-wider\">\n              \340\244\244\340\244\270\340\245\215\340\244\265\340\245\200\340\244\260 {currentIndex + 1} / {gallery.images.length}\n            </span>\n            <button\n              type=\"button\"\n              onClick={() => setIsFullscreen(!isFullscreen)}\n              className=\"p-2 rounded-full bg-black/70 backdrop-blur-xs hover:bg-zinc-800 text-white\"\n              title={isFullscreen ? \"\340\244\253\340\245\201\340\244\262\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\270\340\245\207 \340\244\254\340\244\276\340\244\271\340\244\260 \340\244\250\340\244\277\340\244\225\340\244\262\340\245\207\340\244\202\" : \"\340\244\253\340\245\201\340\244\262\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\256\340\245\213\340\244\241\"}\n            >\n              {isFullscreen ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n            </button>\n          </div>\n        </div>\n\n        {/* Slide Caption Box */}\n        <div className=\"p-4 sm:p-5 bg-zinc-900 border-t border-zinc-800 text-white\">\n          <p className=\"text-sm sm:text-base font-bold text-gray-100\">\n            {currentImage.captionHi}\n          </p>\n          {currentImage.caption && (\n            <p className=\"text-xs text-zinc-400 mt-1\">\n              {currentImage.caption}\n            </p>\n          )}\n        </div>\n\n        {/* Thumbnails Ribbon */}\n        <div className=\"p-3 bg-zinc-950 border-t border-zinc-800 flex items-center gap-2 overflow-x-auto scrollbar-none\">\n          {gallery.images.map((img, idx) => (\n            <button\n              key={idx}\n              type=\"button\"\n              onClick={() => setCurrentIndex(idx)}\n              className={`shrink-0 w-16 h-12 rounded-md overflow-hidden border-2 transition-all ${\n                currentIndex === idx ? \'border-rose-500 scale-105\' : \'border-transparent opacity-60 hover:opacity-100\'\n              }`}\n            >\n              <img\n                src={img.url}\n                alt={`Thumb ${idx + 1}`}\n                className=\"w-full h-full object-cover\"\n                loading=\"lazy\"\n              />\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Other Galleries Grid */}\n      <div className=\"mt-12\">\n        <h3 className=\"text-xl font-bold text-gray-900 mb-6 flex items-center gap-2\">\n          <Images className=\"w-5 h-5 text-rose-600\" />\n          <span>\340\244\205\340\244\250\340\245\215\340\244\257 \340\244\253\340\245\213\340\244\237\340\245\213 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n          {otherGalleries.slice(0, 3).map((item) => (\n            <Link\n              key={item.id}\n              href={`/photos/${item.idSlug}`}\n              className=\"group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-xs hover:shadow-md transition-all block\"\n            >\n              <div className=\"relative aspect-16/10 overflow-hidden bg-gray-100\">\n                <ImageWithFallback\n                  src={item.coverImage}\n                  alt={item.titleHi}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\"\n                />\n                <span className=\"absolute bottom-2 left-2 px-2 py-0.5 rounded bg-black/70 text-white text-[11px] font-semibold flex items-center gap-1\">\n                  <Camera className=\"w-3 h-3\" />\n                  {item.images.length} \340\244\253\340\244\274\340\245\213\340\244\237\340\245\213\n                </span>\n              </div>\n              <div className=\"p-4\">\n                <h4 className=\"text-sm font-bold text-gray-900 group-hover:text-rose-600 line-clamp-2\">\n                  {item.titleHi}\n                </h4>\n              </div>\n            </Link>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
