        }
        lines {
          text: "              const isQuote = para.startsWith(\'> \');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const isList = para.startsWith(\'- \');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
