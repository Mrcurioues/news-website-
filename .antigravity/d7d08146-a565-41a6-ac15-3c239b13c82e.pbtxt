        lines {
          text: "    keyPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Benchmark repo rate reduced to 6.25%, with commercial lenders set to lower lending rates.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'GDP expansion forecast for the ongoing fiscal year retained firmly at a robust 7.4%.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Benchmark equity indices Sensex and Nifty rallied over 800 points following the policy declaration.\'"
