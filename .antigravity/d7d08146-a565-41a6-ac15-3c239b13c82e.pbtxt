    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useRouter } from \'../context/RouterContext\';\n\ninterface AdSlotProps {\n  format?: \'leaderboard\' | \'medium-rectangle\' | \'half-page\' | \'in-feed\' | \'mobile-banner\';\n  className?: string;\n  slotName?: string;\n}\n\nexport const AdSlot: React.FC<AdSlotProps> = ({\n  format = \'leaderboard\',\n  className = \'\',\n  slotName\n}) => {\n  const { lang, t } = useRouter();\n\n  const getDimensionsAndClasses = () => {\n    switch (format) {\n      case \'leaderboard\':\n        return {\n          dims: \'728 \303\227 90\',\n          containerClass: \'min-h-[90px] w-full max-w-[728px] mx-auto py-2\'\n        };\n      case \'medium-rectangle\':\n        return {\n          dims: \'300 \303\227 250\',\n          containerClass: \'min-h-[250px] w-full max-w-[300px] mx-auto my-3\'\n        };\n      case \'half-page\':\n        return {\n          dims: \'300 \303\227 600\',\n          containerClass: \'min-h-[500px] w-full max-w-[300px] mx-auto my-3\'\n        };\n      case \'mobile-banner\':\n        return {\n          dims: \'320 \303\227 50\',\n          containerClass: \'min-h-[50px] w-full max-w-[320px] mx-auto my-2\'\n        };\n      case \'in-feed\':\n      default:\n        return {\n          dims: \'Responsive In-Feed Banner\',\n          containerClass: \'min-h-[100px] w-full my-4\'\n        };\n    }\n  };\n\n  const { dims, containerClass } = getDimensionsAndClasses();\n  const defaultSlotName = lang === \'en\' ? \'Sponsored News Partner\' : \'\340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\225 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250\';\n  const resolvedSlotName = slotName || defaultSlotName;\n\n  return (\n    <div id={`ad-slot-${format}`} className={`flex flex-col items-center justify-center my-4 ${containerClass} ${className}`}>\n      <div className=\"w-full text-[10px] text-gray-500 uppercase tracking-widest text-center mb-1 flex items-center justify-center gap-2\">\n        <span className=\"h-[1px] w-8 bg-gray-300\"></span>\n        <span>{lang === \'en\' ? \'ADVERTISEMENT (DEMO)\' : \'\340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 (\340\244\241\340\245\207\340\244\256\340\245\213) | ADVERTISEMENT\'}</span>\n        <span className=\"h-[1px] w-8 bg-gray-300\"></span>\n      </div>\n      <div className=\"w-full h-full border border-dashed border-gray-300 bg-linear-to-r from-gray-50 via-slate-100 to-gray-50 rounded-lg p-4 flex flex-col items-center justify-center text-center shadow-xs\">\n        <div className=\"flex items-center gap-2 text-xs font-semibold text-gray-600 mb-1\">\n          <span className=\"inline-block w-2 h-2 rounded-full bg-rose-500 animate-pulse\"></span>\n          <span>{resolvedSlotName}</span>\n          <span className=\"text-[10px] px-1.5 py-0.5 bg-gray-200 text-gray-700 rounded\">IAB {dims}</span>\n        </div>\n        <p className=\"text-[11px] text-gray-400\">\n          {lang === \'en\'\n            ? \'Demo ad slot \342\200\224 Your brand sponsorship or AdSense unit will appear here.\'\n            : \'\340\244\241\340\245\207\340\244\256\340\245\213 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 \340\244\270\340\245\215\340\244\262\340\245\211\340\244\237 \342\200\224 \340\244\257\340\244\271\340\244\276\340\244\202 \340\244\206\340\244\252\340\244\225\340\244\276 \340\244\254\340\245\215\340\244\260\340\244\276\340\244\202\340\244\241 \340\244\257\340\244\276 \340\244\227\340\245\202\340\244\227\340\244\262 \340\244\220\340\244\241\340\244\270\340\245\207\340\244\202\340\244\270 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 \340\244\252\340\245\215\340\244\260\340\244\246\340\2