  file_change {
    absolute_path_uri: "file:///src/components/admin/WpArticleEditor.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // Block insertion helpers\n  const handleInsertBlock = (type: \'h2\' | \'h3\' | \'p\' | \'list\' | \'quote\') => {\n    if (type === \'h2\') {\n      setBodyParagraphs([...bodyParagraphs, \'## \340\244\250\340\244\210 H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\265\340\244\277\340\244\267\340\244\257)\']);\n    } else if (type === \'h3\') {\n      setBodyParagraphs([...bodyParagraphs, \'### \340\244\250\340\244\210 H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243)\']);\n    } else if (type === \'p\') {\n      setBodyParagraphs([...bodyParagraphs, \'\340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246: \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\']);\n    } else if (type === \'list\') {\n      setBodyParagraphs([...bodyParagraphs, \'- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 1\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 2\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 3\']);\n    } else if (type === \'quote\') {\n      setBodyParagraphs([...bodyParagraphs, \'> \"\340\244\257\340\244\271 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\225\340\245\207 \340\244\270\340\244\202\340\244\246\340\244\260\340\245\215\340\244\255 \340\244\256\340\245\207\340\244\202 \340\244\217\340\244\225 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\211\340\244\246\340\245\215\340\244\247\340\244\260\340\244\243 \340\244\271\340\245\210\340\245\244\"\']);\n    }\n  };\n\n  const handleUpdateParagraph = (index: number, val: string) => {\n    const updated = [...bodyParagraphs];\n    updated[index] = val;\n    setBodyParagraphs(updated);\n  };\n\n  const handleDeleteParagraph = (index: number) => {\n    if (bodyParagraphs.length <= 1) return;\n    setBodyParagraphs(bodyParagraphs.filter((_, i) => i !== index));\n  };\n\n  // Validate and submit\n  const handleSaveSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const errors: string[] = [];\n\n    if (!title.trim()) errors.push(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\244\276 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Title) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (!metaDescription.trim()) errors.push(\'\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description / Excerpt) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (bodyParagraphs.filter(p => p.trim().length > 0).length === 0) {\n      errors.push(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\200 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 (Body content) \340\244\226\340\244\276\340\244\262\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\213 \340\244\270\340\244\225\340\244\244\340\245\200\340\245\244\');\n    }\n    if (status === \'scheduled\' && !scheduledDate) {\n      errors.push(\'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\245\200 \340\244\227\340\244\210 \340\244\244\340\244\277\340\244\245\340\244\277 \340\244\265 \340\244\270\340\244\256\340\244\257 \340\244\232\340\245\201\340\244\250\340\244\250\340\244\276 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\271\340\245\210\340\245\244\');\n    }"
      replacement_content: "  // Block insertion helpers\n  const handleInsertBlock = (type: \'h2\' | \'h3\' | \'p\' | \'list\' | \'quote\' | \'image\') => {\n    if (type === \'h2\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'## New H2 Heading (Main Section)\' : \'## \340\244\250\340\244\210 H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\265\340\244\277\340\244\267\340\244\257)\']);\n    } else if (type === \'h3\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'### New H3 Subheading (Details)\' : \'### \340\244\250\340\244\210 H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243)\']);\n    } else if (type === \'p\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'New paragraph: enter your story content here.\' : \'\340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246: \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\']);\n    } else if (type === \'list\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'- Key Point 1\\n- Key Point 2\\n- Key Point 3\' : \'- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 1\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 2\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 3\']);\n    } else if (type === \'quote\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'> \"Important expert quote or verified statement.\"\' : \'> \"\340\244\257\340\244\271 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\225\340\245\207 \340\244\270\340\244\202\340\244\246\340\244\260\340\245\215\340\244\255 \340\244\256\340\245\207\340\244\202 \340\244\217\340\244\225 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\211\340\244\246\340\245\215\340\244\247\340\244\260\340\244\243 \340\244\271\340\245\210\340\245\244\"\']);\n    } else if (type === \'image\') {\n      setBodyParagraphs([...bodyParagraphs, lang === \'en\' ? \'![Media image description](https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80)\' : \'![\340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243](https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80)\']);\n    }\n  };\n\n  const handleUpdateParagraph = (index: number, val: string) => {\n    const updated = [...bodyParagraphs];\n    updated[index] = val;\n    setBodyParagraphs(updated);\n  };\n\n  const handleDeleteParagraph = (index: number) => {\n    if (bodyParagraphs.length <= 1) return;\n    setBodyParagraphs(bodyParagraphs.filter((_, i) => i !== index));\n  };\n\n  // Validate and submit\n  const handleSaveSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const errors: string[] = [];\n\n    if (!title.trim()) errors.push(lang === \'en\' ? \'Article H1 Title is required.\' : \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\244\276 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Title) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (!metaDescription.trim()) errors.push(lang === \'en\' ? \'Meta Description / Excerpt is required.\' : \'\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description / Excerpt) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (bodyParagraphs.filter(p => p.trim().length > 0).length === 0) {\n      errors.push(lang === \'en\' ? \'Article body content cannot be empty.\' : \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\200 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 (Body content) \340\244\226\340\244\276\340\244\262\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\213 \340\244\270\340\244\225\340\244\244\340\245\200\340\245\244\');\n    }\n    if (status === \'scheduled\' && !scheduledDate) {\n      errors.push(lang === \'en\' ? \'Scheduled publish date and time is mandatory.\' : \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\245\200 \340\244\227\340\244\210 \340\244\244\340\244\277\340\244\245\340\244\277 \340\244\265 \340\244\270\340\244\256\340\244\257 \340\244\232\340\245\201\340\244\250\340\244\250\340\244\276 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\271\340\245\210\340\245\244\');\n    }"
