      original_chunk {
        target_content: "              {/* Traffic & Search Analytics */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"p-4 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center justify-between\">\n                    <span>{t.trafficStatsHeader}</span>\n                    <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.totalPageViews}:</span>\n                      <span className=\"font-mono font-bold text-white\">{lang === \'hi\' ? \'4,82,900\' : \'482,900\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.uniqueReaders}:</span>\n                      <span className=\"font-mono font-bold text-emerald-400\">{lang === \'hi\' ? \'1,94,200\' : \'194,200\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.avgTimeOnPage}:</span>\n                      <span className=\"font-mono font-bold text-white\">{t.avgTimeVal}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-zinc-400\">{t.bounceRate}:</span>\n                      <span className=\"font-mono font-bold text-amber-400\">32.4% (Best)</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.deviceShareHeader}\n                  </h4>\n                  <div className=\"space-y-2\">\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.mobileDevices}</span>\n                        <span>68%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-rose-600 h-2 rounded-full\" style={{ width: \'68%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.desktopLaptops}</span>\n                        <span>28%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-indigo-600 h-2 rounded-full\" style={{ width: \'28%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.tablets}</span>\n                        <span>4%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-amber-600 h-2 rounded-full\" style={{ width: \'4%\' }} />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.searchRankingHeader}\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.avgPosition}:</span>\n                      <span className=\"font-black text-emerald-600 font-mono\">#3.8</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.impressions}:</span>\n                      <span className=\"font-mono font-bold text-gray-800\">{lang === \'hi\' ? \'12,40,000\' : \'1,240,000\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.ctr}:</span>\n                      <span className=\"font-mono font-bold text-purple-600\">8.4%</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">{t.topSearchKeyword}:</span>\n                      <span className=\"font-bold text-rose-600 truncate max-w-[120px]\">{t.topKeywordVal}</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Actions Bar */}\n              <div className=\"p-4 rounded-2xl bg-linear-to-r from-gray-50 via-rose-50/40 to-purple-50/40 border border-gray-200 flex flex-wrap items-center justify-between gap-3\">\n                <span className=\"text-xs font-bold text-gray-700\">\n                  {t.quickActionsLabel}:\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'creation\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-rose-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \342\236\225 {lang === \'en\' ? \'New Article\' : \'\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'templates\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-purple-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\216\250 {lang === \'en\' ? \'Templates\' : \'\340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'seo\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-emerald-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\224\215 {lang === \'en\' ? \'SEO Audit\' : \'SEO \340\244\221\340\244\241\340\244\277\340\244\237\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'scheduling\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-indigo-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\223\205 {lang === \'en\' ? \'Schedule\' : \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'enhancer\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-amber-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\252\204 {lang === \'en\' ? \'AI Enhancer\' : \'AI \340\244\217\340\244\250\340\245\215\340\244\271\340\244\276\340\244\202\340\244\270\340\244\260\'}\n                  </button>\n                </div>\n              </div>"
        replacement_content: "              {/* Traffic & Search Analytics - Clean Modern Cards */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {/* Traffic Stats */}\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200/90 shadow-2xs space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500 flex items-center justify-between\">\n                    <span>{t.trafficStatsHeader}</span>\n                    <Radio className=\"w-3.5 h-3.5 text-emerald-500 animate-pulse\" />\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.totalPageViews}</span>\n                      <span className=\"font-mono font-bold text-gray-900\">{lang === \'hi\' ? \'4,82,900\' : \'482,900\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.uniqueReaders}</span>\n                      <span className=\"font-mono font-bold text-emerald-600\">{lang === \'hi\' ? \'1,94,200\' : \'194,200\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.avgTimeOnPage}</span>\n                      <span className=\"font-mono font-bold text-gray-900\">{t.avgTimeVal}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">{t.bounceRate}</span>\n                      <span className=\"font-mono font-bold text-amber-600\">32.4% (Best)</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Device Share */}\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200/90 shadow-2xs space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.deviceShareHeader}\n                  </h4>\n                  <div className=\"space-y-2.5\">\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold text-gray-700\">\n                        <span>{t.mobileDevices}</span>\n                        <span className=\"font-bold text-gray-900\">68%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-rose-500 h-2 rounded-full\" style={{ width: \'68%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold text-gray-700\">\n                        <span>{t.desktopLaptops}</span>\n                        <span className=\"font-bold text-gray-900\">28%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-indigo-500 h-2 rounded-full\" style={{ width: \'28%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold text-gray-700\">\n                        <span>{t.tablets}</span>\n                        <span className=\"font-bold text-gray-900\">4%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-amber-500 h-2 rounded-full\" style={{ width: \'4%\' }} />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Search Ranking */}\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200/90 shadow-2xs space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.searchRankingHeader}\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.avgPosition}</span>\n                      <span className=\"font-black text-emerald-600 font-mono\">#3.8</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.impressions}</span>\n                      <span className=\"font-mono font-bold text-gray-800\">{lang === \'hi\' ? \'12,40,000\' : \'1,240,000\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.ctr}</span>\n                      <span className=\"font-mono font-bold text-purple-600\">8.4%</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">{t.topSearchKeyword}</span>\n                      <span className=\"font-bold text-rose-600 truncate max-w-[130px]\">{t.topKeywordVal}</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Actions Bar */}\n              <div className=\"p-4 rounded-2xl bg-gray-50/80 border border-gray-200/80 flex flex-wrap items-center justify-between gap-3\">\n                <span className=\"text-xs font-bold text-gray-700\">\n                  {t.quickActionsLabel}\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'creation\')}\n                    className=\"px-3.5 py-1.5 bg-white border border-gray-200 hover:border-rose-400 hover:text-rose-600 text-xs font-bold rounded-xl shadow-2xs transition-colors cursor-pointer\"\n                  >\n                    \342\236\225 {t.btnNewArticle}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'templates\')}\n                    className=\"px-3.5 py-1.5 bg-white border border-gray-200 hover:border-purple-400 hover:text-purple-600 text-xs font-bold rounded-xl shadow-2xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\216\250 {t.btnTemplates}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'seo\')}\n                    className=\"px-3.5 py-1.5 bg-white border border-gray-200 hover:border-emerald-400 hover:text-emerald-600 text-xs font-bold rounded-xl shadow-2xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\224\215 {t.btnSeoAudit}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'scheduling\')}\n                    className=\"px-3.5 py-1.5 bg-white border border-gray-200 hover:border-indigo-400 hover:text-indigo-600 text-xs font-bold rounded-xl shadow-2xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\223\205 {t.btnSchedule}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'enhancer\')}\n                    className=\"px-3.5 py-1.5 bg-white border border-gray-200 hover:border-amber-400 hover:text-amber-600 text-xs font-bold rounded-xl shadow-2xs transition-colors cursor-pointer\"\n                  >\n                    \360\237\252\204 {t.btnAiEnhancer}\n                  </button>\n                </div>\n              </div>"
      }
