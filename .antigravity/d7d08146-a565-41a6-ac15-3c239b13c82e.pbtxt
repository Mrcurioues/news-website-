        lines {
          text: "// English body and key points content library for initial demo articles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const ARTICLE_EN_DETAILS: Record<string, {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  body: string[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
