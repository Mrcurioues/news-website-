        lines {
          text: "      text: `### \340\244\250\340\244\256\340\244\270\340\245\215\340\244\244\340\245\207! \340\244\256\340\245\210\340\244\202 \340\244\206\340\244\252\340\244\225\340\244\276 WordPress \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\271\340\245\202\340\244\201 \360\237\232\200\\n\\n` +"
