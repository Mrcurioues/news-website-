    instruction: "Localize editor canvas headers, toolbar, permalink in WpArticleEditor"
    replacement_infos {
      original_chunk {
        target_content: "          {/* Post Title & Formats */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-6 shadow-xs\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2 mb-3\">\n              <span className=\"text-[11px] font-bold uppercase text-gray-400 tracking-wider\">\n                \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Headline & Format)\n              </span>\n              <div className=\"flex items-center gap-1 bg-gray-100 p-0.5 rounded-lg text-xs font-medium\">\n                <span className=\"text-[11px] px-2 text-gray-500 font-semibold\">\340\244\252\340\245\215\340\244\260\340\244\276\340\244\260\340\245\202\340\244\252:</span>\n                {([\'standard\', \'tutorial\', \'review\', \'listicle\', \'breaking\'] as ContentFormat[]).map((fmt) => (\n                  <button\n                    key={fmt}\n                    type=\"button\"\n                    onClick={() => setContentFormat(fmt)}\n                    className={`px-2 py-0.5 rounded text-[11px] font-bold capitalize transition-colors ${\n                      contentFormat === fmt ? \'bg-white text-rose-600 shadow-2xs\' : \'text-gray-600\'\n                    }`}\n                  >\n                    {fmt}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* H1 Title Input */}\n            <input\n              type=\"text\"\n              required\n              value={title}\n              onChange={(e) => {\n                setTitle(e.target.value);\n                if (!metaTitle) setMetaTitle(e.target.value);\n              }}\n              placeholder=\"\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 H1 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\"\n              className=\"w-full text-xl sm:text-2xl font-black text-gray-900 placeholder:text-gray-300 border-0 focus:ring-0 p-0 mb-3\"\n            />\n\n            {/* English Title / Subtitle */}\n            <input\n              type=\"text\"\n              value={titleEn}\n              onChange={(e) => setTitleEn(e.target.value)}\n              placeholder=\"English title or subtitle (optional)...\"\n              className=\"w-full text-xs sm:text-sm text-gray-600 placeholder:text-gray-300 border-b border-gray-100 pb-2 mb-3 focus:outline-hidden\"\n            />\n\n            {/* Permalink Slug Bar */}\n            <div className=\"flex items-center gap-2 text-xs text-gray-500 bg-gray-50 p-2.5 rounded-xl border border-gray-200/80\">\n              <Globe className=\"w-4 h-4 text-gray-400 shrink-0\" />\n              <span className=\"font-semibold text-gray-600\">\340\244\252\340\244\260\340\244\256\340\244\276\340\244\262\340\244\277\340\244\202\340\244\225:</span>\n              <span className=\"text-gray-400 hidden sm:inline\">bharatsamachar.live/news/</span>\n              <input\n                type=\"text\"\n                value={slug}\n                onChange={(e) => setSlug(e.target.value)}\n                placeholder=\"seo-friendly-slug\"\n                className=\"flex-1 bg-transparent font-mono text-xs text-rose-600 font-bold focus:outline-hidden\"\n              />\n              <button\n                type=\"button\"\n                onClick={handleAutoSlug}\n                className=\"px-2 py-1 bg-white hover:bg-gray-100 rounded text-[11px] font-semibold text-gray-700 border border-gray-200 transition-colors\"\n                title=\"\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\207 \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\234\340\244\250\340\244\260\340\245\207\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202\"\n              >\n                \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202\n              </button>\n            </div>\n          </div>\n\n          {/* Block Formatting Toolbar */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-3 shadow-xs flex flex-wrap items-center justify-between gap-2 text-xs\">\n            <span className=\"font-bold text-gray-600 pl-1\">\340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Add Blocks):</span>\n            <div className=\"flex flex-wrap items-center gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h2\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Heading2 className=\"w-3.5 h-3.5\" />\n                <span>+ H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h3\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Heading3 className=\"w-3.5 h-3.5\" />\n                <span>+ H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'p\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <AlignLeft className=\"w-3.5 h-3.5\" />\n                <span>+ \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'list\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n                <span>+ \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237 \340\244\262\340\244\277\340\244\270\340\245\215\340\244\237</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'quote\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Quote className=\"w-3.5 h-3.5\" />"
        replacement_content: "          {/* Post Title & Formats */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-6 shadow-xs\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2 mb-3\">\n              <span className=\"text-[11px] font-bold uppercase text-gray-400 tracking-wider\">\n                {lang === \'en\' ? \'Main Headline (H1 Headline & Format)\' : \'\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Headline & Format)\'}\n              </span>\n              <div className=\"flex items-center gap-1 bg-gray-100 p-0.5 rounded-lg text-xs font-medium\">\n                <span className=\"text-[11px] px-2 text-gray-500 font-semibold\">{lang === \'en\' ? \'Format:\' : \'\340\244\252\340\245\215\340\244\260\340\244\276\340\244\260\340\245\202\340\244\252:\'}</span>\n                {([\'standard\', \'tutorial\', \'review\', \'listicle\', \'breaking\'] as ContentFormat[]).map((fmt) => (\n                  <button\n                    key={fmt}\n                    type=\"button\"\n                    onClick={() => setContentFormat(fmt)}\n                    className={`px-2 py-0.5 rounded text-[11px] font-bold capitalize transition-colors cursor-pointer ${\n                      contentFormat === fmt ? \'bg-white text-rose-600 shadow-2xs\' : \'text-gray-600\'\n                    }`}\n                  >\n                    {fmt}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* H1 Title Input */}\n            <input\n              type=\"text\"\n              required\n              value={title}\n              onChange={(e) => {\n                setTitle(e.target.value);\n                if (!metaTitle) setMetaTitle(e.target.value);\n              }}\n              placeholder={lang === \'en\' ? \'Write the main H1 news title here...\' : \'\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 H1 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\'}\n              className=\"w-full text-xl sm:text-2xl font-black text-gray-900 placeholder:text-gray-300 border-0 focus:ring-0 p-0 mb-3\"\n            />\n\n            {/* English Title / Subtitle */}\n            <input\n              type=\"text\"\n              value={titleEn}\n              onChange={(e) => setTitleEn(e.target.value)}\n              placeholder=\"English title or subtitle (optional)...\"\n              className=\"w-full text-xs sm:text-sm text-gray-600 placeholder:text-gray-300 border-b border-gray-100 pb-2 mb-3 focus:outline-hidden\"\n            />\n\n            {/* Permalink Slug Bar */}\n            <div className=\"flex items-center gap-2 text-xs text-gray-500 bg-gray-50 p-2.5 rounded-xl border border-gray-200/80\">\n              <Globe className=\"w-4 h-4 text-gray-400 shrink-0\" />\n              <span className=\"font-semibold text-gray-600\">{lang === \'en\' ? \'Permalink:\' : \'\340\244\252\340\244\260\340\244\256\340\244\276\340\244\262\340\244\277\340\244\202\340\244\225:\'}</span>\n              <span className=\"text-gray-400 hidden sm:inline\">bharatsamachar.live/news/</span>\n              <input\n                type=\"text\"\n                value={slug}\n                onChange={(e) => setSlug(e.target.value)}\n                placeholder=\"seo-friendly-slug\"\n                className=\"flex-1 bg-transparent font-mono text-xs text-rose-600 font-bold focus:outline-hidden\"\n              />\n              <button\n                type=\"button\"\n                onClick={handleAutoSlug}\n                className=\"px-2 py-1 bg-white hover:bg-gray-100 rounded text-[11px] font-semibold text-gray-700 border border-gray-200 transition-colors cursor-pointer\"\n                title={lang === \'en\' ? \'Generate slug from title\' : \'\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\207 \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\234\340\244\250\340\244\260\340\245\207\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202\'}\n              >\n                {lang === \'en\' ? \'Generate Slug\' : \'\340\244\270\340\245\215\340\244\262\340\244\227 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202\'}\n              </button>\n            </div>\n          </div>\n\n          {/* Block Formatting Toolbar */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-3 shadow-xs flex flex-wrap items-center justify-between gap-2 text-xs\">\n            <span className=\"font-bold text-gray-600 pl-1\">{lang === \'en\' ? \'Add Blocks:\' : \'\340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Add Blocks):\'}</span>\n            <div className=\"flex flex-wrap items-center gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h2\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <Heading2 className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ H2 Heading\' : \'+ H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\'}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h3\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <Heading3 className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ H3 Subheading\' : \'+ H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\'}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'p\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <AlignLeft className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ Paragraph\' : \'+ \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246\'}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'list\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ Bullet List\' : \'+ \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237 \340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\'}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'quote\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <Quote className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ Quote\' : \'+ \340\244\211\340\244\246\340\245\215\340\244\247\340\244\260\340\244\243\'}</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'image\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors cursor-pointer\"\n              >\n                <ImageIcon className=\"w-3.5 h-3.5\" />\n                <span>{lang === \'en\' ? \'+ Media / Image\' : \'+ \340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 / \340\244\207\340\244\256\340\245\207\340\244\234\'}</span>\n              </button>\n            </div>\n          </div>"
      }
      num_matches: 1
    }
  }
}
