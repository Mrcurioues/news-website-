  file_change {
    absolute_path_uri: "file:///src/pages/VideoListPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { DEMO_VIDEOS, CATEGORIES } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { ImageWithFallback } from \'../components/ImageWithFallback\';\nimport { getVideoTitle, getVideoDescription, getCategoryName, formatViews } from \'../utils/translations\';\nimport { Play, Video, ChevronRight } from \'lucide-react\';\n\nexport const VideoListPage: React.FC = () => {\n  const { updateMetadata, lang, t } = useRouter();\n  const [selectedCat, setSelectedCat] = useState<string>(\'all\');\n\n  useEffect(() => {\n    updateMetadata({\n      title: `${t.videoBulletins} - ${t.appName}`,\n      description: lang === \'en\'\n        ? \'Watch top news video bulletins, ground reports, press briefings, and cricket highlights 24x7.\'\n        : \'\340\244\246\340\245\207\340\244\266 \340\244\224\340\244\260 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 \340\244\225\340\245\200 \340\244\254\340\244\241\340\244\274\340\245\200 \340\244\226\340\244\254\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237\340\244\277\340\244\250, \340\244\207\340\244\202\340\244\237\340\244\260\340\244\265\340\245\215\340\244\257\340\245\202 \340\244\224\340\244\260 \340\244\227\340\245\215\340\244\260\340\244\276\340\244\211\340\244\202\340\244\241 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\245\244\'\n    });\n  }, [lang, t]);\n\n  const filteredVideos = selectedCat === \'all\'\n    ? DEMO_VIDEOS\n    : DEMO_VIDEOS.filter(v => v.categorySlug === selectedCat);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Breadcrumbs */}\n      <nav aria-label=\"Breadcrumb\" className=\"flex items-center gap-1.5 text-xs text-gray-500 mb-4\">\n        <Link href=\"/\" className=\"hover:text-rose-600 transition-colors\">{t.home}</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <span className=\"text-gray-900 font-semibold\">{t.videoBulletins}</span>\n      </nav>\n\n      {/* Header Banner */}\n      <div className=\"bg-zinc-950 text-white rounded-xl p-6 sm:p-8 mb-8 shadow-md\">\n        <div className=\"flex items-center gap-3 mb-2\">\n          <div className=\"w-10 h-10 rounded-xl bg-rose-600 flex items-center justify-center shadow-lg\">\n            <Video className=\"w-5 h-5 text-white\" />\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-black tracking-tight\">\n            {t.videoBulletins}\n          </h1>\n        </div>\n        <p className=\"text-xs sm:text-sm text-zinc-400 max-w-2xl\">\n          {lang === \'en\'\n            ? \'Exclusive ground reports, official press meets, sports masterclasses, and verified video reports straight to your screen.\'\n            : \'\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213, \340\244\234\340\244\274\340\244\256\340\245\200\340\244\250\340\245\200 \340\244\252\340\244\241\340\244\274\340\244\244\340\244\276\340\244\262, \340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\225\340\245\211\340\244\250\340\245\215\340\244\253\340\245\215\340\244\260\340\245\207\340\244\202\340\244\270 \340\244\224\340\244\260 \340\244\226\340\245\207\340\244\262 \340\244\271\340\244\276\340\244\207\340\244\262\340\244\276\340\244\207\340\244\237\340\245\215\340\244\270 \340\244\270\340\245\200\340\244\247\340\245\207 \340\244\206\340\244\252\340\244\225\340\245\200 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260\340\245\244\'}\n        </p>\n\n        {/* Category Pills */}\n        <div className=\"mt-6 flex flex-wrap gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => setSelectedCat(\'all\')}\n            className={`px-3 py-1 rounded-full text-xs font-bold transition-colors cursor-pointer ${\n              selectedCat === \'all\' ? \'bg-rose-600 text-white\' : \'bg-zinc-800 text-zinc-300 hover:bg-zinc-700\'\n            }`}\n          >\n            {lang === \'en\' ? \'All Videos\' : \'\340\244\270\340\244\255\340\245\200 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213\'}\n          </button>\n          {[\'national\', \'cricket\', \'politics\', \'entertainment\', \'tech\', \'business\', \'lifestyle\'].map((catSlug) => {\n            const catObj = CATEGORIES.find(c => c.slug === catSlug);\n            const label = catObj ? getCategoryName(catObj, lang) : catSlug;\n            return (\n              <button\n                key={catSlug}\n                type=\"button\"\n                onClick={() => setSelectedCat(catSlug)}\n                className={`px-3 py-1 rounded-full text-xs font-bold transition-colors cursor-pointer ${\n                  selectedCat === catSlug ? \'bg-rose-600 text-white\' : \'bg-zinc-800 text-zinc-300 hover:bg-zinc-700\'\n                }`}\n              >\n                {label}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Featured Video (Top 1) */}\n      {filteredVideos[0] && (() => {\n        const topVideo = filteredVideos[0];\n        const topTitle = getVideoTitle(topVideo, lang);\n        const topDesc = getVideoDescription(topVideo, lang);\n        const topCat = getCategoryName({ slug: topVideo.categorySlug, nameHi: topVideo.category }, lang);\n\n        return (\n          <div className=\"mb-10 bg-white rounded-xl border border-gray-200 overflow-hidden shadow-xs\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-0\">\n              <Link\n                href={`/videos/${topVideo.idSlug}`}\n                className=\"lg:col-span-7 relative aspect-16/9 bg-black group overflow-hidden block\"\n              >\n                <ImageWithFallback\n                  src={topVideo.thumbnail}\n                  alt={topTitle}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90\"\n                />\n                <div className=\"absolute inset-0 bg-black/30 flex items-center justify-center\">\n                  <div className=\"w-16 h-16 rounded-full bg-rose-600 text-white flex items-center justify-center shadow-xl group-hover:scale-110 group-hover:bg-rose-700 transition-all\">\n                    <Play className=\"w-8 h-8 fill-white translate-x-0.5\" />\n                  </div>\n                </div>\n                <span className=\"absolute bottom-3 right-3 bg-black/80 px-2.5 py-1 rounded text-xs font-mono text-white\">\n                  {topVideo.duration}\n                </span>\n              </Link>\n\n              <div className=\"lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between\">\n                <div>\n                  <span className=\"inline-block px-3 py-1 rounded-full bg-rose-50 text-rose-700 font-bold text-xs uppercase mb-3\">\n                    {topCat}\n                  </span>\n                  <h2 className=\"text-xl sm:text-2xl font-black text-gray-950 hover:text-rose-600 transition-colors leading-snug\">\n                    <Link href={`/videos/${topVideo.idSlug}`}>\n                      {topTitle}\n                    </Link>\n                  </h2>\n                  <p className=\"mt-3 text-xs sm:text-sm text-gray-600 line-clamp-3\">\n                    {topDesc}\n                  </p>\n                </div>\n\n                <div className=\"mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500\">\n                  <div className=\"flex items-center gap-3\">\n                    <span>{formatViews(topVideo.views, lang)}</span>\n                    <span>\342\200\242</span>\n                    <span>{topVideo.publishedAt}</span>\n                  </div>\n                  <Link\n                    href={`/videos/${topVideo.idSlug}`}\n                    className=\"font-bold text-rose-600 hover:text-rose-800\"\n                  >\n                    {lang === \'en\' ? \'Watch Now \342\206\222\' : \'\340\244\205\340\244\255\340\245\200 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 \342\206\222\'}\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n        );\n      })()}\n\n      {/* Grid of Other Videos */}\n      <h3 className=\"text-xl font-bold text-gray-900 mb-4 flex items-center gap-2\">\n        <span className=\"w-2 h-5 bg-rose-600 rounded-full\"></span>\n        <span>\n          {lang === \'en\'\n            ? `More Video Bulletins (${filteredVideos.length} Videos)`\n            : `\340\244\205\340\244\250\340\245\215\340\244\257 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237\340\244\277\340\244\250 (${filteredVideos.length} \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213)`}\n        </span>\n      </h3>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {filteredVideos.slice(1).map((video) => {\n          const videoTitle = getVideoTitle(video, lang);\n          const catLabel = getCategoryName({ slug: video.categorySlug, nameHi: video.category }, lang);\n\n          return (\n            <article\n              key={video.id}\n              className=\"group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col\"\n            >\n              <Link\n                href={`/videos/${video.idSlug}`}\n                className=\"relative aspect-16/9 bg-zinc-900 overflow-hidden block\"\n              >\n                <ImageWithFallback\n                  src={video.thumbnail}\n                  alt={videoTitle}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\"\n                />\n                <div className=\"absolute inset-0 bg-black/25 flex items-center justify-center group-hover:bg-black/10 transition-colors\">\n                  <div className=\"w-11 h-11 rounded-full bg-rose-600/90 text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform\">\n                    <Play className=\"w-5 h-5 fill-white translate-x-0.5\" />\n                  </div>\n                </div>\n                <span className=\"absolute bottom-2 right-2 bg-black/80 px-2 py-0.5 rounded text-[10px] font-mono text-white\">\n                  {video.duration}\n                </span>\n                <span className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-black/60 backdrop-blur-xs text-[10px] font-medium text-white\">\n                  {catLabel}\n                </span>\n              </Link>\n\n              <div className=\"p-4 flex-1 flex flex-col justify-between\">\n                <h4 className=\"text-sm font-bold text-gray-900 group-hover:text-rose-600 transition-colors line-clamp-2 leading-snug\">\n                  <Link href={`/videos/${video.idSlug}`}>\n                    {videoTitle}\n                  </Link>\n                </h4>\n                <div className=\"mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-500\">\n                  <span>{formatViews(video.views, lang)}</span>\n                  <span>{video.publishedAt}</span>\n                </div>\n              </div>\n            </article>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
