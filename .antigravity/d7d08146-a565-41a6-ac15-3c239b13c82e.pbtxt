        target_content: "import { Article, PostStatus, ContentFormat } from \'../../types\';\nimport { CATEGORIES } from \'../../data/demo\';\nimport {\n  performSeoAudit,\n  generateSeoSlug,\n  calculateFleschReadingEase,\n  calculateKeywordDensity\n} from \'../../utils/seoCalculator\';\n\ninterface WpAiSuiteProps {\n  articles: Article[];\n  currentArticle?: Partial<Article>;\n  onSelectArticle: (article: Article) => void;\n  onCreateArticle: (initialData?: Partial<Article>) => void;\n  onSaveArticle: (articleData: Partial<Article>) => void;\n  onRequestDelete: (id: string, title: string) => void;\n  onOpenEditor: () => void;\n  onOpenAssistant: () => void;\n}\n\nexport type SuiteSection =\n  | \'dashboard\'\n  | \'creation\'\n  | \'templates\'\n  | \'seo\'\n  | \'enhancer\'\n  | \'scheduling\'\n  | \'media\'\n  | \'revisions\'\n  | \'taxonomy\'\n  | \'roles\'\n  | \'delete_module\'\n  | \'settings_help\';\n\nexport const WpAiSuite: React.FC<WpAiSuiteProps> = ({\n  articles,\n  currentArticle,\n  onSelectArticle,\n  onCreateArticle,\n  onSaveArticle,\n  onRequestDelete,\n  onOpenEditor,\n  onOpenAssistant\n}) => {\n  const [activeSection, setActiveSection] = useState<SuiteSection>(\'dashboard\');"
        replacement_content: "import { Article, PostStatus, ContentFormat } from \'../../types\';\nimport { CATEGORIES } from \'../../data/demo\';\nimport { useRouter } from \'../../context/RouterContext\';\nimport { ADMIN_TRANSLATIONS } from \'../../utils/adminTranslations\';\nimport {\n  performSeoAudit,\n  generateSeoSlug,\n  calculateFleschReadingEase,\n  calculateKeywordDensity\n} from \'../../utils/seoCalculator\';\n\ninterface WpAiSuiteProps {\n  articles: Article[];\n  currentArticle?: Partial<Article>;\n  onSelectArticle: (article: Article) => void;\n  onCreateArticle: (initialData?: Partial<Article>) => void;\n  onSaveArticle: (articleData: Partial<Article>) => void;\n  onRequestDelete: (id: string, title: string) => void;\n  onOpenEditor: () => void;\n  onOpenAssistant: () => void;\n}\n\nexport type SuiteSection =\n  | \'dashboard\'\n  | \'creation\'\n  | \'templates\'\n  | \'seo\'\n  | \'enhancer\'\n  | \'scheduling\'\n  | \'media\'\n  | \'revisions\'\n  | \'taxonomy\'\n  | \'roles\'\n  | \'delete_module\'\n  | \'settings_help\';\n\nexport const WpAiSuite: React.FC<WpAiSuiteProps> = ({\n  articles,\n  currentArticle,\n  onSelectArticle,\n  onCreateArticle,\n  onSaveArticle,\n  onRequestDelete,\n  onOpenEditor,\n  onOpenAssistant\n}) => {\n  const { lang, setLang } = useRouter();\n  const t = ADMIN_TRANSLATIONS[lang] || ADMIN_TRANSLATIONS.hi;\n  const [activeSection, setActiveSection] = useState<SuiteSection>(\'dashboard\');"
