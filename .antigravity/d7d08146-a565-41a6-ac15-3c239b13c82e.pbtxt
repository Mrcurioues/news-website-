        lines {
          text: "    body: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'In a historic moment during the parliamentary Monsoon Session, both houses cleared the National Clean Energy & Green Hydrogen Promotion Bill with unanimous support. Introducing the legislation, the Union Minister for Energy declared that this statute positions India firmly in the vanguard of the global clean energy transition.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Key provisions of the enactment include production-linked capital subsidies for electrolyzer fabrication, 25-year transmission fee waivers for renewable plants, and dedicated deep-water port facilities to ship green ammonia worldwide.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Industry federations and environmentalists hailed the milestone, describing it as a catalytic leap toward fulfilling India\342\200\231s Net-Zero sustainability commitments under the Paris Climate Accords.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
