        }
        lines {
          text: "    const matchesSearch ="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      !searchQuery ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      a.title.toLowerCase().includes(searchQuery.toLowerCase()) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (a.focusKeyword && a.focusKeyword.toLowerCase().includes(searchQuery.toLowerCase())) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (a.slug && a.slug.toLowerCase().includes(searchQuery.toLowerCase()));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const matchesStatus ="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      statusFilter === \'all\' ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      (statusFilter === \'published\' && (!a.status || a.status === \'published\')) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      a.status === statusFilter;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const matchesCategory ="
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
