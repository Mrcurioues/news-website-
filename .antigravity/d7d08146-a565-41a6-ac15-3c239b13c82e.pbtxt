        lines {
          text: "        `\340\244\256\340\245\210\340\244\202 \340\244\206\340\244\252\340\244\225\340\245\200 \340\244\256\340\244\246\340\244\246 \340\244\225\340\244\260 \340\244\270\340\244\225\340\244\244\340\244\276 \340\244\271\340\245\202\340\244\201:\\n` +"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
