        lines {
          text: "                  <li><strong>\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\206\340\244\265\340\245\203\340\244\244\340\245\215\340\244\244\340\244\277:</strong> \340\244\252\340\245\215\340\244\260\340\244\244\340\245\215\340\244\257\340\245\207\340\244\225 300-400 \340\244\266\340\244\254\340\245\215\340\244\246\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\246 \340\244\225\340\244\256 \340\244\270\340\245\207 \340\244\225\340\244\256 \340\244\217\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\270\340\244\202\340\244\227\340\244\277\340\244\225 \340\244\224\340\244\260 \340\244\265\340\244\260\340\245\215\340\244\243\340\244\250\340\244\276\340\244\244\340\245\215\340\244\256\340\244\225 \340\244\221\340\244\262\340\245\215\340\244\237-\340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 \340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\205\340\244\265\340\244\266\340\245\215\340\244\257 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <li><strong>\340\244\250\340\244\277\340\244\267\340\245\215\340\244\225\340\244\260\340\245\215\340\244\267 \340\244\256\340\245\207\340\244\202 CTA:</strong> \340\244\262\340\245\207\340\244\226 \340\244\225\340\245\207 \340\244\205\340\244\202\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\217\340\244\225 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237 \340\244\225\340\245\211\340\244\262-\340\244\237\340\245\202-\340\244\217\340\244\225\340\245\215\340\244\266\340\244\250 (\340\244\211\340\244\246\340\244\276: \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\266\340\245\207\340\244\257\340\244\260 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\262\340\245\207\340\244\226 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202) \340\244\260\340\244\226\340\245\207\340\244\202\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <li><strong>\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 (FAQs):</strong> Google Featured Snippets \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250 \340\244\252\340\244\276\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 2-3 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\270\340\245\200\340\244\247\340\245\207 \340\244\265 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \340\244\246\340\245\207\340\244\202\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
