    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { getArticleByIdSlug, getRelatedArticles, getTrendingArticles } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { ImageWithFallback } from \'../components/ImageWithFallback\';\nimport { ShareBar } from \'../components/ShareBar\';\nimport { StoryCard } from \'../components/StoryCard\';\nimport { TrendingWidget } from \'../components/TrendingWidget\';\nimport { AdSlot } from \'../components/AdSlot\';\nimport {\n  ChevronRight,\n  Clock,\n  Eye,\n  Volume2,\n  VolumeX,\n  Type,\n  CheckCircle2,\n  ArrowLeft,\n  Share2,\n  Bookmark\n} from \'lucide-react\';\n\ninterface ArticlePageProps {\n  idSlug: string;\n}\n\nexport const ArticlePage: React.FC<ArticlePageProps> = ({ idSlug }) => {\n  const { updateMetadata } = useRouter();\n  const article = getArticleByIdSlug(idSlug);\n  const [fontSize, setFontSize] = useState<\'sm\' | \'base\' | \'lg\' | \'xl\'>(\'base\');\n  const [isPlayingAudio, setIsPlayingAudio] = useState(false);\n  const [saved, setSaved] = useState(false);\n\n  useEffect(() => {\n    if (article) {\n      updateMetadata({\n        title: article.title,\n        description: article.excerpt,\n        ogImage: article.coverImage\n      });\n    }\n  }, [article]);\n\n  if (!article) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-20 text-center\">\n        <h1 className=\"text-3xl font-black text-gray-900 mb-4\">\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210 (Article Not Found)</h1>\n        <p className=\"text-gray-600 mb-6\">\340\244\225\340\245\215\340\244\267\340\244\256\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\234\340\244\277\340\244\270 \340\244\226\340\244\254\340\244\260 \340\244\225\340\245\213 \340\244\206\340\244\252 \340\244\242\340\245\202\340\244\202\340\244\242 \340\244\260\340\244\271\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\265\340\244\271 \340\244\271\340\244\237\340\244\276 \340\244\246\340\245\200 \340\244\227\340\244\210 \340\244\271\340\245\210 \340\244\257\340\244\276 \340\244\211\340\244\270\340\244\225\340\244\276 \340\244\262\340\244\277\340\244\202\340\244\225 \340\244\254\340\244\246\340\244\262 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244</p>\n        <Link\n          href=\"/\"\n          className=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-rose-600 text-white font-bold hover:bg-rose-700 transition-colors\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>\340\244\271\340\245\213\340\244\256\340\244\252\340\245\207\340\244\234 \340\244\252\340\244\260 \340\244\262\340\245\214\340\244\237\340\245\207\340\244\202</span>\n        </Link>\n      </div>\n    );\n  }\n\n  const relatedStories = getRelatedArticles(article, 3);\n  const trendingArticles = getTrendingArticles(5);\n\n  const getFontSizeClass = () => {\n    switch (fontSize) {\n      case \'sm\':\n        return \'text-sm leading-relaxed\';\n      case \'lg\':\n        return \'text-lg leading-loose\';\n      case \'xl\':\n        return \'text-xl leading-loose\';\n      case \'base\':\n      default:\n        return \'text-base sm:text-lg leading-relaxed\';\n    }\n  };\n\n  return (\n    <article className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* 1. Breadcrumbs */}\n      <nav aria-label=\"Breadcrumb\" className=\"flex items-center gap-1.5 text-xs text-gray-500 mb-4\">\n        <Link href=\"/\" className=\"hover:text-rose-600 transition-colors\">\340\244\271\340\245\213\340\244\256</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <Link href={`/category/${article.categorySlug}`} className=\"hover:text-rose-600 transition-colors\">\n          {article.category}\n        </Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <span className=\"truncate max-w-[200px] sm:max-w-md text-gray-800 font-medium\">\n          {article.title}\n        </span>\n      </nav>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        {/* Main Article Body (8 Cols) */}\n        <div className=\"lg:col-span-8 bg-white rounded-xl border border-gray-200 p-5 sm:p-8 shadow-xs\">\n          {/* Category Pill & Breaking Tag */}\n          <div className=\"flex flex-wrap items-center gap-2 mb-3\">\n            <Link\n              href={`/category/${article.categorySlug}`}\n              className=\"px-3 py-1 rounded-full bg-rose-600 text-white text-xs font-bold uppercase tracking-wider\"\n            >\n              {article.category}\n            </Link>\n            {article.isBreaking && (\n              <span className=\"px-3 py-1 rounded-full bg-black text-rose-400 text-xs font-bold animate-pulse\">\n                \342\232\241 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237\n              </span>\n            )}\n          </div>\n\n          {/* Headline */}\n          <h1 className=\"text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-950 leading-tight tracking-tight\">\n            {article.title}\n          </h1>\n\n          {/* English / Subtitle */}\n          {article.titleEn && (\n            <p className=\"mt-2 text-sm sm:text-base text-gray-600 font-medium italic\">\n              {article.titleEn}\n            </p>\n          )}\n\n          {/* Author Byline & Date */}\n          <div className=\"mt-5 py-3 border-y border-gray-100 flex flex-wrap items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={article.author.avatar}\n                alt={article.author.name}\n                className=\"w-10 h-10 rounded-full object-cover border border-gray-200\"\n              />\n              <div>\n                <div className=\"font-bold text-sm text-gray-900\">{article.author.nameHi}</div>\n                <div className=\"text-xs text-gray-500\">{article.author.role}</div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-4 text-xs text-gray-500\">\n              <div className=\"flex items-center gap-1\">\n                <Clock className=\"w-3.5 h-3.5 text-gray-400\" />\n                <span>{article.publishedAt}</span>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <Eye className=\"w-3.5 h-3.5 text-gray-400\" />\n                <span>{article.views.toLocaleString(\'hi-IN\')} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Article Accessibility Toolbar (Font size & Audio player) */}\n          <div className=\"my-3 flex items-center justify-between bg-gray-50 px-3 py-2 rounded-lg text-xs text-gray-700\">\n            {/* Audio Reader Demo */}\n            <button\n              type=\"button\"\n              onClick={() => setIsPlayingAudio(!isPlayingAudio)}\n              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-md font-semibold transition-colors ${\n                isPlayingAudio ? \'bg-rose-600 text-white\' : \'bg-white border border-gray-200 text-gray-800 hover:bg-gray-100\'\n              }`}\n            >\n              {isPlayingAudio ? (\n                <>\n                  <VolumeX className=\"w-3.5 h-3.5 animate-pulse\" />\n                  <span>\340\244\221\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\260\340\245\213\340\244\225\340\245\207\340\244\202</span>\n                </>\n              ) : (\n                <>\n                  <Volume2 className=\"w-3.5 h-3.5 text-rose-600\" />\n                  <span>\340\244\226\340\244\254\340\244\260 \340\244\270\340\245\201\340\244\250\340\245\207\340\244\202 (Audio)</span>\n                </>\n              )}\n            </button>\n\n            {/* Font Size Adjuster */}\n            <div className=\"flex items-center gap-1\">\n              <Type className=\"w-3.5 h-3.5 text-gray-400 mr-1\" />\n              <span className=\"text-gray-500 text-[11px] mr-1 hidden sm:inline\">\340\244\253\340\245\211\340\244\250\340\245\215\340\244\237 \340\244\270\340\244\276\340\244\207\340\244\234:</span>\n              <button\n                type=\"button\"\n                onClick={() => setFontSize(\'sm\')}\n                className={`px-2 py-0.5 rounded text-xs ${fontSize === \'sm\' ? \'bg-rose-600 text-white font-bold\' : \'hover:bg-gray-200\'}`}\n              >\n                A-\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setFontSize(\'base\')}\n                className={`px-2 py-0.5 rounded text-xs ${fontSize === \'base\' ? \'bg-rose-600 text-white font-bold\' : \'hover:bg-gray-200\'}`}\n              >\n                A\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setFontSize(\'lg\')}\n                className={`px-2 py-0.5 rounded text-xs ${fontSize === \'lg\' ? \'bg-rose-600 text-white font-bold\' : \'hover:bg-gray-200\'}`}\n              >\n                A+\n              </button>\n            </div>\n          </div>\n\n          {/* Social Share Bar */}\n          <ShareBar title={article.title} />\n\n          {/* Hero Image & Caption */}\n          <div className=\"my-6\">\n            <div className=\"relative aspect-16/9 rounded-xl overflow-hidden shadow-xs\">\n              <ImageWithFallback\n                src={article.coverImage}\n                alt={article.title}\n                className=\"w-full h-full object-cover\"\n              />\n            </div>\n            {article.imageCaption && (\n              <p className=\"mt-2 text-xs text-gray-500 italic text-center\">\n                {article.imageCaption}\n              </p>\n            )}\n          </div>\n\n          {/* Key Highlights Box (\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201) */}\n          {article.keyPoints && article.keyPoints.length > 0 && (\n            <div className=\"my-6 p-4 sm:p-5 rounded-xl bg-rose-50/60 border border-rose-100\">\n              <h3 className=\"font-extrabold text-sm sm:text-base text-rose-900 mb-3 flex items-center gap-2\">\n                <span className=\"w-2 h-2 rounded-full bg-rose-600\"></span>\n                <span>\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 (Key Highlights):</span>\n              </h3>\n              <ul className=\"space-y-2\">\n                {article.keyPoints.map((point, i) => (\n                  <li key={i} className=\"flex items-start gap-2 text-xs sm:text-sm text-gray-800\">\n                    <CheckCircle2 className=\"w-4 h-4 text-rose-600 shrink-0 mt-0.5\" />\n                    <span>{point}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          )}\n\n          {/* Main Article Paragraphs */}\n          <div className={`space-y-5 text-gray-900 ${getFontSizeClass()}`}>\n            {article.body.map((paragraph, idx) => (\n              <React.Fragment key={idx}>\n                <p className=\"text-justify leading-relaxed\">\n                  {paragraph}\n                </p>\n\n                {/* In-Article Advertisement Slot after paragraph 1 */}\n                {idx === 0 && (\n                  <AdSlot format=\"in-feed\" slotName=\"\340\244\226\340\244\254\340\244\260 \340\244\225\340\245\207 \340\244\256\340\244\247\340\245\215\340\244\257 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250\" />\n                )}\n              </React.Fragment>\n            ))}\n          </div>\n\n          {/* Clickable Tags Cloud */}\n          <div className=\"mt-8 pt-6 border-t border-gray-100\">\n            <div className=\"text-xs font-bold text-gray-700 mb-3\">\340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270:</div>\n            <div className=\"flex flex-wrap gap-2\">\n              {article.tags.map((tag, idx) => (\n                <Link\n                  key={idx}\n                  href={`/search?q=${encodeURIComponent(tag)}`}\n                  className=\"px-3 py-1 bg-gray-100 hover:bg-rose-50 hover:text-rose-700 text-xs font-medium text-gray-700 rounded-full transition-colors\"\n                >\n                  #{tag}\n                </Link>\n              ))}\n            </div>\n          </div>\n\n          {/* Bottom Share Bar */}\n          <div className=\"mt-6\">\n            <ShareBar title={article.title} />\n          </div>\n        </div>\n\n        {/* Sidebar (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <TrendingWidget articles={trendingArticles} />\n          <AdSlot format=\"medium-rectangle\" slotName=\"\340\244\262\340\245\207\340\244\226 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240 \340\244\270\340\244\276\340\244\207\340\244\241\340\244\254\340\244\276\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\225\" />\n          <AdSlot format=\"half-page\" slotName=\"\340\244\254\340\245\215\340\244\260\340\244\276\340\244\202\340\244\241 \340\244\225\340\245\210\340\244\202\340\244\252\340\245\207\340\244\250 \340\244\254\340\245\210\340\244\250\340\244\260\" />\n        </div>\n      </div>\n\n      {/* Related Stories Section */}\n      <section className=\"mt-12 pt-8 border-t-2 border-gray-200\">\n        <div className=\"flex items-center justify-between mb-6\">\n          <h2 className=\"text-xl sm:text-2xl font-black text-gray-900 flex items-center gap-2\">\n            <span className=\"w-2 h-6 bg-rose-600 rounded-full\"></span>\n            <span>\340\244\257\340\244\271 \340\244\255\340\245\200 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202 (Related Stories)</span>\n          </h2>\n          <Link\n            href={`/category/${article.categorySlug}`}\n            className=\"text-xs sm:text-sm font-bold text-rose-600 hover:underline\"\n          >\n            \340\244\224\340\244\260 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 \342\206\222\n          </Link>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n          {relatedStories.map((story) => (\n            <StoryCard key={story.id} article={story} variant=\"grid\" />\n          ))}\n        </div>\n      </section>\n    </article>\n  );\n};\n"
    }
