          text: "  tags: string[];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  authorRole: string;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  readTime: string;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
