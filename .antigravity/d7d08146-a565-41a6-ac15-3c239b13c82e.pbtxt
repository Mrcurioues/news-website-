  file_change {
    absolute_path_uri: "file:///src/pages/AdminPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { getAllArticles, CATEGORIES, addArticle, updateArticle, deleteArticle } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { Article, PostStatus } from \'../types\';\nimport {\n  ShieldCheck,\n  PlusCircle,\n  List,\n  CheckCircle,\n  Eye,\n  Radio,\n  Flame,\n  FileText,\n  ExternalLink,\n  Sparkles,\n  Edit3,\n  Trash2,\n  Clock,\n  Search,\n  Filter,\n  Bot,\n  AlertTriangle,\n  Layers,\n  Calendar,\n  X\n} from \'lucide-react\';\nimport { WpArticleEditor } from \'../components/admin/WpArticleEditor\';\nimport { WpAssistantChat } from \'../components/admin/WpAssistantChat\';\nimport { DeleteConfirmModal } from \'../components/admin/DeleteConfirmModal\';\n\nexport const AdminPage: React.FC = () => {\n  const { updateMetadata, push } = useRouter();\n  const [articles, setArticles] = useState<Article[]>(() => getAllArticles());\n  const [activeTab, setActiveTab] = useState<\'list\' | \'editor\' | \'assistant\'>(\'list\');\n  const [editingArticle, setEditingArticle] = useState<Partial<Article> | undefined>(undefined);\n\n  // Search and filter for articles table\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n  const [categoryFilter, setCategoryFilter] = useState<string>(\'all\');\n\n  // Success and notification alerts\n  const [notification, setNotification] = useState<{ message: string; slug?: string } | null>(null);\n\n  // Deletion Modal state\n  const [deleteModalState, setDeleteModalState] = useState<{\n    isOpen: boolean;\n    articleId: string;\n    articleTitle: string;\n  }>({\n    isOpen: false,\n    articleId: \'\',\n    articleTitle: \'\'\n  });\n\n  // Floating Assistant Drawer toggle\n  const [isAssistantDrawerOpen, setIsAssistantDrawerOpen] = useState(false);\n\n  useEffect(() => {\n    updateMetadata({\n      title: \'WordPress \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 - Bharat Samachar WP Admin\',\n      description: \'WordPress Article Management Assistant with Yoast & Rank Math SEO, Flesch Readability, and Post Scheduling\'\n    });\n  }, []);\n\n  const refreshArticles = () => {\n    setArticles([...getAllArticles()]);\n  };\n\n  // Open Editor for new article\n  const handleCreateNewArticle = (prefillData?: Partial<Article>) => {\n    setEditingArticle(prefillData || {\n      title: \'\',\n      titleEn: \'\',\n      categorySlug: \'national\',\n      excerpt: \'\',\n      body: [\n        \'## 1. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\244\260\340\244\277\340\244\246\340\245\203\340\244\266\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\340\244\255\340\245\202\340\244\256\340\244\277\',\n        \'\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\',\n        \'## 2. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\217\340\244\265\340\244\202 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\',\n        \'### \340\244\225) \340\244\250\340\245\200\340\244\244\340\244\277\340\244\227\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\255\340\244\276\340\244\265 \340\244\224\340\244\260 \340\244\244\340\244\245\340\245\215\340\244\257\',\n        \'\340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\270\340\245\215\340\244\244\340\245\201\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\'\n      ],\n      coverImage: \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\',\n      status: \'published\',\n      tags: [\'\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\254\340\244\260\', \'\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\'],\n      focusKeyword: \'\',\n      metaTitle: \'\',\n      metaDescription: \'\'\n    });\n    setActiveTab(\'editor\');\n  };\n\n  // Open Editor for existing article\n  const handleEditArticle = (article: Article) => {\n    setEditingArticle({ ...article });\n    setActiveTab(\'editor\');\n  };\n\n  // Handle Save (Create or Update)\n  const handleSaveArticle = (articleData: Partial<Article>) => {\n    let savedArticle: Article;\n    if (articleData.id) {\n      const updated = updateArticle(articleData.id, articleData);\n      savedArticle = updated || addArticle(articleData);\n      setNotification({\n        message: `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    } else {\n      savedArticle = addArticle(articleData);\n      setNotification({\n        message: `\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 / \340\244\270\340\244\271\340\245\207\340\244\234\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    }\n\n    refreshArticles();\n    setEditingArticle(savedArticle);\n    setActiveTab(\'list\');\n\n    setTimeout(() => {\n      setNotification(null);\n    }, 6000);\n  };\n\n  // Apply partial data from Assistant\n  const handleApplyAssistantData = (data: Partial<Article>) => {\n    if (editingArticle) {\n      setEditingArticle(prev => ({\n        ...prev,\n        ...data\n      }));\n    } else {\n      // If currently on list view, start editor with this data\n      handleCreateNewArticle(data);\n    }\n  };\n\n  // Trigger Delete confirmation modal\n  const handleRequestDelete = (id: string, title: string) => {\n    setDeleteModalState({\n      isOpen: true,\n      articleId: id,\n      articleTitle: title\n    });\n  };\n\n  // Perform confirmed deletion\n  const handleConfirmDelete = () => {\n    if (deleteModalState.articleId) {\n      const success = deleteArticle(deleteModalState.articleId);\n      if (success) {\n        refreshArticles();\n        setNotification({\n          message: `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 (Deleted) \340\244\227\340\244\257\340\244\276\340\245\244`\n        });\n        if (editingArticle?.id === deleteModalState.articleId) {\n          setEditingArticle(undefined);\n          setActiveTab(\'list\');\n        }\n      }\n    }\n    setDeleteModalState({ isOpen: false, articleId: \'\', articleTitle: \'\' });\n    setTimeout(() => {\n      setNotification(null);\n    }, 5000);\n  };\n\n  // Metrics\n  const breakingCount = articles.filter(a => a.isBreaking).length;\n  const draftCount = articles.filter(a => a.status === \'draft\').length;\n  const scheduledCount = articles.filter(a => a.status === \'scheduled\').length;\n  const avgSeoScore = Math.round(\n    articles.reduce((acc, a) => acc + (a.seoScore || 85), 0) / Math.max(1, articles.length)\n  );\n\n  // Filtered Articles for Table\n  const filteredArticles = articles.filter(a => {\n    const matchesSearch =\n      !searchQuery ||\n      a.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (a.focusKeyword && a.focusKeyword.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (a.slug && a.slug.toLowerCase().includes(searchQuery.toLowerCase()));\n\n    const matchesStatus =\n      statusFilter === \'all\' ||\n      (statusFilter === \'published\' && (!a.status || a.status === \'published\')) ||\n      a.status === statusFilter;\n\n    const matchesCategory =\n      categoryFilter === \'all\' || a.categorySlug === categoryFilter;\n\n    return matchesSearch && matchesStatus && matchesCategory;\n  });\n\n  return (\n    <div id=\"wp-admin-page-root\" className=\"min-h-screen bg-gray-50/60 pb-16\">\n      {/* Top Banner Header */}\n      <div className=\"bg-linear-to-r from-slate-950 via-zinc-900 to-gray-900 text-white border-b border-gray-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <span className=\"px-2.5 py-0.5 rounded-md bg-rose-500/20 text-rose-400 border border-rose-500/30 text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  WordPress Article Management\n                </span>\n                <span className=\"px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold\">\n                  Rank Math & Yoast Compatible\n                </span>\n              </div>\n              <h1 className=\"text-2xl sm:text-3xl font-black text-white tracking-tight\">\n                \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\217\340\244\265\340\244\202 WordPress \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262\n              </h1>\n              <p className=\"text-xs sm:text-sm text-gray-400 mt-1\">\n                AI-\340\244\270\340\244\202\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\215\340\244\260\340\244\277\340\244\217\340\244\266\340\244\250, H1/H2/H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256, Flesch \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\217\340\244\265\340\244\202 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227\n              </p>\n            </div>\n\n            {/* Quick Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-3\">\n              <button\n                type=\"button\"\n                id=\"create-new-article-top-btn\"\n                onClick={() => handleCreateNewArticle()}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-rose-900/40\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202 (New Post)</span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"toggle-assistant-top-btn\"\n                onClick={() => setActiveTab(\'assistant\')}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-purple-900/40\"\n              >\n                <Sparkles className=\"w-4 h-4\" />\n                <span>AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202 (Open Assistant)</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 pt-6\">\n        {/* Metric Cards Row */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 mb-6\">\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262</span>\n            <div className=\"text-2xl font-black text-gray-900 mt-1\">{articles.length}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\224\340\244\270\340\244\244 SEO \340\244\271\340\245\207\340\244\262\340\245\215\340\244\245</span>\n            <div className=\"text-2xl font-black text-emerald-600 mt-1 flex items-center gap-1.5\">\n              <span>{avgSeoScore}/100</span>\n              <span className=\"text-xs px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold\">Good</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237\340\245\215\340\244\270</span>\n            <div className=\"text-2xl font-black text-indigo-600 mt-1 flex items-center gap-1\">\n              <Clock className=\"w-4 h-4\" />\n              <span>{scheduledCount}</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237\340\245\215\340\244\270 (Drafts)</span>\n            <div className=\"text-2xl font-black text-amber-600 mt-1\">{draftCount}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274</span>\n            <div className=\"text-2xl font-black text-rose-600 mt-1 flex items-center gap-1\">\n              <Radio className=\"w-4 h-4 animate-pulse\" />\n              <span>{breakingCount}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Global Notification Banner */}\n        {notification && (\n          <div className=\"mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center justify-between shadow-xs animate-in fade-in duration-200\">\n            <div className=\"flex items-center gap-2.5 text-xs sm:text-sm font-bold\">\n              <CheckCircle className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n              <span>{notification.message}</span>\n            </div>\n            {notification.slug && (\n              <Link\n                href={`/news/${notification.slug}`}\n                className=\"inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs shrink-0\"\n              >\n                <span>\340\244\262\340\244\276\340\244\207\340\244\265 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n              </Link>\n            )}\n          </div>\n        )}\n\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center justify-between border-b border-gray-200 mb-6 bg-white rounded-2xl px-4 py-2 shadow-2xs\">\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              id=\"tab-all-posts-btn\"\n              onClick={() => setActiveTab(\'list\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'list\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <List className=\"w-4 h-4\" />\n              <span>\340\244\270\340\244\255\340\245\200 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 (All Posts - {articles.length})</span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-editor-btn\"\n              onClick={() => {\n                if (!editingArticle) handleCreateNewArticle();\n                else setActiveTab(\'editor\');\n              }}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'editor\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <Edit3 className=\"w-4 h-4\" />\n              <span>\n                {editingArticle?.id ? \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 (Editing)\' : \'\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 (Create Post)\'}\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-assistant-btn\"\n              onClick={() => setActiveTab(\'assistant\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'assistant\'\n                  ? \'bg-purple-600 text-white shadow-xs\'\n                  : \'text-purple-700 hover:bg-purple-50\'\n              }`}\n            >\n              <Bot className=\"w-4 h-4\" />\n              <span>WordPress AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237</span>\n            </button>\n          </div>\n\n          {/* Quick Indicator of active post in editor */}\n          {editingArticle?.title && activeTab !== \'editor\' && (\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'editor\')}\n              className=\"text-xs text-gray-500 hover:text-rose-600 font-semibold flex items-center gap-1 truncate max-w-xs\"\n            >\n              <span>\340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202:</span>\n              <span className=\"font-bold text-gray-800 truncate\">\"{editingArticle.title}\"</span>\n            </button>\n          )}\n        </div>\n\n        {/* TAB 1: ALL POSTS TABLE (WordPress Management) */}\n        {activeTab === \'list\' && (\n          <div className=\"space-y-4\">\n            {/* Filter and Search Bar */}\n            <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n              <div className=\"relative w-full sm:w-72\">\n                <Search className=\"w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  placeholder=\"\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225, \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\257\340\244\276 \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\270\340\245\207 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202...\"\n                  className=\"w-full pl-10 pr-4 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600\"\n                />\n              </div>\n\n              <div className=\"flex items-center gap-2 w-full sm:w-auto\">\n                <select\n                  value={statusFilter}\n                  onChange={(e) => setStatusFilter(e.target.value)}\n                  className=\"text-xs font-semibold px-3 py-2 rounded-xl border border-gray-300 bg-white\"\n                >\n                  <option value=\"all\">\340\244\270\340\244\255\340\245\200 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202 (All Status)</option>\n                  <option value=\"published\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Published)</option>\n                  <option value=\"draft\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 (Draft)</option>\n                  <option value=\"scheduled\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</option>\n                  <option value=\"pending\">\340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276\340\244\247\340\245\200\340\244\250 (Pending)</option>\n                </select>\n\n                <select\n                  value={categoryFilter}\n                  onChange={(e) => setCategoryFilter(e.target.value)}\n                  className=\"text-xs font-semibold px-3 py-2 rounded-xl border border-gray-300 bg-white\"\n                >\n                  <option value=\"all\">\340\244\270\340\244\255\340\245\200 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 (All Categories)</option>\n                  {CATEGORIES.map(c => (\n                    <option key={c.id} value={c.slug}>{c.nameHi}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* Articles Table */}\n            <div className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-2xs\">\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left text-xs sm:text-sm\">\n                  <thead className=\"bg-gray-50 border-b border-gray-200 text-gray-600 font-bold\">\n                    <tr>\n                      <th className=\"py-3.5 px-4\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\265 \340\244\252\340\244\260\340\244\256\340\244\276\340\244\262\340\244\277\340\244\202\340\244\225 (Title / Permalink)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Category)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 (Status)</th>\n                      <th className=\"py-3.5 px-4\">SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 (Rank Math)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Views)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\246\340\244\277\340\244\250\340\244\276\340\244\202\340\244\225 (Date)</th>\n                      <th className=\"py-3.5 px-4 text-right\">\340\244\225\340\244\276\340\244\260\340\245\215\340\244\260\340\244\265\340\244\276\340\244\210 (Actions)</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-gray-100 text-gray-800\">\n                    {filteredArticles.length === 0 ? (\n                      <tr>\n                        <td colSpan={7} className=\"py-8 text-center text-gray-400 text-xs\">\n                          \340\244\225\340\245\213\340\244\210 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \"\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202\" \340\244\252\340\244\260 \340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\n                        </td>\n                      </tr>\n                    ) : (\n                      filteredArticles.map((item) => {\n                        const postStatus = item.status || \'published\';\n                        const seoScore = item.seoScore || (item.body && item.body.length > 3 ? 88 : 74);\n\n                        return (\n                          <tr key={item.id} className=\"hover:bg-gray-50/70 transition-colors\">\n                            {/* Title & Slug */}\n                            <td className=\"py-3.5 px-4 max-w-xs sm:max-w-md\">\n                              <div className=\"font-bold text-gray-900 line-clamp-1\">{item.title}</div>\n                              <div className=\"text-[11px] text-gray-400 font-mono mt-0.5 flex items-center gap-1.5\">\n                                <span>/news/{item.idSlug}</span>\n                                {item.focusKeyword && (\n                                  <span className=\"px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 text-[10px] font-bold\">\n                                    KW: {item.focusKeyword}\n                                  </span>\n                                )}\n                              </div>\n                            </td>\n\n                            {/* Category */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <span className=\"px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 text-xs font-semibold\">\n                                {item.category}\n                              </span>\n                            </td>\n\n                            {/* Status */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <div className=\"flex flex-col items-start gap-1\">\n                                <span\n                                  className={`px-2 py-0.5 rounded-md text-[11px] font-bold ${\n                                    postStatus === \'published\'\n                                      ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                                      : postStatus === \'scheduled\'\n                                      ? \'bg-indigo-50 text-indigo-700 border border-indigo-200\'\n                                      : postStatus === \'draft\'\n                                      ? \'bg-amber-50 text-amber-700 border border-amber-200\'\n                                      : \'bg-gray-100 text-gray-700\'\n                                  }`}\n                                >\n                                  {postStatus.toUpperCase()}\n                                </span>\n                                {item.isBreaking && (\n                                  <span className=\"px-1.5 py-0.2 rounded bg-rose-100 text-rose-700 text-[10px] font-bold\">\n                                    \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227\n                                  </span>\n                                )}\n                              </div>\n                            </td>\n\n                            {/* SEO Score Pill */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <div\n                                className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black ${\n                                  seoScore >= 80\n                                    ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                                    : seoScore >= 60\n                                    ? \'bg-amber-50 text-amber-700 border border-amber-200\'\n                                    : \'bg-rose-50 text-rose-700 border border-rose-200\'\n                                raid}`}\n                              >\n                                <span className=\"w-1.5 h-1.5 rounded-full bg-current\" />\n                                <span>{seoScore}/100</span>\n                              </div>\n                            </td>\n\n                            {/* Views */}\n                            <td className=\"py-3.5 px-4 font-mono text-gray-600 whitespace-nowrap\">\n                              {item.views.toLocaleString(\'hi-IN\')}\n                            </td>\n\n                            {/* Date */}\n                            <td className=\"py-3.5 px-4 text-xs text-gray-500 whitespace-nowrap\">\n                              {item.scheduledDate ? (\n                                <span className=\"text-indigo-600 font-medium\">\n                                  \342\217\260 {item.scheduledDate.replace(\'T\', \' \')}\n                                </span>\n                              ) : (\n                                item.publishedAt.split(\',\')[0]\n                              )}\n                            </td>\n\n                            {/* Action Buttons */}\n                            <td className=\"py-3.5 px-4 text-right whitespace-nowrap\">\n                              <div className=\"flex items-center justify-end gap-1.5\">\n                                <button\n                                  type=\"button\"\n                                  onClick={() => handleEditArticle(item)}\n                                  className=\"p-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 text-gray-700 transition-colors\"\n                                  title=\"\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Edit)\"\n                                >\n                                  <Edit3 className=\"w-3.5 h-3.5\" />\n                                </button>\n\n                                <Link\n                                  href={`/news/${item.idSlug}`}\n                                  className=\"p-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors\"\n                                  title=\"\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 \340\244\252\340\244\260 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 (View)\"\n                                >\n                                  <Eye className=\"w-3.5 h-3.5\" />\n                                </Link>\n\n                                <button\n                                  type=\"button\"\n                                  onClick={() => handleRequestDelete(item.id, item.title)}\n                                  className=\"p-1.5 rounded-lg bg-gray-100 hover:bg-rose-100 text-rose-600 transition-colors\"\n                                  title=\"\340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202 (Delete with confirmation)\"\n                                >\n                                  <Trash2 className=\"w-3.5 h-3.5\" />\n                                </button>\n                              </div>\n                            </td>\n                          </tr>\n                        );\n                      })\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 2: ARTICLE EDITOR VIEW */}\n        {activeTab === \'editor\' && (\n          <WpArticleEditor\n            initialArticle={editingArticle}\n            onSave={handleSaveArticle}\n            onDeleteRequest={handleRequestDelete}\n            onOpenAssistant={() => setIsAssistantDrawerOpen(true)}\n            onCancel={() => setActiveTab(\'list\')}\n          />\n        )}\n\n        {/* TAB 3: AI ASSISTANT FULL VIEW */}\n        {activeTab === \'assistant\' && (\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n            <div className=\"lg:col-span-8\">\n              <WpAssistantChat\n                currentArticle={editingArticle}\n                allArticles={articles}\n                onApplyArticleData={handleApplyAssistantData}\n                onCreateNewArticle={(data) => {\n                  handleCreateNewArticle(data);\n                }}\n                onConfirmDeleteRequest={handleRequestDelete}\n              />\n            </div>\n\n            {/* Context Sidebar */}\n            <div className=\"lg:col-span-4 space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                <h3 className=\"text-sm font-black text-gray-900 mb-2 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-purple-600\" />\n                  <span>\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\225\340\245\215\340\244\267\340\244\256\340\244\244\340\244\276\340\244\217\340\244\202</span>\n                </h3>\n                <ul className=\"text-xs text-gray-600 space-y-2 leading-relaxed\">\n                  <li>\342\200\242 <strong>SEO \340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\225\340\245\215\340\244\232\340\244\260\340\244\277\340\244\202\340\244\227:</strong> Google \340\244\265 Rank Math \340\244\246\340\244\277\340\244\266\340\244\276\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\260\340\245\202\340\244\252 H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\221\340\244\252\340\245\215\340\244\237\340\244\277\340\244\256\340\244\276\340\244\207\340\244\234\340\244\274\340\245\207\340\244\266\340\244\250:</strong> 150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\262\340\245\200 URL \340\244\270\340\245\215\340\244\262\340\244\227\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\225\340\245\215\340\244\265\340\244\276\340\244\262\340\244\277\340\244\237\340\245\200 \340\244\221\340\244\241\340\244\277\340\244\237:</strong> Flesch Reading Ease \340\244\253\340\245\211\340\244\260\340\245\215\340\244\256\340\245\202\340\244\262\340\244\276 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200 \340\244\225\340\244\276 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\202\340\244\262\340\245\215\340\244\257\340\244\276\340\244\202\340\244\225\340\244\250\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\252\340\245\215\340\244\260\340\244\243\340\244\276\340\244\262\340\245\200:</strong> \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\255\340\245\200 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\225\340\245\213 \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\245\200 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 (Explicit confirmation)\340\245\244</li>\n                </ul>\n              </div>\n\n              {editingArticle?.title && (\n                <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                  <span className=\"text-[11px] font-bold text-gray-400 uppercase block mb-1\">\n                    \340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\232\340\244\257\340\244\250\340\244\277\340\244\244 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237\n                  </span>\n                  <div className=\"font-black text-gray-900 text-sm mb-2\">\n                    {editingArticle.title}\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveTab(\'editor\')}\n                    className=\"w-full py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-xl transition-colors\"\n                  >\n                    \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202 (Open in Editor)\n                  </button>\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Floating Assistant Drawer Button */}\n      <div className=\"fixed bottom-6 right-6 z-40\">\n        <button\n          type=\"button\"\n          id=\"floating-assistant-toggle-btn\"\n          onClick={() => setIsAssistantDrawerOpen(!isAssistantDrawerOpen)}\n          className=\"px-4 py-3 rounded-full bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold text-xs sm:text-sm shadow-xl flex items-center gap-2 transition-transform hover:scale-105\"\n        >\n          <Bot className=\"w-4 h-4\" />\n          <span>{isAssistantDrawerOpen ? \'\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\254\340\244\202\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\' : \'WP AI Assistant\'}</span>\n        </button>\n      </div>\n\n      {/* Floating Assistant Drawer Modal */}\n      {isAssistantDrawerOpen && (\n        <div className=\"fixed bottom-20 right-4 sm:right-6 w-[95vw] sm:w-[480px] z-50 animate-in slide-in-from-bottom-5 duration-200 shadow-2xl rounded-2xl\">\n          <div className=\"relative\">\n            <button\n              type=\"button\"\n              onClick={() => setIsAssistantDrawerOpen(false)}\n              className=\"absolute top-3.5 right-3.5 text-gray-300 hover:text-white p-1 rounded-lg z-50\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n            <WpAssistantChat\n              currentArticle={editingArticle}\n              allArticles={articles}\n              onApplyArticleData={(data) => {\n                handleApplyAssistantData(data);\n                setIsAssistantDrawerOpen(false);\n                setActiveTab(\'editor\');\n              }}\n              onCreateNewArticle={(data) => {\n                handleCreateNewArticle(data);\n                setIsAssistantDrawerOpen(false);\n                setActiveTab(\'editor\');\n              }}\n              onConfirmDeleteRequest={(id, title) => {\n                setIsAssistantDrawerOpen(false);\n                handleRequestDelete(id, title);\n              }}\n              isFloating={true}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* Explicit Confirmation Modal for Post Deletion */}\n      <DeleteConfirmModal\n        isOpen={deleteModalState.isOpen}\n        articleTitle={deleteModalState.articleTitle}\n        articleId={deleteModalState.articleId}\n        onConfirm={handleConfirmDelete}\n        onCancel={() => setDeleteModalState({ isOpen: false, articleId: \'\', articleTitle: \'\' })}\n      />\n    </div>\n  );\n};\n"
    }
