          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'At the United Nations high-level assembly in New York, India made an impassioned pitch championing the developmental priorities of the Global South. The Indian External Affairs delegation stressed that achieving equitable global Net-Zero transitions is impossible without predictable finance and technology transfers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'India\342\200\231s home-grown climate initiatives, such as the International Solar Alliance and the Lifestyle for Environment (LiFE) movement, received widespread praise across multilateral working groups.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
