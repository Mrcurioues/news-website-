        lines {
          text: "  // Metrics"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const breakingCount = articles.filter(a => a.isBreaking).length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const draftCount = articles.filter(a => a.status === \'draft\').length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const scheduledCount = articles.filter(a => a.status === \'scheduled\').length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const avgSeoScore = Math.round("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    articles.reduce((acc, a) => acc + (a.seoScore || 85), 0) / Math.max(1, articles.length)"
