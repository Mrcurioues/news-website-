        lines {
          text: "                <div className=\"font-bold text-gray-900\">\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\244\256 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225\340\244\244\340\244\276\340\244\217\340\244\202 (System Preferences):</div>"
