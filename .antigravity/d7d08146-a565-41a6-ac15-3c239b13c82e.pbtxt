      target_content: "      {/* Gutenberg-style Header Action Bar */}\n      <div className=\"bg-white border border-gray-200 rounded-2xl p-4 mb-6 shadow-xs sticky top-3 z-30 flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            type=\"button\"\n            onClick={onCancel}\n            className=\"text-xs font-bold text-gray-500 hover:text-gray-800 px-3 py-1.5 rounded-lg hover:bg-gray-100 transition-colors\"\n          >\n            \342\206\220 \340\244\265\340\244\276\340\244\252\340\244\270 (Cancel)\n          </button>\n          <div className=\"h-4 w-px bg-gray-200\" />\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-gray-500\">\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277:</span>\n            <select\n              value={status}\n              onChange={(e) => setStatus(e.target.value as PostStatus)}\n              className=\"text-xs font-bold rounded-lg border border-gray-300 px-2.5 py-1 bg-gray-50\"\n            >\n              <option value=\"published\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Published)</option>\n              <option value=\"draft\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 (Draft)</option>\n              <option value=\"pending\">\340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276\340\244\247\340\245\200\340\244\250 (Pending Review)</option>\n              <option value=\"scheduled\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</option>\n            </select>\n          </div>\n        </div>\n\n        {/* SEO Score Pill & Action Buttons */}\n        <div className=\"flex items-center gap-3\">\n          {/* Yoast / Rank Math Score Badge */}\n          <div\n            className={`px-3 py-1.5 rounded-xl border flex items-center gap-2 text-xs font-black shadow-2xs ${\n              audit.overallScore >= 80\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : audit.overallScore >= 60\n                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                : \'bg-rose-50 text-rose-700 border-rose-200\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full animate-pulse bg-current\" />\n            <span>Rank Math SEO: {audit.overallScore}/100</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenAssistant}\n            className=\"px-3.5 py-1.5 rounded-xl bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 transition-all shadow-xs\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\252\340\245\202\340\244\233\340\245\207\340\244\202</span>\n          </button>\n\n          {initialArticle?.id && (\n            <button\n              type=\"button\"\n              onClick={() => onDeleteRequest(initialArticle.id!, title)}\n              className=\"p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors border border-rose-200\"\n              title=\"\340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202 (Confirm Delete)\"\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={handleSaveSubmit}\n            className=\"px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center gap-1.5 transition-colors shadow-sm shadow-rose-200\"\n          >\n            <Save className=\"w-4 h-4\" />\n            <span>\n              {status === \'scheduled\'\n                ? \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 (Schedule Post)\'\n                : status === \'draft\'\n                ? \'\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 (Save Draft)\'\n                : \'\340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish)\'}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Validation Errors Alert */}\n      {validationErrors.length > 0 && (\n        <div className=\"mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1\">\n          <div className=\"font-bold flex items-center gap-1.5 text-sm mb-1 text-rose-900\">\n            <AlertCircle className=\"w-4 h-4 text-rose-600\" />\n            <span>\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\250\340\244\277\340\244\256\340\245\215\340\244\250\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\244\340\245\215\340\244\260\340\245\201\340\244\237\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\225\340\245\213 \340\244\240\340\245\200\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202:</span>\n          </div>"
      replacement_content: "      {/* Gutenberg-style Header Action Bar */}\n      <div className=\"bg-white border border-gray-200 rounded-2xl p-4 mb-6 shadow-xs sticky top-3 z-30 flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            type=\"button\"\n            onClick={onCancel}\n            className=\"text-xs font-bold text-gray-500 hover:text-gray-800 px-3 py-1.5 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer\"\n          >\n            \342\206\220 {lang === \'en\' ? \'Back / Cancel\' : \'\340\244\265\340\244\276\340\244\252\340\244\270 (Cancel)\'}\n          </button>\n          <div className=\"h-4 w-px bg-gray-200\" />\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-gray-500\">{t.colStatus}:</span>\n            <select\n              value={status}\n              onChange={(e) => setStatus(e.target.value as PostStatus)}\n              className=\"text-xs font-bold rounded-lg border border-gray-300 px-2.5 py-1 bg-gray-50\"\n            >\n              <option value=\"published\">{t.statusPublished}</option>\n              <option value=\"draft\">{t.statusDraft}</option>\n              <option value=\"pending\">{t.statusPending}</option>\n              <option value=\"scheduled\">{t.statusScheduled}</option>\n            </select>\n          </div>\n        </div>\n\n        {/* SEO Score Pill & Action Buttons */}\n        <div className=\"flex items-center gap-3\">\n          {/* Yoast / Rank Math Score Badge */}\n          <div\n            className={`px-3 py-1.5 rounded-xl border flex items-center gap-2 text-xs font-black shadow-2xs ${\n              audit.overallScore >= 80\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : audit.overallScore >= 60\n                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                : \'bg-rose-50 text-rose-700 border-rose-200\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full animate-pulse bg-current\" />\n            <span>Rank Math SEO: {audit.overallScore}/100</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenAssistant}\n            className=\"px-3.5 py-1.5 rounded-xl bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 transition-all shadow-xs cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>{lang === \'en\' ? \'Ask AI Assistant\' : \'AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\252\340\245\202\340\244\233\340\245\207\340\244\202\'}</span>\n          </button>\n\n          {initialArticle?.id && (\n            <button\n              type=\"button\"\n              onClick={() => onDeleteRequest(initialArticle.id!, title)}\n              className=\"p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors border border-rose-200 cursor-pointer\"\n              title={t.actionDeleteTooltip}\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={handleSaveSubmit}\n            className=\"px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center gap-1.5 transition-colors shadow-sm shadow-rose-200 cursor-pointer\"\n          >\n            <Save className=\"w-4 h-4\" />\n            <span>\n              {status === \'scheduled\'\n                ? (lang === \'en\' ? \'Schedule Post\' : \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 (Schedule Post)\')\n                : status === \'draft\'\n                ? (lang === \'en\' ? \'Save Draft\' : \'\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 (Save Draft)\')\n                : (lang === \'en\' ? \'Publish Post\' : \'\340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish)\')}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Validation Errors Alert */}\n      {validationErrors.length > 0 && (\n        <div className=\"mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1\">\n          <div className=\"font-bold flex items-center gap-1.5 text-sm mb-1 text-rose-900\">\n            <AlertCircle className=\"w-4 h-4 text-rose-600\" />\n            <span>{lang === \'en\' ? \'Please fix the following required errors:\' : \'\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\250\340\244\277\340\244\256\340\245\215\340\244\250\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\244\340\245\215\340\244\260\340\245\201\340\244\237\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\225\340\245\213 \340\244\240\340\245\200\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202:\'}</span>\n          </div>"
    }
