          text: "          `4. \360\237\223\226 [\340\244\271\340\244\276\340\244\211-\340\244\237\340\245\202 \340\244\266\340\245\210\340\244\262\340\245\200]: \"\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\256\340\244\277\340\244\266\340\244\250: \340\244\234\340\244\276\340\244\250\340\244\277\340\244\217 \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210 76,000 \340\244\225\340\244\260\340\245\213\340\244\241\340\244\274 \340\244\225\340\244\276 \340\244\270\340\244\277\340\244\262\340\244\277\340\244\225\340\245\211\340\244\250 \340\244\207\340\244\225\340\245\213\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\244\256\"\\n` +"
