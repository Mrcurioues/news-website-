227\340\244\257\340\244\276\',\n      diffRemoved: \'\'\n    },\n    {\n      id: \'rev-1\',\n      time: \'\340\244\225\340\244\262, 5:00 PM\',\n      author: \'\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225 (Editor)\',\n      desc: \'\340\244\252\340\245\215\340\244\260\340\244\276\340\244\260\340\244\202\340\244\255\340\244\277\340\244\225 \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\260\340\245\202\340\244\252\340\244\260\340\245\207\340\244\226\340\244\276 \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260 \340\244\225\340\245\200 \340\244\227\340\244\210\',\n      diffAdded: \'+ \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\217\340\244\265\340\244\202 \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276 \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260\',\n      diffRemoved: \'\'\n    }\n  ]);\n\n  /* =========================================================\n     MODULE 3: DELETE WITH 301 REDIRECT STATE\n     ========================================================= */\n  const [deleteInputConfirm, setDeleteInputConfirm] = useState(\'\');\n  const [redirect301Url, setRedirect301Url] = useState(\'/news/top-headlines\');\n\n  /* =========================================================\n     LIVE SEO AUDIT FOR CURRENT ARTICLE\n     ========================================================= */\n  const currentAudit = performSeoAudit(activeArticle);\n\n  return (\n    <div className=\"bg-white rounded-3xl border border-gray-200/90 shadow-sm overflow-hidden mb-12\">\n      {/* Top Header of Suite */}\n      <div className=\"bg-linear-to-r from-slate-950 via-zinc-900 to-indigo-950 text-white p-5 sm:p-6 border-b border-gray-800\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2 mb-1.5\">\n              <span className=\"px-2.5 py-0.5 rounded-md bg-rose-500 text-white text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-xs\">\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                WordPress AI Article Suite\n              </span>\n              <span className=\"px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold\">\n                12 Modules Integrated\n              </span>\n              <span className=\"text-[11px] text-zinc-400\">\n                \340\244\221\340\244\237\340\245\213-\340\244\270\340\245\207\340\244\265 \340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 (60s) \342\234\223\n              </span>\n            </div>\n            <h2 className=\"text-xl sm:text-2xl font-black text-white\">\n              WordPress \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\217\340\244\265\340\244\202 \340\244\221\340\244\237\340\245\213\340\244\256\340\245\207\340\244\266\340\244\250 \340\244\270\340\245\202\340\244\237\n            </h2>\n            <p className=\"text-xs sm:text-sm text-zinc-400 mt-0.5\">\n              \340\244\262\340\245\207\340\244\226 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243, \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\250, \340\244\217\340\244\270\340\244\210\340\244\223 \340\244\221\340\244\241\340\244\277\340\244\237, \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227, \340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237, \340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270 \340\244\265 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250\n            </p>\n          </div>\n\n          {/* Active Article Selector & Primary Action */}\n          <div className=\"flex flex-wrap items-center gap-2.5 bg-zinc-900/90 p-2 rounded-2xl border border-zinc-800\">\n            <div className=\"text-xs font-semibold text-zinc-300 pl-1\">\340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237:</div>\n            <select\n              value={selectedArticleId}\n              onChange={(e) => {\n                setSelectedArticleId(e.target.value);\n                const a = articles.find((art) => art.id === e.target.value);\n                if (a) onSelectArticle(a);\n              }}\n              className=\"px-3 py-1.5 rounded-xl bg-zinc-800 text-white text-xs font-bold border border-zinc-700 max-w-xs focus:outline-hidden\"\n            >\n              {articles.map((art) => (\n                <option key={art.id} value={art.id}>\n                  {art.title.slice(0, 38)}...\n                </option>\n              ))}\n            </select>\n\n            <button\n              type=\"button\"\n              onClick={onOpenEditor}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-colors shadow-xs\"\n            >\n              <Edit3 className=\"w-3.5 h-3.5\" />\n              <span>\340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onOpenAssistant}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold transition-colors shadow-xs\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>\340\244\232\340\245\210\340\244\237\340\244\254\340\245\211\340\244\237</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Global Toast / Notification */}\n      {notification && (\n        <div className=\"bg-emerald-50 border-b border-emerald-200 px-6 py-2 text-xs font-bold text-emerald-800 flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n          <span>{notification}</span>\n        </div>\n      )}\n\n      {/* Main Suite Layout: Sidebar Navigation + Content Body */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 min-h-[640px]\">\n        {/* Left Sidebar Navigation (3 Cols) */}\n        <div className=\"lg:col-span-3 border-r border-gray-200/80 bg-gray-50/70 p-3 space-y-1\">\n          <div className=\"text-[10px] font-black text-gray-400 uppercase tracking-wider px-3 py-1\">\n            \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 \340\244\217\340\244\265\340\244\202 \340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\250 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Modules)\n          </div>\n\n          {[\n            { id: \'dashboard\', label: \'1. \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\217\340\244\250\340\244\276\340\244\262\340\244\277\340\244\237\340\244\277\340\244\225\340\245\215\340\244\270\', icon: BarChart3, badge: \'Stats\' },\n            { id: \'creation\', label: \'2. \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\215\340\244\260\340\244\277\340\244\217\340\244\266\340\244\250 \340\244\265\340\244\277\340\244\234\340\244\276\340\244\260\340\245\215\340\244\241\', icon: PlusCircle, badge: \'5-Steps\' },\n            { id: \'templates\', label: \'3. \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270 \340\244\262\340\244\276\340\244\207\340\244\254\340\245\215\340\244\260\340\245\207\340\244\260\340\245\200\', icon: BookOpen, badge: \'10 Prebuilt\' },\n            { id: \'seo\', label: \'4. On-Page SEO \340\244\265 \340\244\260\340\245\210\340\244\202\340\244\225 \340\244\256\340\245\210\340\244\245\', icon: Search, badge: `${currentAudit.score}/100` },\n            { id: \'enhancer\', label: \'5. AI \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\217\340\244\250\340\245\215\340\244\271\340\244\276\340\244\202\340\244\270\340\244\260 (8 \340\244\237\340\245\202\340\244\262\340\245\215\340\244\270)\', icon: Zap, badge: \'AI Tools\' },\n            { id: \'scheduling\', label: \'6. \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\265 12-\340\244\252\340\245\215\340\244\265\340\244\276\340\244\207\340\244\202\340\244\237 \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\', icon: Calendar, badge: `${checklistCount}/12` },\n            { id: \'media\', label: \'7. \340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\265 \340\244\207\340\244\256\340\245\207\340\244\234 SEO (Alt Text)\', icon: ImageIcon, badge: \'WebP\' },\n            { id: \'revisions\', label: \'8. \340\244\221\340\244\237\340\245\213-\340\244\270\340\245\207\340\244\265 \340\244\265 \340\244\260\340\244\277\340\244\265\340\244\277\340\244\234\340\244\250 \340\244\241\340\244\277\340\244\253\', icon: History, badge: \'3 Saved\' },\n            { id: \'taxonomy\', label: \'9. \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 \340\244\217\340\244\265\340\244\202 \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270\', icon: Tag, badge: \'Taxonomy\' },\n            { id: \'roles\', label: \'10. \340\244\257\340\245\202\340\244\234\340\244\260 \340\244\260\340\245\213\340\244\262\340\245\215\340\244\270 \340\244\265 \340\244\265\340\244\260\340\245\215\340\244\225\340\244\253\340\245\215\340\244\262\340\245\213\', icon: Users, badge: \'RBAC\' },\n            { id: \'delete_module\', label: \'11. \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\265 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237\', icon: Trash2, badge: \'Safe\' },\n            { id: \'settings_help\', label: \'12. \340\244\266\340\245\211\340\244\260\340\245\215\340\244\237\340\244\225\340\244\237\340\245\215\340\244\270, \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 \340\244\265 \340\244\227\340\244\276\340\244\207\340\244\241\', icon: Settings, badge: \'Help\' }\n          ].map((item) => {\n            const Icon = item.icon;\n            const isActive = activeSection === item.id;\n            return (\n              <button\n                key={item.id}\n                type=\"button\"\n                onClick={() => setActiveSection(item.id as SuiteSection)}\n                className={`w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-bold transition-all text-left ${\n                  isActive\n                    ? \'bg-rose-600 text-white shadow-sm shadow-rose-900/20\'\n                    : \'text-gray-700 hover:bg-gray-200/70 hover:text-gray-900\'\n                }`}\n              >\n                <div className=\"flex items-center gap-2.5 truncate\">\n                  <Icon className={`w-4 h-4 shrink-0 ${isActive ? \'text-white\' : \'text-gray-500\'}`} />\n                  <span className=\"truncate\">{item.label}</span>\n                </div>\n                <span\n                  className={`text-[10px] px-1.5 py-0.5 rounded-md font-mono shrink-0 ${\n                    isActive ? \'bg-rose-700 text-white\' : \'bg-gray-200/80 text-gray-600\'\n                  }`}\n                >\n                  {item.badge}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Right Content Area (9 Cols) */}\n        <div className=\"lg:col-span-9 p-5 sm:p-7 bg-white overflow-y-auto\">\n          {/* =========================================================\n              VIEW 1: DASHBOARD & OVERVIEW (Module 4 & 9)\n             ========================================================= */}\n          {activeSection === \'dashboard\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <BarChart3 className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\246\340\244\260\340\245\215\340\244\266\340\244\250 \340\244\256\340\245\210\340\244\237\340\245\215\340\244\260\340\244\277\340\244\225\340\245\215\340\244\270</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\225\340\245\201\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\262\340\245\207\340\244\226, \340\244\224\340\244\270\340\244\244 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\227\340\244\243\340\244\250\340\244\276, \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\241\340\244\276\340\244\211\340\244\250 \340\244\217\340\244\265\340\244\202 \340\244\226\340\245\213\340\244\234 \340\244\260\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'creation\')}\n                  className=\"px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                >\n                  <PlusCircle className=\"w-3.5 h-3.5\" />\n                  <span>\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202</span>\n                </button>\n              </div>\n\n              {/* 8 Stats Grid */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">{articles.length}</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80\">\n                  <span className=\"text-[10px] font-bold text-emerald-700 uppercase\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Live)</span>\n                  <div className=\"text-xl font-black text-emerald-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'published\' || !a.status).length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/80\">\n                  <span className=\"text-[10px] font-bold text-amber-700 uppercase\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237\340\245\215\340\244\270 (Drafts)</span>\n                  <div className=\"text-xl font-black text-amber-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'draft\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-indigo-50/60 border border-indigo-200/80\">\n                  <span className=\"text-[10px] font-bold text-indigo-700 uppercase\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</span>\n                  <div className=\"text-xl font-black text-indigo-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'scheduled\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Words)</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">\n                    {articles.reduce((acc, a) => acc + (a.body?.join(\' \').split(/\\s+/).length || 650), 0).toLocaleString(\'hi-IN\')}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\224\340\244\270\340\244\244 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\227\340\244\243\340\244\250\340\244\276</span>\n                  <div className=\"text-xl font-black text-purple-700 mt-0.5\">1,120 \340\244\266\340\244\254\340\245\215\340\244\246</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200</span>\n                  <div className=\"text-base font-black text-rose-600 mt-0.5 truncate\">\340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 (National)</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\224\340\244\270\340\244\244 SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260</span>\n                  <div className=\"text-xl font-black text-emerald-600 mt-0.5\">88/100</div>\n                </div>\n              </div>\n\n              {/* Traffic & Search Analytics */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"p-4 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center justify-between\">\n                    <span>\340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\277\340\244\225 \340\244\206\340\244\202\340\244\225\340\244\241\340\244\274\340\245\207 (Traffic Stats)</span>\n                    <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\225\340\245\201\340\244\262 \340\244\252\340\245\207\340\244\234 \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274:</span>\n                      <span className=\"font-mono font-bold text-white\">4,82,900</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\265\340\244\277\340\244\266\340\244\277\340\244\267\340\245\215\340\244\237 \340\244\252\340\244\276\340\244\240\340\244\225 (Unique):</span>\n                      <span className=\"font-mono font-bold text-emerald-400\">1,94,200</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\224\340\244\270\340\244\244 \340\244\270\340\244\256\340\244\257 (Time on Page):</span>\n                      <span className=\"font-mono font-bold text-white\">3 \340\244\256\340\244\277\340\244\250\340\244\237 42 \340\244\270\340\245\207\340\244\225\340\244\202\340\244\241</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-zinc-400\">\340\244\254\340\244\276\340\244\211\340\244\202\340\244\270 \340\244\260\340\245\207\340\244\237 (Bounce Rate):</span>\n                      <span className=\"font-mono font-bold text-amber-400\">32.4% (Best)</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\241\340\244\276\340\244\211\340\244\250 (Device Share)\n                  </h4>\n                  <div className=\"space-y-2\">\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 (Mobile Devices)</span>\n                        <span>68%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-rose-600 h-2 rounded-full\" style={{ width: \'68%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\241\340\245\207\340\244\270\340\245\215\340\244\225\340\244\237\340\245\211\340\244\252 (Desktop / Laptops)</span>\n                        <span>28%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-indigo-600 h-2 rounded-full\" style={{ width: \'28%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\237\340\245\210\340\244\254\340\244\262\340\245\207\340\244\237 (Tablets)</span>\n                        <span>4%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-amber-600 h-2 rounded-full\" style={{ width: \'4%\' }} />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    \340\244\226\340\245\213\340\244\234 \340\244\260\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 (Google CTR & Rank)\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\224\340\244\270\340\244\244 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 (Position):</span>\n                      <span className=\"font-black text-emerald-600 font-mono\">#3.8</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\207\340\244\202\340\244\252\340\245\215\340\244\260\340\245\207\340\244\266\340\244\250 (Impressions):</span>\n                      <span className=\"font-mono font-bold text-gray-800\">12,40,000</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\245\340\245\215\340\244\260\340\245\202 \340\244\260\340\245\207\340\244\237 (CTR):</span>\n                      <span className=\"font-mono font-bold text-purple-600\">8.4%</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267 \340\244\226\340\245\213\340\244\234 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241:</span>\n                      <span className=\"font-bold text-rose-600 truncate max-w-[120px]\">\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 \340\244\256\340\244\277\340\244\266\340\244\250 2026</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Actions Bar */}\n              <div className=\"p-4 rounded-2xl bg-linear-to-r from-gray-50 via-rose-50/40 to-purple-50/40 border border-gray-200 flex flex-wrap items-center justify-between gap-3\">\n                <span className=\"text-xs font-bold text-gray-700\">\n                  \340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257 (Quick Actions):\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'creation\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-rose-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \342\236\225 New Article\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'templates\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-purple-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\216\250 Templates\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'seo\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-emerald-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\224\215 SEO Audit\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'scheduling\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-indigo-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\223\205 Schedule\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'enhancer\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-amber-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\252\204 AI Enhancer\n                  </button>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 2: ARTICLE CREATION WIZARD (Module 1)\n             ========================================================= */}\n          {activeSection === \'creation\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <PlusCircle className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\215\340\244\260\340\244\277\340\244\217\340\244\266\340\244\250 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (5-Step Creation Workflow)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\254\340\245\207\340\244\270\340\244\277\340\244\225 \340\244\207\340\244\250\340\245\215\340\244\253\340\245\213 \340\244\270\340\245\207 \340\244\262\340\245\207\340\244\225\340\244\260 \340\244\206\340\244\211\340\244\237\340\244\262\340\244\276\340\244\207\340\244\250, \340\244\265\340\244\260\340\245\215\340\244\241\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\256\340\245\207\340\244\237\340\244\276\340\244\241\340\245\207\340\244\237\340\244\276 \340\244\224\340\244\260 \340\244\260\340\245\207\340\244\241\340\245\200-\340\244\237\340\245\202-\340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266 HTML \340\244\234\340\244\250\340\244\260\340\245\207\340\244\266\340\244\250\n                  </p>\n                </div>\n\n                {/* Step Indicators */}\n                <div className=\"flex items-center gap-1\">\n                  {[1, 2, 3, 4, 5].map((s) => (\n                    <button\n                      key={s}\n                      type=\"button\"\n                      onClick={() => setCreationStep(s as any)}\n                      className={`w-7 h-7 rounded-lg text-xs font-bold flex items-center justify-center transition-all ${\n                        creationStep === s\n                          ? \'bg-rose-600 text-white shadow-xs scale-105\'\n                          : creationStep > s\n                          ? \'bg-emerald-100 text-emerald-800\'\n                          : \'bg-gray-100 text-gray-500\'\n                      }`}\n                    >\n                      {creationStep > s ? \'\342\234\223\' : s}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* STEP 1: GATHER BASIC INFO */}\n              {creationStep === 1 && (\n                <div className=\"space-y-4\">\n                  <div className=\"p-3 bg-rose-50 text-rose-900 rounded-xl text-xs font-bold flex items-center gap-2\">\n                    <span>\340\244\232\340\244\260\340\244\243 1:</span> \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 (Title, Topic, Keyword, Word Count, Tone & Audience)\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div className=\"sm:col-span-2\">\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Article Title - Required)*\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={createTitle}\n                        onChange={(e) => setCreateTitle(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold focus:border-rose-600\"\n                        placeholder=\"\340\244\211\340\244\246\340\244\276: 10 Best SEO Strategies in 2026...\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\265\340\244\277\340\244\267\340\244\257 / \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Topic / Niche - Required)*\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={createNiche}\n                        onChange={(e) => setCreateNiche(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\237\340\244\276\340\244\260\340\244\227\340\245\207\340\244\237 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 (Target Focus Keyword - Required)*\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={createKeyword}\n                        onChange={(e) => setCreateKeyword(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600 font-bold text-purple-700\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\265\340\244\276\340\244\202\340\244\233\340\244\277\340\244\244 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276 (Word Count: 1000-2500)*\n                      </label>\n                      <select\n                        value={createWordCount}\n                        onChange={(e) => setCreateWordCount(Number(e.target.value))}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold\"\n                      >\n                        <option value={800}>\340\244\262\340\244\230\340\245\201 (Short - 800 Words)</option>\n                        <option value={1200}>\340\244\256\340\244\276\340\244\250\340\244\225 (Standard - 1200 Words)</option>\n                        <option value={1500}>\340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 (Comprehensive - 1500 Words)</option>\n                        <option value={2500}>\340\244\205\340\244\262\340\245\215\340\244\237\340\245\200\340\244\256\340\245\207\340\244\237 \340\244\227\340\244\276\340\244\207\340\244\241 (Pillar - 2500+ Words)</option>\n                      </select>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\266\340\245\210\340\244\262\340\245\200 \340\244\265 \340\244\237\340\245\213\340\244\250 (Writing Tone)*\n                      </label>\n                      <select\n                        value={createTone}\n                        onChange={(e) => setCreateTone(e.target.value as any)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold\"\n                      >\n                        <option value=\"professional\">\340\244\252\340\245\207\340\244\266\340\245\207\340\244\265\340\244\260 (Professional & Formal)</option>\n                        <option value=\"conversational\">\340\244\270\340\244\202\340\244\265\340\244\276\340\244\246\340\244\276\340\244\244\340\245\215\340\244\256\340\244\225 (Conversational & Friendly)</option>\n                        <option value=\"technical\">\340\244\244\340\244\225\340\244\250\340\245\200\340\244\225\340\245\200 (Technical & In-depth)</option>\n                        <option value=\"beginner\">\340\244\266\340\245\201\340\244\260\340\245\201\340\244\206\340\244\244\340\245\200 (Beginner-Friendly & Simple)</option>\n                      </select>\n                    </div>\n\n                    <div className=\"sm:col-span-2\">\n                      <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                        \340\244\262\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\252\340\244\276\340\244\240\340\244\225 (Target Audience)\n                      </label>\n                      <input\n                        type=\"text\"\n                        value={createAudience}\n                        onChange={(e) => setCreateAudience(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"flex justify-end pt-4\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(2)}\n                      className=\"px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                    >\n                      <span>\340\244\205\340\244\227\340\244\262\340\244\276: \340\244\206\340\244\211\340\244\237\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202 (Next: Generate Outline)</span>\n                      <ChevronRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              )}\n\n              {/* STEP 2: OUTLINE STRUCTURE */}\n              {creationStep === 2 && (\n                <div className=\"space-y-4\">\n                  <div className=\"p-3 bg-purple-50 text-purple-900 rounded-xl text-xs font-bold flex items-center gap-2\">\n                    <span>\340\244\232\340\244\260\340\244\243 2:</span> \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\244\202\340\244\260\340\244\232\340\244\250\340\244\276 \340\244\217\340\244\265\340\244\202 H2/H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256\n                  </div>\n\n                  <div className=\"bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-2\">\n                    <div className=\"text-xs font-black text-gray-700\">\340\244\234\340\245\207\340\244\250\340\244\260\340\245\207\340\244\237\340\245\207\340\244\241 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\260\340\245\202\340\244\252\340\244\260\340\245\207\340\244\226\340\244\276 (Heading Outline):</div>\n                    {generatedOutline.map((item, idx) => (\n                      <div key={idx} className=\"flex items-center gap-2 bg-white p-2 rounded-xl border border-gray-200 text-xs\">\n                        <span className=\"w-6 h-6 rounded-md bg-gray-100 text-gray-600 font-mono text-[10px] flex items-center justify-center font-bold\">\n                          {idx + 1}\n                        </span>\n                        <input\n                          type=\"text\"\n                          value={item}\n                          onChange={(e) => {\n                            const copy = [...generatedOutline];\n                            copy[idx] = e.target.value;\n                            setGeneratedOutline(copy);\n                          }}\n                          className=\"flex-1 bg-transparent border-0 text-xs font-medium focus:outline-hidden\"\n                        />\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-4\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(1)}\n                      className=\"px-4 py-2 border border-gray-300 rounded-xl text-xs font-bold text-gray-700\"\n                    >\n                      \340\244\265\340\244\276\340\244\252\340\244\270 (Back)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(3)}\n                      className=\"px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                    >\n                      <span>\340\244\205\340\244\227\340\244\262\340\244\276: \340\244\265\340\244\260\340\245\215\340\244\241\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\256\340\245\207\340\244\237\340\244\276\340\244\241\340\245\207\340\244\237\340\244\276 (Next: WordPress Metadata)</span>\n                      <ChevronRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              )}\n\n              {/* STEP 3: WORDPRESS METADATA */}\n              {creationStep === 3 && (\n                <div className=\"space-y-4\">\n                  <div className=\"p-3 bg-blue-50 text-blue-900 rounded-xl text-xs font-bold flex items-center gap-2\">\n                    <span>\340\244\232\340\244\260\340\244\243 3:</span> \340\244\265\340\244\260\340\245\215\340\244\241\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\217\340\244\270\340\244\210\340\244\223 \340\244\256\340\245\207\340\244\237\340\244\276\340\244\241\340\245\207\340\244\237\340\244\276 (Meta Title, Description, Slug & Tags)\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    <div>\n                      <div className=\"flex justify-between text-xs font-bold text-gray-700 mb-1\">\n                        <span>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\237\340\244\276\340\244\207\340\244\237\340\244\262 (Meta Title: 55-60 Chars)*</span>\n                        <span className={createMetaTitle.length > 60 ? \'text-rose-600\' : \'text-emerald-600 font-mono\'}>\n                          {createMetaTitle.length}/60 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\256\n                        </span>\n                      </div>\n                      <input\n                        type=\"text\"\n                        value={createMetaTitle}\n                        onChange={(e) => setCreateMetaTitle(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold focus:border-rose-600\"\n                      />\n                    </div>\n\n                    <div>\n                      <div className=\"flex justify-between text-xs font-bold text-gray-700 mb-1\">\n                        <span>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 (Meta Description: 150-160 Chars)*</span>\n                        <span className={createMetaDesc.length > 160 ? \'text-rose-600\' : \'text-emerald-600 font-mono\'}>\n                          {createMetaDesc.length}/160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\256\n                        </span>\n                      </div>\n                      <textarea\n                        rows={2}\n                        value={createMetaDesc}\n                        onChange={(e) => setCreateMetaDesc(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600\"\n                      />\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                      <div>\n                        <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                          URL \340\244\270\340\245\215\340\244\262\340\244\227 (SEO Friendly Slug)\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={createSlug}\n                          onChange={(e) => setCreateSlug(e.target.value)}\n                          className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-mono\"\n                        />\n                      </div>\n\n                      <div>\n                        <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                          \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Category)\n                        </label>\n                        <select\n                          value={createCategory}\n                          onChange={(e) => setCreateCategory(e.target.value)}\n                          className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold\"\n                        >\n                          {CATEGORIES.map((c) => (\n                            <option key={c.id} value={c.slug}>\n                              {c.nameHi} ({c.nameEn})\n                            </option>\n                          ))}\n                        </select>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-4\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(2)}\n                      className=\"px-4 py-2 border border-gray-300 rounded-xl text-xs font-bold text-gray-700\"\n                    >\n                      \340\244\265\340\244\276\340\244\252\340\244\270 (Back)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(4)}\n                      className=\"px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                    >\n                      <span>\340\244\205\340\244\227\340\244\262\340\244\276: \340\244\265\340\244\260\340\245\215\340\244\241\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 HTML \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 (Next: Generate HTML)</span>\n                      <ChevronRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              )}\n\n              {/* STEP 4: WORDPRESS-READY HTML CONTENT */}\n              {creationStep === 4 && (\n                <div className=\"space-y-4\">\n                  <div className=\"p-3 bg-emerald-50 text-emerald-900 rounded-xl text-xs font-bold flex items-center justify-between\">\n                    <span>\340\244\232\340\244\260\340\244\243 4: \340\244\265\340\244\260\340\245\215\340\244\241\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\260\340\245\207\340\244\241\340\245\200 HTML \340\244\252\340\245\215\340\244\260\340\244\276\340\244\260\340\245\202\340\244\252 (Gutenberg / Classic Compatible)</span>\n                    <button\n                      type=\"button\"\n                      onClick={() => triggerCopy(generatedHtml, \'html-code\')}\n                      className=\"px-2.5 py-1 bg-white text-emerald-800 rounded-lg text-xs font-bold shadow-2xs flex items-center gap-1\"\n                    >\n                      {copiedKey === \'html-code\' ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                      <span>{copiedKey === \'html-code\' ? \'\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276\' : \'HTML \340\244\225\340\245\211\340\244\252\340\245\200 \340\244\225\340\244\260\340\245\207\340\244\202\'}</span>\n                    </button>\n                  </div>\n\n                  <div className=\"bg-zinc-950 rounded-2xl p-4 text-zinc-200 font-mono text-xs overflow-x-auto max-h-80 border border-zinc-800\">\n                    <pre className=\"whitespace-pre-wrap\">{generatedHtml}</pre>\n                  </div>\n\n                  <div className=\"flex items-center justify-between pt-4\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(3)}\n                      className=\"px-4 py-2 border border-gray-300 rounded-xl text-xs font-bold text-gray-700\"\n                    >\n                      \340\244\265\340\244\276\340\244\252\340\244\270 (Back)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(5)}\n                      className=\"px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                    >\n                      <span>\340\244\205\340\244\227\340\244\262\340\244\276: \340\244\270\340\244\244\340\245\215\340\244\257\340\244\276\340\244\252\340\244\250 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 (Next: Validation & Publish)</span>\n                      <ChevronRight className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              )}\n\n              {/* STEP 5: VALIDATION CHECKLIST & PUBLISH */}\n              {creationStep === 5 && (\n                <div className=\"space-y-5\">\n                  <div className=\"p-3 bg-indigo-50 text-indigo-900 rounded-xl text-xs font-bold\">\n                    \340\244\232\340\244\260\340\244\243 5: \340\244\205\340\244\202\340\244\244\340\244\277\340\244\256 \340\244\270\340\244\244\340\245\215\340\244\257\340\244\276\340\244\252\340\244\250 \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237 (Validation Checklist & Publishing)\n                  </div>\n\n                  <div className=\"bg-gray-50 rounded-2xl p-4 border border-gray-200 space-y-2 text-xs\">\n                    <div className=\"flex items-center gap-2 font-bold text-emerald-700\">\n                      <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      <span>\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\206\340\244\225\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\271\340\245\210 \340\244\224\340\244\260 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\266\340\244\276\340\244\256\340\244\277\340\244\262 \340\244\271\340\245\210</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 font-bold text-emerald-700\">\n                      <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      <span>\340\244\211\340\244\232\340\244\277\340\244\244 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256 (H2, H3) \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\271\340\245\210</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 font-bold text-emerald-700\">\n                      <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      <span>\340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 60+ (\340\244\270\340\244\260\340\244\262 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\255\340\244\276\340\244\265\340\245\200 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257)</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 font-bold text-emerald-700\">\n                      <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      <span>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\237\340\244\276\340\244\207\340\244\237\340\244\262 (55-60) \340\244\265 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (150-160) \340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\271\340\245\210</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 font-bold text-emerald-700\">\n                      <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                      <span>\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 \340\244\265 \340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 \340\244\270\340\244\256\340\245\215\340\244\256\340\244\277\340\244\262\340\244\277\340\244\244</span>\n                    </div>\n                  </div>\n\n                  <div className=\"p-4 bg-amber-50/80 rounded-2xl border border-amber-200 text-xs text-amber-900 flex items-center justify-between\">\n                    <div>\n                      <strong>\340\244\225\340\245\215\340\244\257\340\244\276 \340\244\206\340\244\252 \340\244\270\340\245\200\340\244\247\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\257\340\244\276 \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\202\340\244\266\340\245\213\340\244\247\340\244\277\340\244\244 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?</strong>\n                      <div className=\"text-[11px] text-amber-700 mt-0.5\">\n                        \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 \340\244\252\340\244\260 \340\244\234\340\245\213\340\244\241\340\244\274\340\244\276 \340\244\234\340\244\276\340\244\217\340\244\227\340\244\276 \340\244\224\340\244\260 \340\244\241\340\245\207\340\244\237\340\244\276\340\244\254\340\245\207\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\260\340\244\271\340\245\207\340\244\227\340\244\276\340\245\244\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex flex-wrap items-center justify-between gap-3 pt-3\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setCreationStep(4)}\n                      className=\"px-4 py-2 border border-gray-300 rounded-xl text-xs font-bold text-gray-700\"\n                    >\n                      \340\244\265\340\244\276\340\244\252\340\244\270 (Back)\n                    </button>\n\n                    <div className=\"flex gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          onCreateArticle({\n                            title: createTitle,\n                            categorySlug: createCategory,\n                            focusKeyword: createKeyword,\n                            metaTitle: createMetaTitle,\n                            metaDescription: createMetaDesc,\n                            slug: createSlug,\n                            tags: createTags,\n                            body: generatedHtml.split(\'\\n\\n\').filter(Boolean),\n                            status: \'draft\'\n                          });\n                          showNotice(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\265 \340\244\271\340\245\201\340\244\206!\');\n                        }}\n                        className=\"px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-xs\"\n                      >\n                        \360\237\222\276 \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\245\207\340\244\265 \340\244\225\340\244\260\340\245\207\340\244\202 (Save Draft)\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          onSaveArticle({\n                            title: createTitle,\n                            categorySlug: createCategory,\n                            focusKeyword: createKeyword,\n                            metaTitle: createMetaTitle,\n                            metaDescription: createMetaDesc,\n                            slug: createSlug,\n                            tags: createTags,\n                            body: generatedHtml.split(\'\\n\\n\').filter(Boolean),\n                            status: \'published\'\n                          });\n                          showNotice(\'\360\237\216\211 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Published) \340\244\271\340\245\201\340\244\206!\');\n                        }}\n                        className=\"px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs flex items-center gap-1.5\"\n                      >\n                        <Send className=\"w-4 h-4\" />\n                        <span>\340\244\270\340\245\200\340\244\247\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish Now)</span>\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 3: CONTENT TEMPLATES LIBRARY (Module 11)\n             ========================================================= */}\n          {activeSection === \'templates\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <BookOpen className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270 \340\244\262\340\244\276\340\244\207\340\244\254\340\245\215\340\244\260\340\245\207\340\244\260\340\245\200 (10 Pre-built Structures)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    How-To \340\244\227\340\244\276\340\244\207\340\244\241, \340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262, \340\244\244\340\245\201\340\244\262\340\244\250\340\244\276\340\244\244\340\245\215\340\244\256\340\244\225 \340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276, \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274, \340\244\225\340\245\207\340\244\270 \340\244\270\340\245\215\340\244\237\340\244\241\340\245\200\340\244\234 \340\244\265 \340\244\205\340\244\262\340\245\215\340\244\237\340\245\200\340\244\256\340\245\207\340\244\237 \340\244\227\340\244\276\340\244\207\340\244\241\340\245\215\340\244\270\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                {TEMPLATES.map((tmpl) => (\n                  <div\n                    key={tmpl.id}\n                    className=\"p-4 rounded-2xl border border-gray-200/90 hover:border-rose-400 bg-white hover:shadow-md transition-all flex flex-col justify-between space-y-3\"\n                  >\n                    <div>\n                      <div className=\"flex items-center gap-2 mb-1.5\">\n                        <span className=\"text-xl\">{tmpl.icon}</span>\n                        <h4 className=\"font-bold text-sm text-gray-900\">{tmpl.title}</h4>\n                      </div>\n                      <p className=\"text-xs text-gray-500 leading-relaxed\">{tmpl.desc}</p>\n                      <div className=\"mt-3 p-2.5 bg-gray-50 rounded-xl text-[11px] text-gray-700 font-mono\">\n                        {tmpl.suggestedTitle}\n                      </div>\n                    </div>\n\n                    <div className=\"pt-2 border-t border-gray-100 flex items-center justify-between\">\n                      <span className=\"text-[11px] text-gray-400 font-semibold\">\n                        {tmpl.outline.length} \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\270\340\245\207\340\244\225\340\245\215\340\244\266\340\244\250\340\245\215\340\244\270\n                      </span>\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          onCreateArticle({\n                            title: tmpl.suggestedTitle,\n                            body: tmpl.outline.map((h) => `${h}\\n\\n\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\224\340\244\260 \340\244\244\340\244\245\340\245\215\340\244\257 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244`),\n                            status: \'draft\'\n                          });\n                          showNotice(`\340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237 \"${tmpl.title}\" \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\262\340\245\213\340\244\241 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276!`);\n                        }}\n                        className=\"px-3 py-1.5 bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white font-bold text-xs rounded-xl transition-colors\"\n                      >\n                        \340\244\257\340\244\271 \340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202 \342\206\222\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 4: SEO OPTIMIZATION MODULE (Module 5)\n             ========================================================= */}\n          {activeSection === \'seo\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Search className=\"w-5 h-5 text-emerald-600\" />\n                    <span>On-Page SEO \340\244\265 \340\244\260\340\245\210\340\244\202\340\244\225 \340\244\256\340\245\210\340\244\245 \340\244\221\340\244\241\340\244\277\340\244\237\340\244\260 (Rank Math / Yoast Compliant)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\252\340\245\215\340\244\262\340\245\207\340\244\270\340\244\256\340\245\207\340\244\202\340\244\237, \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250, H1/H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\217\340\244\265\340\244\202 \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"text-right\">\n                    <div className=\"text-[10px] text-gray-400 uppercase font-bold\">SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260</div>\n                    <div className=\"text-xl font-black text-emerald-600\">{currentAudit.score}/100</div>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      showNotice(\'\340\244\270\340\244\255\340\245\200 \340\244\270\340\244\202\340\244\255\340\244\276\340\244\265\340\244\277\340\244\244 SEO \340\244\270\340\245\201\340\244\247\340\244\276\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\262\340\244\276\340\244\227\340\245\202 \340\244\225\340\244\277\340\244\217 \340\244\227\340\244\217!\');\n                    }}\n                    className=\"px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs\"\n                  >\n                    \342\232\241 Auto-Fix All Issues\n                  </button>\n                </div>\n              </div>\n\n              {/* Checklist Breakdown */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                {/* 1. Title Tag & Meta */}\n                <div className=\"p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-2 text-xs\">\n                  <div className=\"font-bold text-gray-900 flex items-center gap-2\">\n                    <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                    <span>\340\244\237\340\244\276\340\244\207\340\244\237\340\244\262 \340\244\217\340\244\265\340\244\202 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 (Title & Meta)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\262\340\244\202\340\244\254\340\244\276\340\244\210 (Title Length):</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">\n                      {activeArticle.title?.length || 58} \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260 (Optimal 55-60)\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\256\340\245\207\340\244\202 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241:</span>\n                    <span className=\"font-bold text-emerald-700\">\340\244\271\340\244\276\340\244\201 (\340\244\266\340\245\201\340\244\260\340\245\201\340\244\206\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\256\340\245\214\340\244\234\340\245\202\340\244\246 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description):</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">154 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260 (Target 150-160 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1\">\n                    <span className=\"text-gray-600\">\340\244\225\340\245\211\340\244\262-\340\244\237\340\245\202-\340\244\217\340\244\225\340\245\215\340\244\266\340\244\250 (CTA) \340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244:</span>\n                    <span className=\"font-bold text-emerald-700\">\340\244\271\340\244\276\340\244\201 \342\234\223</span>\n                  </div>\n                </div>\n\n                {/* 2. Content Analysis */}\n                <div className=\"p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-2 text-xs\">\n                  <div className=\"font-bold text-gray-900 flex items-center gap-2\">\n                    <span className=\"w-2 h-2 rounded-full bg-purple-500\" />\n                    <span>\340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200 (Content & Keywords)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Word Count):</span>\n                    <span className=\"font-bold text-gray-900 font-mono\">1,480 \340\244\266\340\244\254\340\245\215\340\244\246 (Target: 1000+ \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200:</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">1.1% (Target: 0.5-1.5% \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\256\340\245\207\340\244\202 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241:</span>\n                    <span className=\"font-bold text-emerald-700\">\340\244\271\340\244\276\340\244\201 (2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\211\340\244\252\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1\">\n                    <span className=\"text-gray-600\">Flesch Reading Ease:</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">74/100 (\340\244\206\340\244\270\340\244\276\340\244\250 \340\244\265 \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257 \342\234\223)</span>\n                  </div>\n                </div>\n\n                {/* 3. Heading Structure */}\n                <div className=\"p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-2 text-xs\">\n                  <div className=\"font-bold text-gray-900 flex items-center gap-2\">\n                    <span className=\"w-2 h-2 rounded-full bg-blue-500\" />\n                    <span>\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256 (Headings Hierarchy)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">H1 \340\244\237\340\245\210\340\244\227 \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276:</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">1 (Strictly 1 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">H2 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\226\340\244\202\340\244\241:</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">6 \340\244\226\340\244\202\340\244\241 (Recommended 5-8 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1\">\n                    <span className=\"text-gray-600\">H3 \340\244\211\340\244\252\340\244\226\340\244\202\340\244\241:</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">5 \340\244\211\340\244\252\340\244\226\340\244\202\340\244\241 \342\234\223</span>\n                  </div>\n                </div>\n\n                {/* 4. Images & Links */}\n                <div className=\"p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-2 text-xs\">\n                  <div className=\"font-bold text-gray-900 flex items-center gap-2\">\n                    <span className=\"w-2 h-2 rounded-full bg-amber-500\" />\n                    <span>\340\244\207\340\244\256\340\245\207\340\244\234\340\245\207\340\244\270 \340\244\265 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 (Images & Links)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 (Alt Text) \340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\207\340\244\256\340\245\207\340\244\234\340\245\207\340\244\270:</span>\n                    <span className=\"font-bold text-emerald-700\">100% (\340\244\270\340\244\255\340\245\200 \340\244\207\340\244\256\340\245\207\340\244\234\340\245\207\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\256\340\245\214\340\244\234\340\245\202\340\244\246 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1 border-b border-gray-200\">\n                    <span className=\"text-gray-600\">\340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 (Internal Links):</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">4 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 (Target: 3-5 \342\234\223)</span>\n                  </div>\n                  <div className=\"flex justify-between py-1\">\n                    <span className=\"text-gray-600\">\340\244\252\340\245\215\340\244\260\340\244\276\340\244\256\340\244\276\340\244\243\340\244\277\340\244\225 \340\244\254\340\244\276\340\244\271\340\244\260\340\245\200 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 (External Links):</span>\n                    <span className=\"font-bold text-emerald-700 font-mono\">2 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 \342\234\223</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 5: AI CONTENT ENHANCER (Module 19)\n             ========================================================= */}\n          {activeSection === \'enhancer\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Zap className=\"w-5 h-5 text-amber-500\" />\n                    <span>AI \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\217\340\244\250\340\245\215\340\244\271\340\244\276\340\244\202\340\244\270\340\244\260 (Intelligent Content Improvements)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\271\340\245\207\340\244\241\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\221\340\244\252\340\245\215\340\244\237\340\244\277\340\244\256\340\244\276\340\244\207\340\244\234\340\244\274\340\244\260, \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\217\340\244\225\340\245\215\340\244\270\340\244\252\340\245\210\340\244\202\340\244\241\340\244\260, \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\201\340\244\247\340\244\276\340\244\260\340\244\225, \340\244\265\340\245\215\340\244\257\340\244\276\340\244\225\340\244\260\340\244\243 \340\244\265 \340\244\270\340\244\276\340\244\271\340\244\277\340\244\244\340\245\215\340\244\257\340\244\277\340\244\225 \340\244\232\340\245\213\340\244\260\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232\n                  </p>\n                </div>\n              </div>\n\n              {/* Enhancer Tool Pills */}\n              <div className=\"flex flex-wrap gap-2\">\n                {[\n                  { id: \'headlines\', label: \'\360\237\224\245 5 \340\244\271\340\245\207\340\244\241\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\265\340\244\277\340\244\225\340\244\262\340\245\215\340\244\252 (Headlines)\' },\n                  { id: \'expander\', label: \'\360\237\223\226 \340\244\252\340\245\210\340\244\260\340\244\276\340\244\227\340\245\215\340\244\260\340\244\276\340\244\253 \340\244\217\340\244\225\340\245\215\340\244\270\340\244\252\340\245\210\340\244\202\340\244\241\340\244\260 (Expander)\' },\n                  { id: \'readability\', label: \'\342\234\250 \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\201\340\244\247\340\244\276\340\244\260\340\244\225 (Readability)\' },\n                  { id: \'grammar\', label: \'\342\234\215\357\270\217 \340\244\265\340\245\215\340\244\257\340\244\276\340\244\225\340\244\260\340\244\243 \340\244\265 \340\244\270\340\245\215\340\244\252\340\245\207\340\244\262 \340\244\232\340\245\207\340\244\225 (Grammar)\' },\n                  { id: \'tone\', label: \'\360\237\216\255 \340\244\237\340\245\213\340\244\250 \340\244\217\340\244\241\340\244\234\340\244\270\340\245\215\340\244\237\340\244\260 (Tone)\' },\n                  { id: \'plagiarism\', label: \'\360\237\233\241\357\270\217 \340\244\256\340\245\214\340\244\262\340\244\277\340\244\225\340\244\244\340\244\276 \340\244\234\340\244\276\340\244\202\340\244\232 (Plagiarism)\' }\n                ].map((t) => (\n                  <button\n                    key={t.id}\n                    type=\"button\"\n                    onClick={() => {\n                      setEnhancerTool(t.id as any);\n                      runEnhancer(t.id);\n                    }}\n                    className={`px-3 py-2 rounded-xl text-xs font-bold transition-colors ${\n                      enhancerTool === t.id\n                        ? \'bg-amber-500 text-white shadow-xs\'\n                        : \'bg-gray-100 text-gray-700 hover:bg-gray-200\'\n                    }`}\n                  >\n                    {t.label}\n                  </button>\n                ))}\n              </div>\n\n              {/* Input Box */}\n              <div>\n                <label className=\"block text-xs font-bold text-gray-700 mb-1\">\n                  \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\271\340\245\207\340\244\244\340\245\201 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 / \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Input Text):\n                </label>\n                <div className=\"flex gap-2\">\n                  <input\n                    type=\"text\"\n                    value={enhancerInput}\n                    onChange={(e) => setEnhancerInput(e.target.value)}\n                    className=\"flex-1 px-3.5 py-2.5 rounded-xl border border-gray-300 text-xs font-semibold focus:border-amber-500\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => runEnhancer(enhancerTool)}\n                    className=\"px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl shadow-xs shrink-0 flex items-center gap-1.5\"\n                  >\n                    <Sparkles className=\"w-3.5 h-3.5\" />\n                    <span>{isEnhancing ? \'\340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243...\' : \'AI \340\244\270\340\245\207 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\270\340\245\207\340\244\270 \340\244\225\340\244\260\340\245\207\340\244\202\'}</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Result Area */}\n              {enhancedResult && (\n                <div className=\"bg-amber-50/60 border border-amber-200/80 rounded-2xl p-5 space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-black text-amber-900 flex items-center gap-1.5\">\n                      <Sparkles className=\"w-4 h-4 text-amber-600\" />\n                      <span>AI \340\244\270\340\244\202\340\244\265\340\244\260\340\245\215\340\244\247\340\244\277\340\244\244 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 (Generated Enhancement):</span>\n                    </span>\n                    <button\n                      type=\"button\"\n                      onClick={() => triggerCopy(enhancedResult, \'enhancer-res\')}\n                      className=\"text-xs font-bold text-amber-800 hover:underline flex items-center gap-1\"\n                    >\n                      {copiedKey === \'enhancer-res\' ? <Check className=\"w-3 h-3\" /> : <Copy className=\"w-3 h-3\" />}\n                      <span>{copiedKey === \'enhancer-res\' ? \'\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276\' : \'\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\225\340\244\260\340\245\207\340\244\202\'}</span>\n                    </button>\n                  </div>\n                  <div className=\"text-xs text-gray-800 leading-relaxed font-sans whitespace-pre-wrap bg-white p-4 rounded-xl border border-amber-100 shadow-2xs\">\n                    {enhancedResult}\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 6: SCHEDULING & PUBLISHING (Module 6)\n             ========================================================= */}\n          {activeSection === \'scheduling\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Calendar className=\"w-5 h-5 text-indigo-600\" />\n                    <span>\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\217\340\244\265\340\244\202 \340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266\340\244\277\340\244\202\340\244\227 \340\244\265\340\244\260\340\245\215\340\244\225\340\244\253\340\244\274\340\245\215\340\244\262\340\245\213 (Scheduling & 12-Point Checklist)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\244\340\244\244\340\245\215\340\244\225\340\244\276\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250, \340\244\255\340\244\265\340\244\277\340\244\267\340\245\215\340\244\257 \340\244\271\340\245\207\340\244\244\340\245\201 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\217\340\244\265\340\244\202 12-\340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\252\340\245\215\340\244\260\340\245\200-\340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266 \340\244\244\340\244\244\340\245\215\340\244\252\340\244\260\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\n                  </p>\n                </div>\n                <div className=\"px-3 py-1 bg-indigo-50 text-indigo-700 rounded-xl text-xs font-black\">\n                  \340\244\244\340\244\244\340\245\215\340\244\252\340\244\260\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260: {checklistCount}/12 \342\234\223\n                </div>\n              </div>\n\n              {/* Status Radio Options */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                {[\n                  { id: \'publish\', label: \'\340\244\244\340\244\244\340\245\215\340\244\225\340\244\276\340\244\262 \340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266 (Immediate Public)\', desc: \'\340\244\270\340\245\200\340\244\247\340\245\207 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 \340\244\252\340\244\260\' },\n                  { id: \'schedule\', label: \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 (Schedule for Later)\', desc: \'\340\244\250\340\244\277\340\244\260\340\245\215\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 \340\244\244\340\244\277\340\244\245\340\244\277 \340\244\265 \340\244\270\340\244\256\340\244\257\' },\n                  { id: \'draft\', label: \'\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 (Save as Draft)\', desc: \'\340\244\225\340\245\207\340\244\265\340\244\262 \340\244\254\340\245\210\340\244\225\340\244\217\340\244\202\340\244\241 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244\' },\n                  { id: \'private\', label: \'\340\244\252\340\245\215\340\244\260\340\244\276\340\244\207\340\244\265\340\245\207\340\244\237 (Only Admins)\', desc: \'\340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\227\340\245\201\340\244\252\340\245\215\340\244\244\' }\n                ].map((st) => (\n                  <button\n                    key={st.id}\n                    type=\"button\"\n                    onClick={() => setScheduleStatus(st.id as any)}\n                    className={`p-3 rounded-2xl border text-left transition-all ${\n                      scheduleStatus === st.id\n                        ? \'bg-indigo-50/80 border-indigo-500 text-indigo-950 ring-2 ring-indigo-200\'\n                        : \'bg-white border-gray-200 text-gray-700 hover:bg-gray-50\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-xs\">{st.label}</div>\n                    <div className=\"text-[10px] text-gray-500 mt-0.5\">{st.desc}</div>\n                  </button>\n                ))}\n              </div>\n\n              {/* Schedule Date & Time Controls */}\n              {scheduleStatus === \'schedule\' && (\n                <div className=\"p-4 rounded-2xl bg-indigo-50/50 border border-indigo-200 space-y-3\">\n                  <div className=\"text-xs font-bold text-indigo-900\">\340\244\255\340\244\265\340\244\277\340\244\267\340\245\215\340\244\257 \340\244\225\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257 \340\244\232\340\245\201\340\244\250\340\245\207\340\244\202:</div>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div>\n                      <label className=\"block text-[11px] font-bold text-gray-600 mb-1\">\340\244\246\340\244\277\340\244\250\340\244\276\340\244\202\340\244\225 (Date)</label>\n                      <input\n                        type=\"date\"\n                        value={scheduleDate}\n                        onChange={(e) => setScheduleDate(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-bold bg-white\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[11px] font-bold text-gray-600 mb-1\">\340\244\270\340\244\256\340\244\257 (Time - IST)</label>\n                      <input\n                        type=\"time\"\n                        value={scheduleTime}\n                        onChange={(e) => setScheduleTime(e.target.value)}\n                        className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-bold bg-white\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"text-[11px] text-indigo-700\">\n                    \360\237\222\241 <strong>\340\244\270\340\244\260\340\245\215\340\244\265\340\245\213\340\244\244\340\245\215\340\244\244\340\244\256 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\270\340\244\256\340\244\257 (Best Times):</strong> \340\244\256\340\244\202\340\244\227\340\244\262\340\244\265\340\244\276\340\244\260 - \340\244\227\340\245\201\340\244\260\340\245\201\340\244\265\340\244\276\340\244\260, \340\244\270\340\245\201\340\244\254\340\244\271 9 \340\244\270\340\245\207 11 \340\244\254\340\244\234\340\245\207 \340\244\257\340\244\276 \340\244\246\340\245\213\340\244\252\340\244\271\340\244\260 2 \340\244\270\340\245\207 4 \340\244\254\340\244\234\340\245\207 (\340\244\211\340\244\232\340\245\215\340\244\232\340\244\244\340\244\256 \340\244\252\340\244\276\340\244\240\340\244\225 \340\244\270\340\244\271\340\244\255\340\244\276\340\244\227\340\244\277\340\244\244\340\244\276)\n                  </div>\n                </div>\n              )}\n\n              {/* 12-Point Checklist Grid */}\n              <div>\n                <h4 className=\"text-xs font-black text-gray-900 uppercase tracking-wider mb-2.5\">\n                  12-\340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\252\340\245\215\340\244\260\340\245\200-\340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266 \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237 (Pre-Publish Checklist)\n                </h4>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n                  {Object.entries({\n                    titleCompelling: \'\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\205\340\244\202\340\244\244\340\244\277\340\244\256 \340\244\260\340\245\202\340\244\252 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\256\340\245\214\340\244\234\340\245\202\340\244\246\',\n                    contentProofread: \'\340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\252\340\245\215\340\244\260\340\245\202\340\244\253\340\244\260\340\245\200\340\244\241 \340\244\265 \340\244\265\340\244\260\340\245\215\340\244\244\340\244\250\340\245\200 \340\244\244\340\245\215\340\244\260\340\245\201\340\244\237\340\244\277\340\244\260\340\244\271\340\244\277\340\244\244\',\n                    imagesOptimized: \'\340\244\207\340\244\256\340\245\207\340\244\234\340\245\207\340\244\270 \340\244\225\340\244\202\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\265 WebP \340\244\256\340\245\207\340\244\202 \340\244\205\340\244\250\340\245\201\340\244\225\340\245\202\340\244\262\340\244\277\340\244\244\',\n                    metaDescWritten: \'\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 (150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260) \340\244\262\340\244\277\340\244\226\340\244\276 \340\244\227\340\244\257\340\244\276\',\n                    categoriesAssigned: \'\340\244\211\340\244\232\340\244\277\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\265 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 \340\244\205\340\244\270\340\244\276\340\244\207\340\244\250 \340\244\225\340\244\277\340\244\217 \340\244\227\340\244\217\',\n                    featuredImageSet: \'\340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 (1200x630px) \340\244\250\340\244\277\340\244\260\340\245\215\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244\',\n                    seoAcceptable: \'SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 70+ \340\244\270\340\245\207 \340\244\205\340\244\247\340\244\277\340\244\225 \340\244\270\340\245\215\340\244\265\340\245\200\340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\',\n                    internalLinksAdded: \'3-5 \340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207 \340\244\227\340\244\217\',\n                    externalLinksVerified: \'\340\244\265\340\244\277\340\244\266\340\245\215\340\244\265\340\244\270\340\244\250\340\245\200\340\244\257 \340\244\254\340\244\276\340\244\271\340\244\260\340\245\200 \340\244\270\340\245\215\340\244\260\340\245\213\340\244\244 \340\244\270\340\244\244\340\245\215\340\244\257\340\244\276\340\244\252\340\244\277\340\244\244\',\n                    mobilePreviewChecked: \'\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260 \340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\276\340\244\265\340\244\262\340\245\213\340\244\225\340\244\250 \340\244\240\340\245\200\340\244\225\',\n                    excerptCreated: \'\340\244\270\340\244\202\340\244\225\340\245\215\340\244\267\340\244\277\340\244\252\340\245\215\340\244\244 \340\244\205\340\244\202\340\244\266 (Excerpt) \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260\',\n                    authorAssigned: \'\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225 / \340\244\262\340\245\207\340\244\226\340\244\225 \340\244\225\340\244\276 \340\244\250\340\244\276\340\244\256 \340\244\246\340\244\260\340\245\215\340\244\234\'\n                  }).map(([key, label]) => {\n                    const isChecked = checklist[key as keyof typeof checklist];\n                    return (\n                      <button\n                        key={key}\n                        type=\"button\"\n                        onClick={() =>\n                          setChecklist((prev) => ({\n                            ...prev,\n                            [key]: !prev[key as keyof typeof checklist]\n                          }))\n                        }\n                        className={`flex items-center gap-2 p-2.5 rounded-xl border text-left text-xs transition-colors ${\n                          isChecked\n                            ? \'bg-emerald-50/60 border-emerald-200 text-emerald-900\'\n                            : \'bg-white border-gray-200 text-gray-600\'\n                        }`}\n                      >\n                        <CheckCircle2\n                          className={`w-4 h-4 shrink-0 ${isChecked ? \'text-emerald-600\' : \'text-gray-300\'}`}\n                        />\n                        <span className=\"font-semibold\">{label}</span>\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Publish Action Button */}\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    showNotice(\n                      scheduleStatus === \'schedule\'\n                        ? `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 ${scheduleDate} \340\244\225\340\245\213 ${scheduleTime} \340\244\254\340\244\234\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!`\n                        : \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\201\340\244\206!\'\n                    );\n                  }}\n                  className=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs flex items-center gap-2\"\n                >\n                  <Send className=\"w-4 h-4\" />\n                  <span>\n                    {scheduleStatus === \'schedule\' ? \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Confirm Schedule)\' : \'\340\244\205\340\244\255\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Confirm Publish)\'}\n                  </span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 7: MEDIA & IMAGE MANAGEMENT (Module 8)\n             ========================================================= */}\n          {activeSection === \'media\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <ImageIcon className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\265 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 (Upload, Alt Text & Optimization)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 WebP \340\244\260\340\245\202\340\244\252\340\244\276\340\244\202\340\244\244\340\244\260\340\244\243, 1200x630px \340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\217\340\244\265\340\244\202 \340\244\260\340\245\211\340\244\257\340\244\262\340\245\215\340\244\237\340\245\200-\340\244\253\340\245\215\340\244\260\340\245\200 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\225 \340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276\n                  </p>\n                </div>\n              </div>\n\n              {/* Upload Box Simulation */}\n              <div className=\"border-2 border-dashed border-gray-300 rounded-3xl p-6 text-center hover:border-rose-400 bg-gray-50/60 transition-colors\">\n                <div className=\"w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-2\">\n                  <ImageIcon className=\"w-6 h-6\" />\n                </div>\n                <div className=\"text-xs font-bold text-gray-900\">\n                  \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\241\340\245\215\340\244\260\340\245\210\340\244\227 \340\244\265 \340\244\241\340\245\215\340\244\260\340\245\211\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 \340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\225\340\244\260\340\244\225\340\245\207 \340\244\205\340\244\252\340\244\262\340\245\213\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202\n                </div>\n                <div className=\"text-[11px] text-gray-500 mt-0.5\">\n                  \340\244\205\340\244\247\340\244\277\340\244\225\340\244\244\340\244\256 2MB \342\200\242 JPG, PNG, WebP \342\200\242 \340\244\205\340\244\250\340\245\201\340\244\266\340\244\202\340\244\270\340\244\277\340\244\244 \340\244\205\340\244\250\340\245\201\340\244\252\340\244\276\340\244\244 16:9 \340\244\257\340\244\276 1200x630\n                </div>\n\n                {/* Auto Optimization Toggles */}\n                <div className=\"flex flex-wrap items-center justify-center gap-4 mt-4 pt-3 border-t border-gray-200/80 text-xs\">\n                  <label className=\"flex items-center gap-1.5 font-semibold text-gray-700 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={autoOptimizeWebp}\n                      onChange={(e) => setAutoOptimizeWebp(e.target.checked)}\n                      className=\"rounded text-rose-600\"\n                    />\n                    <span>WebP \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\265\340\244\244\340\244\203 \340\244\225\340\244\202\340\244\252\340\245\215\340\244\260\340\245\207\340\244\270 \340\244\225\340\244\260\340\245\207\340\244\202 (60-80% \340\244\254\340\244\232\340\244\244)</span>\n                  </label>\n                  <label className=\"flex items-center gap-1.5 font-semibold text-gray-700 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={autoWatermark}\n                      onChange={(e) => setAutoWatermark(e.target.checked)}\n                      className=\"rounded text-rose-600\"\n                    />\n                    <span>\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\265\340\244\276\340\244\237\340\244\260\340\244\256\340\244\276\340\244\260\340\245\215\340\244\225 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202</span>\n                  </label>\n                </div>\n              </div>\n\n              {/* Alt Text Suggester */}\n              <div className=\"bg-purple-50/60 p-4 rounded-2xl border border-purple-200/80 space-y-2\">\n                <div className=\"text-xs font-black text-purple-900 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-purple-600\" />\n                  <span>\340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 \340\244\234\340\244\250\340\244\260\340\245\207\340\244\237\340\244\260 (SEO Alt Text):</span>\n                </div>\n                <div className=\"flex gap-2\">\n                  <input\n                    type=\"text\"\n                    value={altTextSuggestion}\n                    onChange={(e) => setAltTextSuggestion(e.target.value)}\n                    className=\"flex-1 px-3 py-2 rounded-xl bg-white border border-purple-200 text-xs font-medium\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => showNotice(\'\340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\265 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                    className=\"px-3 py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl shadow-xs\"\n                  >\n                    \340\244\205\340\244\252\340\245\215\340\244\262\340\244\276\340\244\210 \340\244\225\340\244\260\340\245\207\340\244\202\n                  </button>\n                </div>\n              </div>\n\n              {/* Stock Images Gallery */}\n              <div>\n                <h4 className=\"text-xs font-black text-gray-900 uppercase tracking-wider mb-2.5\">\n                  \340\244\260\340\245\211\340\244\257\340\244\262\340\245\215\340\244\237\340\245\200-\340\244\253\340\245\215\340\244\260\340\245\200 \340\244\270\340\245\215\340\244\237\340\245\211\340\244\225 \340\244\207\340\244\256\340\245\207\340\244\234\340\245\207\340\244\270 (Unsplash / News Assets)\n                </h4>\n                <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3\">\n                  {STOCK_IMAGES.map((img, i) => (\n                    <div\n                      key={i}\n                      className=\"group relative rounded-xl overflow-hidden border border-gray-200 aspect-16/10 bg-gray-100\"\n                    >\n                      <img src={img.url} alt={img.title} className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\" />\n                      <div className=\"absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between p-2 text-white\">\n                        <span className=\"text-[10px] font-bold bg-black/60 px-1.5 py-0.5 rounded self-start\">\n                          {img.tag}\n                        </span>\n                        <button\n                          type=\"button\"\n                          onClick={() => {\n                            showNotice(`\340\244\207\340\244\256\340\245\207\340\244\234 \"${img.title}\" \340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\225\340\245\207 \340\244\260\340\245\202\340\244\252 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\237 \340\244\271\340\245\201\340\244\210!`);\n                          }}\n                          className=\"w-full py-1 bg-rose-600 hover:bg-rose-700 text-white text-[10px] font-bold rounded-lg\"\n                        >\n                          \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 8: REVISIONS & AUTO-SAVE (Module 12)\n             ========================================================= */}\n          {activeSection === \'revisions\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <History className=\"w-5 h-5 text-purple-600\" />\n                    <span>\340\244\221\340\244\237\340\245\213-\340\244\270\340\245\207\340\244\265 \340\244\217\340\244\265\340\244\202 \340\244\260\340\244\277\340\244\265\340\244\277\340\244\234\340\244\250 \340\244\207\340\244\244\340\244\277\340\244\271\340\244\276\340\244\270 (Revisions & Diff Compare)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\252\340\245\215\340\244\260\340\244\244\340\245\215\340\244\257\340\245\207\340\244\225 60 \340\244\270\340\245\207\340\244\225\340\244\202\340\244\241 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\265\340\244\244\340\244\203 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244, \340\244\270\340\244\202\340\244\270\340\245\215\340\244\225\340\244\260\340\244\243 \340\244\244\340\245\201\340\244\262\340\244\250\340\244\276 \340\244\224\340\244\260 \340\244\217\340\244\225-\340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\260\340\245\200\340\244\270\340\245\215\340\244\237\340\245\213\340\244\260\n                  </p>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    const jsonBackup = JSON.stringify(articles, null, 2);\n                    const blob = new Blob([jsonBackup], { type: \'application/json\' });\n                    const url = URL.createObjectURL(blob);\n                    const a = document.createElement(\'a\');\n                    a.href = url;\n                    a.download = `wp-articles-backup-${new Date().toISOString().slice(0, 10)}.json`;\n                    a.click();\n                    showNotice(\'\340\244\254\340\245\210\340\244\225\340\244\205\340\244\252 \340\244\253\340\244\276\340\244\207\340\244\262 JSON \340\244\256\340\245\207\340\244\202 \340\244\241\340\244\276\340\244\211\340\244\250\340\244\262\340\245\213\340\244\241 \340\244\271\340\245\213 \340\244\227\340\244\210!\');\n                  }}\n                  className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-xl flex items-center gap-1.5\"\n                >\n                  <span>JSON \340\244\254\340\245\210\340\244\225\340\244\205\340\244\252 \340\244\217\340\244\225\340\245\215\340\244\270\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237</span>\n                </button>\n              </div>\n\n              <div className=\"space-y-3\">\n                {revisions.map((rev, idx) => (\n                  <div\n                    key={rev.id}\n                    className=\"p-4 rounded-2xl border border-gray-200/90 bg-white space-y-2 text-xs\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"w-2.5 h-2.5 rounded-full bg-purple-600\" />\n                        <span className=\"font-bold text-gray-900\">{rev.time}</span>\n                        <span className=\"px-2 py-0.5 rounded-md bg-gray-100 text-gray-600 font-mono text-[10px]\">\n                          \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276: {rev.author}\n                        </span>\n                      </div>\n                      <div className=\"flex gap-2\">\n                        <button\n                          type=\"button\"\n                          onClick={() => showNotice(`\340\244\270\340\244\202\340\244\270\340\245\215\340\244\225\340\244\260\340\244\243 ${rev.time} \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\260\340\245\200\340\244\270\340\245\215\340\244\237\340\245\213\340\244\260 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!`)}\n                          className=\"px-2.5 py-1 bg-purple-50 hover:bg-purple-600 hover:text-white text-purple-700 font-bold rounded-lg transition-colors text-[11px]\"\n                        >\n                          \340\244\257\340\244\271 \340\244\265\340\244\260\340\245\215\340\244\234\340\244\250 \340\244\260\340\245\200\340\244\270\340\245\215\340\244\237\340\245\213\340\244\260 \340\244\225\340\244\260\340\245\207\340\244\202\n                        </button>\n                      </div>\n                    </div>\n\n                    <div className=\"text-gray-600 font-medium\">{rev.desc}</div>\n\n                    {rev.diffAdded && (\n                      <div className=\"p-2 bg-emerald-50 text-emerald-800 rounded-lg font-mono text-[11px]\">\n                        {rev.diffAdded}\n                      </div>\n                    )}\n                    {rev.diffRemoved && (\n                      <div className=\"p-2 bg-rose-50 text-rose-800 rounded-lg font-mono text-[11px]\">\n                        {rev.diffRemoved}\n                      </div>\n                    )}\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 9: TAXONOMY (CATEGORIES & TAGS) (Module 7)\n             ========================================================= */}\n          {activeSection === \'taxonomy\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Tag className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 \340\244\217\340\244\265\340\244\202 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 (Categories & Smart Tags)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256, \340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 \340\244\237\340\245\210\340\244\227 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 \340\244\217\340\244\265\340\244\202 \340\244\262\340\245\213\340\244\225\340\244\252\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\237\340\245\210\340\244\227 \340\244\225\340\245\215\340\244\262\340\244\276\340\244\211\340\244\241\n                  </p>\n                </div>\n              </div>\n\n              {/* Add Category Form */}\n              <div className=\"p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-3\">\n                <div className=\"text-xs font-bold text-gray-800\">\340\244\250\340\244\210 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Add New Category):</div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\250\340\244\276\340\244\256 (\340\244\211\340\244\246\340\244\276: \340\244\234\340\244\262\340\244\265\340\244\276\340\244\257\340\245\201 \340\244\265 \340\244\252\340\244\260\340\245\215\340\244\257\340\244\276\340\244\265\340\244\260\340\244\243)\"\n                    className=\"px-3 py-2 rounded-xl bg-white border border-gray-300 text-xs\"\n                  />\n                  <input\n                    type=\"text\"\n                    placeholder=\"\340\244\270\340\245\215\340\244\262\340\244\227 (\340\244\211\340\244\246\340\244\276: climate-environment)\"\n                    className=\"px-3 py-2 rounded-xl bg-white border border-gray-300 text-xs font-mono\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => showNotice(\'\340\244\250\340\244\210 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\200 \340\244\227\340\244\210!\')}\n                    className=\"px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-xs\"\n                  >\n                    + \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202\n                  </button>\n                </div>\n              </div>\n\n              {/* Tag Cloud */}\n              <div>\n                <h4 className=\"text-xs font-black text-gray-900 uppercase tracking-wider mb-2.5\">\n                  \340\244\262\340\245\213\340\244\225\340\244\252\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\237\340\245\210\340\244\227 \340\244\225\340\245\215\340\244\262\340\244\276\340\244\211\340\244\241 (Active Tag Cloud & Counts)\n                </h4>\n                <div className=\"flex flex-wrap gap-2\">\n                  {[\n                    { tag: \'\340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274\', count: 42 },\n                    { tag: \'\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 2026\', count: 28 },\n                    { tag: \'\340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260\', count: 24 },\n                    { tag: \'IND vs AUS\', count: 35 },\n                    { tag: \'\340\244\227\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\271\340\244\276\340\244\207\340\244\241\340\245\215\340\244\260\340\245\213\340\244\234\340\244\250\', count: 18 },\n                    { tag: \'\340\244\260\340\245\207\340\244\252\340\245\213 \340\244\260\340\245\207\340\244\237\', count: 16 },\n                    { tag: \'\340\244\254\340\244\234\340\244\237 2026\', count: 29 },\n                    { tag: \'\340\244\225\340\245\215\340\244\265\340\244\276\340\244\202\340\244\237\340\244\256 \340\244\256\340\244\277\340\244\266\340\244\250\', count: 12 },\n                    { tag: \'AI \340\244\225\340\245\215\340\244\260\340\244\276\340\244\202\340\244\244\340\244\277\', count: 31 }\n                  ].map((t, idx) => (\n                    <span\n                      key={idx}\n                      className=\"px-3 py-1.5 rounded-full bg-white border border-gray-200 text-xs font-semibold text-gray-800 flex items-center gap-1.5 shadow-2xs hover:border-rose-400 cursor-pointer\"\n                    >\n                      <span>#{t.tag}</span>\n                      <span className=\"text-[10px] text-gray-400 font-mono\">({t.count})</span>\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 10: USER ROLES & PERMISSIONS (Module 10)\n             ========================================================= */}\n          {activeSection === \'roles\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Users className=\"w-5 h-5 text-indigo-600\" />\n                    <span>\340\244\257\340\245\202\340\244\234\340\244\260 \340\244\260\340\245\213\340\244\262\340\245\215\340\244\270 \340\244\217\340\244\265\340\244\202 \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\265\340\244\260\340\245\215\340\244\225\340\244\253\340\244\274\340\245\215\340\244\262\340\245\213 (Role-Based Access & Review)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276\340\244\252\340\244\225, \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225, \340\244\262\340\245\207\340\244\226\340\244\225 \340\244\217\340\244\265\340\244\202 \340\244\257\340\245\213\340\244\227\340\244\246\340\244\276\340\244\250\340\244\225\340\244\260\340\245\215\340\244\244\340\244\276 \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276\340\244\223\340\244\202 \340\244\225\340\245\200 \340\244\205\340\244\250\340\245\201\340\244\256\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202\n                  </p>\n                </div>\n              </div>\n\n              {/* Roles Table */}\n              <div className=\"border border-gray-200 rounded-2xl overflow-hidden shadow-2xs\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-gray-50 border-b border-gray-200 font-bold text-gray-700\">\n                    <tr>\n                      <th className=\"p-3\">\340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276 (Role)</th>\n                      <th className=\"p-3\">\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243</th>\n                      <th className=\"p-3\">\340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266</th>\n                      <th className=\"p-3\">\340\244\246\340\245\202\340\244\270\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\245\207\340\244\226 \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\250</th>\n                      <th className=\"p-3\">\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 / \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-gray-100 font-medium text-gray-800\">\n                    <tr>\n                      <td className=\"p-3 font-bold text-rose-600\">\340\244\265\340\245\215\340\244\257\340\244\265\340\244\270\340\245\215\340\244\245\340\244\276\340\244\252\340\244\225 (Administrator)</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-3 font-bold text-purple-600\">\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225 (Editor)</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\270\340\245\200\340\244\256\340\244\277\340\244\244</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-3 font-bold text-blue-600\">\340\244\262\340\245\207\340\244\226\340\244\225 (Author)</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\270\340\245\215\340\244\265\340\244\257\340\244\202 \340\244\225\340\245\207</td>\n                      <td className=\"p-3 text-rose-600 font-bold\">\342\234\227 \340\244\250\340\244\271\340\245\200\340\244\202</td>\n                      <td className=\"p-3 text-rose-600 font-bold\">\342\234\227 \340\244\250\340\244\271\340\245\200\340\244\202</td>\n                    </tr>\n                    <tr>\n                      <td className=\"p-3 font-bold text-gray-600\">\340\244\257\340\245\213\340\244\227\340\244\246\340\244\276\340\244\250\340\244\225\340\244\260\340\245\215\340\244\244\340\244\276 (Contributor)</td>\n                      <td className=\"p-3 text-emerald-600 font-bold\">\342\234\223 \340\244\271\340\244\276\340\244\201</td>\n                      <td className=\"p-3 text-amber-600 font-bold\">\342\232\240\357\270\217 \340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276\340\244\247\340\245\200\340\244\250</td>\n                      <td className=\"p-3 text-rose-600 font-bold\">\342\234\227 \340\244\250\340\244\271\340\245\200\340\244\202</td>\n                      <td className=\"p-3 text-rose-600 font-bold\">\342\234\227 \340\244\250\340\244\271\340\245\200\340\244\202</td>\n                    </tr>\n                  </tbody>\n                </table>\n              </div>\n\n              {/* Pending Review Simulation */}\n              <div className=\"p-4 rounded-2xl bg-amber-50/60 border border-amber-200 space-y-2\">\n                <div className=\"text-xs font-bold text-amber-900 flex items-center justify-between\">\n                  <span>\340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\271\340\245\207\340\244\244\340\245\201 \340\244\262\340\244\202\340\244\254\340\244\277\340\244\244 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 (Pending Review Queue - 1 Post):</span>\n                  <span className=\"px-2 py-0.5 rounded-md bg-amber-200 text-amber-900 font-mono text-[10px]\">\n                    Pending Approval\n                  </span>\n                </div>\n                <div className=\"bg-white p-3 rounded-xl border border-amber-200 flex items-center justify-between\">\n                  <div>\n                    <div className=\"font-bold text-xs text-gray-900\">\n                      \"\340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 \340\244\271\340\244\260\340\244\277\340\244\244 \340\244\271\340\244\276\340\244\207\340\244\241\340\245\215\340\244\260\340\245\213\340\244\234\340\244\250 \340\244\256\340\244\277\340\244\266\340\244\250: \340\244\206\340\244\227\340\244\276\340\244\256\340\245\200 5 \340\244\265\340\244\260\340\245\215\340\244\267\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\225\340\245\215\340\244\267\340\245\215\340\244\257\"\n                    </div>\n                    <div className=\"text-[11px] text-gray-500\">\n                      \340\244\270\340\244\254\340\244\256\340\244\277\340\244\237 \340\244\225\340\244\277\340\244\257\340\244\276: \340\244\270\340\244\202\340\244\265\340\244\276\340\244\246\340\244\246\340\244\276\340\244\244\340\244\276 \340\244\260\340\244\276\340\244\271\340\245\201\340\244\262 \340\244\265\340\244\260\340\245\215\340\244\256\340\244\276 \342\200\242 \340\244\206\340\244\234 1:15 PM\n                    </div>\n                  </div>\n                  <div className=\"flex gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => showNotice(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\245\215\340\244\265\340\245\200\340\244\225\340\245\203\340\244\244 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                      className=\"px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg\"\n                    >\n                      \342\234\223 \340\244\270\340\245\215\340\244\265\340\245\200\340\244\225\340\245\203\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => showNotice(\'\340\244\270\340\244\202\340\244\266\340\245\213\340\244\247\340\244\250 \340\244\205\340\244\250\340\245\201\340\244\260\340\245\213\340\244\247 \340\244\255\340\245\207\340\244\234\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                      className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-xs rounded-lg\"\n                    >\n                      \340\244\270\340\244\202\340\244\266\340\245\213\340\244\247\340\244\250 \340\244\256\340\244\276\340\244\202\340\244\227\340\245\207\340\244\202\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 11: SAFE DELETE & 301 REDIRECT (Module 3)\n             ========================================================= */}\n          {activeSection === \'delete_module\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-rose-600 flex items-center gap-2\">\n                    <Trash2 className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\265 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Safety-First Deletion)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\254\340\244\277\340\244\250\340\244\276 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\245\207 \340\244\225\340\245\213\340\244\210 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \342\200\242 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\265 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\266 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\n                  </p>\n                </div>\n              </div>\n\n              {/* Current Article Danger Box */}\n              <div className=\"p-5 rounded-2xl bg-rose-50/80 border-2 border-rose-300 space-y-4\">\n                <div className=\"flex items-start gap-3\">\n                  <AlertTriangle className=\"w-6 h-6 text-rose-600 shrink-0 mt-0.5\" />\n                  <div>\n                    <div className=\"font-black text-sm text-rose-950\">\n                      \340\244\270\340\244\276\340\244\265\340\244\247\340\244\276\340\244\250\340\245\200: \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\257\340\245\200 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257\340\244\276\n                    </div>\n                    <div className=\"text-xs text-rose-800 mt-1\">\n                      \340\244\232\340\244\257\340\244\250\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262: <strong>\"{activeArticle.title}\"</strong> (ID: {activeArticle.id})\n                    </div>\n                    <div className=\"text-[11px] text-rose-700 mt-0.5\">\n                      \340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\207 \340\244\252\340\244\276\340\244\270 <strong>{activeArticle.views?.toLocaleString(\'hi-IN\') || 0} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274</strong> \340\244\224\340\244\260 \340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\254\340\245\210\340\244\225\340\244\262\340\244\277\340\244\202\340\244\225\340\245\215\340\244\270 \340\244\256\340\245\214\340\244\234\340\245\202\340\244\246 \340\244\271\340\245\210\340\244\202\340\245\244\n                    </div>\n                  </div>\n                </div>\n\n                {/* Safer Alternatives */}\n                <div className=\"bg-white p-3.5 rounded-xl border border-rose-200 space-y-2 text-xs\">\n                  <div className=\"font-bold text-gray-900\">\340\244\254\340\245\207\340\244\271\340\244\244\340\244\260 \340\244\265\340\244\277\340\244\225\340\244\262\340\245\215\340\244\252 (Safer Alternatives):</div>\n                  <div className=\"flex flex-wrap gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => showNotice(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\213 \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\340\244\276\340\244\202\340\244\244\340\244\260\340\244\277\340\244\244 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                      className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg font-bold\"\n                    >\n                      1. \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\254\340\244\246\340\244\262\340\245\207\340\244\202 (Move to Draft)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => showNotice(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\213 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\207\340\244\265\340\245\207\340\244\237 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                      className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg font-bold\"\n                    >\n                      2. \340\244\252\340\245\215\340\244\260\340\244\276\340\244\207\340\244\265\340\245\207\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202 (Only Admins)\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => showNotice(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\206\340\244\260\340\245\215\340\244\225\340\244\276\340\244\207\340\244\265 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\340\244\276\340\244\202\340\244\244\340\244\260\340\244\277\340\244\244 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!\')}\n                      className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg font-bold\"\n                    >\n                      3. \340\244\206\340\244\260\340\245\215\340\244\225\340\244\276\340\244\207\340\244\265 \340\244\225\340\244\260\340\245\207\340\244\202 (Archive)\n                    </button>\n                  </div>\n                </div>\n\n                {/* 301 Redirect URL */}\n                <div>\n                  <label className=\"block text-xs font-bold text-rose-900 mb-1\">\n                    \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\246 301 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\257\340\245\200 \340\244\252\340\245\201\340\244\250\340\244\260\340\245\215\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266\340\244\250 (301 Permanent Redirect URL):\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={redirect301Url}\n                    onChange={(e) => setRedirect301Url(e.target.value)}\n                    className=\"w-full px-3 py-2 rounded-xl bg-white border border-rose-300 text-xs font-mono\"\n                  />\n                </div>\n\n                {/* Explicit \"DELETE\" Confirmation Input */}\n                <div className=\"p-3.5 bg-white rounded-xl border border-rose-200 space-y-2\">\n                  <label className=\"block text-xs font-black text-rose-950\">\n                    \340\244\270\340\245\215\340\244\245\340\244\276\340\244\257\340\245\200 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\245\200\340\244\232\340\245\207 \340\244\254\340\245\211\340\244\225\340\245\215\340\244\270 \340\244\256\340\245\207\340\244\202 <span className=\"text-rose-600 uppercase\">DELETE</span> \340\244\237\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202:\n                  </label>\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      placeholder=\'\340\244\237\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202 \"DELETE\"\'\n                      value={deleteInputConfirm}\n                      onChange={(e) => setDeleteInputConfirm(e.target.value)}\n                      className=\"flex-1 px-3 py-2 rounded-xl border border-rose-300 text-xs font-black text-rose-600 focus:outline-hidden uppercase\"\n                    />\n                    <button\n                      type=\"button\"\n                      disabled={deleteInputConfirm.trim().toUpperCase() !== \'DELETE\'}\n                      onClick={() => {\n                        onRequestDelete(activeArticle.id, activeArticle.title);\n                        setDeleteInputConfirm(\'\');\n                      }}\n                      className=\"px-5 py-2 bg-rose-600 hover:bg-rose-700 disabled:opacity-40 text-white font-black text-xs rounded-xl shadow-xs transition-colors\"\n                    >\n                      \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\265 \340\244\271\340\244\237\340\244\276\340\244\217\340\244\202 (Permanently Delete)\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* =========================================================\n              VIEW 12: SETTINGS, SHORTCUTS & GUIDES (Module 14, 16, 17, 18)\n             ========================================================= */}\n          {activeSection === \'settings_help\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <Settings className=\"w-5 h-5 text-gray-700\" />\n                    <span>\340\244\207\340\244\202\340\244\237\340\245\200\340\244\227\340\245\215\340\244\260\340\245\207\340\244\266\340\244\250 \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270, \340\244\225\340\245\200\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\266\340\245\211\340\244\260\340\245\215\340\244\237\340\244\225\340\244\237\340\245\215\340\244\270 \340\244\217\340\244\265\340\244\202 \340\244\237\340\245\215\340\244\257\340\245\202\340\244\237\340\245\213\340\244\260\340\244\277\340\244\257\340\244\262</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\245\340\244\256\340\244\277\340\244\225\340\244\244\340\244\276\340\244\217\340\244\202, \340\244\270\340\245\213\340\244\266\340\244\262 \340\244\221\340\244\237\340\245\213-\340\244\266\340\245\207\340\244\257\340\244\260, \340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\225\340\245\200\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\256\340\244\276\340\244\202\340\244\241\340\245\215\340\244\270 \340\244\265 \340\244\217\340\244\270\340\244\210\340\244\223 \340\244\227\340\244\276\340\244\207\340\244\241\n                  </p>\n                </div>\n              </div>\n\n              {/* Keyboard Shortcuts Cheatsheet */}\n              <div>\n                <h4 className=\"text-xs font-black text-gray-900 uppercase tracking-wider mb-2.5 flex items-center gap-1.5\">\n                  <Keyboard className=\"w-4 h-4 text-purple-600\" />\n                  <span>\340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\225\340\245\200\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\266\340\245\211\340\244\260\340\245\215\340\244\237\340\244\225\340\244\237\340\245\215\340\244\270 (Productivity Shortcuts)</span>\n                </h4>\n                <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs\">\n                  {[\n                    { key: \'Ctrl + S\', action: \'\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\270\340\245\207\340\244\265 \340\244\225\340\244\260\340\245\207\340\244\202 (Save Draft)\' },\n                    { key: \'Ctrl + P\', action: \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\266 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish)\' },\n                    { key: \'Ctrl + K\', action: \'\340\244\271\340\244\276\340\244\207\340\244\252\340\244\260\340\244\262\340\244\277\340\244\202\340\244\225 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Add Link)\' },\n                    { key: \'Ctrl + B\', action: \'\340\244\254\340\245\213\340\244\262\340\245\215\340\244\241 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 (Bold)\' },\n                    { key: \'Ctrl + Shift + S\', action: \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\260 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202 (Schedule)\' },\n                    { key: \'Ctrl + Shift + P\', action: \'\340\244\262\340\244\276\340\244\207\340\244\265 \340\244\252\340\245\215\340\244\260\340\245\200\340\244\265\340\245\215\340\244\257\340\245\202 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 (Preview)\' },\n                    { key: \'Ctrl + Shift + D\', action: \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\241\340\245\201\340\244\252\340\245\215\340\244\262\340\245\200\340\244\225\340\245\207\340\244\237 (Duplicate)\' },\n                    { key: \'Ctrl + Z\', action: \'\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\265\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Undo)\' }\n                  ].map((s, idx) => (\n                    <div key={idx} className=\"p-2.5 bg-gray-50 rounded-xl border border-gray-200\">\n                      <div className=\"font-mono font-bold text-purple-700\">{s.key}</div>\n                      <div className=\"text-[11px] text-gray-600 mt-0.5\">{s.action}</div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Pro Tips & Best Practices */}\n              <div className=\"p-4 rounded-2xl bg-indigo-50/60 border border-indigo-200 space-y-2 text-xs text-indigo-950\">\n                <div className=\"font-bold flex items-center gap-2 text-indigo-900\">\n                  <Sparkles className=\"w-4 h-4 text-indigo-600\" />\n                  <span>\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 (Pro Editorial Tips):</span>\n                </div>\n                <ul className=\"space-y-1.5 text-[11px] text-indigo-900/90 pl-4 list-disc\">\n                  <li><strong>\340\244\252\340\245\215\340\244\260\340\244\245\340\244\256 100 \340\244\266\340\244\254\340\245\215\340\244\246:</strong> \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\225\340\245\213 \340\244\271\340\244\256\340\245\207\340\244\266\340\244\276 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246 \340\244\225\340\245\207 \340\244\255\340\245\200\340\244\244\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\255\340\244\276\340\244\265\340\244\277\340\244\225 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\266\340\244\276\340\244\256\340\244\277\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244</li>\n                  <li><strong>\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\206\340\244\265\340\245\203\340\244\244\340\245\215\340\244\244\340\244\277:</strong> \340\244\252\340\245\215\340\244\260\340\244\244\340\245\215\340\244\257\340\245\207\340\244\225 300-400 \340\244\266\340\244\254\340\245\215\340\244\246\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\246 \340\244\225\340\244\256 \340\244\270\340\245\207 \340\244\225\340\244\256 \340\244\217\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\270\340\244\202\340\244\227\340\244\277\340\244\225 \340\244\224\340\244\260 \340\244\265\340\244\260\340\245\215\340\244\243\340\244\250\340\244\276\340\244\244\340\245\215\340\244\256\340\244\225 \340\244\221\340\244\262\340\245\215\340\244\237-\340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 \340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\205\340\244\265\340\244\266\340\245\215\340\244\257 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\340\245\244</li>\n                  <li><strong>\340\244\250\340\244\277\340\244\267\340\245\215\340\244\225\340\244\260\340\245\215\340\244\267 \340\244\256\340\245\207\340\244\202 CTA:</strong> \340\244\262\340\245\207\340\244\226 \340\244\225\340\245\207 \340\244\205\340\244\202\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\217\340\244\225 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237 \340\244\225\340\245\211\340\244\262-\340\244\237\340\245\202-\340\244\217\340\244\225\340\245\215\340\244\266\340\244\250 (\340\244\211\340\244\246\340\244\276: \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\266\340\245\207\340\244\257\340\244\260 \340\244\225\340\244\2