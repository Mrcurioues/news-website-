244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260 \340\244\225\340\244\260\340\245\213\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\217\267\357\270\217 Meta Tags & Slug\' : \'\360\237\217\267\357\270\217 150-\340\244\205\340\244\225\340\245\215\340\244\267\340\244\260 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265 \340\244\270\340\245\215\340\244\262\340\244\227\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Generate a 150-character meta description, focus keyword, and SEO slug for this article\'\n        : \'\340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 150 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243, \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\224\340\244\260 SEO \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\254\340\244\250\340\244\276\340\244\223\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\342\217\260 Schedule Post\' : \'\342\217\260 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 / \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\207\340\244\237\340\244\270\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Schedule this article for tomorrow morning at 9:00 AM\'\n        : \'\340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \34