          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Single-window clearance launched to accelerate domestic solar, wind, and green hydrogen manufacturing.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Over 1.5 million direct and indirect green jobs expected to be generated across the next five years.\',"
