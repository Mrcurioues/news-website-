        }
        lines {
          text: "      \'Indian cricket icons Rohit Sharma and Virat Kohli registered another monumental milestone in ODI cricket history, becoming only the second duo ever to aggregate over 10,000 partnership runs in the format.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
