          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return matchesSearch && matchesStatus && matchesCategory;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
