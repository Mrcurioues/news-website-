        lines {
          text: "  const regex = new RegExp(escaped, \'gi\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const matches = cleanContent.match(regex);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
