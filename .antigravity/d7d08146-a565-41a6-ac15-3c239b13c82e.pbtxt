  file_change {
    absolute_path_uri: "file:///src/pages/HomePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect } from \'react\';\nimport {\n  getAllArticles,\n  CATEGORIES,\n  getArticlesByCategory,\n  getTrendingArticles,\n  DEMO_VIDEOS,\n  DEMO_GALLERIES\n} from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { StoryCard } from \'../components/StoryCard\';\nimport { SectionBlock } from \'../components/SectionBlock\';\nimport { TrendingWidget } from \'../components/TrendingWidget\';\nimport { AdSlot } from \'../components/AdSlot\';\nimport { Video, Camera, Play, ChevronRight, Sparkles } from \'lucide-react\';\nimport { ImageWithFallback } from \'../components/ImageWithFallback\';\n\nexport const HomePage: React.FC = () => {\n  const { updateMetadata } = useRouter();\n  const allArticles = getAllArticles();\n\n  useEffect(() => {\n    updateMetadata({\n      title: \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 - \340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\274\340\244\254\340\244\260\340\245\207\340\244\202, \340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277, \340\244\225\340\245\215\340\244\260\340\244\277\340\244\225\340\245\207\340\244\237 \340\244\265 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213\',\n      description: \'\340\244\246\340\245\207\340\244\266 \340\244\224\340\244\260 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 \340\244\225\340\245\200 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274, \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260, \340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277, \340\244\265\340\245\215\340\244\257\340\244\276\340\244\252\340\244\276\340\244\260 \340\244\224\340\244\260 \340\244\256\340\244\250\340\245\213\340\244\260\340\244\202\340\244\234\340\244\250 \340\244\225\340\245\200 \340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\274\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202\340\245\244\'\n    });\n  }, []);\n\n  const leadStory = allArticles[0];\n  const secondaryStories = allArticles.slice(1, 4);\n  const trendingArticles = getTrendingArticles(5);\n\n  const nationalArticles = getArticlesByCategory(\'national\');\n  const politicsArticles = getArticlesByCategory(\'politics\');\n  const cricketArticles = getArticlesByCategory(\'cricket\');\n  const entertainmentArticles = getArticlesByCategory(\'entertainment\');\n  const techArticles = getArticlesByCategory(\'tech\');\n  const businessArticles = getArticlesByCategory(\'business\');\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* 1. Top Leaderboard Banner Ad */}\n      <AdSlot format=\"leaderboard\" slotName=\"\340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\225 | Main Sponsor Banner\" />\n\n      {/* 2. Top Lead Hero + Featured Grid + Trending Sidebar Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 mt-4\">\n        {/* Main Content Area (8 Cols) */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          {/* Hero Lead Story */}\n          {leadStory && (\n            <StoryCard article={leadStory} variant=\"hero\" />\n          )}\n\n          {/* Secondary 3-Stories Row */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2\">\n            {secondaryStories.map((story) => (\n              <StoryCard key={story.id} article={story} variant=\"secondary\" />\n            ))}\n          </div>\n        </div>\n\n        {/* Desktop Sidebar (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Trending / Most Read Widget */}\n          <TrendingWidget articles={trendingArticles} />\n\n          {/* Sidebar Ad Placement */}\n          <AdSlot format=\"medium-rectangle\" slotName=\"\340\244\270\340\244\276\340\244\207\340\244\241\340\244\254\340\244\276\340\244\260 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250\" />\n        </div>\n      </div>\n\n      {/* 3. Mid-Page In-Feed Ad */}\n      <AdSlot format=\"in-feed\" slotName=\"\340\244\256\340\244\247\340\245\215\340\244\257 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\250 (Mid-Page Ad)\" />\n\n      {/* 4. Category Sections Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mt-8\">\n        {/* Left 8 Cols: Major News Category Sections */}\n        <div className=\"lg:col-span-8 space-y-10\">\n          {/* National News */}\n          {CATEGORIES.find(c => c.slug === \'national\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'national\')!}\n              articles={nationalArticles}\n            />\n          )}\n\n          {/* Politics News */}\n          {CATEGORIES.find(c => c.slug === \'politics\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'politics\')!}\n              articles={politicsArticles}\n            />\n          )}\n\n          {/* In-Article Ad Slot */}\n          <div className=\"my-6\">\n            <AdSlot format=\"in-feed\" slotName=\"\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\256\340\244\247\340\245\215\340\244\257 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 \340\244\270\340\245\215\340\244\262\340\245\211\340\244\237\" />\n          </div>\n\n          {/* Cricket News */}\n          {CATEGORIES.find(c => c.slug === \'cricket\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'cricket\')!}\n              articles={cricketArticles}\n            />\n          )}\n\n          {/* Entertainment News */}\n          {CATEGORIES.find(c => c.slug === \'entertainment\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'entertainment\')!}\n              articles={entertainmentArticles}\n            />\n          )}\n\n          {/* Tech News */}\n          {CATEGORIES.find(c => c.slug === \'tech\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'tech\')!}\n              articles={techArticles}\n            />\n          )}\n\n          {/* Business News */}\n          {CATEGORIES.find(c => c.slug === \'business\') && (\n            <SectionBlock\n              category={CATEGORIES.find(c => c.slug === \'business\')!}\n              articles={businessArticles}\n            />\n          )}\n        </div>\n\n        {/* Right 4 Cols: Multimedia highlights and Sticky Ad */}\n        <div className=\"lg:col-span-4 space-y-8\">\n          {/* Video Highlights Box */}\n          <div className=\"bg-zinc-900 text-white rounded-xl p-4 sm:p-5 shadow-md\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-zinc-800 mb-4\">\n              <div className=\"flex items-center gap-2 font-black text-lg text-white\">\n                <Video className=\"w-5 h-5 text-rose-500\" />\n                <span>\340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237\340\244\277\340\244\250</span>\n              </div>\n              <Link href=\"/videos\" className=\"text-xs font-bold text-rose-400 hover:text-rose-300\">\n                \340\244\270\340\244\255\340\245\200 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \342\206\222\n              </Link>\n            </div>\n\n            <div className=\"space-y-4\">\n              {DEMO_VIDEOS.slice(0, 3).map((video) => (\n                <Link\n                  key={video.id}\n                  href={`/videos/${video.idSlug}`}\n                  className=\"group block border-b border-zinc-800 pb-3 last:border-0 last:pb-0\"\n                >\n                  <div className=\"relative aspect-16/9 rounded-lg overflow-hidden mb-2 bg-zinc-800\">\n                    <ImageWithFallback\n                      src={video.thumbnail}\n                      alt={video.titleHi}\n                      className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\"\n                    />\n                    <div className=\"absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition-colors\">\n                      <div className=\"w-10 h-10 rounded-full bg-rose-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform\">\n                        <Play className=\"w-5 h-5 fill-white translate-x-0.5\" />\n                      </div>\n                    </div>\n                    <span className=\"absolute bottom-2 right-2 bg-black/80 px-2 py-0.5 rounded text-[10px] font-mono text-white\">\n                      {video.duration}\n                    </span>\n                  </div>\n                  <h4 className=\"text-xs sm:text-sm font-bold text-gray-200 group-hover:text-rose-400 line-clamp-2 leading-snug\">\n                    {video.titleHi}\n                  </h4>\n                  <div className=\"flex items-center gap-2 text-[11px] text-zinc-400 mt-1\">\n                    <span>{video.views} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274</span>\n                    <span>\342\200\242</span>\n                    <span>{video.publishedAt}</span>\n                  </div>\n                </Link>\n              ))}\n            </div>\n          </div>\n\n          {/* Photo Gallery Spotlight */}\n          <div className=\"bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-xs\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-gray-100 mb-4\">\n              <div className=\"flex items-center gap-2 font-extrabold text-lg text-gray-900\">\n                <Camera className=\"w-5 h-5 text-rose-600\" />\n                <span>\340\244\253\340\245\213\340\244\237\340\245\213 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200</span>\n              </div>\n              <Link href=\"/photos\" className=\"text-xs font-bold text-rose-600 hover:text-rose-800\">\n                \340\244\270\340\244\255\340\245\200 \340\244\227\340\245\210\340\244\262\340\244\260\340\245\200 \342\206\222\n              </Link>\n            </div>\n\n            <div className=\"space-y-4\">\n              {DEMO_GALLERIES.slice(0, 2).map((gallery) => (\n                <Link\n                  key={gallery.id}\n                  href={`/photos/${gallery.idSlug}`}\n                  className=\"group block\"\n                >\n                  <div className=\"relative aspect-16/10 rounded-lg overflow-hidden mb-2 bg-gray-100\">\n                    <ImageWithFallback\n                      src={gallery.coverImage}\n                      alt={gallery.titleHi}\n                      className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\"\n                    />\n                    <span className=\"absolute bottom-2 left-2 px-2 py-0.5 rounded bg-black/70 backdrop-blur-xs text-white text-[11px] font-semibold flex items-center gap-1\">\n                      <Camera className=\"w-3 h-3\" />\n                      {gallery.images.length} \340\244\244\340\244\270\340\245\215\340\244\265\340\245\200\340\244\260\340\245\207\340\244\202\n                    </span>\n                  </div>\n                  <h4 className=\"text-sm font-bold text-gray-900 group-hover:text-rose-600 line-clamp-2 leading-snug\">\n                    {gallery.titleHi}\n                  </h4>\n                </Link>\n              ))}\n            </div>\n          </div>\n\n          {/* Tall Half-Page Sticky Ad */}\n          <div className=\"sticky top-20\">\n            <AdSlot format=\"half-page\" slotName=\"\340\244\252\340\245\215\340\244\260\340\245\200\340\244\256\340\244\277\340\244\257\340\244\256 \340\244\254\340\245\215\340\244\260\340\244\276\340\244\202\340\244\241 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\225\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
