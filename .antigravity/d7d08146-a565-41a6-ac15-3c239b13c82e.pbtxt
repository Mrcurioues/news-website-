    instruction: "Add bilingual translation support and language switcher to AdminPage"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport { getAllArticles, CATEGORIES, addArticle, updateArticle, deleteArticle } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { Article, PostStatus } from \'../types\';\nimport {\n  ShieldCheck,\n  PlusCircle,\n  List,\n  CheckCircle,\n  Eye,\n  Radio,\n  Flame,\n  FileText,\n  ExternalLink,\n  Sparkles,\n  Edit3,\n  Trash2,\n  Clock,\n  Search,\n  Filter,\n  Bot,\n  AlertTriangle,\n  Layers,\n  Calendar,\n  X\n} from \'lucide-react\';\nimport { WpArticleEditor } from \'../components/admin/WpArticleEditor\';\nimport { WpAssistantChat } from \'../components/admin/WpAssistantChat\';\nimport { DeleteConfirmModal } from \'../components/admin/DeleteConfirmModal\';\nimport { WpAiSuite } from \'../components/admin/WpAiSuite\';\n\nexport const AdminPage: React.FC = () => {\n  const { updateMetadata, push } = useRouter();\n  const [articles, setArticles] = useState<Article[]>(() => getAllArticles());\n  const [activeTab, setActiveTab] = useState<\'suite\' | \'list\' | \'editor\' | \'assistant\'>(\'suite\');\n  const [editingArticle, setEditingArticle] = useState<Partial<Article> | undefined>(undefined);\n\n  // Search and filter for articles table\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n  const [categoryFilter, setCategoryFilter] = useState<string>(\'all\');\n\n  // Success and notification alerts\n  const [notification, setNotification] = useState<{ message: string; slug?: string } | null>(null);\n\n  // Deletion Modal state\n  const [deleteModalState, setDeleteModalState] = useState<{\n    isOpen: boolean;\n    articleId: string;\n    articleTitle: string;\n  }>({\n    isOpen: false,\n    articleId: \'\',\n    articleTitle: \'\'\n  });\n\n  // Floating Assistant Drawer toggle\n  const [isAssistantDrawerOpen, setIsAssistantDrawerOpen] = useState(false);\n\n  useEffect(() => {\n    updateMetadata({\n      title: \'WordPress \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 - Bharat Samachar WP Admin\',\n      description: \'WordPress Article Management Assistant with Yoast & Rank Math SEO, Flesch Readability, and Post Scheduling\'\n    });\n  }, []);\n\n  const refreshArticles = () => {\n    setArticles([...getAllArticles()]);\n  };\n\n  // Open Editor for new article\n  const handleCreateNewArticle = (prefillData?: Partial<Article>) => {\n    setEditingArticle(prefillData || {\n      title: \'\',\n      titleEn: \'\',\n      categorySlug: \'national\',\n      excerpt: \'\',\n      body: [\n        \'## 1. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\244\260\340\244\277\340\244\246\340\245\203\340\244\266\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\340\244\255\340\245\202\340\244\256\340\244\277\',\n        \'\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\',\n        \'## 2. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\217\340\244\265\340\244\202 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\',\n        \'### \340\244\225) \340\244\250\340\245\200\340\244\244\340\244\277\340\244\227\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\255\340\244\276\340\244\265 \340\244\224\340\244\260 \340\244\244\340\244\245\340\245\215\340\244\257\',\n        \'\340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\270\340\245\215\340\244\244\340\245\201\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\'\n      ],\n      coverImage: \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\',\n      status: \'published\',\n      tags: [\'\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\254\340\244\260\', \'\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\'],\n      focusKeyword: \'\',\n      metaTitle: \'\',\n      metaDescription: \'\'\n    });\n    setActiveTab(\'editor\');\n  };\n\n  // Open Editor for existing article\n  const handleEditArticle = (article: Article) => {\n    setEditingArticle({ ...article });\n    setActiveTab(\'editor\');\n  };\n\n  // Handle Save (Create or Update)\n  const handleSaveArticle = (articleData: Partial<Article>) => {\n    let savedArticle: Article;\n    if (articleData.id) {\n      const updated = updateArticle(articleData.id, articleData);\n      savedArticle = updated || addArticle(articleData);\n      setNotification({\n        message: `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    } else {\n      savedArticle = addArticle(articleData);\n      setNotification({\n        message: `\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 / \340\244\270\340\244\271\340\245\207\340\244\234\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    }\n\n    refreshArticles();\n    setEditingArticle(savedArticle);\n    setActiveTab(\'list\');\n\n    setTimeout(() => {\n      setNotification(null);\n    }, 6000);\n  };\n\n  // Apply partial data from Assistant\n  const handleApplyAssistantData = (data: Partial<Article>) => {\n    if (editingArticle) {\n      setEditingArticle(prev => ({\n        ...prev,\n        ...data\n      }));\n    } else {\n      // If currently on list view, start editor with this data\n      handleCreateNewArticle(data);\n    }\n  };\n\n  // Trigger Delete confirmation modal\n  const handleRequestDelete = (id: string, title: string) => {\n    setDeleteModalState({\n      isOpen: true,\n      articleId: id,\n      articleTitle: title\n    });\n  };\n\n  // Perform confirmed deletion\n  const handleConfirmDelete = () => {\n    if (deleteModalState.articleId) {\n      const success = deleteArticle(deleteModalState.articleId);\n      if (success) {\n        refreshArticles();\n        setNotification({\n          message: `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 (Deleted) \340\244\227\340\244\257\340\244\276\340\245\244`\n        });\n        if (editingArticle?.id === deleteModalState.articleId) {\n          setEditingArticle(undefined);\n          setActiveTab(\'list\');\n        }\n      }\n    }\n    setDeleteModalState({ isOpen: false, articleId: \'\', articleTitle: \'\' });\n    setTimeout(() => {\n      setNotification(null);\n    }, 5000);\n  };\n\n  // Metrics\n  const breakingCount = articles.filter(a => a.isBreaking).length;\n  const draftCount = articles.filter(a => a.status === \'draft\').length;\n  const scheduledCount = articles.filter(a => a.status === \'scheduled\').length;\n  const avgSeoScore = Math.round(\n    articles.reduce((acc, a) => acc + (a.seoScore || 85), 0) / Math.max(1, articles.length)\n  );\n\n  // Filtered Articles for Table\n  const filteredArticles = articles.filter(a => {\n    const matchesSearch =\n      !searchQuery ||\n      a.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (a.focusKeyword && a.focusKeyword.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (a.slug && a.slug.toLowerCase().includes(searchQuery.toLowerCase()));\n\n    const matchesStatus =\n      statusFilter === \'all\' ||\n      (statusFilter === \'published\' && (!a.status || a.status === \'published\')) ||\n      a.status === statusFilter;\n\n    const matchesCategory =\n      categoryFilter === \'all\' || a.categorySlug === categoryFilter;\n\n    return matchesSearch && matchesStatus && matchesCategory;\n  });\n\n  return (\n    <div id=\"wp-admin-page-root\" className=\"min-h-screen bg-gray-50/60 pb-16\">\n      {/* Top Banner Header */}\n      <div className=\"bg-linear-to-r from-slate-950 via-zinc-900 to-gray-900 text-white border-b border-gray-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <span className=\"px-2.5 py-0.5 rounded-md bg-rose-500/20 text-rose-400 border border-rose-500/30 text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  WordPress Article Management\n                </span>\n                <span className=\"px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold\">\n                  Rank Math & Yoast Compatible\n                </span>\n              </div>\n              <h1 className=\"text-2xl sm:text-3xl font-black text-white tracking-tight\">\n                \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\217\340\244\265\340\244\202 WordPress \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262\n              </h1>\n              <p className=\"text-xs sm:text-sm text-gray-400 mt-1\">\n                AI-\340\244\270\340\244\202\340\244\232\340\244\276\340\244\262\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\215\340\244\260\340\244\277\340\244\217\340\244\266\340\244\250, H1/H2/H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256, Flesch \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\217\340\244\265\340\244\202 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227\n              </p>\n            </div>\n\n            {/* Quick Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-3\">\n              <button\n                type=\"button\"\n                id=\"toggle-suite-top-btn\"\n                onClick={() => setActiveTab(\'suite\')}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-black text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm border border-zinc-700\"\n              >\n                <Sparkles className=\"w-4 h-4 text-rose-400\" />\n                <span>AI \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\202\340\244\237 (12 Modules)</span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"create-new-article-top-btn\"\n                onClick={() => handleCreateNewArticle()}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-rose-900/40\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202 (New Post)</span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"toggle-assistant-top-btn\"\n                onClick={() => setActiveTab(\'assistant\')}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-purple-900/40\"\n              >\n                <Bot className=\"w-4 h-4\" />\n                <span>AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 pt-6\">\n        {/* Metric Cards Row */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 mb-6\">\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262</span>\n            <div className=\"text-2xl font-black text-gray-900 mt-1\">{articles.length}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\224\340\244\270\340\244\244 SEO \340\244\271\340\245\207\340\244\262\340\245\215\340\244\245</span>\n            <div className=\"text-2xl font-black text-emerald-600 mt-1 flex items-center gap-1.5\">\n              <span>{avgSeoScore}/100</span>\n              <span className=\"text-xs px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold\">Good</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237\340\245\215\340\244\270</span>\n            <div className=\"text-2xl font-black text-indigo-600 mt-1 flex items-center gap-1\">\n              <Clock className=\"w-4 h-4\" />\n              <span>{scheduledCount}</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237\340\245\215\340\244\270 (Drafts)</span>\n            <div className=\"text-2xl font-black text-amber-600 mt-1\">{draftCount}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">\340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274</span>\n            <div className=\"text-2xl font-black text-rose-600 mt-1 flex items-center gap-1\">\n              <Radio className=\"w-4 h-4 animate-pulse\" />\n              <span>{breakingCount}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Global Notification Banner */}\n        {notification && (\n          <div className=\"mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center justify-between shadow-xs animate-in fade-in duration-200\">\n            <div className=\"flex items-center gap-2.5 text-xs sm:text-sm font-bold\">\n              <CheckCircle className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n              <span>{notification.message}</span>\n            </div>\n            {notification.slug && (\n              <Link\n                href={`/news/${notification.slug}`}\n                className=\"inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs shrink-0\"\n              >\n                <span>\340\244\262\340\244\276\340\244\207\340\244\265 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n              </Link>\n            )}\n          </div>\n        )}\n\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center justify-between border-b border-gray-200 mb-6 bg-white rounded-2xl px-4 py-2 shadow-2xs overflow-x-auto\">\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              type=\"button\"\n              id=\"tab-suite-btn\"\n              onClick={() => setActiveTab(\'suite\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'suite\'\n                  ? \'bg-zinc-950 text-white shadow-xs\'\n                  : \'text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100\'\n              }`}\n            >\n              <Sparkles className=\"w-4 h-4 text-rose-500\" />\n              <span>AI \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\202\340\244\237 (12 Modules)</span>\n              <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-rose-600 text-white font-black uppercase tracking-wider\">\n                All-in-One\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-all-posts-btn\"\n              onClick={() => setActiveTab(\'list\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'list\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <List className=\"w-4 h-4\" />\n              <span>\340\244\270\340\244\255\340\245\200 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 (All Posts - {articles.length})</span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-editor-btn\"\n              onClick={() => {\n                if (!editingArticle) handleCreateNewArticle();\n                else setActiveTab(\'editor\');\n              }}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'editor\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <Edit3 className=\"w-4 h-4\" />\n              <span>\n                {editingArticle?.id ? \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 (Editing)\' : \'\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 (Create Post)\'}\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-assistant-btn\"\n              onClick={() => setActiveTab(\'assistant\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors ${\n                activeTab === \'assistant\'\n                  ? \'bg-purple-600 text-white shadow-xs\'\n                  : \'text-purple-700 hover:bg-purple-50\'\n              }`}\n            >\n              <Bot className=\"w-4 h-4\" />\n              <span>WordPress AI \340\244\232\340\245\210\340\244\237\340\244\254\340\245\211\340\244\237</span>\n            </button>\n          </div>\n\n          {/* Quick Indicator of active post in editor */}\n          {editingArticle?.title && activeTab !== \'editor\' && (\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'editor\')}\n              className=\"text-xs text-gray-500 hover:text-rose-600 font-semibold flex items-center gap-1 truncate max-w-xs shrink-0 pl-3\"\n            >\n              <span>\340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202:</span>\n              <span className=\"font-bold text-gray-800 truncate\">\"{editingArticle.title}\"</span>\n            </button>\n          )}\n        </div>"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { getAllArticles, CATEGORIES, addArticle, updateArticle, deleteArticle } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { Article, PostStatus } from \'../types\';\nimport { ADMIN_TRANSLATIONS } from \'../utils/adminTranslations\';\nimport { getArticleTitle, getCategoryName } from \'../utils/translations\';\nimport {\n  ShieldCheck,\n  PlusCircle,\n  List,\n  CheckCircle,\n  Eye,\n  Radio,\n  Flame,\n  FileText,\n  ExternalLink,\n  Sparkles,\n  Edit3,\n  Trash2,\n  Clock,\n  Search,\n  Filter,\n  Bot,\n  AlertTriangle,\n  Layers,\n  Calendar,\n  X,\n  Languages\n} from \'lucide-react\';\nimport { WpArticleEditor } from \'../components/admin/WpArticleEditor\';\nimport { WpAssistantChat } from \'../components/admin/WpAssistantChat\';\nimport { DeleteConfirmModal } from \'../components/admin/DeleteConfirmModal\';\nimport { WpAiSuite } from \'../components/admin/WpAiSuite\';\n\nexport const AdminPage: React.FC = () => {\n  const { updateMetadata, push, lang, setLang } = useRouter();\n  const adminT = ADMIN_TRANSLATIONS[lang] || ADMIN_TRANSLATIONS.hi;\n  const [articles, setArticles] = useState<Article[]>(() => getAllArticles());\n  const [activeTab, setActiveTab] = useState<\'suite\' | \'list\' | \'editor\' | \'assistant\'>(\'suite\');\n  const [editingArticle, setEditingArticle] = useState<Partial<Article> | undefined>(undefined);\n\n  // Search and filter for articles table\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n  const [categoryFilter, setCategoryFilter] = useState<string>(\'all\');\n\n  // Success and notification alerts\n  const [notification, setNotification] = useState<{ message: string; slug?: string } | null>(null);\n\n  // Deletion Modal state\n  const [deleteModalState, setDeleteModalState] = useState<{\n    isOpen: boolean;\n    articleId: string;\n    articleTitle: string;\n  }>({\n    isOpen: false,\n    articleId: \'\',\n    articleTitle: \'\'\n  });\n\n  // Floating Assistant Drawer toggle\n  const [isAssistantDrawerOpen, setIsAssistantDrawerOpen] = useState(false);\n\n  useEffect(() => {\n    if (lang === \'en\') {\n      updateMetadata({\n        title: \'WordPress Article Management Dashboard - Bharat Samachar WP Admin\',\n        description: \'WordPress Article Management Assistant with Yoast & Rank Math SEO, Flesch Readability, and Post Scheduling\'\n      });\n    } else {\n      updateMetadata({\n        title: \'WordPress \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 - Bharat Samachar WP Admin\',\n        description: \'WordPress Article Management Assistant with Yoast & Rank Math SEO, Flesch Readability, and Post Scheduling\'\n      });\n    }\n  }, [lang]);\n\n  const refreshArticles = () => {\n    setArticles([...getAllArticles()]);\n  };\n\n  // Open Editor for new article\n  const handleCreateNewArticle = (prefillData?: Partial<Article>) => {\n    setEditingArticle(prefillData || {\n      title: \'\',\n      titleEn: \'\',\n      categorySlug: \'national\',\n      excerpt: \'\',\n      body: lang === \'en\' ? [\n        \'## 1. Key Background and Context\',\n        \'Provide an overview and context of the news story here.\',\n        \'## 2. Key Highlights and Analysis\',\n        \'### a) Strategic & Policy Impacts\',\n        \'Present supporting facts, quotes and verified data.\'\n      ] : [\n        \'## 1. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\244\260\340\244\277\340\244\246\340\245\203\340\244\266\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\340\244\255\340\245\202\340\244\256\340\244\277\',\n        \'\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\',\n        \'## 2. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\217\340\244\265\340\244\202 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\',\n        \'### \340\244\225) \340\244\250\340\245\200\340\244\244\340\244\277\340\244\227\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\255\340\244\276\340\244\265 \340\244\224\340\244\260 \340\244\244\340\244\245\340\245\215\340\244\257\',\n        \'\340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\270\340\245\215\340\244\244\340\245\201\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\'\n      ],\n      coverImage: \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\',\n      status: \'published\',\n      tags: lang === \'en\' ? [\'Breaking News\', \'In-Depth Analysis\'] : [\'\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\254\340\244\260\', \'\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\'],\n      focusKeyword: \'\',\n      metaTitle: \'\',\n      metaDescription: \'\'\n    });\n    setActiveTab(\'editor\');\n  };\n\n  // Open Editor for existing article\n  const handleEditArticle = (article: Article) => {\n    setEditingArticle({ ...article });\n    setActiveTab(\'editor\');\n  };\n\n  // Handle Save (Create or Update)\n  const handleSaveArticle = (articleData: Partial<Article>) => {\n    let savedArticle: Article;\n    if (articleData.id) {\n      const updated = updateArticle(articleData.id, articleData);\n      savedArticle = updated || addArticle(articleData);\n      setNotification({\n        message: lang === \'en\'\n          ? `Article \"${savedArticle.titleEn || savedArticle.title}\" updated successfully!`\n          : `\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    } else {\n      savedArticle = addArticle(articleData);\n      setNotification({\n        message: lang === \'en\'\n          ? `New article \"${savedArticle.titleEn || savedArticle.title}\" published & saved successfully!`\n          : `\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \"${savedArticle.title}\" \340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 / \340\244\270\340\244\271\340\245\207\340\244\234\340\244\276 \340\244\227\340\244\257\340\244\276!`,\n        slug: savedArticle.idSlug\n      });\n    }\n\n    refreshArticles();\n    setEditingArticle(savedArticle);\n    setActiveTab(\'list\');\n\n    setTimeout(() => {\n      setNotification(null);\n    }, 6000);\n  };\n\n  // Apply partial data from Assistant\n  const handleApplyAssistantData = (data: Partial<Article>) => {\n    if (editingArticle) {\n      setEditingArticle(prev => ({\n        ...prev,\n        ...data\n      }));\n    } else {\n      // If currently on list view, start editor with this data\n      handleCreateNewArticle(data);\n    }\n  };\n\n  // Trigger Delete confirmation modal\n  const handleRequestDelete = (id: string, title: string) => {\n    setDeleteModalState({\n      isOpen: true,\n      articleId: id,\n      articleTitle: title\n    });\n  };\n\n  // Perform confirmed deletion\n  const handleConfirmDelete = () => {\n    if (deleteModalState.articleId) {\n      const success = deleteArticle(deleteModalState.articleId);\n      if (success) {\n        refreshArticles();\n        setNotification({\n          message: adminT.deleteConfirmedMsg\n        });\n        if (editingArticle?.id === deleteModalState.articleId) {\n          setEditingArticle(undefined);\n          setActiveTab(\'list\');\n        }\n      }\n    }\n    setDeleteModalState({ isOpen: false, articleId: \'\', articleTitle: \'\' });\n    setTimeout(() => {\n      setNotification(null);\n    }, 5000);\n  };\n\n  // Metrics\n  const breakingCount = articles.filter(a => a.isBreaking).length;\n  const draftCount = articles.filter(a => a.status === \'draft\').length;\n  const scheduledCount = articles.filter(a => a.status === \'scheduled\').length;\n  const avgSeoScore = Math.round(\n    articles.reduce((acc, a) => acc + (a.seoScore || 85), 0) / Math.max(1, articles.length)\n  );\n\n  // Filtered Articles for Table\n  const filteredArticles = articles.filter(a => {\n    const titleToSearch = lang === \'en\' ? (a.titleEn || a.title) : a.title;\n    const matchesSearch =\n      !searchQuery ||\n      titleToSearch.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      a.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (a.focusKeyword && a.focusKeyword.toLowerCase().includes(searchQuery.toLowerCase())) ||\n      (a.slug && a.slug.toLowerCase().includes(searchQuery.toLowerCase()));\n\n    const matchesStatus =\n      statusFilter === \'all\' ||\n      (statusFilter === \'published\' && (!a.status || a.status === \'published\')) ||\n      a.status === statusFilter;\n\n    const matchesCategory =\n      categoryFilter === \'all\' || a.categorySlug === categoryFilter;\n\n    return matchesSearch && matchesStatus && matchesCategory;\n  });\n\n  return (\n    <div id=\"wp-admin-page-root\" className=\"min-h-screen bg-gray-50/60 pb-16\">\n      {/* Top Banner Header */}\n      <div className=\"bg-linear-to-r from-slate-950 via-zinc-900 to-gray-900 text-white border-b border-gray-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2 mb-2\">\n                <span className=\"px-2.5 py-0.5 rounded-md bg-rose-500/20 text-rose-400 border border-rose-500/30 text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5\" />\n                  {adminT.wpAdminBadge}\n                </span>\n                <span className=\"px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-bold\">\n                  {adminT.rankMathBadge}\n                </span>\n                {/* Admin Language Switcher in Badge Row */}\n                <div\n                  id=\"admin-lang-switcher\"\n                  className=\"flex items-center bg-zinc-800 p-0.5 rounded-lg border border-zinc-700 text-xs ml-auto sm:ml-2\"\n                  role=\"group\"\n                  aria-label=\"Language selection\"\n                >\n                  <button\n                    type=\"button\"\n                    onClick={() => setLang(\'hi\')}\n                    className={`px-2.5 py-0.5 rounded-md font-bold text-[11px] transition-all cursor-pointer ${\n                      lang === \'hi\'\n                        ? \'bg-rose-600 text-white shadow-xs\'\n                        : \'text-zinc-300 hover:text-white hover:bg-zinc-700\'\n                    }`}\n                  >\n                    \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setLang(\'en\')}\n                    className={`px-2.5 py-0.5 rounded-md font-bold text-[11px] transition-all cursor-pointer ${\n                      lang === \'en\'\n                        ? \'bg-rose-600 text-white shadow-xs\'\n                        : \'text-zinc-300 hover:text-white hover:bg-zinc-700\'\n                    }`}\n                  >\n                    English\n                  </button>\n                </div>\n              </div>\n              <h1 className=\"text-2xl sm:text-3xl font-black text-white tracking-tight\">\n                {adminT.adminPortalTitle}\n              </h1>\n              <p className=\"text-xs sm:text-sm text-gray-400 mt-1\">\n                {adminT.adminPortalSubtitle}\n              </p>\n            </div>\n\n            {/* Quick Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-3\">\n              <button\n                type=\"button\"\n                id=\"toggle-suite-top-btn\"\n                onClick={() => setActiveTab(\'suite\')}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-zinc-900 hover:bg-black text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm border border-zinc-700\"\n              >\n                <Sparkles className=\"w-4 h-4 text-rose-400\" />\n                <span>{adminT.aiSuiteBtn}</span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"create-new-article-top-btn\"\n                onClick={() => handleCreateNewArticle()}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-rose-900/40\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>{adminT.newArticleBtn}</span>\n              </button>\n\n              <button\n                type=\"button\"\n                id=\"toggle-assistant-top-btn\"\n                onClick={() => setActiveTab(\'assistant\')}\n                className=\"flex items-center gap-2 px-4 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm shadow-purple-900/40\"\n              >\n                <Bot className=\"w-4 h-4\" />\n                <span>{adminT.openAssistantBtn}</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 pt-6\">\n        {/* Metric Cards Row */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 mb-6\">\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">{adminT.metricTotalArticles}</span>\n            <div className=\"text-2xl font-black text-gray-900 mt-1\">{articles.length}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">{adminT.metricAvgSeo}</span>\n            <div className=\"text-2xl font-black text-emerald-600 mt-1 flex items-center gap-1.5\">\n              <span>{avgSeoScore}/100</span>\n              <span className=\"text-xs px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold\">{adminT.statusGood}</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">{adminT.metricScheduled}</span>\n            <div className=\"text-2xl font-black text-indigo-600 mt-1 flex items-center gap-1\">\n              <Clock className=\"w-4 h-4\" />\n              <span>{scheduledCount}</span>\n            </div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">{adminT.metricDrafts}</span>\n            <div className=\"text-2xl font-black text-amber-600 mt-1\">{draftCount}</div>\n          </div>\n          <div className=\"bg-white p-4 rounded-2xl border border-gray-200/80 shadow-2xs\">\n            <span className=\"text-[11px] text-gray-500 font-bold uppercase\">{adminT.metricBreaking}</span>\n            <div className=\"text-2xl font-black text-rose-600 mt-1 flex items-center gap-1\">\n              <Radio className=\"w-4 h-4 animate-pulse\" />\n              <span>{breakingCount}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Global Notification Banner */}\n        {notification && (\n          <div className=\"mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center justify-between shadow-xs animate-in fade-in duration-200\">\n            <div className=\"flex items-center gap-2.5 text-xs sm:text-sm font-bold\">\n              <CheckCircle className=\"w-5 h-5 text-emerald-600 shrink-0\" />\n              <span>{notification.message}</span>\n            </div>\n            {notification.slug && (\n              <Link\n                href={`/news/${notification.slug}`}\n                className=\"inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors shadow-2xs shrink-0\"\n              >\n                <span>{adminT.liveViewBtn}</span>\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n              </Link>\n            )}\n          </div>\n        )}\n\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center justify-between border-b border-gray-200 mb-6 bg-white rounded-2xl px-4 py-2 shadow-2xs overflow-x-auto\">\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              type=\"button\"\n              id=\"tab-suite-btn\"\n              onClick={() => setActiveTab(\'suite\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors cursor-pointer ${\n                activeTab === \'suite\'\n                  ? \'bg-zinc-950 text-white shadow-xs\'\n                  : \'text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100\'\n              }`}\n            >\n              <Sparkles className=\"w-4 h-4 text-rose-500\" />\n              <span>{adminT.tabSuite}</span>\n              <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-rose-600 text-white font-black uppercase tracking-wider\">\n                {adminT.tabSuiteBadge}\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-all-posts-btn\"\n              onClick={() => setActiveTab(\'list\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors cursor-pointer ${\n                activeTab === \'list\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <List className=\"w-4 h-4\" />\n              <span>{adminT.tabAllPosts} ({articles.length})</span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-editor-btn\"\n              onClick={() => {\n                if (!editingArticle) handleCreateNewArticle();\n                else setActiveTab(\'editor\');\n              }}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors cursor-pointer ${\n                activeTab === \'editor\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900 hover:bg-gray-100\'\n              }`}\n            >\n              <Edit3 className=\"w-4 h-4\" />\n              <span>\n                {editingArticle?.id ? adminT.tabEditorEdit : adminT.tabEditorNew}\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              id=\"tab-assistant-btn\"\n              onClick={() => setActiveTab(\'assistant\')}\n              className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-colors cursor-pointer ${\n                activeTab === \'assistant\'\n                  ? \'bg-purple-600 text-white shadow-xs\'\n                  : \'text-purple-700 hover:bg-purple-50\'\n              }`}\n            >\n              <Bot className=\"w-4 h-4\" />\n              <span>{adminT.tabAssistant}</span>\n            </button>\n          </div>\n\n          {/* Quick Indicator of active post in editor */}\n          {editingArticle?.title && activeTab !== \'editor\' && (\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'editor\')}\n              className=\"text-xs text-gray-500 hover:text-rose-600 font-semibold flex items-center gap-1 truncate max-w-xs shrink-0 pl-3 cursor-pointer\"\n            >\n              <span>{adminT.inEditorActive}</span>\n              <span className=\"font-bold text-gray-800 truncate\">\n                \"{lang === \'en\' ? (editingArticle.titleEn || editingArticle.title) : editingArticle.title}\"\n              </span>\n            </button>\n          )}\n        </div>"
      }
      num_matches: 1
    }
  }
}
