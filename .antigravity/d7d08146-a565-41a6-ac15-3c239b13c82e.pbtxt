  file_change {
    absolute_path_uri: "file:///src/components/TrendingWidget.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Article } from \'../types\';\nimport { Link } from \'../context/RouterContext\';\nimport { Flame, TrendingUp, Tag } from \'lucide-react\';\n\ninterface TrendingWidgetProps {\n  articles: Article[];\n}\n\nexport const TrendingWidget: React.FC<TrendingWidgetProps> = ({ articles }) => {\n  const topArticles = articles.slice(0, 5);\n\n  const trendingTags = [\n    { tag: \'ISRO\', link: \'/search?q=ISRO\' },\n    { tag: \'IND vs AUS\', link: \'/search?q=AUS\' },\n    { tag: \'\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250\', link: \'/search?q=\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250\' },\n    { tag: \'\340\244\227\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\271\340\244\276\340\244\207\340\244\241\340\245\215\340\244\260\340\245\213\340\244\234\340\244\250\', link: \'/search?q=\340\244\271\340\244\276\340\244\207\340\244\241\340\245\215\340\244\260\340\245\213\340\244\234\340\244\250\' },\n    { tag: \'RBI \340\244\260\340\245\207\340\244\252\340\245\213 \340\244\260\340\245\207\340\244\237\', link: \'/search?q=RBI\' },\n    { tag: \'\340\244\225\340\245\215\340\244\265\340\244\276\340\244\202\340\244\237\340\244\256 \340\244\270\340\245\201\340\244\252\340\244\260\340\244\225\340\244\202\340\244\252\340\245\215\340\244\257\340\245\202\340\244\237\340\244\260\', link: \'/search?q=\340\244\225\340\245\215\340\244\265\340\244\276\340\244\202\340\244\237\340\244\256\' },\n    { tag: \'\340\244\254\340\245\201\340\244\262\340\245\207\340\244\237 \340\244\237\340\245\215\340\244\260\340\245\207\340\244\250\', link: \'/search?q=\340\244\237\340\245\215\340\244\260\340\245\207\340\244\250\' }\n  ];\n\n  return (\n    <aside className=\"bg-white rounded-xl border border-gray-200 p-4 sm:p-5 shadow-xs\">\n      {/* Widget Header */}\n      <div className=\"flex items-center justify-between pb-3 border-b border-gray-100 mb-4\">\n        <div className=\"flex items-center gap-2 text-gray-900 font-extrabold text-base sm:text-lg\">\n          <div className=\"w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center\">\n            <TrendingUp className=\"w-4 h-4\" />\n          </div>\n          <span>\340\244\237\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\277\340\244\202\340\244\227 / \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\234\340\245\215\340\244\257\340\244\276\340\244\246\340\244\276 \340\244\252\340\244\242\340\244\274\340\245\200 \340\244\227\340\244\210\340\244\202</span>\n        </div>\n        <span className=\"flex items-center gap-1 text-[11px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full\">\n          <Flame className=\"w-3 h-3 fill-rose-600 text-rose-600 animate-pulse\" />\n          TOP 5\n        </span>\n      </div>\n\n      {/* Numbered List */}\n      <div className=\"space-y-3.5\">\n        {topArticles.map((article, idx) => (\n          <div key={article.id} className=\"flex items-start gap-3 group pb-3 border-b border-gray-100 last:border-0 last:pb-0\">\n            {/* Rank Number Badge */}\n            <div\n              className={`shrink-0 w-7 h-7 rounded-lg flex items-center justify-center font-black text-sm transition-transform group-hover:scale-110 ${\n                idx === 0\n                  ? \'bg-rose-600 text-white shadow-xs shadow-rose-200\'\n                  : idx === 1\n                  ? \'bg-orange-500 text-white\'\n                  : idx === 2\n                  ? \'bg-amber-500 text-white\'\n                  : \'bg-gray-100 text-gray-700 font-semibold\'\n              }`}\n            >\n              {idx + 1}\n            </div>\n\n            <div className=\"flex-1 min-w-0\">\n              <span className=\"text-[10px] font-bold text-rose-600 uppercase tracking-wide\">\n                {article.category}\n              </span>\n              <h4 className=\"text-xs sm:text-sm font-bold text-gray-900 line-clamp-2 leading-snug group-hover:text-rose-600 transition-colors mt-0.5\">\n                <Link href={`/news/${article.idSlug}`}>{article.title}</Link>\n              </h4>\n              <div className=\"mt-1 flex items-center gap-2 text-[10px] text-gray-500\">\n                <span>{article.views.toLocaleString(\'hi-IN\')} \340\244\252\340\244\276\340\244\240\340\244\225</span>\n                <span>\342\200\242</span>\n                <span>{article.readTime}</span>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Hot Topics / Trending Tags */}\n      <div className=\"mt-5 pt-4 border-t border-gray-100\">\n        <div className=\"flex items-center gap-1.5 text-xs font-bold text-gray-700 mb-2.5\">\n          <Tag className=\"w-3.5 h-3.5 text-gray-400\" />\n          <span>\340\244\262\340\245\213\340\244\225\340\244\252\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\265\340\244\277\340\244\267\340\244\257 (Trending Tags):</span>\n        </div>\n        <div className=\"flex flex-wrap gap-1.5\">\n          {trendingTags.map((item, i) => (\n            <Link\n              key={i}\n              href={item.link}\n              className=\"text-[11px] font-medium px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 hover:bg-rose-50 hover:text-rose-700 transition-colors\"\n            >\n              #{item.tag}\n            </Link>\n          ))}\n        </div>\n      </div>\n    </aside>\n  );\n};\n"
    }
