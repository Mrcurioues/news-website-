        lines {
          text: "  const [enhancerTool, setEnhancerTool] = useState<\'headlines\' | \'expander\' | \'readability\' | \'grammar\' | \'tone\' | \'plagiarism\'>(\'headlines\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [enhancerInput, setEnhancerInput] = useState(activeArticle.title || \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243\');"
