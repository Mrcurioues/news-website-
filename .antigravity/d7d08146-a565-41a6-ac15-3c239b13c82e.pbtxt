    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  BarChart3,\n  FileText,\n  Sparkles,\n  Search,\n  Calendar,\n  Image as ImageIcon,\n  Tag,\n  ShieldCheck,\n  History,\n  Trash2,\n  Settings,\n  PlusCircle,\n  CheckCircle2,\n  AlertTriangle,\n  Clock,\n  Eye,\n  Copy,\n  Check,\n  ExternalLink,\n  ChevronRight,\n  RefreshCw,\n  Send,\n  Zap,\n  Users,\n  BookOpen,\n  Keyboard,\n  Sliders,\n  Maximize2,\n  Edit3,\n  Share2,\n  Globe,\n  Radio,\n  FolderTree,\n  List,\n  AlertCircle\n} from \'lucide-react\';\nimport { Article, PostStatus, ContentFormat } from \'../../types\';\nimport { CATEGORIES } from \'../../data/demo\';\nimport {\n  performSeoAudit,\n  generateSeoSlug,\n  calculateFleschReadingEase,\n  calculateKeywordDensity\n} from \'../../utils/seoCalculator\';\n\ninterface WpAiSuiteProps {\n  articles: Article[];\n  currentArticle?: Partial<Article>;\n  onSelectArticle: (article: Article) => void;\n  onCreateArticle: (initialData?: Partial<Article>) => void;\n  onSaveArticle: (articleData: Partial<Article>) => void;\n  onRequestDelete: (id: string, title: string) => void;\n  onOpenEditor: () => void;\n  onOpenAssistant: () => void;\n}\n\nexport type SuiteSection =\n  | \'dashboard\'\n  | \'creation\'\n  | \'templates\'\n  | \'seo\'\n  | \'enhancer\'\n  | \'scheduling\'\n  | \'media\'\n  | \'revisions\'\n  | \'taxonomy\'\n  | \'roles\'\n  | \'delete_module\'\n  | \'settings_help\';\n\nexport const WpAiSuite: React.FC<WpAiSuiteProps> = ({\n  articles,\n  currentArticle,\n  onSelectArticle,\n  onCreateArticle,\n  onSaveArticle,\n  onRequestDelete,\n  onOpenEditor,\n  onOpenAssistant\n}) => {\n  const [activeSection, setActiveSection] = useState<SuiteSection>(\'dashboard\');\n  const [selectedArticleId, setSelectedArticleId] = useState<string>(\n    currentArticle?.id || (articles[0]?.id ?? \'\')\n  );\n  const [copiedKey, setCopiedKey] = useState<string | null>(null);\n  const [notification, setNotification] = useState<string | null>(null);\n\n  const activeArticle = articles.find((a) => a.id === selectedArticleId) || articles[0] || ({} as Article);\n\n  const triggerCopy = (text: string, key: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedKey(key);\n    setTimeout(() => setCopiedKey(null), 2000);\n  };\n\n  const showNotice = (msg: string) => {\n    setNotification(msg);\n    setTimeout(() => setNotification(null), 3500);\n  };\n\n  // Sync selected article when currentArticle changes from outside\n  useEffect(() => {\n    if (currentArticle?.id && currentArticle.id !== selectedArticleId) {\n      setSelectedArticleId(currentArticle.id);\n    }\n  }, [currentArticle?.id]);\n\n  /* =========================================================\n     MODULE 1: ARTICLE CREATION WIZARD STATE\n     ========================================================= */\n  const [creationStep, setCreationStep] = useState<1 | 2 | 3 | 4 | 5>(1);\n  const [createTitle, setCreateTitle] = useState(\'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\225\340\245\215\340\244\260\340\244\276\340\244\202\340\244\244\340\244\277: \340\244\230\340\244\260\340\245\207\340\244\262\340\245\202 \340\244\232\340\244\277\340\244\252 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243 \340\244\224\340\244\260 \340\244\255\340\244\265\340\244\277\340\244\267\340\245\215\340\244\257 \340\244\225\340\245\200 \340\244\244\340\244\225\340\244\250\340\245\200\340\244\225\');\n  const [createNiche, setCreateNiche] = useState(\'\340\244\244\340\244\225\340\244\250\340\245\200\340\244\225 \340\244\217\340\244\265\340\244\202 \340\244\207\340\244\262\340\245\207\340\244\225\340\245\215\340\244\237\340\245\215\340\244\260\340\245\211\340\244\250\340\244\277\340\244\225\340\245\215\340\244\270 (Technology)\');\n  const [createKeyword, setCreateKeyword] = useState(\'\340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243 \340\244\255\340\244\276\340\244\260\340\244\244\');\n  const [createWordCount, setCreateWordCount] = useState<number>(1500);\n  const [createTone, setCreateTone] = useState<\'professional\' | \'conversational\' | \'technical\' | \'beginner\'>(\'professional\');\n  const [createAudience, setCreateAudience] = useState(\'\340\244\211\340\244\246\340\245\215\340\244\257\340\245\213\340\244\227 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236, \340\244\244\340\244\225\340\244\250\340\245\200\340\244\225\340\245\200 \340\244\233\340\244\276\340\244\244\340\245\215\340\244\260 \340\244\265 \340\244\270\340\244\276\340\244\256\340\244\276\340\244\250\340\245\215\340\244\257 \340\244\252\340\244\276\340\244\240\340\244\225\');\n\n  // Step 2: Outline\n  const [generatedOutline, setGeneratedOutline] = useState<string[]>([\n    \'H2: \340\244\255\340\245\202\340\244\256\340\244\277\340\244\225\340\244\276 (Introduction) - \340\244\265\340\245\210\340\244\266\340\245\215\340\244\265\340\244\277\340\244\225 \340\244\232\340\244\277\340\244\252 \340\244\270\340\244\202\340\244\225\340\244\237 \340\244\224\340\244\260 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\225\340\245\200 \340\244\260\340\244\243\340\244\250\340\245\200\340\244\244\340\244\277\340\244\225 \340\244\252\340\244\271\340\244\262\',\n    \'H2: 1. \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\256\340\244\277\340\244\266\340\244\250 (ISM) \340\244\225\340\245\207 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\245\215\340\244\244\340\244\202\340\244\255\',\n    \'H3: \340\244\225) \340\244\227\340\245\201\340\244\234\340\244\260\340\244\276\340\244\244 \340\244\224\340\244\260 \340\244\205\340\244\270\340\244\256 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\252\340\244\277\340\244\244 \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\245\207 \340\244\250\340\244\217 \340\244\253\340\245\210\340\244\254\340\245\215\340\244\270\',\n    \'H3: \340\244\226) \340\244\252\340\245\200\340\244\217\340\244\262\340\244\206\340\244\210 (PLI) \340\244\270\340\245\215\340\244\225\340\245\200\340\244\256 \340\244\224\340\244\260 \340\244\265\340\245\210\340\244\266\340\245\215\340\244\265\340\244\277\340\244\225 \340\244\225\340\244\202\340\244\252\340\244\250\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\250\340\244\277\340\244\265\340\245\207\340\244\266\',\n    \'H2: 2. \340\244\230\340\244\260\340\245\207\340\244\262\340\245\202 \340\244\232\340\244\277\340\244\252 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243 \340\244\270\340\245\207 \340\244\206\340\244\244\340\245\215\340\244\256\340\244\250\340\244\277\340\244\260\340\245\215\340\244\255\340\244\260 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\225\340\245\213 \340\244\227\340\244\244\340\244\277\',\n    \'H3: \340\244\225) \340\244\221\340\244\237\340\245\213\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\265 5G \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\340\245\200\340\244\257 \340\244\232\340\244\277\340\244\252\340\245\215\340\244\270 \340\244\225\340\245\200 \340\244\206\340\244\252\340\245\202\340\244\260\340\245\215\340\244\244\340\244\277\',\n    \'H3: \340\244\226) \340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\224\340\244\260 \340\244\270\340\244\202\340\244\265\340\245\207\340\244\246\340\244\250\340\244\266\340\245\200\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n    \'H2: 3. \340\244\232\340\245\201\340\244\250\340\245\214\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202: \340\244\205\340\244\262\340\245\215\340\244\237\340\245\215\340\244\260\340\244\276-\340\244\252\340\245\215\340\244\257\340\245\213\340\244\260 \340\244\252\340\244\276\340\244\250\340\245\200, \340\244\250\340\244\277\340\244\260\340\245\215\340\244\254\340\244\276\340\244\247 \340\244\254\340\244\277\340\244\234\340\244\262\340\245\200 \340\244\265 \340\244\225\340\245\201\340\244\266\340\244\262 \340\244\234\340\244\250\340\244\266\340\244\225\340\245\215\340\244\244\340\244\277\',\n    \'H2: \340\244\250\340\244\277\340\244\267\340\245\215\340\244\225\340\244\260\340\245\215\340\244\267 (Conclusion) - 2030 \340\244\244\340\244\225 \340\244\227\340\245\215\340\244\262\340\245\213\340\244\254\340\244\262 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\271\340\244\254 \340\244\254\340\244\250\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\260\340\245\213\340\244\241\340\244\256\340\245\210\340\244\252\',\n    \'H2: \340\244\205\340\244\225\340\245\215\340\244\270\340\244\260 \340\244\252\340\245\202\340\244\233\340\245\207 \340\244\234\340\244\276\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250 (FAQs)\'\n  ]);\n\n  // Step 3: WordPress Metadata\n  const [createMetaTitle, setCreateMetaTitle] = useState(\'\340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243 \340\244\255\340\244\276\340\244\260\340\244\244: \340\244\232\340\244\277\340\244\252 \340\244\225\340\245\215\340\244\260\340\244\276\340\244\202\340\244\244\340\244\277 \340\244\224\340\244\260 \340\244\250\340\244\217 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237\340\245\215\340\244\270\');\n  const [createMetaDesc, setCreateMetaDesc] = useState(\'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207\340\244\256\340\245\200\340\244\225\340\244\202\340\244\241\340\244\225\340\245\215\340\244\237\340\244\260 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\276\340\244\243 \340\244\225\340\245\207 \340\244\250\340\244\217 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237\340\245\215\340\244\270, \340\244\252\340\245\200\340\244\217\340\244\262\340\244\206\340\244\210 \340\244\270\340\244\254\340\245\215\340\244\270\340\244\277\340\244\241\340\245\200 \340\244\224\340\244\260 \340\244\230\340\244\260\340\245\207\340\244\262\340\245\202 \340\244\232\340\244\277\340\244\252 \340\244\211\340\244\244\340\245\215\340\244\252\340\244\276\340\244\246\340\244\250 \340\244\252\340\244\260 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202\340\245\244\');\n  const [createSlug, setCreateSlug] = useState(\'semiconductor-manufacturing-india-chip-revolution\');\n  const [createCategory, setCreateCategory] = useState(\'tech\');\n  const [create