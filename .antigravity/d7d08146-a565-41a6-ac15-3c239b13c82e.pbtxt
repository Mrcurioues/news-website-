  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { CATEGORIES } from \'../data/demo\';\nimport { Link, useRouter, usePathname } from \'../context/RouterContext\';\nimport { getCategoryName, getFormattedDate } from \'../utils/translations\';\nimport {\n  Search,\n  Menu,\n  X,\n  Tv,\n  Calendar,\n  CloudSun,\n  Video,\n  Camera,\n  ShieldCheck,\n  ChevronRight,\n  Globe\n} from \'lucide-react\';\n\nexport const Header: React.FC = () => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [searchOpen, setSearchOpen] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [formattedDate, setFormattedDate] = useState(\'\');\n  const pathname = usePathname();\n  const { push, lang, setLang, t } = useRouter();\n\n  useEffect(() => {\n    setFormattedDate(getFormattedDate(lang));\n  }, [lang]);\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (searchQuery.trim()) {\n      push(`/search?q=${encodeURIComponent(searchQuery.trim())}`);\n      setSearchOpen(false);\n      setMobileMenuOpen(false);\n      setSearchQuery(\'\');\n    }\n  };\n\n  return (\n    <header className=\"w-full bg-white z-40 shadow-xs\">\n      {/* 1. Top Utility Strip */}\n      <div className=\"bg-gray-900 text-gray-300 text-xs border-b border-gray-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 h-9 flex items-center justify-between\">\n          {/* Date & Weather */}\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-1.5 text-gray-300\">\n              <Calendar className=\"w-3.5 h-3.5 text-rose-500\" />\n              <span>{formattedDate || (lang === \'en\' ? \'Thursday, September 3, 2026\' : \'\340\244\227\340\245\201\340\244\260\340\245\201\340\244\265\340\244\276\340\244\260, 3 \340\244\270\340\244\277\340\244\244\340\244\202\340\244\254\340\244\260 2026\')}</span>\n            </div>\n            <div className=\"hidden sm:flex items-center gap-1.5 text-gray-300\">\n              <CloudSun className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>{lang === \'en\' ? \'New Delhi 32\302\260C\' : \'\340\244\250\340\244\210 \340\244\246\340\244\277\340\244\262\340\245\215\340\244\262\340\245\200 32\302\260C\'}</span>\n            </div>\n          </div>\n\n          {/* Right Utility Buttons */}\n          <div className=\"flex items-center gap-2.5 sm:gap-4\">\n            {/* Live TV Link */}\n            <Link\n              href=\"/videos\"\n              className=\"flex items-center gap-1 text-rose-400 hover:text-rose-300 font-bold uppercase tracking-wider text-[11px]\"\n            >\n              <span className=\"inline-block w-2 h-2 rounded-full bg-rose-500 animate-pulse\"></span>\n              <Tv className=\"w-3.5 h-3.5\" />\n              <span>{t.liveTv}</span>\n            </Link>\n\n            {/* Language Switcher Button (Highlighted state for active language) */}\n            <div\n              id=\"language-switcher-header\"\n              className=\"flex items-center bg-gray-800 p-0.5 rounded-md border border-gray-700 text-[11px] shadow-xs\"\n              role=\"group\"\n              aria-label=\"Language selection\"\n            >\n              <button\n                type=\"button\"\n                id=\"lang-btn-hi\"\n                onClick={() => setLang(\'hi\')}\n                className={`px-2 py-0.5 rounded font-bold transition-all cursor-pointer ${\n                  lang === \'hi\'\n                    ? \'bg-rose-600 text-white shadow-xs\'\n                    : \'text-gray-300 hover:text-white hover:bg-gray-700\'\n                }`}\n                title=\"\340\244\252\340\245\202\340\244\260\340\245\200 \340\244\265\340\245\207\340\244\254\340\244\270\340\244\276\340\244\207\340\244\237 \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 \340\244\256\340\245\207\340\244\202 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\"\n              >\n                \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200\n              </button>\n              <button\n                type=\"button\"\n                id=\"lang-btn-en\"\n                onClick={() => setLang(\'en\')}\n                className={`px-2 py-0.5 rounded font-bold transition-all cursor-pointer ${\n                  lang === \'en\'\n                    ? \'bg-rose-600 text-white shadow-xs\'\n                    : \'text-gray-300 hover:text-white hover:bg-gray-700\'\n                }`}\n                title=\"View entire website in English\"\n              >\n                English\n              </button>\n            </div>\n\n            {/* Demo Admin Link */}\n            <Link\n              href=\"/admin\"\n              className=\"hidden sm:flex items-center gap-1 text-gray-400 hover:text-white text-[11px] transition-colors\"\n            >\n              <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>{t.admin}</span>\n            </Link>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. Main Logo & Brand Banner */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-3.5 sm:py-5 flex items-center justify-between\">\n        {/* Brand Logo */}\n        <Link href=\"/\" className=\"flex items-center gap-3 group\">\n          <div className=\"w-10 h-10 sm:w-12 sm:h-12 bg-rose-600 rounded-xl flex items-center justify-center text-white font-black text-xl sm:text-2xl shadow-md group-hover:bg-rose-700 transition-colors\">\n            {lang === \'en\' ? \'BN\' : \'\340\244\255\340\244\276\'}\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-xl sm:text-3xl font-black tracking-tight text-gray-950 font-serif\">\n                {t.appName}\n              </span>\n              <span className=\"bg-rose-600 text-white font-black text-[10px] sm:text-xs px-2 py-0.5 rounded tracking-widest uppercase animate-pulse\">\n                {t.appNameSuffix}\n              </span>\n            </div>\n            <p className=\"text-[10px] sm:text-xs text-gray-500 font-medium tracking-wide\">\n              {t.tagline}\n            </p>\n          </div>\n        </Link>\n\n        {/* Header Ad Slot (Desktop Leaderboard) */}\n        <div className=\"hidden lg:block\">\n          <div className=\"w-[468px] h-[60px] border border-dashed border-gray-300 bg-gray-50 rounded-lg p-2 flex items-center justify-between text-xs text-gray-500 shadow-2xs\">\n            <div>\n              <span className=\"text-[10px] text-gray-400 uppercase font-semibold block\">{t.adNotice}</span>\n              <span className=\"font-bold text-gray-700\">\n                {lang === \'en\' ? \'National Clean Energy & Digital Literacy Mission\' : \'\340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 \340\244\265\340\244\277\340\244\225\340\244\276\340\244\270 \340\244\217\340\244\265\340\244\202 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276 \340\244\256\340\244\277\340\244\266\340\244\250\'}\n              </span>\n            </div>\n            <span className=\"px-2 py-1 bg-rose-50 text-rose-700 rounded font-semibold text-[11px]\">\n              {t.learnMore}\n            </span>\n          </div>\n        </div>\n\n        {/* Mobile Action Buttons */}\n        <div className=\"flex items-center gap-2 lg:hidden\">\n          <button\n            type=\"button\"\n            onClick={() => setSearchOpen(!searchOpen)}\n            className=\"p-2 text-gray-700 hover:text-rose-600 rounded-lg hover:bg-gray-100\"\n            aria-label=\"Search\"\n          >\n            <Search className=\"w-5 h-5\" />\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"p-2 text-gray-700 hover:text-rose-600 rounded-lg hover:bg-gray-100\"\n            aria-label=\"Toggle Navigation\"\n          >\n            {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* 3. Sticky Category Navigation Bar */}\n      <nav className=\"sticky top-0 z-30 bg-rose-700 text-white shadow-md\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between\">\n          {/* Categories Links (Desktop Horizontal Scroll) */}\n          <div className=\"flex items-center space-x-1 sm:space-x-2 overflow-x-auto py-1 scrollbar-none\">\n            <Link\n              href=\"/\"\n              className={`px-3 py-2 text-sm font-bold whitespace-nowrap rounded transition-colors ${\n                pathname === \'/\' ? \'bg-rose-900 text-white\' : \'hover:bg-rose-800 text-rose-50\'\n              }`}\n            >\n              {t.home}\n            </Link>\n\n            {CATEGORIES.map((cat) => {\n              const isActive = pathname === `/category/${cat.slug}`;\n              const label = getCategoryName(cat, lang);\n              return (\n                <Link\n                  key={cat.id}\n                  href={`/category/${cat.slug}`}\n                  className={`px-3 py-2 text-sm font-bold whitespace-nowrap rounded transition-colors ${\n                    isActive ? \'bg-rose-900 text-white\' : \'hover:bg-rose-800 text-rose-50\'\n                  }`}\n                >\n                  {label}\n                </Link>\n              );\n            })}\n\n            {/* Special Media Tabs */}\n            <Link\n              href=\"/videos\"\n              className={`flex items-center gap-1 px-3 py-2 text-sm font-bold whitespace-nowrap rounded transition-colors ${\n                pathname.startsWith(\'/videos\') ? \'bg-rose-900 text-white\' : \'hover:bg-rose-800 text-rose-50\'\n              }`}\n            >\n              <Video className=\"w-3.5 h-3.5\" />\n              <span>{t.videos}</span>\n            </Link>\n\n            <Link\n              href=\"/photos\"\n              className={`flex items-center gap-1 px-3 py-2 text-sm font-bold whitespace-nowrap rounded transition-colors ${\n                pathname.startsWith(\'/photos\') ? \'bg-rose-900 text-white\' : \'hover:bg-rose-800 text-rose-50\'\n              }`}\n            >\n              <Camera className=\"w-3.5 h-3.5\" />\n              <span>{t.photos}</span>\n            </Link>\n          </div>\n\n          {/* Desktop Search Trigger */}\n          <div className=\"hidden lg:flex items-center pl-2\">\n            <button\n              type=\"button\"\n              onClick={() => setSearchOpen(!searchOpen)}\n              className=\"flex items-center gap-1 px-3 py-1.5 rounded-full bg-rose-800 hover:bg-rose-900 text-xs font-semibold text-rose-100 transition-colors\"\n            >\n              <Search className=\"w-3.5 h-3.5\" />\n              <span>{t.search}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Expandable Search Input Bar */}\n        {searchOpen && (\n          <div className=\"bg-rose-800 px-4 py-3 border-t border-rose-900\">\n            <div className=\"max-w-3xl mx-auto\">\n              <form onSubmit={handleSearchSubmit} className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder={t.searchPlaceholder}\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  autoFocus\n                  className=\"flex-1 px-4 py-2 rounded-lg bg-white text-gray-900 text-sm focus:outline-hidden focus:ring-2 focus:ring-amber-400\"\n                />\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 bg-amber-400 hover:bg-amber-500 text-gray-950 font-bold text-sm rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer\"\n                >\n                  <Search className=\"w-4 h-4\" />\n                  <span>{t.search}</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setSearchOpen(false)}\n                  className=\"px-3 py-2 text-rose-200 hover:text-white text-sm cursor-pointer\"\n                >\n                  {t.cancel}\n                </button>\n              </form>\n            </div>\n          </div>\n        )}\n      </nav>\n\n      {/* 4. Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex\">\n          <div className=\"w-4/5 max-w-sm bg-white h-full shadow-2xl flex flex-col overflow-y-auto\">\n            {/* Drawer Header */}\n            <div className=\"p-4 bg-rose-700 text-white flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-white text-rose-700 font-black flex items-center justify-center text-base\">\n                  {lang === \'en\' ? \'BN\' : \'\340\244\255\340\244\276\'}\n                </div>\n                <div>\n                  <h3 className=\"font-bold text-base leading-none\">\n                    {lang === \'en\' ? \'BHARAT NEWS LIVE\' : \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 LIVE\'}\n                  </h3>\n                  <span className=\"text-[10px] text-rose-200\">\n                    {lang === \'en\' ? \'Menu & Categories\' : \'\340\244\256\340\245\207\340\244\250\340\245\202 \340\244\217\340\244\265\340\244\202 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202\'}\n                  </span>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setMobileMenuOpen(false)}\n                className=\"p-1.5 text-white hover:bg-rose-800 rounded-lg\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Mobile Language Switcher Card */}\n            <div className=\"p-3 bg-rose-50 border-b border-rose-100 flex items-center justify-between\">\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-rose-950\">\n                <Globe className=\"w-4 h-4 text-rose-600\" />\n                <span>{lang === \'en\' ? \'Language:\' : \'\340\244\255\340\244\276\340\244\267\340\244\276:\'}</span>\n              </div>\n              <div className=\"flex bg-white rounded-lg p-0.5 border border-rose-200 shadow-2xs\">\n                <button\n                  type=\"button\"\n                  onClick={() => setLang(\'hi\')}\n                  className={`px-3 py-1 text-xs font-bold rounded-md transition-all ${\n                    lang === \'hi\'\n                      ? \'bg-rose-600 text-white shadow-xs\'\n                      : \'text-gray-700 hover:bg-gray-100\'\n                  }`}\n                >\n                  \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setLang(\'en\')}\n                  className={`px-3 py-1 text-xs font-bold rounded-md transition-all ${\n                    lang === \'en\'\n                      ? \'bg-rose-600 text-white shadow-xs\'\n                      : \'text-gray-700 hover:bg-gray-100\'\n                  }`}\n                >\n                  English\n                </button>\n              </div>\n            </div>\n\n            {/* Search inside Mobile Menu */}\n            <div className=\"p-4 border-b border-gray-100\">\n              <form onSubmit={handleSearchSubmit} className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  placeholder={t.searchPlaceholder}\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"flex-1 px-3 py-2 rounded-md border border-gray-300 text-sm focus:outline-hidden focus:border-rose-600\"\n                />\n                <button type=\"submit\" className=\"p-2 bg-rose-600 text-white rounded-md\">\n                  <Search className=\"w-4 h-4\" />\n                </button>\n              </form>\n            </div>\n\n            {/* Category Links */}\n            <div className=\"p-2 flex-1 space-y-1\">\n              <Link\n                href=\"/\"\n                onClick={() => setMobileMenuOpen(false)}\n                className=\"flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-bold text-gray-800 hover:bg-rose-50 hover:text-rose-600\"\n              >\n                <span>{t.home}</span>\n                <ChevronRight className=\"w-4 h-4 text-gray-400\" />\n              </Link>\n\n              {CATEGORIES.map((cat) => {\n                const label = getCategoryName(cat, lang);\n                return (\n                  <Link\n                    key={cat.id}\n                    href={`/category/${cat.slug}`}\n                    onClick={() => setMobileMenuOpen(false)}\n                    className=\"flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-bold text-gray-800 hover:bg-rose-50 hover:text-rose-600\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"w-2 h-2 rounded-full bg-rose-600\"></span>\n                      <span>{label}</span>\n                    </div>\n                    <ChevronRight className=\"w-4 h-4 text-gray-400\" />\n                  </Link>\n                );\n              })}\n\n              <div className=\"pt-2 border-t border-gray-200\">\n                <Link\n                  href=\"/videos\"\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-bold text-gray-800 hover:bg-rose-50 hover:text-rose-600\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <Video className=\"w-4 h-4 text-rose-600\" />\n                    <span>{t.videoBulletins}</span>\n                  </div>\n                  <ChevronRight className=\"w-4 h-4 text-gray-400\" />\n                </Link>\n\n                <Link\n                  href=\"/photos\"\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-bold text-gray-800 hover:bg-rose-50 hover:text-rose-600\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <Camera className=\"w-4 h-4 text-rose-600\" />\n                    <span>{t.photoGalleries}</span>\n                  </div>\n                  <ChevronRight className=\"w-4 h-4 text-gray-400\" />\n                </Link>\n\n                <Link\n                  href=\"/admin\"\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"flex items-center justify-between px-4 py-2.5 rounded-lg text-sm font-bold text-emerald-700 hover:bg-emerald-50\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <ShieldCheck className=\"w-4 h-4 text-emerald-600\" />\n                    <span>{t.admin}</span>\n                  </div>\n                  <ChevronRight className=\"w-4 h-4 text-emerald-400\" />\n                </Link>\n              </div>\n            </div>\n\n            {/* Mobile Drawer Footer */}\n            <div className=\"p-4 bg-gray-50 border-t border-gray-200 text-xs text-gray-500\">\n              <p className=\"font-semibold text-gray-700 mb-1\">\n                {lang === \'en\' ? \'Bharat News Live App\' : \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\220\340\244\252\'}\n              </p>\n              <p className=\"text-[11px] text-gray-500\">\n                {lang === \'en\'\n                  ? \'Stay connected for real-time unbiased journalism.\'\n                  : \'\340\244\270\340\244\237\340\245\200\340\244\225 \340\244\224\340\244\260 \340\244\250\340\244\277\340\244\267\340\245\215\340\244\252\340\244\225\340\245\215\340\244\267 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\234\340\245\201\340\244\241\340\244\274\340\245\207 \340\244\260\340\244\271\340\245\207\340\244\202\340\245\244\'}\n              </p>\n            </div>\n          </div>\n\n          {/* Dismiss Click Area */}\n          <div className=\"flex-1\" onClick={() => setMobileMenuOpen(false)}></div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
