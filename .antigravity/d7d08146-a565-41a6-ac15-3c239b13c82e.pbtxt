    replacement_infos {
      original_chunk {
        target_content: "    // AI Suite Sidebar Modules\n    moduleNavHeader: \'\340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 \340\244\217\340\244\265\340\244\202 \340\244\270\340\245\215\340\244\265\340\244\232\340\244\276\340\244\262\340\244\250 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Modules)\',\n    modDashboard: \'1. \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\217\340\244\250\340\244\276\340\244\262\340\244\277\340\244\237\340\244\277\340\244\225\340\245\215\340\244\270\',\n    modCreation: \'2. \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\215\340\244\260\340\244\277\340\244\217\340\244\266\340\244\250 \340\244\265\340\244\277\340\244\234\340\244\276\340\244\260\340\245\215\340\244\241\',\n    modTemplates: \'3. \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270 \340\244\262\340\244\276\340\244\207\340\244\254\340\245\215\340\244\260\340\245\207\340\244\260\340\245\200\',\n    modSeo: \'4. On-Page SEO \340\244\265 \340\244\260\340\245\210\340\244\202\340\244\225 \340\244\256\340\245\210\340\244\245\',\n    modEnhancer: \'5. AI \340\244\225\340\244\202\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\217\340\244\250\340\245\215\340\244\271\340\244\276\340\244\202\340\244\270\340\244\260 (8 \340\244\237\340\245\202\340\244\262\340\245\215\340\244\270)\',\n    modScheduling: \'6. \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\265 12-\340\244\252\340\245\215\340\244\265\340\244\276\340\244\207\340\244\202\340\244\237 \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\',\n    modMedia: \'7. \340\244\256\340\245\200\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\265 \340\244\207\340\244\256\340\245\207\340\244\234 SEO (Alt Text)\',\n    modRevisions: \'8. \340\244\221\340\244\237\340\245\213-\340\244\270\340\245\207\340\244\265 \340\244\265 \340\244\260\340\244\277\340\244\265\340\244\277\340\244\234\340\244\250 \340\244\241\340\244\277\340\244\253\',\n    modTaxonomy: \'9. \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 \340\244\217\340\244\265\340\244\202 \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270\',\n    modRoles: \'10. \340\244\257\340\245\202\340\244\234\340\244\260 \340\244\260\340\245\213\340\244\262\340\245\215\340\244\270 \340\244\265 \340\244\265\340\244\260\340\245\215\340\244\225\340\244\253\340\245\215\340\244\262\340\245\213\',\n    modDelete: \'11. \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\265 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237\',\n    modSettings: \'12. \340\244\266\340\245\211\340\244\260\340\245\215\340\244\237\340\244\225\340\244\237\340\245\215\340\244\270, \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 \340\244\265 \340\244\227\340\244\276\340\244\207\340\244\241\',\n\n    // Module 1: Dashboard\n    dashTitle: \'\340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\225\340\245\200\340\244\257 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\217\340\244\250\340\244\276\340\244\262\340\244\277\340\244\237\340\244\277\340\244\225\340\245\215\340\244\270\',\n    dashSubtitle: \'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\252\340\244\260\340\244\253\340\245\211\340\244\260\340\245\215\340\244\256\340\245\207\340\244\202\340\244\270, \340\244\221\340\244\260\340\245\215\340\244\227\340\245\207\340\244\250\340\244\277\340\244\225 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\277\340\244\225, \340\244\217\340\244\270\340\244\210\340\244\223 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\270\340\245\215\340\244\245\340\245\215\340\244\257 \340\244\217\340\244\265\340\244\202 \340\244\252\340\244\276\340\244\240\340\244\225 \340\244\270\340\244\271\340\244\255\340\244\276\340\244\227\340\244\277\340\244\244\340\244\276 \340\244\256\340\245\207\340\244\237\340\245\215\340\244\260\340\244\277\340\244\225\340\245\215\340\244\270\',\n    dashTotalPublished: \'\340\244\225\340\245\201\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262\',\n    dashTotalWords: \'\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\227\340\244\243\340\244\250\340\244\276 (Words)\',\n    dashTotalViews: \'\340\244\225\340\245\201\340\244\262 \340\244\270\340\244\202\340\244\232\340\244\257\340\245\200 \340\244\252\340\245\207\340\244\234\340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\',\n    dashAvgTime: \'\340\244\224\340\244\270\340\244\244 \340\244\252\340\244\240\340\244\250 \340\244\270\340\244\256\340\244\257\',\n    dashAvgRank: \'\340\244\224\340\244\270\340\244\244 \340\244\227\340\245\202\340\244\227\340\244\262 \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\260\340\245\210\340\244\202\340\244\225\',\n    dashTrafficAnalytics: \'30-\340\244\246\340\244\277\340\244\265\340\244\270\340\245\200\340\244\257 \340\244\237\340\245\215\340\244\260\340\245\210\