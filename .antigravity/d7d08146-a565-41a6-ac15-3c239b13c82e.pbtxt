    instruction: "Update Module 1 Dashboard with translations in WpAiSuite"
    replacement_infos {
      original_chunk {
        target_content: "          {/* =========================================================\n              VIEW 1: DASHBOARD & OVERVIEW (Module 4 & 9)\n             ========================================================= */}\n          {activeSection === \'dashboard\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <BarChart3 className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\256\340\245\210\340\244\250\340\245\207\340\244\234\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\241\340\245\210\340\244\266\340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\246\340\244\260\340\245\215\340\244\266\340\244\250 \340\244\256\340\245\210\340\244\237\340\245\215\340\244\260\340\244\277\340\244\225\340\245\215\340\244\270</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\225\340\245\201\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\262\340\245\207\340\244\226, \340\244\224\340\244\270\340\244\244 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\227\340\244\243\340\244\250\340\244\276, \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\241\340\244\276\340\244\211\340\244\250 \340\244\217\340\244\265\340\244\202 \340\244\226\340\245\213\340\244\234 \340\244\260\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'creation\')}\n                  className=\"px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs\"\n                >\n                  <PlusCircle className=\"w-3.5 h-3.5\" />\n                  <span>\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202</span>\n                </button>\n              </div>\n\n              {/* 8 Stats Grid */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">{articles.length}</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80\">\n                  <span className=\"text-[10px] font-bold text-emerald-700 uppercase\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Live)</span>\n                  <div className=\"text-xl font-black text-emerald-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'published\' || !a.status).length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/80\">\n                  <span className=\"text-[10px] font-bold text-amber-700 uppercase\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237\340\245\215\340\244\270 (Drafts)</span>\n                  <div className=\"text-xl font-black text-amber-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'draft\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-indigo-50/60 border border-indigo-200/80\">\n                  <span className=\"text-[10px] font-bold text-indigo-700 uppercase\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</span>\n                  <div className=\"text-xl font-black text-indigo-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'scheduled\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Words)</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">\n                    {articles.reduce((acc, a) => acc + (a.body?.join(\' \').split(/\\s+/).length || 650), 0).toLocaleString(\'hi-IN\')}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\224\340\244\270\340\244\244 \340\244\266\340\244\254\340\245\215\340\244\246 \340\244\227\340\244\243\340\244\250\340\244\276</span>\n                  <div className=\"text-xl font-black text-purple-700 mt-0.5\">1,120 \340\244\266\340\244\254\340\245\215\340\244\246</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200</span>\n                  <div className=\"text-base font-black text-rose-600 mt-0.5 truncate\">\340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 (National)</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">\340\244\224\340\244\270\340\244\244 SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260</span>\n                  <div className=\"text-xl font-black text-emerald-600 mt-0.5\">88/100</div>\n                </div>\n              </div>\n\n              {/* Traffic & Search Analytics */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"p-4 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center justify-between\">\n                    <span>\340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\277\340\244\225 \340\244\206\340\244\202\340\244\225\340\244\241\340\244\274\340\245\207 (Traffic Stats)</span>\n                    <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\225\340\245\201\340\244\262 \340\244\252\340\245\207\340\244\234 \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274:</span>\n                      <span className=\"font-mono font-bold text-white\">4,82,900</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\265\340\244\277\340\244\266\340\244\277\340\244\267\340\245\215\340\244\237 \340\244\252\340\244\276\340\244\240\340\244\225 (Unique):</span>\n                      <span className=\"font-mono font-bold text-emerald-400\">1,94,200</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">\340\244\224\340\244\270\340\244\244 \340\244\270\340\244\256\340\244\257 (Time on Page):</span>\n                      <span className=\"font-mono font-bold text-white\">3 \340\244\256\340\244\277\340\244\250\340\244\237 42 \340\244\270\340\245\207\340\244\225\340\244\202\340\244\241</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-zinc-400\">\340\244\254\340\244\276\340\244\211\340\244\202\340\244\270 \340\244\260\340\245\207\340\244\237 (Bounce Rate):</span>\n                      <span className=\"font-mono font-bold text-amber-400\">32.4% (Best)</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\241\340\244\276\340\244\211\340\244\250 (Device Share)\n                  </h4>\n                  <div className=\"space-y-2\">\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 (Mobile Devices)</span>\n                        <span>68%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-rose-600 h-2 rounded-full\" style={{ width: \'68%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\241\340\245\207\340\244\270\340\245\215\340\244\225\340\244\237\340\245\211\340\244\252 (Desktop / Laptops)</span>\n                        <span>28%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-indigo-600 h-2 rounded-full\" style={{ width: \'28%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>\340\244\237\340\245\210\340\244\254\340\244\262\340\245\207\340\244\237 (Tablets)</span>\n                        <span>4%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-amber-600 h-2 rounded-full\" style={{ width: \'4%\' }} />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    \340\244\226\340\245\213\340\244\234 \340\244\260\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 (Google CTR & Rank)\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\224\340\244\270\340\244\244 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 (Position):</span>\n                      <span className=\"font-black text-emerald-600 font-mono\">#3.8</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\207\340\244\202\340\244\252\340\245\215\340\244\260\340\245\207\340\244\266\340\244\250 (Impressions):</span>\n                      <span className=\"font-mono font-bold text-gray-800\">12,40,000</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">\340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\245\340\245\215\340\244\260\340\245\202 \340\244\260\340\245\207\340\244\237 (CTR):</span>\n                      <span className=\"font-mono font-bold text-purple-600\">8.4%</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267 \340\244\226\340\245\213\340\244\234 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241:</span>\n                      <span className=\"font-bold text-rose-600 truncate max-w-[120px]\">\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 \340\244\256\340\244\277\340\244\266\340\244\250 2026</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Actions Bar */}\n              <div className=\"p-4 rounded-2xl bg-linear-to-r from-gray-50 via-rose-50/40 to-purple-50/40 border border-gray-200 flex flex-wrap items-center justify-between gap-3\">\n                <span className=\"text-xs font-bold text-gray-700\">\n                  \340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257 (Quick Actions):\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'creation\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-rose-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \342\236\225 New Article\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'templates\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-purple-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\216\250 Templates\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'seo\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-emerald-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\224\215 SEO Audit\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'scheduling\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-indigo-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\223\205 Schedule\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'enhancer\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-amber-500 text-xs font-bold rounded-xl shadow-2xs\"\n                  >\n                    \360\237\252\204 AI Enhancer\n                  </button>\n                </div>\n              </div>\n            </div>\n          )}"
        replacement_content: "          {/* =========================================================\n              VIEW 1: DASHBOARD & OVERVIEW (Module 4 & 9)\n             ========================================================= */}\n          {activeSection === \'dashboard\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-gray-900 flex items-center gap-2\">\n                    <BarChart3 className=\"w-5 h-5 text-rose-600\" />\n                    <span>{t.dashTitle}</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    {t.dashSubtitle}\n                  </p>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'creation\')}\n                  className=\"px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center gap-1.5 shadow-xs cursor-pointer\"\n                >\n                  <PlusCircle className=\"w-3.5 h-3.5\" />\n                  <span>{t.btnNewArticle}</span>\n                </button>\n              </div>\n\n              {/* 8 Stats Grid */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">{t.dashTotalArticles}</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">{articles.length}</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-emerald-50/60 border border-emerald-200/80\">\n                  <span className=\"text-[10px] font-bold text-emerald-700 uppercase\">{t.dashPublished}</span>\n                  <div className=\"text-xl font-black text-emerald-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'published\' || !a.status).length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/80\">\n                  <span className=\"text-[10px] font-bold text-amber-700 uppercase\">{t.dashDrafts}</span>\n                  <div className=\"text-xl font-black text-amber-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'draft\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-indigo-50/60 border border-indigo-200/80\">\n                  <span className=\"text-[10px] font-bold text-indigo-700 uppercase\">{t.dashScheduled}</span>\n                  <div className=\"text-xl font-black text-indigo-700 mt-0.5\">\n                    {articles.filter((a) => a.status === \'scheduled\').length}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">{t.dashTotalWords}</span>\n                  <div className=\"text-xl font-black text-gray-900 mt-0.5\">\n                    {articles.reduce((acc, a) => acc + (a.body?.join(\' \').split(/\\s+/).length || 650), 0).toLocaleString(lang === \'hi\' ? \'hi-IN\' : \'en-US\')}\n                  </div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">{t.dashAvgWordCount}</span>\n                  <div className=\"text-xl font-black text-purple-700 mt-0.5\">{lang === \'en\' ? \'1,120 words\' : \'1,120 \340\244\266\340\244\254\340\245\215\340\244\246\'}</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">{t.dashTopCategory}</span>\n                  <div className=\"text-base font-black text-rose-600 mt-0.5 truncate\">{lang === \'en\' ? \'National\' : \'\340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 (National)\'}</div>\n                </div>\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/80\">\n                  <span className=\"text-[10px] font-bold text-gray-500 uppercase\">{t.dashAvgSeoScore}</span>\n                  <div className=\"text-xl font-black text-emerald-600 mt-0.5\">88/100</div>\n                </div>\n              </div>\n\n              {/* Traffic & Search Analytics */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"p-4 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center justify-between\">\n                    <span>{t.trafficStatsHeader}</span>\n                    <Radio className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse\" />\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.totalPageViews}:</span>\n                      <span className=\"font-mono font-bold text-white\">{lang === \'hi\' ? \'4,82,900\' : \'482,900\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.uniqueReaders}:</span>\n                      <span className=\"font-mono font-bold text-emerald-400\">{lang === \'hi\' ? \'1,94,200\' : \'194,200\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-zinc-800\">\n                      <span className=\"text-zinc-400\">{t.avgTimeOnPage}:</span>\n                      <span className=\"font-mono font-bold text-white\">{t.avgTimeVal}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-zinc-400\">{t.bounceRate}:</span>\n                      <span className=\"font-mono font-bold text-amber-400\">32.4% (Best)</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.deviceShareHeader}\n                  </h4>\n                  <div className=\"space-y-2\">\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.mobileDevices}</span>\n                        <span>68%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-rose-600 h-2 rounded-full\" style={{ width: \'68%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.desktopLaptops}</span>\n                        <span>28%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-indigo-600 h-2 rounded-full\" style={{ width: \'28%\' }} />\n                      </div>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-xs mb-1 font-semibold\">\n                        <span>{t.tablets}</span>\n                        <span>4%</span>\n                      </div>\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\n                        <div className=\"bg-amber-600 h-2 rounded-full\" style={{ width: \'4%\' }} />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-2xl bg-white border border-gray-200 space-y-3\">\n                  <h4 className=\"text-xs font-bold uppercase tracking-wider text-gray-500\">\n                    {t.searchRankingHeader}\n                  </h4>\n                  <div className=\"space-y-2 text-xs\">\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.avgPosition}:</span>\n                      <span className=\"font-black text-emerald-600 font-mono\">#3.8</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.impressions}:</span>\n                      <span className=\"font-mono font-bold text-gray-800\">{lang === \'hi\' ? \'12,40,000\' : \'1,240,000\'}</span>\n                    </div>\n                    <div className=\"flex justify-between py-1 border-b border-gray-100\">\n                      <span className=\"text-gray-500\">{t.ctr}:</span>\n                      <span className=\"font-mono font-bold text-purple-600\">8.4%</span>\n                    </div>\n                    <div className=\"flex justify-between py-1\">\n                      <span className=\"text-gray-500\">{t.topSearchKeyword}:</span>\n                      <span className=\"font-bold text-rose-600 truncate max-w-[120px]\">{t.topKeywordVal}</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Quick Actions Bar */}\n              <div className=\"p-4 rounded-2xl bg-linear-to-r from-gray-50 via-rose-50/40 to-purple-50/40 border border-gray-200 flex flex-wrap items-center justify-between gap-3\">\n                <span className=\"text-xs font-bold text-gray-700\">\n                  {t.quickActionsLabel}:\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'creation\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-rose-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \342\236\225 {lang === \'en\' ? \'New Article\' : \'\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'templates\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-purple-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\216\250 {lang === \'en\' ? \'Templates\' : \'\340\244\237\340\245\207\340\244\256\340\245\215\340\244\252\340\244\262\340\245\207\340\244\237\340\245\215\340\244\270\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'seo\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-emerald-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\224\215 {lang === \'en\' ? \'SEO Audit\' : \'SEO \340\244\221\340\244\241\340\244\277\340\244\237\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'scheduling\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-indigo-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\223\205 {lang === \'en\' ? \'Schedule\' : \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveSection(\'enhancer\')}\n                    className=\"px-3 py-1.5 bg-white border border-gray-300 hover:border-amber-500 text-xs font-bold rounded-xl shadow-2xs cursor-pointer\"\n                  >\n                    \360\237\252\204 {lang === \'en\' ? \'AI Enhancer\' : \'AI \340\244\217\340\244\250\340\245\215\340\244\271\340\244\276\340\244\202\340\244\270\340\244\260\'}\n                  </button>\n                </div>\n              </div>\n            </div>\n          )}"
      }
      num_matches: 1
    }
  }
}
