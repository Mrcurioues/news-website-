      replacement_content: "import React from \'react\';\nimport { RouterProvider, useRouter } from \'./context/RouterContext\';\nimport { getAllArticles } from \'./data/demo\';\nimport { Header } from \'./components/Header\';\nimport { BreakingTicker } from \'./components/BreakingTicker\';\nimport { Footer } from \'./components/Footer\';\n\n// Pages\nimport { HomePage } from \'./pages/HomePage\';\nimport { ArticlePage } from \'./pages/ArticlePage\';\nimport { CategoryPage } from \'./pages/CategoryPage\';\nimport { SearchPage } from \'./pages/SearchPage\';\nimport { VideoListPage } from \'./pages/VideoListPage\';\nimport { VideoDetailPage } from \'./pages/VideoDetailPage\';\nimport { PhotoListPage } from \'./pages/PhotoListPage\';\nimport { PhotoDetailPage } from \'./pages/PhotoDetailPage\';\nimport { AdminPage } from \'./pages/AdminPage\';\n\nfunction AppContent() {\n  const { path } = useRouter();\n  const allArticles = getAllArticles();\n\n  // Simple clean route matching\n  const renderRoute = () => {\n    // 1. Home\n    if (path === \'/\' || path === \'\') {\n      return <HomePage />;\n    }\n\n    // 2. Search\n    if (path.startsWith(\'/search\')) {\n      return <SearchPage />;\n    }\n\n    // 3. Admin\n    if (path.startsWith(\'/admin\')) {\n      return <AdminPage />;\n    }\n\n    // 4. Video Detail & Video List\n    if (path.startsWith(\'/videos/\')) {\n      const idSlug = path.replace(\'/videos/\', \'\');\n      return <VideoDetailPage idSlug={idSlug} />;\n    }\n    if (path === \'/videos\') {\n      return <VideoListPage />;\n    }\n\n    // 5. Photo Detail & Photo List\n    if (path.startsWith(\'/photos/\')) {\n      const idSlug = path.replace(\'/photos/\', \'\');\n      return <PhotoDetailPage idSlug={idSlug} />;\n    }\n    if (path === \'/photos\') {\n      return <PhotoListPage />;\n    }\n\n    // 6. News Article Page: /news/[idSlug]\n    if (path.startsWith(\'/news/\')) {\n      const idSlug = path.replace(\'/news/\', \'\');\n      return <ArticlePage idSlug={idSlug} />;\n    }\n\n    // 7. Category Page: /category/[slug]\n    if (path.startsWith(\'/category/\')) {\n      const slug = path.replace(\'/category/\', \'\');\n      return <CategoryPage slug={slug} />;\n    }\n\n    // Fallback: 404\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-20 text-center\">\n        <h1 className=\"text-3xl font-black text-gray-900 mb-2\">404 - \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276</h1>\n        <p className=\"text-gray-500 mb-6\">\340\244\225\340\245\215\340\244\267\340\244\256\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276 \340\244\226\340\245\213\340\244\234\340\244\276 \340\244\227\340\244\257\340\244\276 \340\244\265\340\245\207\340\244\254\340\244\252\340\245\207\340\244\234 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210\340\245\244</p>\n        <a\n          href=\"/\"\n          className=\"inline-block px-6 py-2.5 bg-rose-600 text-white rounded-lg font-bold text-sm hover:bg-rose-700 transition-colors\"\n        >\n          \340\244\271\340\245\213\340\244\256\340\244\252\340\245\207\340\244\234 \340\244\252\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\270 \340\244\234\340\244\276\340\244\217\340\244\202\n        </a>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-gray-100 selection:bg-rose-500 selection:text-white\">\n      {/* Sticky Header with Bilingual Nav and Weather */}\n      <Header />\n\n      {/* Breaking News Ticker below Header */}\n      <BreakingTicker articles={allArticles} />\n\n      {/* Dynamic Route Content */}\n      <main className=\"flex-1\">\n        {renderRoute()}\n      </main>\n\n      {/* ABP Style Comprehensive Footer */}\n      <Footer />\n    </div>\n  );\n}\n\nexport default function App() {\n  return (\n    <RouterProvider>\n      <AppContent />\n    </RouterProvider>\n  );\n}\n"
