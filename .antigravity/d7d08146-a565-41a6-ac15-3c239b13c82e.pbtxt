    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { CATEGORIES, getArticlesByCategory, getTrendingArticles } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { StoryCard } from \'../components/StoryCard\';\nimport { TrendingWidget } from \'../components/TrendingWidget\';\nimport { AdSlot } from \'../components/AdSlot\';\nimport { ChevronRight, ArrowDownCircle, Layers } from \'lucide-react\';\n\ninterface CategoryPageProps {\n  slug: string;\n}\n\nexport const CategoryPage: React.FC<CategoryPageProps> = ({ slug }) => {\n  const { updateMetadata } = useRouter();\n  const category = CATEGORIES.find((c) => c.slug.toLowerCase() === slug.toLowerCase()) || {\n    id: \'unknown\',\n    slug,\n    nameHi: slug.toUpperCase(),\n    nameEn: slug,\n    description: \'\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260\',\n    color: \'bg-rose-600\'\n  };\n\n  const allCategoryArticles = getArticlesByCategory(slug);\n  const [visibleCount, setVisibleCount] = useState(6);\n  const [isLoadingMore, setIsLoadingMore] = useState(false);\n\n  useEffect(() => {\n    updateMetadata({\n      title: `${category.nameHi} \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 - ${category.nameEn} Latest News`,\n      description: `${category.nameHi} \340\244\225\340\245\200 \340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\224\340\244\260 \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202, \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\245\244`\n    });\n    setVisibleCount(6);\n  }, [slug]);\n\n  const handleLoadMore = () => {\n    setIsLoadingMore(true);\n    setTimeout(() => {\n      setVisibleCount((prev) => prev + 6);\n      setIsLoadingMore(false);\n    }, 400);\n  };\n\n  const displayedArticles = allCategoryArticles.slice(0, visibleCount);\n  const trendingArticles = getTrendingArticles(5);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Breadcrumbs */}\n      <nav aria-label=\"Breadcrumb\" className=\"flex items-center gap-1.5 text-xs text-gray-500 mb-4\">\n        <Link href=\"/\" className=\"hover:text-rose-600 transition-colors\">\340\244\271\340\245\213\340\244\256</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <span className=\"text-gray-900 font-semibold\">{category.nameHi} ({category.nameEn})</span>\n      </nav>\n\n      {/* Category Banner Header */}\n      <div className=\"bg-white rounded-xl border border-gray-200 p-6 mb-8 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"w-2.5 h-7 bg-rose-600 rounded-full inline-block\"></span>\n            <h1 className=\"text-2xl sm:text-3xl font-black text-gray-950\">\n              {category.nameHi}\n            </h1>\n            <span className=\"text-sm font-semibold text-gray-500\">/ {category.nameEn} News</span>\n          </div>\n          <p className=\"text-xs sm:text-sm text-gray-600 max-w-2xl\">\n            {category.description || \'\340\244\207\340\244\270 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\225\340\245\200 \340\244\270\340\244\255\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\230\340\244\237\340\244\250\340\244\276\340\244\217\340\244\202, \340\244\217\340\244\225\340\245\215\340\244\270\340\244\225\340\245\215\340\244\262\340\245\202\340\244\270\340\244\277\340\244\265 \340\244\225\340\244\265\340\244\260\340\245\207\340\244\234 \340\244\224\340\244\260 \340\244\244\340\245\215\340\244\265\340\244\260\340\244\277\340\244\244 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237\340\245\215\340\244\270\340\245\244\'}\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 text-xs font-medium text-gray-500 bg-gray-50 px-3.5 py-2 rounded-lg border border-gray-100\">\n          <Layers className=\"w-4 h-4 text-rose-600\" />\n          <span>\340\244\225\340\245\201\340\244\262 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202: <strong>{allCategoryArticles.length}</strong></span>\n        </div>\n      </div>\n\n      {/* Main Content Grid + Sidebar */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        {/* Story List (8 Cols) */}\n        <div className=\"lg:col-span-8\">\n          {displayedArticles.length === 0 ? (\n            <div className=\"bg-white rounded-xl border border-gray-200 p-12 text-center\">\n              <p className=\"text-gray-600 text-base font-medium\">\n                \340\244\207\340\244\270 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\256\340\245\207\340\244\202 \340\244\205\340\244\255\340\245\200 \340\244\225\340\245\213\340\244\210 \340\244\226\340\244\254\340\244\260 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210\340\245\244\n              </p>\n              <Link\n                href=\"/\"\n                className=\"mt-4 inline-block px-4 py-2 bg-rose-600 text-white text-xs font-bold rounded-lg hover:bg-rose-700\"\n              >\n                \340\244\271\340\245\213\340\244\256\340\244\252\340\245\207\340\244\234 \340\244\252\340\244\260 \340\244\234\340\244\276\340\244\217\340\244\202\n              </Link>\n            </div>\n          ) : (\n            <div className=\"space-y-6\">\n              {/* Top featured item in horizontal/large format */}\n              {displayedArticles[0] && (\n                <StoryCard article={displayedArticles[0]} variant=\"horizontal\" />\n              )}\n\n              {/* Grid for remaining items */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2\">\n                {displayedArticles.slice(1).map((article) => (\n                  <StoryCard key={article.id} article={article} variant=\"grid\" />\n                ))}\n              </div>\n\n              {/* Load More Button */}\n              {visibleCount < allCategoryArticles.length && (\n                <div className=\"pt-6 text-center\">\n                  <button\n                    type=\"button\"\n                    onClick={handleLoadMore}\n                    disabled={isLoadingMore}\n                    className=\"inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white border border-gray-300 shadow-xs hover:bg-gray-50 text-gray-800 font-bold text-sm transition-all hover:border-rose-400\"\n                  >\n                    <ArrowDownCircle className={`w-4 h-4 text-rose-600 ${isLoadingMore ? \'animate-spin\' : \'\'}`} />\n                    <span>{isLoadingMore ? \'\340\244\262\340\245\213\340\244\241 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\' : \'\340\244\224\340\244\260 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\262\340\245\213\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202 (Load More)\'}</span>\n                  </button>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Sidebar (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <TrendingWidget articles={trendingArticles} />\n          <AdSlot format=\"medium-rectangle\" slotName=\"\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250\" />\n          <AdSlot format=\"half-page\" slotName=\"\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\257\340\245\213\340\244\234\340\244\225\" />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
