    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { CATEGORIES, searchArticles, getAllArticles } from \'../data/demo\';\nimport { useRouter, useSearchParams, Link } from \'../context/RouterContext\';\nimport { StoryCard } from \'../components/StoryCard\';\nimport { Search, X, Filter, SlidersHorizontal, ArrowLeft } from \'lucide-react\';\n\nexport const SearchPage: React.FC = () => {\n  const { updateMetadata, push } = useRouter();\n  const searchParams = useSearchParams();\n  const initialQuery = searchParams.get(\'q\') || \'\';\n\n  const [query, setQuery] = useState(initialQuery);\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n  const [sortBy, setSortBy] = useState<\'latest\' | \'views\'>(\'latest\');\n\n  useEffect(() => {\n    updateMetadata({\n      title: query ? `\340\244\226\340\245\213\340\244\234 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256: ${query}` : \'\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202 - Search News\',\n      description: \'\340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\262\340\244\276\340\244\207\340\244\265 \340\244\252\340\244\260 \340\244\205\340\244\252\340\244\250\340\245\200 \340\244\252\340\244\270\340\244\202\340\244\246\340\245\200\340\244\246\340\244\276 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202, \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\224\340\244\260 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202\340\245\244\'\n    });\n  }, [query]);\n\n  // Sync state if URL query changes\n  useEffect(() => {\n    const q = searchParams.get(\'q\') || \'\';\n    setQuery(q);\n  }, [searchParams.toString()]);\n\n  const results = useMemo(() => {\n    const list = searchArticles(query, selectedCategory === \'all\' ? undefined : selectedCategory);\n    if (sortBy === \'views\') {\n      return [...list].sort((a, b) => b.views - a.views);\n    }\n    return list;\n  }, [query, selectedCategory, sortBy]);\n\n  const handleClear = () => {\n    setQuery(\'\');\n    push(\'/search\');\n  };\n\n  const handleQueryChange = (val: string) => {\n    setQuery(val);\n    push(val ? `/search?q=${encodeURIComponent(val)}` : \'/search\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Search Header Container */}\n      <div className=\"bg-white rounded-xl border border-gray-200 p-6 sm:p-8 mb-8 shadow-xs\">\n        <h1 className=\"text-2xl sm:text-3xl font-black text-gray-900 mb-2 flex items-center gap-2\">\n          <Search className=\"w-6 h-6 text-rose-600\" />\n          <span>\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202 (Search Portal)</span>\n        </h1>\n        <p className=\"text-xs sm:text-sm text-gray-500 mb-6\">\n          \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225, \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\257\340\244\276 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\244\225\340\245\207 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\224\340\244\260 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 \340\244\225\340\245\200 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202\340\245\244\n        </p>\n\n        {/* Search Input Box */}\n        <div className=\"relative max-w-3xl\">\n          <input\n            type=\"text\"\n            value={query}\n            onChange={(e) => handleQueryChange(e.target.value)}\n            placeholder=\"\340\244\211\340\244\246\340\244\276. \340\244\207\340\244\270\340\244\260\340\245\213, \340\244\232\340\245\201\340\244\250\340\244\276\340\244\265, \340\244\254\340\244\234\340\244\237, \340\244\225\340\245\215\340\244\260\340\244\277\340\244\225\340\245\207\340\244\237, \340\244\254\340\245\211\340\244\262\340\245\200\340\244\265\340\245\201\340\244\241...\"\n            className=\"w-full pl-11 pr-10 py-3.5 rounded-xl border border-gray-300 focus:border-rose-600 focus:ring-2 focus:ring-rose-100 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 shadow-xs\"\n          />\n          <Search className=\"w-5 h-5 text-gray-400 absolute left-3.5 top-4\" />\n          {query && (\n            <button\n              type=\"button\"\n              onClick={handleClear}\n              className=\"absolute right-3.5 top-3.5 p-1 rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-100\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          )}\n        </div>\n\n        {/* Filter Controls Row */}\n        <div className=\"mt-5 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100 text-xs\">\n          {/* Category Dropdown Filter */}\n          <div className=\"flex items-center gap-2\">\n            <Filter className=\"w-3.5 h-3.5 text-gray-500\" />\n            <span className=\"font-semibold text-gray-700\">\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 \340\244\232\340\245\201\340\244\250\340\245\207\340\244\202:</span>\n            <select\n              value={selectedCategory}\n              onChange={(e) => setSelectedCategory(e.target.value)}\n              className=\"px-3 py-1.5 rounded-lg border border-gray-300 bg-white text-gray-800 font-medium focus:outline-hidden focus:border-rose-600\"\n            >\n              <option value=\"all\">\340\244\270\340\244\255\340\245\200 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 (All Categories)</option>\n              {CATEGORIES.map((c) => (\n                <option key={c.id} value={c.slug}>\n                  {c.nameHi} ({c.nameEn})\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Sort By Dropdown */}\n          <div className=\"flex items-center gap-2\">\n            <SlidersHorizontal className=\"w-3.5 h-3.5 text-gray-500\" />\n            <span className=\"font-semibold text-gray-700\">\340\244\225\340\245\215\340\244\260\340\244\256\340\244\254\340\244\246\340\245\215\340\244\247 \340\244\225\340\244\260\340\245\207\340\244\202:</span>\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as \'latest\' | \'views\')}\n              className=\"px-3 py-1.5 rounded-lg border border-gray-300 bg-white text-gray-800 font-medium focus:outline-hidden focus:border-rose-600\"\n            >\n              <option value=\"latest\">\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\252\340\244\271\340\244\262\340\245\207 (Latest First)</option>\n              <option value=\"views\">\340\244\270\340\244\254\340\244\270\340\245\207 \340\244\234\340\245\215\340\244\257\340\244\276\340\244\246\340\244\276 \340\244\252\340\244\242\340\244\274\340\245\200 \340\244\227\340\244\210\340\244\202 (Most Read)</option>\n            </select>\n          </div>\n        </div>\n\n        {/* Quick Suggestion Pills */}\n        <div className=\"mt-4 flex flex-wrap items-center gap-2 text-xs\">\n          <span className=\"text-gray-400 font-medium\">\340\244\270\340\245\201\340\244\235\340\244\276\340\244\265:</span>\n          {[\'\340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250\', \'IND vs AUS\', \'\340\244\227\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\271\340\244\276\340\244\207\340\244\241\340\245\215\340\244\260\340\245\213\340\244\234\340\244\250\', \'\340\244\260\340\245\207\340\244\252\340\245\213 \340\244\260\340\245\207\340\244\237\', \'\340\244\225\340\245\215\340\244\265\340\244\276\340\244\202\340\244\237\340\244\256\', \'\340\244\254\340\245\201\340\244\262\340\245\207\340\244\237 \340\244\237\340\245\215\340\244\260\340\245\207\340\244\250\'].map((suggest) => (\n            <button\n              key={suggest}\n              type=\"button\"\n              onClick={() => handleQueryChange(suggest)}\n              className=\"px-2.5 py-1 rounded-full bg-gray-100 hover:bg-rose-50 hover:text-rose-700 text-gray-600 font-medium transition-colors\"\n            >\n              {suggest}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Results Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <h2 className=\"text-lg font-bold text-gray-900\">\n          {query ? `\"${query}\" \340\244\225\340\245\207 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256` : \'\340\244\270\340\244\255\340\245\200 \340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\274\340\244\254\340\244\260\340\245\207\340\244\202\'}\n        </h2>\n        <span className=\"text-xs text-gray-500 font-semibold bg-gray-100 px-3 py-1 rounded-full\">\n          {results.length} \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 \340\244\256\340\244\277\340\244\262\340\245\207\n        </span>\n      </div>\n\n      {/* Results Grid */}\n      {results.length === 0 ? (\n        <div className=\"bg-white rounded-xl border border-gray-200 p-12 text-center my-6\">\n          <div className=\"w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto mb-3\">\n            <Search className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-gray-800 mb-1\">\340\244\225\340\245\213\340\244\210 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276</h3>\n          <p className=\"text-xs text-gray-500 max-w-md mx-auto mb-4\">\n            \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\225\340\245\213\340\244\210 \340\244\246\340\245\202\340\244\270\340\244\260\340\244\276 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\257\340\244\276 \340\244\265\340\244\260\340\245\215\340\244\244\340\244\250\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232\340\244\225\340\244\260 \340\244\252\340\245\201\340\244\250\340\244\203 \340\244\252\340\245\215\340\244\260\340\244\257\340\244\276\340\244\270 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\n          </p>\n          <button\n            type=\"button\"\n            onClick={handleClear}\n            className=\"px-4 py-2 bg-rose-600 text-white rounded-lg text-xs font-bold hover:bg-rose-700\"\n          >\n            \340\244\270\340\244\255\340\245\200 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\n          </button>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {results.map((article) => (\n            <StoryCard key={article.id} article={article} variant=\"grid\" />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
