  file_change {
    absolute_path_uri: "file:///src/components/admin/WpArticleEditor.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport {\n  Save,\n  Clock,\n  CheckCircle2,\n  AlertCircle,\n  Eye,\n  Trash2,\n  Sparkles,\n  Heading1,\n  Heading2,\n  Heading3,\n  AlignLeft,\n  List,\n  Quote,\n  Image as ImageIcon,\n  Tag,\n  FolderTree,\n  Search,\n  ExternalLink,\n  ChevronDown,\n  ChevronUp,\n  RefreshCw,\n  Globe\n} from \'lucide-react\';\nimport { Article, Category, ContentFormat, PostStatus } from \'../../types\';\nimport { CATEGORIES } from \'../../data/demo\';\nimport {\n  performSeoAudit,\n  generateSeoSlug,\n  calculateFleschReadingEase,\n  calculateKeywordDensity,\n  detectDuplicateContent\n} from \'../../utils/seoCalculator\';\n\ninterface WpArticleEditorProps {\n  initialArticle?: Partial<Article>;\n  onSave: (articleData: Partial<Article>) => void;\n  onDeleteRequest: (id: string, title: string) => void;\n  onOpenAssistant: () => void;\n  onCancel: () => void;\n}\n\nexport const WpArticleEditor: React.FC<WpArticleEditorProps> = ({\n  initialArticle,\n  onSave,\n  onDeleteRequest,\n  onOpenAssistant,\n  onCancel\n}) => {\n  // Post data states\n  const [title, setTitle] = useState(initialArticle?.title || \'\');\n  const [titleEn, setTitleEn] = useState(initialArticle?.titleEn || \'\');\n  const [slug, setSlug] = useState(initialArticle?.slug || generateSeoSlug(initialArticle?.title || \'\'));\n  const [categorySlug, setCategorySlug] = useState(initialArticle?.categorySlug || \'national\');\n  const [contentFormat, setContentFormat] = useState<ContentFormat>(initialArticle?.contentFormat || \'standard\');\n  const [status, setStatus] = useState<PostStatus>(initialArticle?.status || \'published\');\n  const [scheduledDate, setScheduledDate] = useState(\n    initialArticle?.scheduledDate || new Date(Date.now() + 86400000).toISOString().slice(0, 16)\n  );\n  const [isBreaking, setIsBreaking] = useState(!!initialArticle?.isBreaking);\n  const [isTrending, setIsTrending] = useState(!!initialArticle?.isTrending);\n\n  // Content body\n  const [bodyParagraphs, setBodyParagraphs] = useState<string[]>(\n    initialArticle?.body && initialArticle.body.length > 0\n      ? initialArticle.body\n      : [\n          \'## 1. \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\244\260\340\244\277\340\244\246\340\245\203\340\244\266\340\245\215\340\244\257 \340\244\224\340\244\260 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\340\244\255\340\245\202\340\244\256\340\244\277\',\n          \'\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\224\340\244\260 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\340\244\255\340\245\202\340\244\256\340\244\277 \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\',\n          \'## 2. \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 \340\244\217\340\244\265\340\244\202 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\',\n          \'### \340\244\225) \340\244\250\340\245\200\340\244\244\340\244\277\340\244\227\340\244\244 \340\244\224\340\244\260 \340\244\260\340\244\243\340\244\250\340\245\200\340\244\244\340\244\277\340\244\225 \340\244\252\340\245\215\340\244\260\340\244\255\340\244\276\340\244\265\',\n          \'\340\244\265\340\244\277\340\244\267\340\244\257 \340\244\270\340\245\207 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247\340\244\277\340\244\244 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\206\340\244\202\340\244\225\340\244\241\340\244\274\340\245\207 \340\244\224\340\244\260 \340\244\244\340\244\245\340\245\215\340\244\257\340\245\244\'\n        ]\n  );\n\n  // Meta and SEO Fields\n  const [focusKeyword, setFocusKeyword] = useState(initialArticle?.focusKeyword || \'\');\n  const [metaTitle, setMetaTitle] = useState(initialArticle?.metaTitle || initialArticle?.title || \'\');\n  const [metaDescription, setMetaDescription] = useState(\n    initialArticle?.metaDescription || initialArticle?.excerpt || \'\'\n  );\n  const [coverImage, setCoverImage] = useState(\n    initialArticle?.coverImage ||\n      \'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=1200&q=80\'\n  );\n  const [imageAltText, setImageAltText] = useState(\n    initialArticle?.imageAltText || initialArticle?.imageCaption || \'\'\n  );\n  const [tags, setTags] = useState<string[]>(\n    initialArticle?.tags && initialArticle.tags.length > 0\n      ? initialArticle.tags\n      : [\'\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\254\340\244\260\', \'\340\244\255\340\244\276\340\244\260\340\244\244\', \'\340\244\265\340\244\277\340\244\266\340\245\207\340\244\267 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243\']\n  );\n  const [tagInput, setTagInput] = useState(\'\');\n\n  // UI tabs for Inspector (Sidebar)\n  const [activeInspectorTab, setActiveInspectorTab] = useState<\'seo\' | \'readability\' | \'settings\'>(\'seo\');\n  const [previewDevice, setPreviewDevice] = useState<\'desktop\' | \'mobile\'>(\'desktop\');\n  const [showSeoChecklist, setShowSeoChecklist] = useState(true);\n\n  // Validation errors\n  const [validationErrors, setValidationErrors] = useState<string[]>([]);\n\n  // Real-time SEO and Readability Audit\n  const audit = useMemo(() => {\n    return performSeoAudit({\n      title,\n      titleEn,\n      slug,\n      focusKeyword,\n      metaTitle,\n      metaDescription,\n      body: bodyParagraphs,\n      coverImage,\n      imageAltText\n    });\n  }, [title, titleEn, slug, focusKeyword, metaTitle, metaDescription, bodyParagraphs, coverImage, imageAltText]);\n\n  // Duplicate sentences check\n  const duplicateSentences = useMemo(() => {\n    return detectDuplicateContent(bodyParagraphs);\n  }, [bodyParagraphs]);\n\n  // Handle Slug generation\n  const handleAutoSlug = () => {\n    const base = focusKeyword || titleEn || title;\n    setSlug(generateSeoSlug(base));\n  };\n\n  // Tag management\n  const handleAddTag = () => {\n    const clean = tagInput.trim();\n    if (clean && !tags.includes(clean)) {\n      setTags([...tags, clean]);\n      setTagInput(\'\');\n    }\n  };\n\n  const handleRemoveTag = (tagToRemove: string) => {\n    setTags(tags.filter(t => t !== tagToRemove));\n  };\n\n  // Block insertion helpers\n  const handleInsertBlock = (type: \'h2\' | \'h3\' | \'p\' | \'list\' | \'quote\') => {\n    if (type === \'h2\') {\n      setBodyParagraphs([...bodyParagraphs, \'## \340\244\250\340\244\210 H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\265\340\244\277\340\244\267\340\244\257)\']);\n    } else if (type === \'h3\') {\n      setBodyParagraphs([...bodyParagraphs, \'### \340\244\250\340\244\210 H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 (\340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243)\']);\n    } else if (type === \'p\') {\n      setBodyParagraphs([...bodyParagraphs, \'\340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246: \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\265\340\244\277\340\244\270\340\245\215\340\244\244\340\245\203\340\244\244 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\']);\n    } else if (type === \'list\') {\n      setBodyParagraphs([...bodyParagraphs, \'- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 1\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 2\\n- \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\254\340\244\277\340\244\202\340\244\246\340\245\201 3\']);\n    } else if (type === \'quote\') {\n      setBodyParagraphs([...bodyParagraphs, \'> \"\340\244\257\340\244\271 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\225\340\245\207 \340\244\270\340\244\202\340\244\246\340\244\260\340\245\215\340\244\255 \340\244\256\340\245\207\340\244\202 \340\244\217\340\244\225 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\265\340\244\277\340\244\266\340\245\207\340\244\267\340\244\234\340\245\215\340\244\236 \340\244\211\340\244\246\340\245\215\340\244\247\340\244\260\340\244\243 \340\244\271\340\245\210\340\245\244\"\']);\n    }\n  };\n\n  const handleUpdateParagraph = (index: number, val: string) => {\n    const updated = [...bodyParagraphs];\n    updated[index] = val;\n    setBodyParagraphs(updated);\n  };\n\n  const handleDeleteParagraph = (index: number) => {\n    if (bodyParagraphs.length <= 1) return;\n    setBodyParagraphs(bodyParagraphs.filter((_, i) => i !== index));\n  };\n\n  // Validate and submit\n  const handleSaveSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const errors: string[] = [];\n\n    if (!title.trim()) errors.push(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\244\276 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Title) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (!metaDescription.trim()) errors.push(\'\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description / Excerpt) \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\271\340\245\210\340\245\244\');\n    if (bodyParagraphs.filter(p => p.trim().length > 0).length === 0) {\n      errors.push(\'\340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\200 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 (Body content) \340\244\226\340\244\276\340\244\262\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\213 \340\244\270\340\244\225\340\244\244\340\245\200\340\245\244\');\n    }\n    if (status === \'scheduled\' && !scheduledDate) {\n      errors.push(\'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\245\200 \340\244\227\340\244\210 \340\244\244\340\244\277\340\244\245\340\244\277 \340\244\265 \340\244\270\340\244\256\340\244\257 \340\244\232\340\245\201\340\244\250\340\244\250\340\244\276 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\271\340\245\210\340\245\244\');\n    }\n\n    if (errors.length > 0) {\n      setValidationErrors(errors);\n      return;\n    }\n\n    setValidationErrors([]);\n\n    const categoryObj = CATEGORIES.find(c => c.slug === categorySlug) || CATEGORIES[0];\n\n    onSave({\n      id: initialArticle?.id,\n      title: title.trim(),\n      titleEn: titleEn.trim(),\n      slug: slug.trim() || generateSeoSlug(title),\n      category: categoryObj.nameHi,\n      categorySlug: categoryObj.slug,\n      excerpt: metaDescription.trim(),\n      body: bodyParagraphs.filter(p => p.trim().length > 0),\n      focusKeyword: focusKeyword.trim(),\n      metaTitle: metaTitle.trim() || title.trim(),\n      metaDescription: metaDescription.trim(),\n      coverImage: coverImage.trim(),\n      imageAltText: imageAltText.trim(),\n      tags,\n      status,\n      scheduledDate: status === \'scheduled\' ? scheduledDate : undefined,\n      contentFormat,\n      isBreaking,\n      isTrending,\n      seoScore: audit.overallScore,\n      readabilityScore: audit.fleschReadingEase\n    });\n  };\n\n  return (\n    <div id=\"wp-article-editor-root\" className=\"max-w-7xl mx-auto pb-16\">\n      {/* Gutenberg-style Header Action Bar */}\n      <div className=\"bg-white border border-gray-200 rounded-2xl p-4 mb-6 shadow-xs sticky top-3 z-30 flex flex-wrap items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            type=\"button\"\n            onClick={onCancel}\n            className=\"text-xs font-bold text-gray-500 hover:text-gray-800 px-3 py-1.5 rounded-lg hover:bg-gray-100 transition-colors\"\n          >\n            \342\206\220 \340\244\265\340\244\276\340\244\252\340\244\270 (Cancel)\n          </button>\n          <div className=\"h-4 w-px bg-gray-200\" />\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-gray-500\">\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277:</span>\n            <select\n              value={status}\n              onChange={(e) => setStatus(e.target.value as PostStatus)}\n              className=\"text-xs font-bold rounded-lg border border-gray-300 px-2.5 py-1 bg-gray-50\"\n            >\n              <option value=\"published\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Published)</option>\n              <option value=\"draft\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 (Draft)</option>\n              <option value=\"pending\">\340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276\340\244\247\340\245\200\340\244\250 (Pending Review)</option>\n              <option value=\"scheduled\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</option>\n            </select>\n          </div>\n        </div>\n\n        {/* SEO Score Pill & Action Buttons */}\n        <div className=\"flex items-center gap-3\">\n          {/* Yoast / Rank Math Score Badge */}\n          <div\n            className={`px-3 py-1.5 rounded-xl border flex items-center gap-2 text-xs font-black shadow-2xs ${\n              audit.overallScore >= 80\n                ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                : audit.overallScore >= 60\n                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                : \'bg-rose-50 text-rose-700 border-rose-200\'\n            }`}\n          >\n            <span className=\"w-2 h-2 rounded-full animate-pulse bg-current\" />\n            <span>Rank Math SEO: {audit.overallScore}/100</span>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenAssistant}\n            className=\"px-3.5 py-1.5 rounded-xl bg-linear-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 transition-all shadow-xs\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>AI \340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\252\340\245\202\340\244\233\340\245\207\340\244\202</span>\n          </button>\n\n          {initialArticle?.id && (\n            <button\n              type=\"button\"\n              onClick={() => onDeleteRequest(initialArticle.id!, title)}\n              className=\"p-2 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors border border-rose-200\"\n              title=\"\340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202 (Confirm Delete)\"\n            >\n              <Trash2 className=\"w-4 h-4\" />\n            </button>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={handleSaveSubmit}\n            className=\"px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center gap-1.5 transition-colors shadow-sm shadow-rose-200\"\n          >\n            <Save className=\"w-4 h-4\" />\n            <span>\n              {status === \'scheduled\'\n                ? \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 (Schedule Post)\'\n                : status === \'draft\'\n                ? \'\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 (Save Draft)\'\n                : \'\340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\270\340\244\271\340\245\207\340\244\234\340\245\207\340\244\202 \340\244\265 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202 (Publish)\'}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Validation Errors Alert */}\n      {validationErrors.length > 0 && (\n        <div className=\"mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1\">\n          <div className=\"font-bold flex items-center gap-1.5 text-sm mb-1 text-rose-900\">\n            <AlertCircle className=\"w-4 h-4 text-rose-600\" />\n            <span>\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\250\340\244\277\340\244\256\340\245\215\340\244\250\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\244\340\245\215\340\244\260\340\245\201\340\244\237\340\244\277\340\244\257\340\245\213\340\244\202 \340\244\225\340\245\213 \340\244\240\340\245\200\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202:</span>\n          </div>\n          {validationErrors.map((err, i) => (\n            <div key={i}>\342\200\242 {err}</div>\n          ))}\n        </div>\n      )}\n\n      {/* Main Grid: Left Editor & Right Inspector */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* LEFT COLUMN: Main WordPress Article Canvas (8 cols) */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          {/* Post Title & Formats */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-6 shadow-xs\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2 mb-3\">\n              <span className=\"text-[11px] font-bold uppercase text-gray-400 tracking-wider\">\n                \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (H1 Headline & Format)\n              </span>\n              <div className=\"flex items-center gap-1 bg-gray-100 p-0.5 rounded-lg text-xs font-medium\">\n                <span className=\"text-[11px] px-2 text-gray-500 font-semibold\">\340\244\252\340\245\215\340\244\260\340\244\276\340\244\260\340\245\202\340\244\252:</span>\n                {([\'standard\', \'tutorial\', \'review\', \'listicle\', \'breaking\'] as ContentFormat[]).map((fmt) => (\n                  <button\n                    key={fmt}\n                    type=\"button\"\n                    onClick={() => setContentFormat(fmt)}\n                    className={`px-2 py-0.5 rounded text-[11px] font-bold capitalize transition-colors ${\n                      contentFormat === fmt ? \'bg-white text-rose-600 shadow-2xs\' : \'text-gray-600\'\n                    }`}\n                  >\n                    {fmt}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* H1 Title Input */}\n            <input\n              type=\"text\"\n              required\n              value={title}\n              onChange={(e) => {\n                setTitle(e.target.value);\n                if (!metaTitle) setMetaTitle(e.target.value);\n              }}\n              placeholder=\"\340\244\257\340\244\271\340\244\276\340\244\201 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 H1 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\"\n              className=\"w-full text-xl sm:text-2xl font-black text-gray-900 placeholder:text-gray-300 border-0 focus:ring-0 p-0 mb-3\"\n            />\n\n            {/* English Title / Subtitle */}\n            <input\n              type=\"text\"\n              value={titleEn}\n              onChange={(e) => setTitleEn(e.target.value)}\n              placeholder=\"English title or subtitle (optional)...\"\n              className=\"w-full text-xs sm:text-sm text-gray-600 placeholder:text-gray-300 border-b border-gray-100 pb-2 mb-3 focus:outline-hidden\"\n            />\n\n            {/* Permalink Slug Bar */}\n            <div className=\"flex items-center gap-2 text-xs text-gray-500 bg-gray-50 p-2.5 rounded-xl border border-gray-200/80\">\n              <Globe className=\"w-4 h-4 text-gray-400 shrink-0\" />\n              <span className=\"font-semibold text-gray-600\">\340\244\252\340\244\260\340\244\256\340\244\276\340\244\262\340\244\277\340\244\202\340\244\225:</span>\n              <span className=\"text-gray-400 hidden sm:inline\">bharatsamachar.live/news/</span>\n              <input\n                type=\"text\"\n                value={slug}\n                onChange={(e) => setSlug(e.target.value)}\n                placeholder=\"seo-friendly-slug\"\n                className=\"flex-1 bg-transparent font-mono text-xs text-rose-600 font-bold focus:outline-hidden\"\n              />\n              <button\n                type=\"button\"\n                onClick={handleAutoSlug}\n                className=\"px-2 py-1 bg-white hover:bg-gray-100 rounded text-[11px] font-semibold text-gray-700 border border-gray-200 transition-colors\"\n                title=\"\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\207 \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\234\340\244\250\340\244\260\340\245\207\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202\"\n              >\n                \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202\n              </button>\n            </div>\n          </div>\n\n          {/* Block Formatting Toolbar */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-3 shadow-xs flex flex-wrap items-center justify-between gap-2 text-xs\">\n            <span className=\"font-bold text-gray-600 pl-1\">\340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202 (Add Blocks):</span>\n            <div className=\"flex flex-wrap items-center gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h2\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Heading2 className=\"w-3.5 h-3.5\" />\n                <span>+ H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'h3\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Heading3 className=\"w-3.5 h-3.5\" />\n                <span>+ H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'p\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <AlignLeft className=\"w-3.5 h-3.5\" />\n                <span>+ \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'list\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n                <span>+ \340\244\254\340\245\201\340\244\262\340\245\207\340\244\237 \340\244\262\340\244\277\340\244\270\340\245\215\340\244\237</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleInsertBlock(\'quote\')}\n                className=\"px-2.5 py-1.5 rounded-lg bg-gray-100 hover:bg-rose-50 hover:text-rose-600 font-bold text-gray-700 flex items-center gap-1 transition-colors\"\n              >\n                <Quote className=\"w-3.5 h-3.5\" />\n                <span>+ \340\244\211\340\244\246\340\245\215\340\244\247\340\244\260\340\244\243 (Quote)</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Structured Paragraph Blocks */}\n          <div className=\"space-y-4\">\n            {bodyParagraphs.map((para, index) => {\n              const isH2 = para.startsWith(\'## \');\n              const isH3 = para.startsWith(\'### \');\n              const isQuote = para.startsWith(\'> \');\n              const isList = para.startsWith(\'- \');\n\n              return (\n                <div\n                  key={index}\n                  className={`bg-white rounded-2xl border p-4 shadow-xs transition-all relative group ${\n                    isH2\n                      ? \'border-blue-200 bg-blue-50/20\'\n                      : isH3\n                      ? \'border-indigo-200 bg-indigo-50/20\'\n                      : isQuote\n                      ? \'border-amber-200 bg-amber-50/20\'\n                      : \'border-gray-200\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between text-[11px] text-gray-400 mb-1.5\">\n                    <span className=\"font-bold flex items-center gap-1\">\n                      {isH2 && <span className=\"px-1.5 py-0.5 rounded bg-blue-100 text-blue-700\">H2 SECTION</span>}\n                      {isH3 && <span className=\"px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-700\">H3 SUB-SECTION</span>}\n                      {isQuote && <span className=\"px-1.5 py-0.5 rounded bg-amber-100 text-amber-700\">QUOTE BLOCK</span>}\n                      {isList && <span className=\"px-1.5 py-0.5 rounded bg-gray-100 text-gray-700\">LIST BLOCK</span>}\n                      {!isH2 && !isH3 && !isQuote && !isList && <span>PARAGRAPH #{index + 1}</span>}\n                    </span>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => handleDeleteParagraph(index)}\n                      className=\"opacity-0 group-hover:opacity-100 text-rose-500 hover:text-rose-700 p-1 transition-opacity text-xs\"\n                      title=\"\340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\271\340\244\237\340\244\276\340\244\217\340\244\202\"\n                    >\n                      \340\244\271\340\244\237\340\244\276\340\244\217\340\244\202 \342\234\225\n                    </button>\n                  </div>\n\n                  <textarea\n                    rows={isH2 || isH3 ? 2 : 4}\n                    value={para}\n                    onChange={(e) => handleUpdateParagraph(index, e.target.value)}\n                    placeholder=\"\340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202...\"\n                    className={`w-full bg-transparent border-0 focus:ring-0 p-0 text-gray-900 ${\n                      isH2\n                        ? \'text-lg font-black\'\n                        : isH3\n                        ? \'text-base font-bold\'\n                        : isQuote\n                        ? \'italic text-amber-900 font-medium\'\n                        : \'text-sm leading-relaxed\'\n                    }`}\n                  />\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Quick Add Bottom Button */}\n          <button\n            type=\"button\"\n            onClick={() => handleInsertBlock(\'p\')}\n            className=\"w-full py-3 rounded-2xl border-2 border-dashed border-gray-300 hover:border-rose-400 text-gray-500 hover:text-rose-600 font-bold text-xs transition-colors flex items-center justify-center gap-1.5\"\n          >\n            <span>+ \340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202</span>\n          </button>\n        </div>\n\n        {/* RIGHT COLUMN: Yoast & Rank Math SEO Inspector (4 cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Inspector Navigation Tabs */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-1.5 shadow-xs flex text-xs font-bold\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'seo\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'seo\' ? \'bg-rose-600 text-white shadow-xs\' : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              SEO (Yoast/Rank)\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'readability\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'readability\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 (Flesch)\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'settings\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'settings\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 (WP)\n            </button>\n          </div>\n\n          {/* TAB 1: SEO BOX (Yoast & Rank Math) */}\n          {activeInspectorTab === \'seo\' && (\n            <div className=\"space-y-4\">\n              {/* Focus Keyword Box */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 (Focus Keyword) *\n                </label>\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    value={focusKeyword}\n                    onChange={(e) => setFocusKeyword(e.target.value)}\n                    placeholder=\"\340\244\211\340\244\246\340\244\276. ISRO \340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 2026\"\n                    className=\"flex-1 px-3 py-2 rounded-xl border border-gray-300 text-xs font-bold focus:border-rose-600\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={onOpenAssistant}\n                    className=\"p-2 rounded-xl bg-purple-50 text-purple-700 hover:bg-purple-100 text-xs\"\n                    title=\"\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 \340\244\262\340\245\207\340\244\202\"\n                  >\n                    <Sparkles className=\"w-4 h-4\" />\n                  </button>\n                </div>\n                <div className=\"mt-2 flex items-center justify-between text-[11px] text-gray-500\">\n                  <span>\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200: <strong>{audit.keywordDensity}%</strong></span>\n                  <span className={audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                    {audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5 ? \'\340\244\206\340\244\246\340\244\260\340\245\215\340\244\266 (1-2.5%)\' : \'\340\244\270\340\244\256\340\244\276\340\244\257\340\245\213\340\244\234\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\'}\n                  </span>\n                </div>\n              </div>\n\n              {/* SERP Preview (Google Snippet) */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-bold text-gray-700 uppercase\">Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\270\340\245\215\340\244\250\340\244\277\340\244\252\340\245\207\340\244\237 \340\244\252\340\245\215\340\244\260\340\244\277\340\244\265\340\245\215\340\244\257\340\245\202</span>\n                  <div className=\"flex items-center gap-1 text-[11px]\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'desktop\')}\n                      className={`px-2 py-0.5 rounded font-bold ${\n                        previewDevice === \'desktop\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      \340\244\241\340\245\207\340\244\270\340\245\215\340\244\225\340\244\237\340\245\211\340\244\252\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'mobile\')}\n                      className={`px-2 py-0.5 rounded font-bold ${\n                        previewDevice === \'mobile\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      \340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262\n                    </button>\n                  </div>\n                </div>\n\n                {/* Google Snippet Card */}\n                <div className=\"p-3 bg-gray-50 rounded-xl border border-gray-200/80 font-sans text-left\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-gray-600 truncate mb-0.5\">\n                    <div className=\"w-3.5 h-3.5 rounded-full bg-rose-600 text-white flex items-center justify-center text-[8px] font-bold\">\n                      B\n                    </div>\n                    <span>bharatsamachar.live</span>\n                    <span className=\"text-gray-400\">\342\200\272 news \342\200\272 {slug || \'article\'}</span>\n                  </div>\n                  <div className=\"text-sm font-medium text-blue-800 line-clamp-1 hover:underline cursor-pointer\">\n                    {metaTitle || title || \'\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225\'}\n                  </div>\n                  <div className=\"text-xs text-gray-600 line-clamp-2 mt-1 leading-snug\">\n                    {metaDescription || \'\340\244\257\340\244\271\340\244\276\340\244\201 Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\260\340\244\277\340\244\234\340\244\262\340\245\215\340\244\237\340\245\215\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\244\276 150 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\246\340\244\260\340\245\215\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\213\340\244\227\340\244\276...\'}\n                  </div>\n                </div>\n\n                {/* SEO Title Input */}\n                <div className=\"mt-4\">\n                  <div className=\"flex items-center justify-between text-[11px] text-gray-500 mb-1\">\n                    <span className=\"font-bold text-gray-700\">SEO \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Meta Title)</span>\n                    <span className={metaTitle.length >= 40 && metaTitle.length <= 65 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                      {metaTitle.length}/60 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\n                    </span>\n                  </div>\n                  <input\n                    type=\"text\"\n                    value={metaTitle}\n                    onChange={(e) => setMetaTitle(e.target.value)}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                </div>\n\n                {/* Meta Description Input with 150-160 char counter */}\n                <div className=\"mt-3\">\n                  <div className=\"flex items-center justify-between text-[11px] text-gray-500 mb-1\">\n                    <span className=\"font-bold text-gray-700\">\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description)</span>\n                    <span\n                      className={\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'text-emerald-600 font-bold\'\n                          : \'text-amber-600\'\n                      }\n                    >\n                      {metaDescription.length}/160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\n                    </span>\n                  </div>\n                  <textarea\n                    rows={3}\n                    value={metaDescription}\n                    onChange={(e) => setMetaDescription(e.target.value)}\n                    placeholder=\"150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\202\340\244\225\340\245\215\340\244\267\340\244\277\340\244\252\340\245\215\340\244\244 \340\244\224\340\244\260 \340\244\206\340\244\225\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 \340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213...\"\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                  {/* Progress bar for 150-160 chars */}\n                  <div className=\"w-full bg-gray-100 h-1.5 rounded-full overflow-hidden mt-1\">\n                    <div\n                      className={`h-1.5 rounded-full transition-all ${\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'bg-emerald-500\'\n                          : metaDescription.length > 165\n                          ? \'bg-rose-500\'\n                          : \'bg-amber-400\'\n                      }`}\n                      style={{ width: `${Math.min(100, (metaDescription.length / 160) * 100)}%` }}\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Rank Math 10-Point Checklist */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowSeoChecklist(!showSeoChecklist)}\n                  className=\"w-full flex items-center justify-between text-xs font-bold text-gray-800\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                    <span>Rank Math \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237 ({audit.passedCount}/{audit.totalChecks})</span>\n                  </div>\n                  {showSeoChecklist ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                </button>\n\n                {showSeoChecklist && (\n                  <div className=\"mt-3 divide-y divide-gray-100 text-xs space-y-2\">\n                    {audit.checks.map((item) => (\n                      <div key={item.id} className=\"pt-2 flex items-start gap-2\">\n                        <span className=\"shrink-0 mt-0.5\">\n                          {item.passed ? (\n                            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                          ) : (\n                            <AlertCircle className=\"w-3.5 h-3.5 text-amber-500\" />\n                          )}\n                        </span>\n                        <div>\n                          <div className=\"font-bold text-gray-900 leading-snug\">{item.titleHi}</div>\n                          <div className=\"text-[11px] text-gray-500 mt-0.5\">{item.recommendationHi}</div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: READABILITY & QUALITY CHECKS */}\n          {activeInspectorTab === \'readability\' && (\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-3\">\n                  Flesch Reading Ease \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\n                </span>\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex flex-col items-center justify-center shrink-0\">\n                    <span className=\"text-xl font-black\">{audit.fleschReadingEase}</span>\n                    <span className=\"text-[9px] font-bold uppercase\">/ 100</span>\n                  </div>\n                  <div>\n                    <div className=\"text-xs font-bold text-gray-900\">{audit.fleschGrade}</div>\n                    <p className=\"text-[11px] text-gray-500 mt-1\">\n                      \340\244\270\340\244\276\340\244\256\340\244\276\340\244\250\340\245\215\340\244\257 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 60+ \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\211\340\244\252\340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\256\340\244\276\340\244\250\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\n                    </p>\n                  </div>\n                </div>\n\n                {/* Metrics */}\n                <div className=\"grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-gray-100 text-xs\">\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Words)</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.wordCount}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">\340\244\252\340\244\242\340\244\274\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.readingTimeMinutes} \340\244\256\340\244\277\340\244\250\340\244\237</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h2}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h3}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Duplicate Content Detection */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-2\">\n                  \340\244\241\340\245\201\340\244\252\340\245\215\340\244\262\340\245\200\340\244\225\340\245\207\340\244\237 / \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232\n                </span>\n                {duplicateSentences.length === 0 ? (\n                  <div className=\"text-xs text-emerald-700 bg-emerald-50 p-3 rounded-xl border border-emerald-200 flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                    <span>\340\244\225\340\245\213\340\244\210 \340\244\205\340\244\250\340\244\276\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\256\340\245\214\340\244\262\340\244\277\340\244\225 \340\244\271\340\245\210\340\245\244</span>\n                  </div>\n                ) : (\n                  <div className=\"text-xs text-amber-800 bg-amber-50 p-3 rounded-xl border border-amber-200 space-y-1.5\">\n                    <div className=\"font-bold flex items-center gap-1.5\">\n                      <AlertCircle className=\"w-4 h-4 text-amber-600\" />\n                      <span>{duplicateSentences.length} \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\217 \340\244\227\340\244\217 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\252\340\244\276\340\244\217 \340\244\227\340\244\217:</span>\n                    </div>\n                    {duplicateSentences.map((sent, i) => (\n                      <div key={i} className=\"text-[11px] italic text-amber-900\">\n                        \342\200\242 \"{sent}\"\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Internal & External Linking Opportunities */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs text-xs space-y-3\">\n                <span className=\"font-bold text-gray-800 uppercase block\">\340\244\262\340\244\277\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\205\340\244\265\340\244\270\340\244\260 (Linking Suggestions)</span>\n                <div>\n                  <span className=\"text-[11px] font-bold text-gray-600 block mb-1\">\340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225 (Internal Links):</span>\n                  {audit.internalLinkOpportunities.map((link, i) => (\n                    <div key={i} className=\"text-[11px] text-blue-700 flex items-center gap-1 my-0.5\">\n                      <ExternalLink className=\"w-3 h-3 text-blue-500\" />\n                      <span>{link}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: SETTINGS (Category, Tags, Image & Alt Text, Schedule) */}\n          {activeInspectorTab === \'settings\' && (\n            <div className=\"space-y-4\">\n              {/* Category */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (WordPress Category) *\n                </label>\n                <select\n                  value={categorySlug}\n                  onChange={(e) => setCategorySlug(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold bg-white\"\n                >\n                  {CATEGORIES.map((c) => (\n                    <option key={c.id} value={c.slug}>\n                      {c.nameHi} ({c.nameEn})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Featured Image & Alt Text */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 URL (Featured Media)\n                </label>\n                <input\n                  type=\"url\"\n                  value={coverImage}\n                  onChange={(e) => setCoverImage(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-mono mb-2\"\n                />\n\n                {coverImage && (\n                  <div className=\"rounded-xl overflow-hidden border border-gray-200 mb-3 h-28 bg-gray-100\">\n                    <img\n                      src={coverImage}\n                      alt={imageAltText || \'Preview\'}\n                      className=\"w-full h-full object-cover\"\n                    />\n                  </div>\n                )}\n\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 (Image Alt Text - SEO \340\244\265 \340\244\270\340\245\201\340\244\262\340\244\255\340\244\244\340\244\276) *\n                </label>\n                <input\n                  type=\"text\"\n                  value={imageAltText}\n                  onChange={(e) => setImageAltText(e.target.value)}\n                  placeholder=\"\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 (\340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213)...\"\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs\"\n                />\n                <p className=\"text-[10px] text-gray-400 mt-1\">\n                  WordPress \340\244\224\340\244\260 Google Images \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\271\340\245\200 Alt Text \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\274\340\244\277\340\244\225 \340\244\254\340\244\242\340\244\274\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\n                </p>\n              </div>\n\n              {/* Tags Manager */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 (WordPress Tags)\n                </label>\n                <div className=\"flex items-center gap-1.5 mb-2\">\n                  <input\n                    type=\"text\"\n                    value={tagInput}\n                    onChange={(e) => setTagInput(e.target.value)}\n                    onKeyDown={(e) => {\n                      if (e.key === \'Enter\') {\n                        e.preventDefault();\n                        handleAddTag();\n                      }\n                    }}\n                    placeholder=\"\340\244\237\340\245\210\340\244\227 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202...\"\n                    className=\"flex-1 px-3 py-1.5 rounded-lg border border-gray-300 text-xs\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={handleAddTag}\n                    className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-lg\"\n                  >\n                    \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\n                  </button>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {tags.map((t) => (\n                    <span\n                      key={t}\n                      className=\"px-2 py-0.5 rounded-lg bg-rose-50 text-rose-700 text-[11px] font-semibold flex items-center gap-1\"\n                    >\n                      <span>#{t}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleRemoveTag(t)}\n                        className=\"hover:text-rose-900 text-rose-400 font-bold\"\n                      >\n                        \342\234\225\n                      </button>\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Post Toggles & Schedule Date */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs space-y-3\">\n                {status === \'scheduled\' && (\n                  <div>\n                    <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                      \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\270\340\244\256\340\244\257 (Publish Date & Time) *\n                    </label>\n                    <input\n                      type=\"datetime-local\"\n                      value={scheduledDate}\n                      onChange={(e) => setScheduledDate(e.target.value)}\n                      className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-medium\"\n                    />\n                  </div>\n                )}\n\n                <div className=\"flex items-center gap-2 pt-2 border-t border-gray-100\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"breakingToggle\"\n                    checked={isBreaking}\n                    onChange={(e) => setIsBreaking(e.target.checked)}\n                    className=\"w-4 h-4 text-rose-600 rounded border-gray-300\"\n                  />\n                  <label htmlFor=\"breakingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Breaking Banner)\n                  </label>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"trendingToggle\"\n                    checked={isTrending}\n                    onChange={(e) => setIsTrending(e.target.checked)}\n                    className=\"w-4 h-4 text-amber-500 rounded border-gray-300\"\n                  />\n                  <label htmlFor=\"trendingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    \340\244\237\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\270\340\245\207\340\244\225\340\245\215\340\244\266\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\276\340\244\217\340\244\202\n                  </label>\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState, useMemo } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Save,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Clock,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  CheckCircle2,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  AlertCircle,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Eye,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Trash2,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Sparkles,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Heading1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Heading2,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
