        target_content: "            {/* Context Sidebar */}\n            <div className=\"lg:col-span-4 space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                <h3 className=\"text-sm font-black text-gray-900 mb-2 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-purple-600\" />\n                  <span>\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\225\340\245\215\340\244\267\340\244\256\340\244\244\340\244\276\340\244\217\340\244\202</span>\n                </h3>\n                <ul className=\"text-xs text-gray-600 space-y-2 leading-relaxed\">\n                  <li>\342\200\242 <strong>SEO \340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\225\340\245\215\340\244\232\340\244\260\340\244\277\340\244\202\340\244\227:</strong> Google \340\244\265 Rank Math \340\244\246\340\244\277\340\244\266\340\244\276\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\260\340\245\202\340\244\252 H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\221\340\244\252\340\245\215\340\244\237\340\244\277\340\244\256\340\244\276\340\244\207\340\244\234\340\244\274\340\245\207\340\244\266\340\244\250:</strong> 150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\262\340\245\200 URL \340\244\270\340\245\215\340\244\262\340\244\227\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\225\340\245\215\340\244\265\340\244\276\340\244\262\340\244\277\340\244\237\340\245\200 \340\244\221\340\244\241\340\244\277\340\244\237:</strong> Flesch Reading Ease \340\244\253\340\245\211\340\244\260\340\245\215\340\244\256\340\245\202\340\244\262\340\244\276 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200 \340\244\225\340\244\276 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\202\340\244\262\340\245\215\340\244\257\340\244\276\340\244\202\340\244\225\340\244\250\340\245\244</li>\n                  <li>\342\200\242 <strong>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\252\340\245\215\340\244\260\340\244\243\340\244\276\340\244\262\340\245\200:</strong> \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\255\340\245\200 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\225\340\245\213 \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\245\200 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 (Explicit confirmation)\340\245\244</li>\n                </ul>\n              </div>\n\n              {editingArticle?.title && (\n                <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                  <span className=\"text-[11px] font-bold text-gray-400 uppercase block mb-1\">\n                    \340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\232\340\244\257\340\244\250\340\244\277\340\244\244 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237\n                  </span>\n                  <div className=\"font-black text-gray-900 text-sm mb-2\">\n                    {editingArticle.title}\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveTab(\'editor\')}\n                    className=\"w-full py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-xl transition-colors\"\n                  >\n                    \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202 (Open in Editor)\n                  </button>\n                </div>\n              )}\n            </div>"
        replacement_content: "            {/* Context Sidebar */}\n            <div className=\"lg:col-span-4 space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                <h3 className=\"text-sm font-black text-gray-900 mb-2 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-purple-600\" />\n                  <span>{lang === \'en\' ? \'Key Assistant Capabilities\' : \'\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\225\340\245\215\340\244\267\340\244\256\340\244\244\340\244\276\340\244\217\340\244\202\'}</span>\n                </h3>\n                <ul className=\"text-xs text-gray-600 space-y-2 leading-relaxed\">\n                  {lang === \'en\' ? (\n                    <>\n                      <li>\342\200\242 <strong>SEO Structuring:</strong> H1, H2, H3 heading hierarchy complying with Google & Rank Math guidelines.</li>\n                      <li>\342\200\242 <strong>Meta Optimization:</strong> Exact 150-160 character meta descriptions and search-friendly URL slugs.</li>\n                      <li>\342\200\242 <strong>Quality Audit:</strong> Flesch Reading Ease readability scoring and keyword density evaluation.</li>\n                      <li>\342\200\242 <strong>Safety First:</strong> Strict confirmation modal required before any post deletion.</li>\n                    </>\n                  ) : (\n                    <>\n                      <li>\342\200\242 <strong>SEO \340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\225\340\245\215\340\244\232\340\244\260\340\244\277\340\244\202\340\244\227:</strong> Google \340\244\265 Rank Math \340\244\246\340\244\277\340\244\266\340\244\276\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\260\340\245\202\340\244\252 H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256\340\245\244</li>\n                      <li>\342\200\242 <strong>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\221\340\244\252\340\245\215\340\244\237\340\244\277\340\244\256\340\244\276\340\244\207\340\244\234\340\244\274\340\245\207\340\244\266\340\244\250:</strong> 150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\262\340\245\200 URL \340\244\270\340\245\215\340\244\262\340\244\227\340\245\244</li>\n                      <li>\342\200\242 <strong>\340\244\225\340\245\215\340\244\265\340\244\276\340\244\262\340\244\277\340\244\237\340\245\200 \340\244\221\340\244\241\340\244\277\340\244\237:</strong> Flesch Reading Ease \340\244\253\340\245\211\340\244\260\340\245\215\340\244\256\340\245\202\340\244\262\340\244\276 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200 \340\244\225\340\244\276 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\202\340\244\262\340\245\215\340\244\257\340\244\276\340\244\202\340\244\225\340\244\250\340\245\244</li>\n                      <li>\342\200\242 <strong>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\252\340\245\215\340\244\260\340\244\243\340\244\276\340\244\262\340\245\200:</strong> \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\255\340\245\200 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\225\340\245\213 \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\245\200 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 (Explicit confirmation)\340\245\244</li>\n                    </>\n                  )}\n                </ul>\n              </div>\n\n              {editingArticle?.title && (\n                <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">\n                  <span className=\"text-[11px] font-bold text-gray-400 uppercase block mb-1\">\n                    {lang === \'en\' ? \'Currently Selected Post\' : \'\340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\232\340\244\257\340\244\250\340\244\277\340\244\244 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237\'}\n                  </span>\n                  <div className=\"font-black text-gray-900 text-sm mb-2\">\n                    {lang === \'en\' ? (editingArticle.titleEn || editingArticle.title) : editingArticle.title}\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setActiveTab(\'editor\')}\n                    className=\"w-full py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-xl transition-colors cursor-pointer\"\n                  >\n                    {lang === \'en\' ? \'Open in Editor\' : \'\340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\226\340\245\213\340\244\262\340\245\207\340\244\202 (Open in Editor)\'}\n                  </button>\n                </div>\n              )}\n            </div>"
      }
      num_matches: 1
    }
  }
}
