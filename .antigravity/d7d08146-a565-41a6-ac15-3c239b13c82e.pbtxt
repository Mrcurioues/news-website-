    instruction: "Add subnav and translated titles to delete_module view"
    replacement_infos {
      original_chunk {
        target_content: "          {/* =========================================================\n              VIEW 11: SAFE DELETE & 301 REDIRECT (Module 3)\n             ========================================================= */}\n          {activeSection === \'delete_module\' && (\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-rose-600 flex items-center gap-2\">\n                    <Trash2 className=\"w-5 h-5 text-rose-600\" />\n                    <span>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 \340\244\265 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Safety-First Deletion)</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    \340\244\254\340\244\277\340\244\250\340\244\276 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\245\207 \340\244\225\340\245\213\340\244\210 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \342\200\242 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\265 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\266 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\n                  </p>\n                </div>\n              </div>"
        replacement_content: "          {/* =========================================================\n              VIEW 11: SAFE DELETE & 301 REDIRECT (Module 3)\n             ========================================================= */}\n          {activeSection === \'delete_module\' && (\n            <div className=\"space-y-6\">\n              {/* Clean Sub-Nav for Workflow & Settings */}\n              <div className=\"flex items-center gap-1.5 p-1 bg-gray-100/90 rounded-xl w-fit overflow-x-auto max-w-full\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'revisions\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\225\222 {t.revTitle}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'taxonomy\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\217\267\357\270\217 {t.modTaxonomy}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'roles\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \360\237\221\245 {t.modRoles}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'delete_module\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap bg-white text-gray-900 shadow-2xs cursor-pointer\"\n                >\n                  \360\237\233\241\357\270\217 {t.modDelete}\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveSection(\'settings_help\')}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap text-gray-600 hover:text-gray-900 cursor-pointer\"\n                >\n                  \342\232\231\357\270\217 {t.modSettings}\n                </button>\n              </div>\n\n              <div className=\"flex items-center justify-between border-b border-gray-100 pb-4\">\n                <div>\n                  <h3 className=\"text-lg font-black text-rose-600 flex items-center gap-2\">\n                    <Trash2 className=\"w-5 h-5 text-rose-600\" />\n                    <span>{t.modDelete}</span>\n                  </h3>\n                  <p className=\"text-xs text-gray-500 mt-0.5\">\n                    {lang === \'en\' ? \'Safe article deletion, trash recovery protection, and 301 permanent redirects\' : \'\340\244\254\340\244\277\340\244\250\340\244\276 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 \340\244\225\340\245\207 \340\244\225\340\245\213\340\244\210 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \342\200\242 301 \340\244\260\340\245\200\340\244\241\340\244\276\340\244\257\340\244\260\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\265 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\266 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\'}\n                  </p>\n                </div>\n              </div>"
      }
