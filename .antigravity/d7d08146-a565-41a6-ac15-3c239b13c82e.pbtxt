        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    body: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'The Reserve Bank of India\342\200\231s Monetary Policy Committee (MPC) concluded its three-day deliberations today by voting to reduce the benchmark repo rate by 25 basis points to 6.25%. The rate easing comes after retail inflation softened comfortably into the central bank\342\200\231s target band.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'The RBI Governor affirmed that India\342\200\231s economic fundamentals remain resilient despite global geopolitical headwinds. The interest rate reduction is anticipated to invigorate consumer demand across housing, automotive, and capital investment sectors.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Leading commercial banks including SBI, HDFC, and ICICI indicated that they would promptly pass on the rate benefits through revised marginal cost and repo-linked lending rates to borrowers.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
