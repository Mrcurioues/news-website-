        }
        lines {
          text: "    keyPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Domestic net theatrical collections cross Rs 620 crore in record-breaking opening week.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Shatters previous overseas records across North America, the UK, and Gulf markets.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
