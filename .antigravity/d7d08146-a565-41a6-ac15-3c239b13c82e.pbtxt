          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}> = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'101\': {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    readTime: \'4 min read\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    publishedAt: \'03 Sep 2026, 03:45 PM IST\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    authorRole: \'Senior Science Correspondent\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tags: [\'ISRO\', \'Gaganyaan\', \'Spaceflight\', \'Science\', \'India\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'The unmanned crew module achieved a precise 400 km low-Earth orbit before executing a smooth descent.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Advanced drogue and main parachute systems ensured a secure touchdown in the Bay of Bengal.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'The Prime Minister and Space Minister congratulated ISRO scientists on achieving this pivotal mission milestone.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    body: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'The Indian Space Research Organisation (ISRO) has accomplished a watershed breakthrough in its flagship human spaceflight programme, Gaganyaan. In an intensive demonstration staged from the Satish Dhawan Space Centre in Sriharikota, the spacecraft successfully validated its propulsion, thermal shield, and life support architectures under orbital flight conditions.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Addressing a press conference, the ISRO Chairman confirmed that the spacecraft achieved an exact 400-kilometer low-Earth orbit, fulfilling all pre-programmed scientific simulations. Following this, automated retrograde thruster burns initiated a controlled re-entry, safely splashing down at the designated coordinates in the Bay of Bengal. A combined recovery task force from the Indian Navy and Coast Guard recovered the capsule intact.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Aerospace analysts highlighted that this flawless trial cements India\342\200\231s roadmap for its inaugural crewed spaceflight slated for 2027. Four designated astronauts (Gaganauts), trained comprehensively in India and Russia, are scheduled to embark on the human spaceflight mission.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \'102\': {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    readTime: \'3 min read\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    publishedAt: \'03 Sep 2026, 02:10 PM IST\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    authorRole: \'Sports Desk Chief\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tags: [\'Cricket\', \'IND vs AUS\', \'Final\', \'Team India\', \'Sports\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Explosive opening pair Rohit and Gill look to capitalize on the new ball in the early powerplay.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Melbourne\342\200\231s greenish surface makes bowling first upon winning the toss a favorable tactical decision.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Indian wrist-spinner Kuldeep Yadav\342\200\231s spells during the middle overs are anticipated to be match-defining.\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
