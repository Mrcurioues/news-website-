    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHvJWKf-20Kv04U69B68NyZyPXxGORbsy1b5YafXZnFKXP3HOfSL3PsL-tdm0mu8Ewu9m370p5PX9xpNkq1mrsPC7LBw5t-ccO5I1Lpo1O8Oqxw3GGcDNlDo-dm6viUgv2TI5xqargCo76bWRI566Bi75njhAzBd7D069MDZ5kHQcz6qkexqNZCJAqY4Mcp4kxGbsTGCqYhSZ0OclLQOuIJ7g=="
