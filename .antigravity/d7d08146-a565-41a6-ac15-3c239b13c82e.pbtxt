    instruction: "Update table, filters, actions and drawer button in AdminPage with adminT translations"
    replacement_infos {
      original_chunk {
        target_content: "            {/* Filter and Search Bar */}\n            <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n              <div className=\"relative w-full sm:w-72\">\n                <Search className=\"w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                <input\n                  type=\"text\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  placeholder=\"\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225, \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\257\340\244\276 \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\270\340\245\207 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202...\"\n                  className=\"w-full pl-10 pr-4 py-2 rounded-xl border border-gray-300 text-xs focus:border-rose-600\"\n                />\n              </div>\n\n              <div className=\"flex items-center gap-2 w-full sm:w-auto\">\n                <select\n                  value={statusFilter}\n                  onChange={(e) => setStatusFilter(e.target.value)}\n                  className=\"text-xs font-semibold px-3 py-2 rounded-xl border border-gray-300 bg-white\"\n                >\n                  <option value=\"all\">\340\244\270\340\244\255\340\245\200 \340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277\340\244\257\340\244\276\340\244\202 (All Status)</option>\n                  <option value=\"published\">\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 (Published)</option>\n                  <option value=\"draft\">\340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 (Draft)</option>\n                  <option value=\"scheduled\">\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Scheduled)</option>\n                  <option value=\"pending\">\340\244\270\340\244\256\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276\340\244\247\340\245\200\340\244\250 (Pending)</option>\n                </select>\n\n                <select\n                  value={categoryFilter}\n                  onChange={(e) => setCategoryFilter(e.target.value)}\n                  className=\"text-xs font-semibold px-3 py-2 rounded-xl border border-gray-300 bg-white\"\n                >\n                  <option value=\"all\">\340\244\270\340\244\255\340\245\200 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202 (All Categories)</option>\n                  {CATEGORIES.map(c => (\n                    <option key={c.id} value={c.slug}>{c.nameHi}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* Articles Table */}\n            <div className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-2xs\">\n              <div className=\"overflow-x-auto\">\n                <table className=\"w-full text-left text-xs sm:text-sm\">\n                  <thead className=\"bg-gray-50 border-b border-gray-200 text-gray-600 font-bold\">\n                    <tr>\n                      <th className=\"py-3.5 px-4\">\340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\265 \340\244\252\340\244\260\340\244\256\340\244\276\340\244\262\340\244\277\340\244\202\340\244\225 (Title / Permalink)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (Category)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\270\340\245\215\340\244\245\340\244\277\340\244\244\340\244\277 (Status)</th>\n                      <th className=\"py-3.5 px-4\">SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 (Rank Math)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Views)</th>\n                      <th className=\"py-3.5 px-4\">\340\244\246\340\244\277\340\244\250\340\244\276\340\244\202\340\244\225 (Date)</th>\n                      <th className=\"py-3.5 px-4 text-right\">\340\244\225\340\244\276\340\244\260\340\245\215\340\244\260\340\244\265\340\244\276\340\244\210 (Actions)</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-gray-100 text-gray-800\">\n                    {filteredArticles.length === 0 ? (\n                      <tr>\n                        <td colSpan={7} className=\"py-8 text-center text-gray-400 text-xs\">\n                          \340\244\225\340\245\213\340\244\210 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \"\340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\254\340\244\250\340\244\276\340\244\217\340\244\202\" \340\244\252\340\244\260 \340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\n                        </td>\n                      </tr>\n                    ) : (\n                      filteredArticles.map((item) => {\n                        const postStatus = item.status || \'published\';\n                        const seoScore = item.seoScore || (item.body && item.body.length > 3 ? 88 : 74);\n\n                        return (\n                          <tr key={item.id} className=\"hover:bg-gray-50/70 transition-colors\">\n                            {/* Title & Slug */}\n                            <td className=\"py-3.5 px-4 max-w-xs sm:max-w-md\">\n                              <div className=\"font-bold text-gray-900 line-clamp-1\">{item.title}</div>\n                              <div className=\"text-[11px] text-gray-400 font-mono mt-0.5 flex items-center gap-1.5\">\n                                <span>/news/{item.idSlug}</span>\n                                {item.focusKeyword && (\n                                  <span className=\"px-1.5 py-0.2 rounded bg-purple-50 text-purple-700 text-[10px] font-bold\">\n                                    KW: {item.focusKeyword}\n                                  </span>\n                                )}\n                              </div>\n                            </td>\n\n                            {/* Category */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <span className=\"px-2.5 py-1 rounded-lg bg-gray-100 text-gray-700 text-xs font-semibold\">\n                                {item.category}\n                              </span>\n                            </td>\n\n                            {/* Status */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <div className=\"flex flex-col items-start gap-1\">\n                                <span\n                                  className={`px-2 py-0.5 rounded-md text-[11px] font-bold ${\n                                    postStatus === \'published\'\n                                      ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                                      : postStatus === \'scheduled\'\n                                      ? \'bg-indigo-50 text-indigo-700 border border-indigo-200\'\n                                      : postStatus === \'draft\'\n                                      ? \'bg-amber-50 text-amber-700 border border-amber-200\'\n                                      : \'bg-gray-100 text-gray-700\'\n                                  }`}\n                                >\n                                  {postStatus.toUpperCase()}\n                                </span>\n                                {item.isBreaking && (\n                                  <span className=\"px-1.5 py-0.2 rounded bg-rose-100 text-rose-700 text-[10px] font-bold\">\n                                    \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227\n                                  </span>\n                                )}\n                              </div>\n                            </td>\n\n                            {/* SEO Score Pill */}\n                            <td className=\"py-3.5 px-4 whitespace-nowrap\">\n                              <div\n                                className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black ${\n                                  seoScore >= 80\n                                    ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                                    : seoScore >= 60\n                                    ? \'bg-amber-50 text-amber-700 border border-amber-200\'\n                                    : \'bg-rose-50 text-rose-700 border border-rose-200\'\n                                }`}\n                              >\n                                <span className=\"w-1.5 h-1.5 rounded-full bg-current\" />\n                                <span>{seoScore}/100</span>\n                              </div>\n                            </td>\n\n                            {/* Views */}\n                            <td className=\"py-3.5 px-4 font-mono text-gray-600 whitespace-nowrap\">\n                              {item.views.toLocaleString(\'hi-IN\')}\n                            </td>\n\n                            {/* Date */}\n                            <td className=\"py-3.5 px-4 text-xs text-gray-500 whitespace-nowrap\">\n                     