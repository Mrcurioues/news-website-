    instruction: "Localize bottom quick add, tabs, and focus keyword box in WpArticleEditor"
    replacement_infos {
      original_chunk {
        target_content: "          {/* Quick Add Bottom Button */}\n          <button\n            type=\"button\"\n            onClick={() => handleInsertBlock(\'p\')}\n            className=\"w-full py-3 rounded-2xl border-2 border-dashed border-gray-300 hover:border-rose-400 text-gray-500 hover:text-rose-600 font-bold text-xs transition-colors flex items-center justify-center gap-1.5\"\n          >\n            <span>+ \340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202</span>\n          </button>\n        </div>\n\n        {/* RIGHT COLUMN: Yoast & Rank Math SEO Inspector (4 cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Inspector Navigation Tabs */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-1.5 shadow-xs flex text-xs font-bold\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'seo\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'seo\' ? \'bg-rose-600 text-white shadow-xs\' : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              SEO (Yoast/Rank)\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'readability\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'readability\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 (Flesch)\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'settings\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors ${\n                activeInspectorTab === \'settings\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              \340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 (WP)\n            </button>\n          </div>\n\n          {/* TAB 1: SEO BOX (Yoast & Rank Math) */}\n          {activeInspectorTab === \'seo\' && (\n            <div className=\"space-y-4\">\n              {/* Focus Keyword Box */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 (Focus Keyword) *\n                </label>\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    value={focusKeyword}\n                    onChange={(e) => setFocusKeyword(e.target.value)}\n                    placeholder=\"\340\244\211\340\244\246\340\244\276. ISRO \340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 2026\"\n                    className=\"flex-1 px-3 py-2 rounded-xl border border-gray-300 text-xs font-bold focus:border-rose-600\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={onOpenAssistant}\n                    className=\"p-2 rounded-xl bg-purple-50 text-purple-700 hover:bg-purple-100 text-xs\"\n                    title=\"\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 \340\244\262\340\245\207\340\244\202\"\n                  >\n                    <Sparkles className=\"w-4 h-4\" />\n                  </button>\n                </div>\n                <div className=\"mt-2 flex items-center justify-between text-[11px] text-gray-500\">\n                  <span>\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200: <strong>{audit.keywordDensity}%</strong></span>\n                  <span className={audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                    {audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5 ? \'\340\244\206\340\244\246\340\244\260\340\245\215\340\244\266 (1-2.5%)\' : \'\340\244\270\340\244\256\340\244\276\340\244\257\340\245\213\340\244\234\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\'}\n                  </span>\n                </div>\n              </div>\n\n              {/* SERP Preview (Google Snippet) */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-bold text-gray-700 uppercase\">Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\270\340\245\215\340\244\250\340\244\277\340\244\252\340\245\207\340\244\237 \340\244\252\340\245\215\340\244\260\340\244\277\340\244\265\340\245\215\340\244\257\340\245\202</span>\n                  <div className=\"flex items-center gap-1 text-[11px]\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'desktop\')}\n                      className={`px-2 py-0.5 rounded font-bold ${\n                        previewDevice === \'desktop\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      \340\244\241\340\245\207\340\244\270\340\245\215\340\244\225\340\244\237\340\245\211\340\244\252\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'mobile\')}\n                      className={`px-2 py-0.5 rounded font-bold ${\n                        previewDevice === \'mobile\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      \340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262\n                    </button>\n                  </div>\n                </div>\n\n                {/* Google Snippet Card */}\n                <div className=\"p-3 bg-gray-50 rounded-xl border border-gray-200/80 font-sans text-left\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-gray-600 truncate mb-0.5\">\n                    <div className=\"w-3.5 h-3.5 rounded-full bg-rose-600 text-white flex items-center justify-center text-[8px] font-bold\">\n                      B\n                    </div>\n                    <span>bharatsamachar.live</span>\n                    <span className=\"text-gray-400\">\342\200\272 news \342\200\272 {slug || \'article\'}</span>\n                  </div>\n                  <div className=\"text-sm font-medium text-blue-800 line-clamp-1 hover:underline cursor-pointer\">\n                    {metaTitle || title || \'\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225\'}\n                  </div>\n                  <div className=\"text-xs text-gray-600 line-clamp-2 mt-1 leading-snug\">\n                    {metaDescription || \'\340\244\257\340\244\271\340\244\276\340\244\201 Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\260\340\244\277\340\244\234\340\244\262\340\245\215\340\244\237\340\245\215\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\244\276 150 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\246\340\244\260\340\245\215\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\213\340\244\227\340\244\276...\'}\n                  </div>\n                </div>\n\n                {/* SEO Title Input */}\n                <div className=\"mt-4\">\n                  <div className=\"flex items-center justify-between text-[11px] text-gray-500 mb-1\">\n                    <span className=\"font-bold text-gray-700\">SEO \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Meta Title)</span>\n                    <span className={metaTitle.length >= 40 && metaTitle.length <= 65 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                      {metaTitle.length}/60 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\n                    </span>\n                  </div>\n                  <input\n                    type=\"text\"\n                    value={metaTitle}\n                    onChange={(e) => setMetaTitle(e.target.value)}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                </div>"
        replacement_content: "          {/* Quick Add Bottom Button */}\n          <button\n            type=\"button\"\n            onClick={() => handleInsertBlock(\'p\')}\n            className=\"w-full py-3 rounded-2xl border-2 border-dashed border-gray-300 hover:border-rose-400 text-gray-500 hover:text-rose-600 font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n          >\n            <span>{lang === \'en\' ? \'+ Add New Paragraph\' : \'+ \340\244\250\340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\232\340\245\215\340\244\233\340\245\207\340\244\246 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\'}</span>\n          </button>\n        </div>\n\n        {/* RIGHT COLUMN: Yoast & Rank Math SEO Inspector (4 cols) */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Inspector Navigation Tabs */}\n          <div className=\"bg-white rounded-2xl border border-gray-200 p-1.5 shadow-xs flex text-xs font-bold\">\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'seo\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors cursor-pointer ${\n                activeInspectorTab === \'seo\' ? \'bg-rose-600 text-white shadow-xs\' : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              SEO (Yoast/Rank)\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'readability\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors cursor-pointer ${\n                activeInspectorTab === \'readability\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              {lang === \'en\' ? \'Readability\' : \'\340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 (Flesch)\'}\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setActiveInspectorTab(\'settings\')}\n              className={`flex-1 py-2 rounded-xl text-center transition-colors cursor-pointer ${\n                activeInspectorTab === \'settings\'\n                  ? \'bg-rose-600 text-white shadow-xs\'\n                  : \'text-gray-600 hover:text-gray-900\'\n              }`}\n            >\n              {lang === \'en\' ? \'Settings (WP)\' : \'\340\244\270\340\245\207\340\244\237\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270 (WP)\'}\n            </button>\n          </div>\n\n          {/* TAB 1: SEO BOX (Yoast & Rank Math) */}\n          {activeInspectorTab === \'seo\' && (\n            <div className=\"space-y-4\">\n              {/* Focus Keyword Box */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  {lang === \'en\' ? \'Focus Keyword *\' : \'\340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 (Focus Keyword) *\'}\n                </label>\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    value={focusKeyword}\n                    onChange={(e) => setFocusKeyword(e.target.value)}\n                    placeholder={lang === \'en\' ? \'e.g. ISRO Gaganyaan 2026\' : \'\340\244\211\340\244\246\340\244\276. ISRO \340\244\227\340\244\227\340\244\250\340\244\257\340\244\276\340\244\250 2026\'}\n                    className=\"flex-1 px-3 py-2 rounded-xl border border-gray-300 text-xs font-bold focus:border-rose-600\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={onOpenAssistant}\n                    className=\"p-2 rounded-xl bg-purple-50 text-purple-700 hover:bg-purple-100 text-xs cursor-pointer\"\n                    title={lang === \'en\' ? \'Get keyword suggestions from Assistant\' : \'\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\270\340\245\207 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\201\340\244\235\340\244\276\340\244\265 \340\244\262\340\245\207\340\244\202\'}\n                  >\n                    <Sparkles className=\"w-4 h-4\" />\n                  </button>\n                </div>\n                <div className=\"mt-2 flex items-center justify-between text-[11px] text-gray-500\">\n                  <span>{lang === \'en\' ? \'Keyword Density:\' : \'\340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200:\'} <strong>{audit.keywordDensity}%</strong></span>\n                  <span className={audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                    {audit.keywordDensity >= 1 && audit.keywordDensity <= 2.5\n                      ? (lang === \'en\' ? \'Optimal (1-2.5%)\' : \'\340\244\206\340\244\246\340\244\260\340\245\215\340\244\266 (1-2.5%)\')\n                      : (lang === \'en\' ? \'Adjust density\' : \'\340\244\270\340\244\256\340\244\276\340\244\257\340\245\213\340\244\234\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\')}\n                  </span>\n                </div>\n              </div>\n\n              {/* SERP Preview (Google Snippet) */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-bold text-gray-700 uppercase\">\n                    {lang === \'en\' ? \'Google Search Snippet Preview\' : \'Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\270\340\245\215\340\244\250\340\244\277\340\244\252\340\245\207\340\244\237 \340\244\252\340\245\215\340\244\260\340\244\277\340\244\265\340\245\215\340\244\257\340\245\202\'}\n                  </span>\n                  <div className=\"flex items-center gap-1 text-[11px]\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'desktop\')}\n                      className={`px-2 py-0.5 rounded font-bold cursor-pointer ${\n                        previewDevice === \'desktop\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      {lang === \'en\' ? \'Desktop\' : \'\340\244\241\340\245\207\340\244\270\340\245\215\340\244\225\340\244\237\340\245\211\340\244\252\'}\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewDevice(\'mobile\')}\n                      className={`px-2 py-0.5 rounded font-bold cursor-pointer ${\n                        previewDevice === \'mobile\' ? \'bg-gray-200 text-gray-900\' : \'text-gray-400\'\n                      }`}\n                    >\n                      {lang === \'en\' ? \'Mobile\' : \'\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262\'}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Google Snippet Card */}\n                <div className=\"p-3 bg-gray-50 rounded-xl border border-gray-200/80 font-sans text-left\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-gray-600 truncate mb-0.5\">\n                    <div className=\"w-3.5 h-3.5 rounded-full bg-rose-600 text-white flex items-center justify-center text-[8px] font-bold\">\n                      B\n                    </div>\n                    <span>bharatsamachar.live</span>\n                    <span className=\"text-gray-400\">\342\200\272 news \342\200\272 {slug || \'article\'}</span>\n                  </div>\n                  <div className=\"text-sm font-medium text-blue-800 line-clamp-1 hover:underline cursor-pointer\">\n                    {metaTitle || title || (lang === \'en\' ? \'News Title\' : \'\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225\')}\n                  </div>\n                  <div className=\"text-xs text-gray-600 line-clamp-2 mt-1 leading-snug\">\n                    {metaDescription || (lang === \'en\' ? \'This is where the 150-character meta description appearing in Google search results will be displayed...\' : \'\340\244\257\340\244\271\340\244\276\340\244\201 Google \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\260\340\244\277\340\244\234\340\244\262\340\245\215\340\244\237\340\245\215\340\244\270 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\244\276 150 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\252\340\245\215\340\244\260\340\244\246\340\244\260\340\245\215\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\213\340\244\227\340\244\276...\')}\n                  </div>\n                </div>\n\n                {/* SEO Title Input */}\n                <div className=\"mt-4\">\n                  <div className=\"flex items-center justify-between text-[11px] text-gray-500 mb-1\">\n                    <span className=\"font-bold text-gray-700\">{lang === \'en\' ? \'SEO Title (Meta Title)\' : \'SEO \340\244\266\340\245\200\340\244\260\340\245\215\340\244\267\340\244\225 (Meta Title)\'}</span>\n                    <span className={metaTitle.length >= 40 && metaTitle.length <= 65 ? \'text-emerald-600 font-bold\' : \'text-amber-600\'}>\n                      {metaTitle.length}/60 {lang === \'en\' ? \'chars\' : \'\340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\'}\n                    </span>\n                  </div>\n                  <input\n                    type=\"text\"\n                    value={metaTitle}\n                    onChange={(e) => setMetaTitle(e.target.value)}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                </div>"
      }
      num_matches: 1
    }
  }
}
