      target_content: "                    <span className=\"font-bold text-gray-700\">\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description)</span>\n                    <span\n                      className={\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'text-emerald-600 font-bold\'\n                          : \'text-amber-600\'\n                      }\n                    >\n                      {metaDescription.length}/160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\n                    </span>\n                  </div>\n                  <textarea\n                    rows={3}\n                    value={metaDescription}\n                    onChange={(e) => setMetaDescription(e.target.value)}\n                    placeholder=\"150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\202\340\244\225\340\245\215\340\244\267\340\244\277\340\244\252\340\245\215\340\244\244 \340\244\224\340\244\260 \340\244\206\340\244\225\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 \340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213...\"\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                  {/* Progress bar for 150-160 chars */}\n                  <div className=\"w-full bg-gray-100 h-1.5 rounded-full overflow-hidden mt-1\">\n                    <div\n                      className={`h-1.5 rounded-full transition-all ${\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'bg-emerald-500\'\n                          : metaDescription.length > 165\n                          ? \'bg-rose-500\'\n                          : \'bg-amber-400\'\n                      }`}\n                      style={{ width: `${Math.min(100, (metaDescription.length / 160) * 100)}%` }}\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Rank Math 10-Point Checklist */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowSeoChecklist(!showSeoChecklist)}\n                  className=\"w-full flex items-center justify-between text-xs font-bold text-gray-800\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                    <span>Rank Math \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237 ({audit.passedCount}/{audit.totalChecks})</span>\n                  </div>\n                  {showSeoChecklist ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                </button>\n\n                {showSeoChecklist && (\n                  <div className=\"mt-3 divide-y divide-gray-100 text-xs space-y-2\">\n                    {audit.checks.map((item) => (\n                      <div key={item.id} className=\"pt-2 flex items-start gap-2\">\n                        <span className=\"shrink-0 mt-0.5\">\n                          {item.passed ? (\n                            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                          ) : (\n                            <AlertCircle className=\"w-3.5 h-3.5 text-amber-500\" />\n                          )}\n                        </span>\n                        <div>\n                          <div className=\"font-bold text-gray-900 leading-snug\">{item.titleHi}</div>\n                          <div className=\"text-[11px] text-gray-500 mt-0.5\">{item.recommendationHi}</div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: READABILITY & QUALITY CHECKS */}\n          {activeInspectorTab === \'readability\' && (\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-3\">\n                  Flesch Reading Ease \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\n                </span>\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex flex-col items-center justify-center shrink-0\">\n                    <span className=\"text-xl font-black\">{audit.fleschReadingEase}</span>\n                    <span className=\"text-[9px] font-bold uppercase\">/ 100</span>\n                  </div>\n                  <div>\n                    <div className=\"text-xs font-bold text-gray-900\">{audit.fleschGrade}</div>\n                    <p className=\"text-[11px] text-gray-500 mt-1\">\n                      \340\244\270\340\244\276\340\244\256\340\244\276\340\244\250\340\245\215\340\244\257 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 60+ \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\211\340\244\252\340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\256\340\244\276\340\244\250\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\n                    </p>\n                  </div>\n                </div>\n\n                {/* Metrics */}\n                <div className=\"grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-gray-100 text-xs\">\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Words)</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.wordCount}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">\340\244\252\340\244\242\340\244\274\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.readingTimeMinutes} \340\244\256\340\244\277\340\244\250\340\244\237</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h2}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h3}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Duplicate Content Detection */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-2\">\n                  \340\244\241\340\245\201\340\244\252\340\245\215\340\244\262\340\245\200\340\244\225\340\245\207\340\244\237 / \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232\n                </span>\n                {duplicateSentences.length === 0 ? (\n                  <div className=\"text-xs text-emerald-700 bg-emerald-50 p-3 rounded-xl border border-emerald-200 flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                    <span>\340\244\225\340\245\213\340\244\210 \340\244\205\340\244\250\340\244\276\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\256\340\245\214\340\244\262\340\244\277\340\244\225 \340\244\271\340\245\210\340\245\244</span>\n                  </div>\n                ) : (\n                  <div className=\"text-xs text-amber-800 bg-amber-50 p-3 rounded-xl border border-amber-200 space-y-1.5\">\n                    <div className=\"font-bold flex items-center gap-1.5\">\n                      <AlertCircle className=\"w-4 h-4 text-amber-600\" />\n                      <span>{duplicateSentences.length} \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\217 \340\244\227\340\244\217 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\252\340\244\276\340\244\217 \340\244\227\340\244\217:</span>\n                    </div>\n                    {duplicateSentences.map((sent, i) => (\n                      <div key={i} className=\"text-[11px] italic text-amber-900\">\n                        \342\200\242 \"{sent}\"\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Internal & External Linking Opportunities */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs text-xs space-y-3\">\n                <span className=\"font-bold text-gray-800 uppercase block\">\340\244\262\340\244\277\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\205\340\244\265\340\244\270\340\244\260 (Linking Suggestions)</span>\n                <div>\n                  <span className=\"text-[11px] font-bold text-gray-600 block mb-1\">\340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225 (Internal Links):</span>\n                  {audit.internalLinkOpportunities.map((link, i) => (\n                    <div key={i} className=\"text-[11px] text-blue-700 flex items-center gap-1 my-0.5\">\n                      <ExternalLink className=\"w-3 h-3 text-blue-500\" />\n                      <span>{link}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: SETTINGS (Category, Tags, Image & Alt Text, Schedule) */}\n          {activeInspectorTab === \'settings\' && (\n            <div className=\"space-y-4\">\n              {/* Category */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (WordPress Category) *\n                </label>\n                <select\n                  value={categorySlug}\n                  onChange={(e) => setCategorySlug(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold bg-white\"\n                >\n                  {CATEGORIES.map((c) => (\n                    <option key={c.id} value={c.slug}>\n                      {c.nameHi} ({c.nameEn})\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Featured Image & Alt Text */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 URL (Featured Media)\n                </label>\n                <input\n                  type=\"url\"\n                  value={coverImage}\n                  onChange={(e) => setCoverImage(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-mono mb-2\"\n                />\n\n                {coverImage && (\n                  <div className=\"rounded-xl overflow-hidden border border-gray-200 mb-3 h-28 bg-gray-100\">\n                    <img\n                      src={coverImage}\n                      alt={imageAltText || \'Preview\'}\n                      className=\"w-full h-full object-cover\"\n                    />\n                  </div>\n                )}\n\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 (Image Alt Text - SEO \340\244\265 \340\244\270\340\245\201\340\244\262\340\244\255\340\244\244\340\244\276) *\n                </label>\n                <input\n                  type=\"text\"\n                  value={imageAltText}\n                  onChange={(e) => setImageAltText(e.target.value)}\n                  placeholder=\"\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 (\340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213)...\"\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs\"\n                />\n                <p className=\"text-[10px] text-gray-400 mt-1\">\n                  WordPress \340\244\224\340\244\260 Google Images \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\271\340\245\200 Alt Text \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\274\340\244\277\340\244\225 \340\244\254\340\244\242\340\244\274\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\n                </p>\n              </div>\n\n              {/* Tags Manager */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 (WordPress Tags)\n                </label>\n                <div className=\"flex items-center gap-1.5 mb-2\">\n                  <input\n                    type=\"text\"\n                    value={tagInput}\n                    onChange={(e) => setTagInput(e.target.value)}\n                    onKeyDown={(e) => {\n                      if (e.key === \'Enter\') {\n                        e.preventDefault();\n                        handleAddTag();\n                      }\n                    }}\n                    placeholder=\"\340\244\237\340\245\210\340\244\227 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202...\"\n                    className=\"flex-1 px-3 py-1.5 rounded-lg border border-gray-300 text-xs\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={handleAddTag}\n                    className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-lg\"\n                  >\n                    \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\n                  </button>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {tags.map((t) => (\n                    <span\n                      key={t}\n                      className=\"px-2 py-0.5 rounded-lg bg-rose-50 text-rose-700 text-[11px] font-semibold flex items-center gap-1\"\n                    >\n                      <span>#{t}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleRemoveTag(t)}\n                        className=\"hover:text-rose-900 text-rose-400 font-bold\"\n                      >\n                        \342\234\225\n                      </button>\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Post Toggles & Schedule Date */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs space-y-3\">\n                {status === \'scheduled\' && (\n                  <div>\n                    <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                      \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\270\340\244\256\340\244\257 (Publish Date & Time) *\n                    </label>\n                    <input\n                      type=\"datetime-local\"\n                      value={scheduledDate}\n                      onChange={(e) => setScheduledDate(e.target.value)}\n                      className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-medium\"\n                    />\n                  </div>\n                )}\n\n                <div className=\"flex items-center gap-2 pt-2 border-t border-gray-100\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"breakingToggle\"\n                    checked={isBreaking}\n                    onChange={(e) => setIsBreaking(e.target.checked)}\n                    className=\"w-4 h-4 text-rose-600 rounded border-gray-300\"\n                  />\n                  <label htmlFor=\"breakingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    \340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Breaking Banner)\n                  </label>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"trendingToggle\"\n                    checked={isTrending}\n                    onChange={(e) => setIsTrending(e.target.checked)}\n                    className=\"w-4 h-4 text-amber-500 rounded border-gray-300\"\n                  />\n                  <label htmlFor=\"trendingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    \340\244\237\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\270\340\245\207\340\244\225\340\245\215\340\244\266\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\276\340\244\217\340\244\202\n                  </label>\n                </div>\n              </div>\n            </div>\n          )}"
      replacement_content: "                    <span className=\"font-bold text-gray-700\">{lang === \'en\' ? \'Meta Description\' : \'\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Meta Description)\'}</span>\n                    <span\n                      className={\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'text-emerald-600 font-bold\'\n                          : \'text-amber-600\'\n                      }\n                    >\n                      {metaDescription.length}/160 {lang === \'en\' ? \'chars\' : \'\340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\'}\n                    </span>\n                  </div>\n                  <textarea\n                    rows={3}\n                    value={metaDescription}\n                    onChange={(e) => setMetaDescription(e.target.value)}\n                    placeholder={lang === \'en\' ? \'Write a concise 150-160 char summary with your focus keyword...\' : \'150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\202\340\244\225\340\245\215\340\244\267\340\244\277\340\244\252\340\245\215\340\244\244 \340\244\224\340\244\260 \340\244\206\340\244\225\340\244\260\340\245\215\340\244\267\340\244\225 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 \340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213...\'}\n                    className=\"w-full px-3 py-1.5 rounded-lg border border-gray-300 text-xs focus:border-rose-600\"\n                  />\n                  {/* Progress bar for 150-160 chars */}\n                  <div className=\"w-full bg-gray-100 h-1.5 rounded-full overflow-hidden mt-1\">\n                    <div\n                      className={`h-1.5 rounded-full transition-all ${\n                        metaDescription.length >= 140 && metaDescription.length <= 165\n                          ? \'bg-emerald-500\'\n                          : metaDescription.length > 165\n                          ? \'bg-rose-500\'\n                          : \'bg-amber-400\'\n                      }`}\n                      style={{ width: `${Math.min(100, (metaDescription.length / 160) * 100)}%` }}\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Rank Math 10-Point Checklist */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowSeoChecklist(!showSeoChecklist)}\n                  className=\"w-full flex items-center justify-between text-xs font-bold text-gray-800 cursor-pointer\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                    <span>{lang === \'en\' ? \'Rank Math SEO Checklist\' : \'Rank Math \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\'} ({audit.passedCount}/{audit.totalChecks})</span>\n                  </div>\n                  {showSeoChecklist ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                </button>\n\n                {showSeoChecklist && (\n                  <div className=\"mt-3 divide-y divide-gray-100 text-xs space-y-2\">\n                    {audit.checks.map((item) => (\n                      <div key={item.id} className=\"pt-2 flex items-start gap-2\">\n                        <span className=\"shrink-0 mt-0.5\">\n                          {item.passed ? (\n                            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                          ) : (\n                            <AlertCircle className=\"w-3.5 h-3.5 text-amber-500\" />\n                          )}\n                        </span>\n                        <div>\n                          <div className=\"font-bold text-gray-900 leading-snug\">\n                            {lang === \'en\' ? (item.title || item.titleHi) : item.titleHi}\n                          </div>\n                          <div className=\"text-[11px] text-gray-500 mt-0.5\">\n                            {lang === \'en\' ? (item.recommendation || item.recommendationHi) : item.recommendationHi}\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2: READABILITY & QUALITY CHECKS */}\n          {activeInspectorTab === \'readability\' && (\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-3\">\n                  {lang === \'en\' ? \'Flesch Reading Ease Readability Score\' : \'Flesch Reading Ease \340\244\252\340\244\240\340\244\250\340\245\200\340\244\257\340\244\244\340\244\276 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260\'}\n                </span>\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 border border-emerald-200 flex flex-col items-center justify-center shrink-0\">\n                    <span className=\"text-xl font-black\">{audit.fleschReadingEase}</span>\n                    <span className=\"text-[9px] font-bold uppercase\">/ 100</span>\n                  </div>\n                  <div>\n                    <div className=\"text-xs font-bold text-gray-900\">{audit.fleschGrade}</div>\n                    <p className=\"text-[11px] text-gray-500 mt-1\">\n                      {lang === \'en\' ? \'A score of 60+ is considered optimal for general news readers.\' : \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\250\340\245\215\340\244\257 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 60+ \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\211\340\244\252\340\244\257\340\245\201\340\244\225\340\245\215\340\244\244 \340\244\256\340\244\276\340\244\250\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\'}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Metrics */}\n                <div className=\"grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-gray-100 text-xs\">\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">{lang === \'en\' ? \'Total Words\' : \'\340\244\225\340\245\201\340\244\262 \340\244\266\340\244\254\340\245\215\340\244\246 (Words)\'}</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.wordCount}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">{lang === \'en\' ? \'Reading Time\' : \'\340\244\252\340\244\242\340\244\274\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\270\340\244\256\340\244\257\'}</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.readingTimeMinutes} {lang === \'en\' ? \'min\' : \'\340\244\256\340\244\277\340\244\250\340\244\237\'}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">{lang === \'en\' ? \'H2 Headings\' : \'H2 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270\'}</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h2}</span>\n                  </div>\n                  <div className=\"bg-gray-50 p-2.5 rounded-xl\">\n                    <span className=\"text-[10px] text-gray-400 block font-semibold\">{lang === \'en\' ? \'H3 Subheadings\' : \'H3 \340\244\270\340\244\254-\340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270\'}</span>\n                    <span className=\"text-base font-black text-gray-800\">{audit.headingCounts.h3}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Duplicate Content Detection */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <span className=\"text-xs font-bold text-gray-800 uppercase block mb-2\">\n                  {lang === \'en\' ? \'Duplicate / Repetitive Content Check\' : \'\340\244\241\340\245\201\340\244\252\340\245\215\340\244\262\340\245\200\340\244\225\340\245\207\340\244\237 / \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\234\340\244\276\340\244\202\340\244\232\'}\n                </span>\n                {duplicateSentences.length === 0 ? (\n                  <div className=\"text-xs text-emerald-700 bg-emerald-50 p-3 rounded-xl border border-emerald-200 flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" />\n                    <span>{lang === \'en\' ? \'No unnecessary repetition detected. Content is original.\' : \'\340\244\225\340\245\213\340\244\210 \340\244\205\340\244\250\340\244\276\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\265 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \340\244\270\340\244\276\340\244\256\340\244\227\340\245\215\340\244\260\340\245\200 \340\244\256\340\245\214\340\244\262\340\244\277\340\244\225 \340\244\271\340\245\210\340\245\244\'}</span>\n                  </div>\n                ) : (\n                  <div className=\"text-xs text-amber-800 bg-amber-50 p-3 rounded-xl border border-amber-200 space-y-1.5\">\n                    <div className=\"font-bold flex items-center gap-1.5\">\n                      <AlertCircle className=\"w-4 h-4 text-amber-600\" />\n                      <span>{duplicateSentences.length} {lang === \'en\' ? \'repetitive sentences found:\' : \'\340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\217 \340\244\227\340\244\217 \340\244\265\340\244\276\340\244\225\340\245\215\340\244\257 \340\244\252\340\244\276\340\244\217 \340\244\227\340\244\217:\'}</span>\n                    </div>\n                    {duplicateSentences.map((sent, i) => (\n                      <div key={i} className=\"text-[11px] italic text-amber-900\">\n                        \342\200\242 \"{sent}\"\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Internal & External Linking Opportunities */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs text-xs space-y-3\">\n                <span className=\"font-bold text-gray-800 uppercase block\">\n                  {lang === \'en\' ? \'Linking Suggestions\' : \'\340\244\262\340\244\277\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\205\340\244\265\340\244\270\340\244\260 (Linking Suggestions)\'}\n                </span>\n                <div>\n                  <span className=\"text-[11px] font-bold text-gray-600 block mb-1\">\n                    {lang === \'en\' ? \'Internal Links:\' : \'\340\244\206\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225 \340\244\262\340\244\277\340\244\202\340\244\225 (Internal Links):\'}\n                  </span>\n                  {audit.internalLinkOpportunities.map((link, i) => (\n                    <div key={i} className=\"text-[11px] text-blue-700 flex items-center gap-1 my-0.5\">\n                      <ExternalLink className=\"w-3.5 h-3.5 text-blue-500\" />\n                      <span>{link}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 3: SETTINGS (Category, Tags, Image & Alt Text, Schedule) */}\n          {activeInspectorTab === \'settings\' && (\n            <div className=\"space-y-4\">\n              {/* Category */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  {lang === \'en\' ? \'WordPress Category *\' : \'\340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200 (WordPress Category) *\'}\n                </label>\n                <select\n                  value={categorySlug}\n                  onChange={(e) => setCategorySlug(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-semibold bg-white\"\n                >\n                  {CATEGORIES.map((c) => (\n                    <option key={c.id} value={c.slug}>\n                      {lang === \'en\' ? (c.nameEn || c.nameHi) : `${c.nameHi} (${c.nameEn})`}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              {/* Featured Image & Alt Text */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  {lang === \'en\' ? \'Featured Media URL\' : \'\340\244\253\340\245\200\340\244\232\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\256\340\245\207\340\244\234 URL (Featured Media)\'}\n                </label>\n                <input\n                  type=\"url\"\n                  value={coverImage}\n                  onChange={(e) => setCoverImage(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-mono mb-2\"\n                />\n\n                {coverImage && (\n                  <div className=\"rounded-xl overflow-hidden border border-gray-200 mb-3 h-28 bg-gray-100\">\n                    <img\n                      src={coverImage}\n                      alt={imageAltText || \'Preview\'}\n                      className=\"w-full h-full object-cover\"\n                    />\n                  </div>\n                )}\n\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  {lang === \'en\' ? \'Image Alt Text (SEO & Accessibility) *\' : \'\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\221\340\244\262\340\245\215\340\244\237 \340\244\237\340\245\207\340\244\225\340\245\215\340\244\270\340\245\215\340\244\237 (Image Alt Text - SEO \340\244\265 \340\244\270\340\245\201\340\244\262\340\244\255\340\244\244\340\244\276) *\'}\n                </label>\n                <input\n                  type=\"text\"\n                  value={imageAltText}\n                  onChange={(e) => setImageAltText(e.target.value)}\n                  placeholder={lang === \'en\' ? \'Describe image (including target keyword)...\' : \'\340\244\207\340\244\256\340\245\207\340\244\234 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202 (\340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\271\340\245\213)...\'}\n                  className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs\"\n                />\n                <p className=\"text-[10px] text-gray-400 mt-1\">\n                  {lang === \'en\' ? \'Accurate alt text boosts rankings in WordPress and Google Images.\' : \'WordPress \340\244\224\340\244\260 Google Images \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\271\340\245\200 Alt Text \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\237\340\245\215\340\244\260\340\245\210\340\244\253\340\244\274\340\244\277\340\244\225 \340\244\254\340\244\242\340\244\274\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\'}\n                </p>\n              </div>\n\n              {/* Tags Manager */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs\">\n                <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                  {lang === \'en\' ? \'WordPress Tags\' : \'\340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 (WordPress Tags)\'}\n                </label>\n                <div className=\"flex items-center gap-1.5 mb-2\">\n                  <input\n                    type=\"text\"\n                    value={tagInput}\n                    onChange={(e) => setTagInput(e.target.value)}\n                    onKeyDown={(e) => {\n                      if (e.key === \'Enter\') {\n                        e.preventDefault();\n                        handleAddTag();\n                      }\n                    }}\n                    placeholder={lang === \'en\' ? \'Enter tag...\' : \'\340\244\237\340\245\210\340\244\227 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202...\'}\n                    className=\"flex-1 px-3 py-1.5 rounded-lg border border-gray-300 text-xs\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={handleAddTag}\n                    className=\"px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-lg cursor-pointer\"\n                  >\n                    {lang === \'en\' ? \'Add\' : \'\340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\'}\n                  </button>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {tags.map((tg) => (\n                    <span\n                      key={tg}\n                      className=\"px-2 py-0.5 rounded-lg bg-rose-50 text-rose-700 text-[11px] font-semibold flex items-center gap-1\"\n                    >\n                      <span>#{tg}</span>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleRemoveTag(tg)}\n                        className=\"hover:text-rose-900 text-rose-400 font-bold cursor-pointer\"\n                      >\n                        \342\234\225\n                      </button>\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Post Toggles & Schedule Date */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 p-4 shadow-xs space-y-3\">\n                {status === \'scheduled\' && (\n                  <div>\n                    <label className=\"block text-xs font-bold text-gray-800 uppercase mb-1\">\n                      {lang === \'en\' ? \'Publish Date & Time *\' : \'\340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\250 \340\244\270\340\244\256\340\244\257 (Publish Date & Time) *\'}\n                    </label>\n                    <input\n                      type=\"datetime-local\"\n                      value={scheduledDate}\n                      onChange={(e) => setScheduledDate(e.target.value)}\n                      className=\"w-full px-3 py-2 rounded-xl border border-gray-300 text-xs font-medium\"\n                    />\n                  </div>\n                )}\n\n                <div className=\"flex items-center gap-2 pt-2 border-t border-gray-100\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"breakingToggle\"\n                    checked={isBreaking}\n                    onChange={(e) => setIsBreaking(e.target.checked)}\n                    className=\"w-4 h-4 text-rose-600 rounded border-gray-300 cursor-pointer\"\n                  />\n                  <label htmlFor=\"breakingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    {lang === \'en\' ? \'Breaking News (Banner)\' : \'\340\244\254\340\245\215\340\244\260\340\245\207\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\250\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274 (Breaking Banner)\'}\n                  </label>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"trendingToggle\"\n                    checked={isTrending}\n                    onChange={(e) => setIsTrending(e.target.checked)}\n                    className=\"w-4 h-4 text-amber-500 rounded border-gray-300 cursor-pointer\"\n                  />\n                  <label htmlFor=\"trendingToggle\" className=\"text-xs font-bold text-gray-800 cursor-pointer\">\n                    {lang === \'en\' ? \'Show in Trending Section\' : \'\340\244\237\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\270\340\245\207\340\244\225\340\245\215\340\244\266\340\244\250 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\226\340\244\276\340\244\217\340\244\202\'}\n                  </label>\n                </div>\n              </div>\n            </div>\n          )}"
    }
