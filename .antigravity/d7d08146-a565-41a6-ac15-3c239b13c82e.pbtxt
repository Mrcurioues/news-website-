        lines {
          text: "              <div className=\"bg-white rounded-2xl border border-gray-200 p-5 shadow-xs\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <h3 className=\"text-sm font-black text-gray-900 mb-2 flex items-center gap-1.5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <Sparkles className=\"w-4 h-4 text-purple-600\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <span>\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\225\340\245\215\340\244\267\340\244\256\340\244\244\340\244\276\340\244\217\340\244\202</span>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <span>{lang === \'en\' ? \'Key Assistant Capabilities\' : \'\340\244\205\340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\225\340\245\215\340\244\267\340\244\256\340\244\244\340\244\276\340\244\217\340\244\202\'}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </h3>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <ul className=\"text-xs text-gray-600 space-y-2 leading-relaxed\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <li>\342\200\242 <strong>SEO \340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\225\340\245\215\340\244\232\340\244\260\340\244\277\340\244\202\340\244\227:</strong> Google \340\244\265 Rank Math \340\244\246\340\244\277\340\244\266\340\244\276\340\244\250\340\244\277\340\244\260\340\245\215\340\244\246\340\245\207\340\244\266\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\205\340\244\250\340\245\201\340\244\260\340\245\202\340\244\252 H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <li>\342\200\242 <strong>\340\244\256\340\245\207\340\244\237\340\244\276 \340\244\221\340\244\252\340\245\215\340\244\237\340\244\277\340\244\256\340\244\276\340\244\207\340\244\234\340\244\274\340\245\207\340\244\266\340\244\250:</strong> 150-160 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\241\340\244\277\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\244\277\340\244\252\340\245\215\340\244\266\340\244\250 \340\244\224\340\244\260 \340\244\253\340\245\215\340\244\260\340\245\207\340\244\202\340\244\241\340\244\262\340\245\200 URL \340\244\270\340\245\215\340\244\262\340\244\227\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <li>\342\200\242 <strong>\340\244\225\340\245\215\340\244\265\340\244\276\340\244\262\340\244\277\340\244\237\340\245\200 \340\244\221\340\244\241\340\244\277\340\244\237:</strong> Flesch Reading Ease \340\244\253\340\245\211\340\244\260\340\245\215\340\244\256\340\245\202\340\244\262\340\244\276 \340\244\265 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\241\340\245\207\340\244\202\340\244\270\340\244\277\340\244\237\340\245\200 \340\244\225\340\244\276 \340\244\270\340\244\237\340\245\200\340\244\225 \340\244\256\340\245\202\340\244\262\340\245\215\340\244\257\340\244\276\340\244\202\340\244\225\340\244\250\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  <li>\342\200\242 <strong>\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\257\340\244\252\340\245\215\340\244\260\340\244\243\340\244\276\340\244\262\340\245\200:</strong> \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\255\340\245\200 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\225\340\245\213 \340\244\271\340\244\237\340\244\276\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\205\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\245\215\340\244\257 \340\244\246\340\245\213\340\244\271\340\244\260\340\245\200 \340\244\252\340\245\201\340\244\267\340\245\215\340\244\237\340\244\277 (Explicit confirmation)\340\245\244</li>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                  {lang === \'en\' ? ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      <li>\342\200\242 <strong>SEO Structuring:</strong> H1, H2, H3 heading hierarchy complying with Google & Rank Math guidelines.</li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      <li>\342\200\242 <strong>Meta Optimization:</strong> Exact 150-160 character meta descriptions and search-friendly URL slugs.</li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      <li>\342\200\242 <strong>Quality Audit:</strong> Flesch Reading Ease readability scoring and keyword density evaluation.</li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      <li>\342\200\242 <strong>Safety First:</strong> Strict confirmation modal required before any post deletion.</li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
