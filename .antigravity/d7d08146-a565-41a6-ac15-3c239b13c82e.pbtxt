      replacement_content: "    } catch (err) {\n      console.error(err);\n      setMessages(prev => [\n        ...prev,\n        {\n          id: \'bot-err-\' + Date.now(),\n          sender: \'assistant\',\n          text: lang === \'en\'\n            ? \'Sorry, encountered an issue processing your query. Please try again.\'\n            : \'\340\244\225\340\245\215\340\244\267\340\244\256\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\225\340\245\215\340\244\265\340\245\207\340\244\260\340\245\200 \340\244\252\340\245\215\340\244\260\340\245\213\340\244\270\340\245\207\340\244\270 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\206\340\244\210\340\245\244 \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\252\340\245\201\340\244\250\340\244\203 \340\244\252\340\245\215\340\244\260\340\244\257\340\244\276\340\244\270 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n          timestamp: lang === \'en\' ? \'Just now\' : \'\340\244\205\340\244\255\340\245\200\'\n        }\n      ]);\n    } finally {\n      setIsProcessing(false);\n      setProgressStatus(null);\n    }\n  };\n\n  const handleExecuteAction = (actionPayload: AssistantMessage[\'actionPayload\']) => {\n    if (!actionPayload) return;\n\n    if (actionPayload.actionType === \'create_article\' && actionPayload.articleData) {\n      onCreateNewArticle(actionPayload.articleData);\n      setMessages(prev => [\n        ...prev,\n        {\n          id: \'action-confirm-\' + Date.now(),\n          sender: \'assistant\',\n          text: lang === \'en\'\n            ? `\342\234\205 **Successfully Loaded!** New article draft is active in the editor. You can now inspect and edit.`\n            : `\342\234\205 **\340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\262\340\245\213\340\244\241 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276!** \340\244\250\340\244\257\340\244\276 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\217\340\244\241\340\244\277\340\244\237\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\270\340\244\225\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\206\340\244\252 \340\244\205\340\244\254 \340\244\207\340\244\270\340\245\207 \340\244\246\340\245\207\340\244\226 \340\244\224\340\244\260 \340\244\270\340\244\202\340\244\252\340\244\276\340\244\246\340\244\277\340\244\244 \340\244\225\340\244\260 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244`,\n          timestamp: lang === \'en\' ? \'Just now\' : \'\340\244\205\340\244\255\340\245\200\'\n        }\n      ]);\n    } else if (\n      (actionPayload.actionType === \'update_article\' || actionPayload.actionType === \'apply_seo\' || actionPayload.actionType === \'schedule_article\') &&\n      actionPayload.articleData\n    ) {\n      onApplyArticleData(actionPayload.articleData);\n      setMessages(prev => [\n        ...prev,\n        {\n          id: \'action-confirm-\' + Date.now(),\n          sender: \'assistant\',\n          text: lang === \'en\'\n            ? `\342\234\205 **Changes Applied!** Article headings, meta tags, or schedule details updated for the current post.`\n            : `\342\234\205 **\340\244\252\340\244\260\340\244\277\340\244\265\340\244\260\340\245\215\340\244\244\340\244\250 \340\244\262\340\244\276\340\244\227\340\245\202 \340\244\271\340\245\201\340\244\217!** \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227\340\245\215\340\244\270, \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\237\340\245\210\340\244\227\340\245\215\340\244\270 \340\244\205\340\244\245\340\244\265\340\244\276 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 \340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\252\340\245\213\340\244\270\340\245\215\340\244\237 \340\244\256\340\245\207\340\244\202 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\217 \340\244\227\340\244\217 \340\244\271\340\245\210\340\244\202\340\245\244`,\n          timestamp: lang === \'en\' ? \'Just now\' : \'\340\244\205\340\244\255\340\245\200\'\n        }\n      ]);\n    } else if (actionPayload.actionType === \'delete_article\') {\n      const articleId = actionPayload.articleId || currentArticle?.id || \'current\';\n      const articleTitle = currentArticle?.title || (lang === \'en\' ? \'Selected Article\' : \'\340\244\232\340\244\257\340\244\250\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262\');\n      onConfirmDeleteRequest(articleId, articleTitle);\n    }\n  };\n\n  const quickPrompts = [\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\223\235 Draft New Article\' : \'\360\237\223\235 \340\244\250\340\244\257\340\244\276 SEO \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Write a 600-word SEO-optimized article on ISRO latest space exploration mission\'\n        : \'ISRO \340\244\225\340\245\207 \340\244\250\340\244\217 \340\244\205\340\244\202\340\244\244\340\244\260\340\244\277\340\244\225\340\245\215\340\244\267 \340\244\252\340\244\260\340\245\200\340\244\225\340\245\215\340\244\267\340\244\243 \340\244\252\340\244\260 600 \340\244\266\340\244\254\340\245\215\340\244\246\340\245\213\340\244\202 \340\244\225\340\244\276 SEO-\340\244\205\340\244\250\340\245\201\340\244\225\340\245\202\340\244\262\340\244\277\340\244\244 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\262\340\244\277\340\244\226\340\245\213\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\224\215 SEO Audit\' : \'\360\237\224\215 Yoast/Rank Math \340\244\221\340\244\241\340\244\277\340\244\237\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Audit the Rank Math and Yoast SEO score of the current article\'\n        : \'\340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\244\276 Rank Math \340\244\224\340\244\260 Yoast SEO \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260 \340\244\221\340\244\241\340\244\277\340\244\237 \340\244\225\340\244\260\340\245\213\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\223\221 Fix H1/H2/H3 Headings\' : \'\360\237\223\221 H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\270\340\245\215\340\244\237\340\245\215\340\244\260\340\244\225\340\245\215\340\244\232\340\244\260\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Create a WordPress H1, H2, H3 heading hierarchy for the current article\'\n        : \'\340\244\265\340\244\260\340\245\215\340\244\244\340\244\256\340\244\276\340\244\250 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 WordPress H1, H2, H3 \340\244\271\340\245\207\340\244\241\340\244\277\340\244\202\340\244\227 \340\244\252\340\244\246\340\244\276\340\244\250\340\245\201\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\244\340\245\210\340\244\257\340\244\276\340\244\260 \340\244\225\340\244\260\340\245\213\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\217\267\357\270\217 Meta Tags & Slug\' : \'\360\237\217\267\357\270\217 150-\340\244\205\340\244\225\340\245\215\340\244\267\340\244\260 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265 \340\244\270\340\245\215\340\244\262\340\244\227\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Generate a 150-character meta description, focus keyword, and SEO slug for this article\'\n        : \'\340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 150 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\256\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\277\340\244\265\340\244\260\340\244\243, \340\244\253\340\245\213\340\244\225\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\224\340\244\260 SEO \340\244\270\340\245\215\340\244\262\340\244\227 \340\244\254\340\244\250\340\244\276\340\244\223\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\342\217\260 Schedule Post\' : \'\342\217\260 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 / \340\244\241\340\245\215\340\244\260\340\244\276\340\244\253\340\245\215\340\244\237 \340\244\270\340\245\215\340\244\237\340\245\207\340\244\237\340\244\270\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Schedule this article for tomorrow morning at 9:00 AM\'\n        : \'\340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\213 \340\244\225\340\244\262 \340\244\270\340\245\201\340\244\254\340\244\271 9 \340\244\254\340\244\234\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\266\340\245\207\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 (Schedule) \340\244\225\340\244\260\340\245\213\'\n    },\n    {\n      label: (language === \'en\' || lang === \'en\') ? \'\360\237\227\221\357\270\217 Delete Article\' : \'\360\237\227\221\357\270\217 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\271\340\244\237\340\244\276\340\244\217\340\244\202 (Delete)\',\n      query: (language === \'en\' || lang === \'en\')\n        ? \'Delete this article\'\n        : \'\340\244\207\340\244\270 \340\244\206\340\244\260\340\245\215\340\244\237\340\244\277\340\244\225\340\244\262 \340\244\225\340\245\213 \340\244\241\340\244\277\340\244\262\340\245\200\340\244\237 (Delete) \340\244\225\340\244\260\340\245\213\'\n    }\n  ];"
