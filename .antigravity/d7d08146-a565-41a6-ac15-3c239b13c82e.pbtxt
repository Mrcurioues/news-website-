    replacement_chunks {
      replacement_content: "import React, { useEffect } from \'react\';\nimport { getVideoByIdSlug, DEMO_VIDEOS } from \'../data/demo\';\nimport { useRouter, Link } from \'../context/RouterContext\';\nimport { ShareBar } from \'../components/ShareBar\';\nimport { ImageWithFallback } from \'../components/ImageWithFallback\';\nimport { ChevronRight, Play, Eye, Clock, ArrowLeft, Video } from \'lucide-react\';\n\ninterface VideoDetailPageProps {\n  idSlug: string;\n}\n\nexport const VideoDetailPage: React.FC<VideoDetailPageProps> = ({ idSlug }) => {\n  const { updateMetadata } = useRouter();\n  const video = getVideoByIdSlug(idSlug);\n\n  useEffect(() => {\n    if (video) {\n      updateMetadata({\n        title: video.titleHi,\n        description: video.description,\n        ogImage: video.thumbnail\n      });\n    }\n  }, [video]);\n\n  if (!video) {\n    return (\n      <div className=\"max-w-4xl mx-auto px-4 py-20 text-center\">\n        <h1 className=\"text-2xl font-black text-gray-900 mb-4\">\340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\211\340\244\252\340\244\262\340\244\254\340\245\215\340\244\247 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210</h1>\n        <Link\n          href=\"/videos\"\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 text-white rounded-lg font-bold text-sm\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>\340\244\270\340\244\255\340\245\200 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202</span>\n        </Link>\n      </div>\n    );\n  }\n\n  const nextVideos = DEMO_VIDEOS.filter(v => v.id !== video.id);\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6\">\n      {/* Breadcrumbs */}\n      <nav aria-label=\"Breadcrumb\" className=\"flex items-center gap-1.5 text-xs text-gray-500 mb-4\">\n        <Link href=\"/\" className=\"hover:text-rose-600 transition-colors\">\340\244\271\340\245\213\340\244\256</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <Link href=\"/videos\" className=\"hover:text-rose-600 transition-colors\">\340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213</Link>\n        <ChevronRight className=\"w-3 h-3 text-gray-400\" />\n        <span className=\"truncate max-w-[200px] sm:max-w-md text-gray-900 font-semibold\">{video.titleHi}</span>\n      </nav>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        {/* Main Video Player & Details (8 Cols) */}\n        <div className=\"lg:col-span-8\">\n          {/* 16:9 Responsive YouTube Video Player */}\n          <div className=\"relative aspect-16/9 w-full bg-black rounded-xl overflow-hidden shadow-lg border border-gray-800\">\n            <iframe\n              src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=1&rel=0`}\n              title={video.titleHi}\n              className=\"w-full h-full border-0\"\n              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n              allowFullScreen\n            ></iframe>\n          </div>\n\n          {/* Video Metadata Box */}\n          <div className=\"bg-white rounded-xl border border-gray-200 p-6 mt-4 shadow-xs\">\n            <div className=\"flex flex-wrap items-center gap-2 mb-3\">\n              <span className=\"px-3 py-1 rounded-full bg-rose-600 text-white font-bold text-xs\">\n                {video.category}\n              </span>\n              <span className=\"px-2.5 py-0.5 rounded bg-gray-100 text-gray-600 text-xs font-mono\">\n                \340\244\205\340\244\265\340\244\247\340\244\277: {video.duration}\n              </span>\n            </div>\n\n            <h1 className=\"text-xl sm:text-2xl font-black text-gray-950 leading-snug\">\n              {video.titleHi}\n            </h1>\n\n            {video.title && (\n              <p className=\"mt-1 text-sm text-gray-500 font-medium\">\n                {video.title}\n              </p>\n            )}\n\n            <div className=\"mt-4 py-3 border-y border-gray-100 flex flex-wrap items-center justify-between gap-4 text-xs text-gray-500\">\n              <div className=\"flex items-center gap-4\">\n                <span className=\"flex items-center gap-1 font-medium text-gray-700\">\n                  <Eye className=\"w-4 h-4 text-gray-400\" />\n                  {video.views} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274\n                </span>\n                <span className=\"flex items-center gap-1\">\n                  <Clock className=\"w-4 h-4 text-gray-400\" />\n                  {video.publishedAt}\n                </span>\n              </div>\n            </div>\n\n            {/* Share Bar */}\n            <ShareBar title={video.titleHi} />\n\n            {/* Video Description */}\n            <div className=\"mt-4 pt-4 border-t border-gray-100\">\n              <h3 className=\"font-bold text-sm text-gray-900 mb-2\">\340\244\265\340\244\277\340\244\265\340\244\260\340\244\243 (Description):</h3>\n              <p className=\"text-xs sm:text-sm text-gray-700 leading-relaxed\">\n                {video.description}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Rail: Next Videos (4 Cols) */}\n        <div className=\"lg:col-span-4 space-y-4\">\n          <div className=\"bg-white rounded-xl border border-gray-200 p-4 shadow-xs\">\n            <h3 className=\"font-extrabold text-base text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2\">\n              <Video className=\"w-4 h-4 text-rose-600\" />\n              <span>\340\244\205\340\244\227\340\244\262\340\244\276 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 (More Videos)</span>\n            </h3>\n\n            <div className=\"space-y-4\">\n              {nextVideos.map((item) => (\n                <Link\n                  key={item.id}\n                  href={`/videos/${item.idSlug}`}\n                  className=\"group flex gap-3 pb-3 border-b border-gray-100 last:border-0 last:pb-0\"\n                >\n                  <div className=\"relative w-28 aspect-16/10 rounded-md overflow-hidden bg-black shrink-0\">\n                    <ImageWithFallback\n                      src={item.thumbnail}\n                      alt={item.titleHi}\n                      className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\"\n                    />\n                    <div className=\"absolute inset-0 bg-black/30 flex items-center justify-center\">\n                      <Play className=\"w-4 h-4 fill-white text-white\" />\n                    </div>\n                    <span className=\"absolute bottom-1 right-1 bg-black/80 text-white text-[9px] px-1 rounded font-mono\">\n                      {item.duration}\n                    </span>\n                  </div>\n\n                  <div className=\"flex-1 min-w-0\">\n                    <span className=\"text-[10px] font-bold text-rose-600 uppercase\">\n                      {item.category}\n                    </span>\n                    <h4 className=\"text-xs font-bold text-gray-900 group-hover:text-rose-600 transition-colors line-clamp-2 leading-snug mt-0.5\">\n                      {item.titleHi}\n                    </h4>\n                    <div className=\"mt-1 text-[10px] text-gray-400\">\n                      {item.views} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\340\244\274\n                    </div>\n                  </div>\n                </Link>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
